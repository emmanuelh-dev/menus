{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menus",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "menus.bysmax.com",
      "zone_name": "bysmax.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "GO_API_URL": "https://adminm.bysmax.com"
  },
  "observability": {
    "enabled": true
  }
}
