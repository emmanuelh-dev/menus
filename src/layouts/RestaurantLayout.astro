---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ReviewForm from "../components/ReviewForm";
import ScrollTopAndComment from "../components/ScrollTopAndComment";
import { supabase } from "../lib/supabase";

const path = Astro.url.pathname;

interface Address {
	streetAddress?: string;
	addressLocality?: string;
	postalCode?: string;
	addressCountry?: string;
}

interface MenuItem {
	"@type": "MenuItem";
	name: string;
	description?: string;
	price?: string;
	image?: string;
}

interface MenuSection {
	"@type": "MenuSection";
	name: string;
	description?: string;
	items?: MenuItem[];
}

interface OpeningHoursSpecification {
	"@type": "OpeningHoursSpecification";
	dayOfWeek: string[];
	opens: string;
	closes: string;
}

export interface Props {
	title: string;
	description: string;
	image?: string;
	type?: "Restaurant" | "Menu" | "Event";
	textWhite?: boolean;
	backgroundColor?: string;
	favicon?: string;
	canonical?: string;
	ogUrl?: string;
	keywords?: string;
	place?: any;
	schemaEnrichment?: {
		address?: Address;
		telephone?: string;
		email?: string;
		priceRange?: string;
		servesCuisine?: string | string[];
		menu?: MenuSection[];
		openingHours?: string | OpeningHoursSpecification[];
		acceptsReservations?: boolean;
		paymentAccepted?: string[];
		currenciesAccepted?: string[];
		aggregateRating?: {
			ratingValue: number;
			reviewCount: number;
		};
		awards?: string[];
		suitableForDiet?: string[];
	};
}

const {
	title,
	description,
	image,
	favicon,
	type = "Restaurant",
	textWhite = false,
	backgroundColor = "bg-white",
	schemaEnrichment = {},
	canonical,
	ogUrl,
	keywords,
	place = {},
} = Astro.props;

const currentYear = new Date().getFullYear();
const streetAddress =
	schemaEnrichment.address?.streetAddress ||
	place?.content?.semantic_data?.address ||
	"";
const city =
	schemaEnrichment.address?.addressLocality ||
	place?.states?.name ||
	"Monterrey";

const isMotel = place?.type === "motel" || path.includes("/moteles");

function generateSEOTitle(): string {
	const location = city ? ` en ${city}` : "";
	if (isMotel) {
		return `${title} Precios, Fotos y Habitaciones (${currentYear})${location}`;
	}
	return `Menú de ${title} y Precios (${currentYear}) | Carta Digital${location}`;
}

function generateSEODescription(): string {
	const location = city ? ` en ${city}` : "";
	const reviews =
		reviewStats.reviewCount > 0
			? ` Con ${reviewStats.reviewCount} opiniones y ${reviewStats.ratingValue} estrellas.`
			: "";

	if (isMotel) {
		return `Consulta los precios actualizados, fotos de habitaciones y ubicación de ${title}${location}. Descubre tarifas de 12 horas y opciones con jacuzzi.${reviews}`;
	}
	return `Conoce el menú actualizado de ${title}${location}. Consulta todos los precios del ${currentYear}, paquetes y fotos de los platillos. ${description || ""}${reviews}`;
}

let reviewStats = {
	ratingValue: 0,
	reviewCount: 0,
};

let initialReviews = [];
let restaurantData: any = null;

try {
	const { data } = await supabase
		.from("places")
		.select("id")
		.eq("menu", path)
		.single();

	restaurantData = data;

	if (restaurantData) {
		const [reviewsResponse, statsResponse] = await Promise.all([
			supabase
				.from("reviews")
				.select("*")
				.eq("place_id", restaurantData.id)
				.order("created_at", { ascending: false })
				.limit(10),

			supabase.from("reviews").select("rate").eq("place_id", restaurantData.id),
		]);

		if (reviewsResponse.data) {
			initialReviews = reviewsResponse.data as any;
		}

		if (statsResponse.data && statsResponse.data.length > 0) {
			const totalRating = statsResponse.data.reduce(
				(sum, review) => sum + review.rate,
				0,
			);
			const averageRating = totalRating / statsResponse.data.length;

			reviewStats = {
				ratingValue: parseFloat(averageRating.toFixed(1)),
				reviewCount: statsResponse.data.length,
			};
		}
	}
} catch (error) {
	console.error("Error al obtener estadísticas de reseñas:", error);
}

const seoTitle = generateSEOTitle();
const seoDescription = generateSEODescription();
const trackingPlaceId = place?.id || restaurantData?.id || null;

// Fallback image logic
let ogImage = image || place.image;
if (!ogImage && place.content?.blocks) {
	const firstBlockWithImage = place.content.blocks.find((block: any) => {
		if (block.type === "carrusel" && block.data.items?.[0]?.src) return true;
		if (
			block.type === "section" &&
			block.data.items?.some((item: any) => item.image)
		)
			return true;
		if (block.type === "gallery" && block.data.images?.[0]?.src) return true;
		return false;
	});

	if (firstBlockWithImage) {
		if (firstBlockWithImage.type === "carrusel")
			ogImage = firstBlockWithImage.data.items[0].src;
		else if (firstBlockWithImage.type === "section")
			ogImage = firstBlockWithImage.data.items.find((i: any) => i.image).image;
		else if (firstBlockWithImage.type === "gallery")
			ogImage = firstBlockWithImage.data.images[0].src;
	}
}

const schema: any = {
	"@context": "https://schema.org",
	"@type": type,
	name: title,
	description: seoDescription,
};

if (ogImage) {
	schema.image = ogImage.startsWith("http")
		? ogImage
		: new URL(ogImage, Astro.url).toString();
}

if (schemaEnrichment.address) {
	schema.address = {
		"@type": "PostalAddress",
		...schemaEnrichment.address,
	};
} else if (place?.content?.semantic_data?.address) {
	schema.address = {
		"@type": "PostalAddress",
		streetAddress: place.content.semantic_data.address,
		addressLocality: city,
		addressRegion: place.states?.name || "Nuevo León",
		addressCountry: "MX",
	};
}

if (schemaEnrichment.telephone) {
	schema.telephone = schemaEnrichment.telephone;
} else if (place?.content?.semantic_data?.phone) {
	schema.telephone = place.content.semantic_data.phone;
}
if (schemaEnrichment.email) schema.email = schemaEnrichment.email;
if (schemaEnrichment.priceRange)
	schema.priceRange = schemaEnrichment.priceRange;
if (schemaEnrichment.servesCuisine)
	schema.servesCuisine = schemaEnrichment.servesCuisine;
if (schemaEnrichment.openingHours)
	schema.openingHours = schemaEnrichment.openingHours;
if (schemaEnrichment.acceptsReservations)
	schema.acceptsReservations = schemaEnrichment.acceptsReservations;
if (schemaEnrichment.paymentAccepted)
	schema.paymentAccepted = schemaEnrichment.paymentAccepted;
if (schemaEnrichment.currenciesAccepted)
	schema.currenciesAccepted = schemaEnrichment.currenciesAccepted;

if (reviewStats.reviewCount > 0) {
	schema.aggregateRating = {
		"@type": "AggregateRating",
		ratingValue: reviewStats.ratingValue,
		reviewCount: reviewStats.reviewCount,
		bestRating: 5,
		worstRating: 1,
	};

	// Agregar reviews individuales para rich snippets
	schema.review = initialReviews.slice(0, 10).map((review: any) => ({
		"@type": "Review",
		reviewRating: {
			"@type": "Rating",
			ratingValue: review.rate,
			bestRating: 5,
			worstRating: 1,
		},
		author: {
			"@type": "Person",
			name: review.name || "Usuario Anónimo",
		},
		reviewBody: review.comments,
		datePublished: review.created_at,
	}));
} else if (schemaEnrichment.aggregateRating) {
	schema.aggregateRating = {
		"@type": "AggregateRating",
		...schemaEnrichment.aggregateRating,
	};
}

if (type === "Menu" && schemaEnrichment.menu) {
	schema.hasMenuSection = schemaEnrichment.menu;
}

if (schemaEnrichment.awards) {
	schema.awards = schemaEnrichment.awards;
}

if (schemaEnrichment.suitableForDiet) {
	schema.suitableForDiet = schemaEnrichment.suitableForDiet.map(
		(diet) => `http://schema.org/${diet}`,
	);
}
---

<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0"
		/>
		{
			place?.short_name ? (
				<link
					rel="manifest"
					href={`/manifest.json?slug=${place.short_name}&v=4&type=${place.type || "restaurant"}&path=${Astro.url.pathname}`}
				/>
			) : (
				<link rel="manifest" href="/site.webmanifest" />
			)
		}
		<link
			rel="icon"
			type="image/svg+xml"
			href={favicon ? favicon : "/favicon.ico"}
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{seoTitle}</title>
		<meta name="description" content={seoDescription} />
		{keywords && <meta name="keywords" content={keywords} />}
		<link rel="canonical" href={canonical || Astro.url} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={ogUrl || Astro.url} />
		<meta property="og:title" content={seoTitle} />
		<meta property="og:description" content={seoDescription} />
		{
			ogImage && (
				<meta
					property="og:image"
					content={
						ogImage.startsWith("http")
							? ogImage
							: new URL(ogImage, Astro.url).toString()
					}
				/>
			)
		}
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={ogUrl || Astro.url} />
		<meta property="twitter:title" content={seoTitle} />
		<meta property="twitter:description" content={seoDescription} />
		{
			ogImage && (
				<meta
					property="twitter:image"
					content={
						ogImage.startsWith("http")
							? ogImage
							: new URL(ogImage, Astro.url).toString()
					}
				/>
			)
		}

		<!-- Schema.org for Google -->
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />

		<!-- Google Fonts for Restaurant Feel -->
		<link
			href="https://fonts.googleapis.com/css2?family=Yeseva+One&family=Inter:wght@400;700;900&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Merriweather:ital,opsz,wght@0,18..144,300..900;1,18..144,300..900&display=swap"
			rel="stylesheet"
		/>

		<!-- Google Maps API -->
		<script
			src={`https://maps.googleapis.com/maps/api/js?key=${import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY}&libraries=places&language=es&region=MX`}
			async
			defer></script>

		<!-- <script 
         async 
         src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3646138644530578"
         crossorigin="anonymous"
        /> -->

		<!-- <ViewTransitions />

        <style is:global>
            :root {
                --color-text: #333;
                --color-bg: #fff;
                --color-primary: #8b4513;
                --color-secondary: #f4a460;
            }
            html {
                font-family: "Lato", system-ui, sans-serif;
                background-color: var(--color-bg);
                color: var(--color-text);
            }
            .font-serif {
                  font-family: "Yeseva One", serif;
            }
        </style> -->

		<script
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id="b5a89fc6-d2ad-490e-b6f0-e608f3330d6b"></script>
		{trackingPlaceId && (
			<script is:inline define:vars={{ trackingPlaceId }}>
				(() => {
					try {
						const isLocalhost =
							window.location.hostname === "localhost" ||
							window.location.hostname === "127.0.0.1";
						const storageKey = "menu_visitor_id";
						let visitorId = localStorage.getItem(storageKey);
						if (!visitorId) {
							visitorId =
								typeof crypto !== "undefined" && "randomUUID" in crypto
									? crypto.randomUUID()
									: `${Date.now()}-${Math.random().toString(16).slice(2)}`;
							localStorage.setItem(storageKey, visitorId);
						}

						const payload = JSON.stringify({
							placeId: trackingPlaceId,
							visitorId,
							path: window.location.pathname,
						});

						if (isLocalhost) {
							console.log("[analytics] track payload", {
								placeId: trackingPlaceId,
								visitorId,
								path: window.location.pathname,
							});
						}

						if (!isLocalhost && navigator.sendBeacon) {
							const blob = new Blob([payload], { type: "application/json" });
							navigator.sendBeacon("/api/analytics/visit", blob);
						} else {
							fetch("/api/analytics/visit", {
								method: "POST",
								headers: { "Content-Type": "application/json" },
								body: payload,
								keepalive: true,
							})
								.then(async (response) => {
									if (isLocalhost) {
										const text = await response.text();
										console.log("[analytics] track response", response.status, text || "<empty>");
									}
								})
								.catch((error) => {
									if (isLocalhost) {
										console.error("[analytics] track error", error);
									}
								});
						}
					} catch (_error) {
						return;
					}
				})();
			</script>
		)}
		<script is:inline>
			(function (c, l, a, r, i, t, y) {
				c[a] =
					c[a] ||
					function () {
						(c[a].q = c[a].q || []).push(arguments);
					};
				t = l.createElement(r);
				t.async = 1;
				t.src = "https://www.clarity.ms/tag/" + i;
				y = l.getElementsByTagName(r)[0];
				y.parentNode.insertBefore(t, y);
			})(window, document, "clarity", "script", "s1a8gh6len");
		</script>
	</head>
	<body class="restaurant-typography">
		<Header textWhite={textWhite} backgroundColor={backgroundColor} />
		<slot />
		{
			(path.includes("/menus/") ||
				path.includes("/cafeterias") ||
				path.includes("/espadas") ||
				path.includes("/moteles")) && (
				<div
					class={`${textWhite ? "text-white" : "text-black"} ${backgroundColor} review-form-section`}
				>
					<div>
						{(place?.id || restaurantData?.id) && (
							<ReviewForm
								client:load
								id={place?.id || restaurantData?.id}
								restaurantName={title}
								initialReviews={initialReviews}
							/>
						)}
					</div>
				</div>
			)
		}
		<ScrollTopAndComment client:load />
		<Footer textWhite={textWhite} backgroundColor={backgroundColor} />

		<style>
			body {
				overflow-x: hidden;
				width: 100vw;
			}
		</style>
	</body>
</html>
