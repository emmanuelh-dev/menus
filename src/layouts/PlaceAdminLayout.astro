---
import AdminLayout from "./AdminLayout.astro";
import PlaceSecondaryNav from "../components/admin/PlaceSecondaryNav";

interface Props {
	title: string;
	placeId: string;
}

const { title, placeId } = Astro.props;
const currentPath = Astro.url.pathname;
---

<AdminLayout title={title}>
	<div class="flex flex-col min-h-screen">
		<PlaceSecondaryNav
			placeId={placeId}
			currentPath={currentPath}
			client:load
		/>

		<div
			class="flex-1 w-full max-w-7xl mx-auto px-4 py-6 md:py-8 pb-32 md:pb-8"
		>
			<slot />
		</div>
	</div>
</AdminLayout>
