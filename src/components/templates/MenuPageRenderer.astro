---
import RestaurantLayout from "../../layouts/RestaurantLayout.astro";
import Gallery from "../Gallery.astro";
import { Image } from "astro:assets";
import CartManager from "../CartManager.tsx";
import FavoritesManager from "../FavoritesManager.tsx";
import Carousel from "../Carousel.tsx";

interface Props {
	place: any;
	name: string;
}

const { place, name } = Astro.props;

let { blocks = [], view_settings = {} } = place.content || {};
const enableCart = place.content?.semantic_data?.enable_cart || false;
const whatsappNumber = place.content?.semantic_data?.whatsapp || "";

// Limpieza de bloques
blocks = blocks.map((block: any) => {
	if (block.type === "gallery" && block.data.images) {
		const imagesWithAlt = block.data.images.map((img: any, idx: number) => ({
			...img,
			alt: img.alt || `${place.name} - Galería ${idx + 1}`,
		}));
		return { ...block, data: { ...block.data, images: imagesWithAlt } };
	}
	return block;
});

const address = place.content?.semantic_data?.address || place.address || "";
const mapsSearchQuery = encodeURIComponent(`${place.name} ${address || ""}`);
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsSearchQuery}`;

// Find first carousel block for hero
const heroCarousel = blocks.find((block: any) => block.type === "carrusel");

const template = view_settings.template || "default";

const templateConfigs: Record<string, any> = {
	default: {
		bg: "bg-[#FCFCFC]",
		text: "text-[#1A1A1A]",
		headerClass: "text-center",
		titleClass: "text-4xl md:text-6xl font-bold serif italic drop-shadow-2xl",
		sectionTitleClass:
			"text-xl uppercase tracking-[0.3em] font-black text-stone-800 transition-all group-open:text-red-900",
		itemTitleClass:
			"text-lg font-medium tracking-tight group-hover/item:text-red-900 transition-colors",
		fontImport: "family=Playfair+Display:ital,wght@1,400;1,700",
		fontFamily: "'Playfair Display', serif",
	},
	modern: {
		bg: "bg-white",
		text: "text-gray-900",
		headerClass: "text-left border-l-4 border-black pl-6",
		titleClass:
			"text-5xl md:text-7xl font-black uppercase tracking-tighter leading-none",
		sectionTitleClass:
			"text-3xl font-black tracking-tighter text-gray-900 group-open:text-blue-600",
		itemTitleClass:
			"text-xl font-bold tracking-tight group-hover/item:text-blue-600 transition-colors",
		fontImport: "family=Inter:wght@400;700;900",
		fontFamily: "'Inter', sans-serif",
	},
	elegant: {
		bg: "bg-stone-50",
		text: "text-stone-900",
		headerClass: "text-center py-12",
		titleClass: "text-5xl md:text-8xl font-light serif italic tracking-tight",
		sectionTitleClass:
			"text-2xl serif italic tracking-widest text-stone-800 group-open:text-amber-700",
		itemTitleClass:
			"text-lg serif font-semibold tracking-wide group-hover/item:text-amber-700 transition-colors",
		fontImport: "family=Cormorant+Garamond:ital,wght@1,300;1,600",
		fontFamily: "'Cormorant Garamond', serif",
	},
};

const config = templateConfigs[template] || templateConfigs.default;
---

<RestaurantLayout
	description={place?.content?.semantic_data?.description ||
		place?.description ||
		place.name}
	title={place.name}
	place={place}
	backgroundColor={config.bg}
>
	<div class:list={["min-h-screen", config.bg, config.text]}>
		{/* Hero Section with Carousel or Image */}
		<div>
			{
				heroCarousel && heroCarousel.data.items?.length > 0 ? (
					<Carousel
						client:load
						items={heroCarousel.data.items}
						className="w-full max-w-3xl mx-auto"
					/>
				) : place.image?.trim() ? (
					<Image
						src={place.image}
						alt={`${place.name} - ${place.content?.semantic_data?.description || place.description || "Restaurante"}`}
						width={400}
						height={400}
						class="w-full h-auto object-cover max-h-[60vh]"
						loading="eager"
						format="webp"
					/>
				) : (
					<div class="h-32 bg-stone-900" />
				)
			}
		</div>

		<div class:list={["max-w-2xl mx-auto px-6 mt-8", config.headerClass]}>
			<h1 class={config.titleClass}>
				{place.name}
			</h1>
		</div>

		<div class="max-w-2xl mx-auto px-6 mt-8">
			{/* Info compacta en una sola línea de chips */}
			{
				place.content?.semantic_data && (
					<section class="mb-12" aria-label="Información del restaurante">
						<div class="flex flex-wrap justify-center gap-2 text-xs text-stone-600">
							{place.content.semantic_data.phone && (
								<a
									href={`tel:${place.content.semantic_data.phone}`}
									class="inline-flex items-center gap-1.5 px-3 py-2 bg-red-500 hover:bg-red-600 text-white rounded-full text-xs font-bold transition-all"
									aria-label={`Llamar a ${place.name} al teléfono ${place.content.semantic_data.phone}`}
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="w-4 h-4"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
										/>
									</svg>
									Llamar
								</a>
							)}

							{place.content.semantic_data.whatsapp && (
								<a
									href={`https://wa.me/${place.content.semantic_data.whatsapp.replace(/\D/g, "")}?text=${encodeURIComponent(`Hola, me gustaría hacer una reservación en ${place.name}`)}`}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1.5 px-3 py-2 bg-green-500 hover:bg-green-600 text-white rounded-full text-xs font-bold transition-all"
									aria-label={`Enviar mensaje de WhatsApp a ${place.name}`}
								>
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
										<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
									</svg>
									WhatsApp
								</a>
							)}

							{address && (
								<a
									href={googleMapsUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1.5 px-3 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-full text-xs font-bold transition-all"
									aria-label={`Ver ubicación de ${place.name} en Google Maps: ${address}`}
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="w-4 h-4"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
										/>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
										/>
									</svg>
									Ubicación
								</a>
							)}
							{place.content.semantic_data.hours && (
								<span class="inline-flex items-center gap-1 px-3 py-1.5 bg-stone-100 rounded-full">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="w-3.5 h-3.5"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
										/>
									</svg>
									<span class="font-medium">
										{place.content.semantic_data.hours}
									</span>
								</span>
							)}

							{place.content.semantic_data.price_range && (
								<span class="inline-flex items-center gap-1 px-3 py-1.5 bg-stone-100 rounded-full">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="w-3.5 h-3.5"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
										/>
									</svg>
									<span class="font-medium">
										{place.content.semantic_data.price_range}
									</span>
								</span>
							)}

							{place.content.semantic_data.parking && (
								<span class="inline-flex items-center gap-1 px-3 py-1.5 bg-stone-100 rounded-full">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="w-3.5 h-3.5"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"
										/>
									</svg>
									<span class="font-medium">
										{place.content.semantic_data.parking}
									</span>
								</span>
							)}

							{place.content.semantic_data.payment_options &&
								place.content.semantic_data.payment_options.length > 0 && (
									<>
										{place.content.semantic_data.payment_options.map(
											(payment: string) => (
												<span class="inline-flex items-center gap-1 px-3 py-1.5 bg-stone-100 rounded-full text-xs">
													{payment.toLowerCase().includes("efectivo") && "💵"}
													{payment.toLowerCase().includes("tarjeta") && "💳"}
													{payment.toLowerCase().includes("transferencia") &&
														"🏦"}
													<span class="font-medium">{payment}</span>
												</span>
											),
										)}
									</>
								)}
						</div>
					</section>
				)
			}

			{/* Favorites Manager - Always visible */}
			<FavoritesManager client:load placeSlug={name} blocks={blocks} />

			{/* Cart Manager - Only when enabled */}
			{
				enableCart && whatsappNumber && (
					<CartManager
						client:load
						placeName={place.name}
						placeSlug={name}
						whatsappNumber={whatsappNumber}
						blocks={blocks}
					/>
				)
			}

			{/* Menú con Acordeón Nativo y Lógica de Apertura */}
			<div class="space-y-12">
				{
					(() => {
						let sectionCounter = 0;
						return blocks.map((block: any) => {
							if (block.type === "section") {
								const isOpen = sectionCounter < 2;
								sectionCounter++;

								return (
									<details
										class="group border-b border-stone-100 pb-8"
										open={isOpen}
									>
										<summary
											class:list={[
												"flex justify-between items-center cursor-pointer list-none sticky top-0 backdrop-blur-md z-10 py-6 outline-none",
												config.bg + "/95",
											]}
										>
											<h2 class={config.sectionTitleClass}>
												{block.data.title}
											</h2>
											<div class="text-stone-400 transition-transform duration-300 group-open:rotate-180">
												<svg
													xmlns="http://www.w3.org/2000/svg"
													class="h-5 w-5"
													fill="none"
													viewBox="0 0 24 24"
													stroke="currentColor"
												>
													<path
														stroke-linecap="round"
														stroke-linejoin="round"
														stroke-width="2"
														d="M19 9l-7 7-7-7"
													/>
												</svg>
											</div>
										</summary>

										<div class="space-y-12 pt-8 animate-in fade-in slide-in-from-top-2 duration-500 overflow-hidden">
											{block.data.description && (
												<p class="text-stone-400 text-sm font-light italic mb-8 border-l-2 border-stone-200 px-4">
													{block.data.description}
												</p>
											)}

											{block.data.items?.map((item: any) => (
												<div class="space-y-4" data-item-id={item.id}>
													<div class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-x-8 items-start group/item">
														<div class="order-2 sm:order-1">
															<div class="flex justify-between items-baseline mb-1">
																<h3 class={config.itemTitleClass}>
																	{item.name}
																</h3>
																<span class="text-sm font-bold text-stone-500 ml-4">
																	{view_settings.show_prices &&
																		item.price > 0 &&
																		`$${item.price}`}
																</span>
															</div>
															{item.description && (
																<p class="text-stone-400 text-sm font-light leading-relaxed">
																	{item.description}
																</p>
															)}
															{enableCart &&
																whatsappNumber &&
																item.price > 0 && (
																	<div class="flex gap-2 mt-3">
																		<button
																			class="cart-add-btn px-6 py-2 bg-black text-white text-xs font-medium uppercase tracking-wider rounded-full transition-all hover:scale-105 active:scale-95 shadow-sm"
																			data-item={JSON.stringify({
																				id: item.id,
																				name: item.name,
																				price: item.price,
																				image: item.image,
																			})}
																		>
																			Agregar al Pedido
																		</button>
																	</div>
																)}
														</div>

														{item.image && item.image.trim() !== "" && (
															<div class="order-1 sm:order-2 mb-4 sm:mb-0 overflow-hidden rounded-xl shadow-lg">
																<Image
																	src={item.image}
																	alt={item.name}
																	width={120}
																	height={120}
																	class="w-full sm:w-32 h-48 sm:h-32 object-cover transition-all duration-700 hover:scale-110"
																	loading="lazy"
																	format="webp"
																/>
															</div>
														)}
													</div>

													{item.gallery && item.gallery.length > 0 && (
														<div class="mt-4">
															<Gallery images={item.gallery} />
														</div>
													)}
												</div>
											))}
										</div>
									</details>
								);
							}

							if (block.type === "gallery") {
								return (
									<div class="py-12">
										<Gallery images={block.data.images || []} />
									</div>
								);
							}

							if (block.type === "carrusel") {
								if (heroCarousel && block === heroCarousel) {
									return null;
								}
								return (
									<div class="py-8">
										<Carousel
											client:load
											items={block.data.items || []}
											className="w-full"
										/>
									</div>
								);
							}
						});
					})()
				}
			</div>

			<footer class="mt-32 pb-16 text-center border-t border-stone-100 pt-16">
				<p
					class="text-[10px] text-stone-300 uppercase tracking-[0.3em] font-bold"
				>
					Potenciado por BYSMAX • {place.name}
				</p>
			</footer>
		</div>
	</div>

	<style define:vars={{ fontFamily: config.fontFamily }}>
		@import url(`https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&${config.fontImport}&display=swap`);

		body {
			font-family: var(--fontFamily);
		}

		h1,
		h2,
		h3,
		.serif {
			font-family: var(--fontFamily);
		}

		/* Fuente más suave y legible para UI, Carrito y botones */
		button,
		input,
		textarea,
		.cart-manager-container,
		.cart-add-btn,
		footer p {
			font-family: "Outfit", sans-serif !important;
		}

		.serif {
			font-family: var(--fontFamily);
		}

		/* Quita la flecha nativa de details en Safari/Chrome */
		summary::-webkit-details-marker {
			display: none;
		}
	</style>
</RestaurantLayout>
