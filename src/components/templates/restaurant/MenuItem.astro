---
import { Image } from "astro:assets";

interface Props {
	item: any;
	template: string;
	showPrices: boolean;
	enableCart: boolean;
	whatsappNumber: string;
}

import MarkdownBlock from "../../MarkdownBlock";

const { item, template, showPrices, enableCart, whatsappNumber } = Astro.props;

const isVibrant = template === "vibrant";
const isUber = template === "uber";
const isDidi = template === "didi";
const isTienda = template === "tienda";
const isMariscos = template === "mariscos";
---

{
	isMariscos && (
		<div
			class="bg-white p-6 rounded-[2.5rem] shadow-xl shadow-blue-900/5 mb-8 relative overflow-hidden group"
			data-item-id={item.id}
		>
			<div class="flex flex-col sm:flex-row gap-8">
				{item.image && (
					<div class="relative shrink-0 w-full sm:w-48 h-48 sm:h-48 overflow-hidden bg-gray-50 flex items-center justify-center border-0 rounded-none">
						<Image
							src={item.image}
							alt={item.name}
							width={600}
							height={600}
							class="w-full h-full object-cover transition-none rounded-[1.5rem]"
							loading="lazy"
							format="webp"
							quality={90}
						/>
					</div>
				)}

				<div class="flex-1 min-w-0 flex flex-col justify-between py-2">
					<div>
						<div class="flex justify-between items-start mb-3">
							<h3 class="text-2xl font-black text-[#002B5B] tracking-tight leading-none uppercase">
								{item.name}
							</h3>
							{showPrices && item.price > 0 && (
								<div class="bg-[#FF6F00] text-white px-4 py-1.5 font-black text-xl shadow-lg shadow-orange-100">
									${item.price}
								</div>
							)}
						</div>

						{item.description && (
							<div class="mb-5 line-clamp-3">
								<MarkdownBlock
									client:load
									content={item.description}
									className="text-slate-500 text-sm font-medium leading-relaxed !m-0"
								/>
							</div>
						)}

						{item.options && item.options.length > 0 && (
							<div class="mb-5 flex flex-wrap gap-2">
								{item.options.map((opt: any) => (
									<div class="bg-blue-50 text-[10px] text-[#004AAD] px-3 py-1 font-black uppercase tracking-wider border border-blue-100">
										{opt.name}: {opt.values.join(", ")}
									</div>
								))}
							</div>
						)}
					</div>

					{enableCart && whatsappNumber && item.price > 0 && (
						<div class="flex justify-end pt-4">
							<button
								class="cart-add-btn group/btn px-8 py-3 bg-[#004AAD] text-white text-xs font-black uppercase tracking-[0.2em] transition-all hover:bg-[#FF6F00] active:scale-95 shadow-xl shadow-blue-100 hover:shadow-orange-100 flex items-center gap-3 rounded-[2rem]"
								data-item={JSON.stringify(item)}
							>
								<span class="w-5 h-5 bg-white/20 flex items-center justify-center group-hover/btn:bg-white/40 font-mono text-lg">
									+
								</span>
								Agregar
							</button>
						</div>
					)}
				</div>
			</div>

			{/* Decorative Elements - Subtle */}
			<div class="absolute top-0 right-0 w-32 h-32 bg-blue-50/50 -mr-16 -mt-16 -z-10" />
			<div class="absolute bottom-0 left-0 w-24 h-24 bg-[#FF6F00]/5 -ml-12 -mb-12 -z-10" />
		</div>
	)
}

{
	isVibrant && (
		<div
			class="bg-white p-6 rounded-[32px] shadow-sm border border-emerald-50 mb-6 relative overflow-hidden group hover:shadow-md transition-shadow"
			data-item-id={item.id}
		>
			<div class="flex justify-between items-center gap-6">
				<div class="flex-1 min-w-0">
					<h3 class="text-xl font-black tracking-tight text-slate-800 mb-2">
						{item.name}
					</h3>
					{item.description && (
						<div class="mb-4 line-clamp-2">
							<MarkdownBlock
								client:load
								content={item.description}
								className="text-slate-500 text-sm font-light leading-relaxed !m-0"
							/>
						</div>
					)}

					{item.options && item.options.length > 0 && (
						<div class="mb-4 flex flex-wrap gap-1.5">
							{item.options.map((opt: any) => (
								<div class="bg-emerald-50 text-[10px] text-emerald-700 px-2 py-1 rounded-lg font-bold uppercase tracking-tight border border-emerald-100">
									{opt.name}: {opt.values.join(", ")}
								</div>
							))}
						</div>
					)}

					{item.image && (
						<div class="w-28 h-28 sm:w-32 sm:h-32 rounded-[2rem] overflow-hidden shadow-sm border-4 border-white">
							<Image
								src={item.image}
								alt={item.name}
								width={600}
								height={600}
								class="w-full h-full object-cover"
								loading="lazy"
								format="webp"
								quality={90}
							/>
						</div>
					)}
				</div>

				<div class="flex flex-col items-end gap-4 shrink-0">
					{showPrices && item.price > 0 && (
						<div class="bg-[#FF4D00] text-white px-5 py-2 rounded-2xl font-black text-2xl shadow-xl shadow-orange-100 italic transform transition-transform group-hover:scale-110">
							${item.price}
						</div>
					)}
					{enableCart && item.price > 0 && (
						<button
							class="cart-add-btn px-6 py-2 bg-slate-900 text-white text-[10px] font-black uppercase tracking-widest rounded-full transition-all hover:scale-105 active:scale-95 shadow-lg shadow-slate-200"
							data-item={JSON.stringify(item)}
						>
							+ Agregar
						</button>
					)}
				</div>
			</div>
		</div>
	)
}

{
	isUber && (
		<div
			class="flex justify-between items-start gap-4 p-5 border-b border-white/10 hover:bg-white/5 transition-colors group"
			data-item-id={item.id}
		>
			<div class="flex-1 min-w-0">
				<h3 class="font-bold text-white text-lg mb-1">{item.name}</h3>
				{item.description && (
					<div class="mb-3 line-clamp-2 flex-grow">
						<MarkdownBlock
							client:load
							content={item.description}
							className="text-gray-400 text-sm !m-0"
						/>
					</div>
				)}
				{item.options && item.options.length > 0 && (
					<div class="mb-3 space-y-1">
						{item.options.map((opt: any) => (
							<div class="text-[10px] text-gray-500 uppercase tracking-wider font-medium">
								<span class="text-white/40">{opt.name}:</span>{" "}
								{opt.values.join(", ")}
							</div>
						))}
					</div>
				)}
				<div class="mt-auto flex items-center gap-4">
					{showPrices && (
						<span class="text-white font-bold text-lg">${item.price}</span>
					)}
					{enableCart && item.price > 0 && (
						<button
							class="cart-add-btn text-[10px] uppercase font-black tracking-widest text-emerald-400 hover:text-emerald-300"
							data-item={JSON.stringify(item)}
						>
							Agregar
						</button>
					)}
				</div>
			</div>
			<div class="relative shrink-0">
				{item.image && (
					<div class="w-32 h-32 sm:w-40 sm:h-40 rounded-xl overflow-hidden shadow-2xl">
						<Image
							src={item.image}
							alt={item.name}
							width={500}
							height={500}
							class="w-full h-full object-cover"
							loading="lazy"
							format="webp"
							quality={85}
						/>
					</div>
				)}
				{enableCart && (
					<button
						class="cart-add-btn absolute -bottom-2 -right-2 w-10 h-10 bg-white text-black rounded-full shadow-2xl flex items-center justify-center hover:scale-110 active:scale-90 transition-transform"
						data-item={JSON.stringify(item)}
					>
						<span class="text-2xl font-light">+</span>
					</button>
				)}
			</div>
		</div>
	)
}

{
	isDidi && (
		<div
			class="bg-white p-4 rounded-2xl shadow-sm border border-orange-50 mb-4 flex gap-4 hover:shadow-md transition-all group"
			data-item-id={item.id}
		>
			<div class="flex-1 min-w-0 flex flex-col justify-between">
				<div>
					<h3 class="font-black text-slate-800 text-lg mb-1">{item.name}</h3>
					{item.description && (
						<div class="line-clamp-2 leading-relaxed">
							<MarkdownBlock
								client:load
								content={item.description}
								className="text-slate-500 text-xs !m-0"
							/>
						</div>
					)}
					{item.options && item.options.length > 0 && (
						<div class="mt-2 flex flex-wrap gap-1">
							{item.options.map((opt: any) => (
								<div class="bg-orange-50 text-[9px] text-[#FF5B00] px-2 py-0.5 rounded-full font-black uppercase border border-orange-100">
									{opt.name}: {opt.values.join(", ")}
								</div>
							))}
						</div>
					)}
				</div>
				<div class="flex items-center gap-2 mt-4">
					{showPrices && (
						<>
							<span class="text-[#FF5B00] font-black text-xl italic">
								${item.price}
							</span>
							<span class="text-xs text-slate-300 line-through font-bold">
								${(item.price * 1.2).toFixed(0)}
							</span>
						</>
					)}
				</div>
			</div>

			<div class="relative shrink-0 self-center">
				{item.image ? (
					<div class="w-32 h-32 sm:w-36 sm:h-36 rounded-3xl overflow-hidden shadow-inner border border-slate-50">
						<Image
							src={item.image}
							alt={item.name}
							width={400}
							height={400}
							class="w-full h-full object-cover"
							loading="lazy"
							format="webp"
							quality={80}
						/>
					</div>
				) : (
					<div class="w-28 h-28 rounded-3xl bg-slate-50 flex items-center justify-center text-slate-200">
						<span class="text-4xl">+</span>
					</div>
				)}
				{enableCart && (
					<button
						class="cart-add-btn absolute -bottom-1 -right-1 w-9 h-9 bg-[#FF5B00] text-white rounded-2xl shadow-lg flex items-center justify-center hover:rotate-90 transition-transform"
						data-item={JSON.stringify(item)}
					>
						<span class="text-xl font-black">+</span>
					</button>
				)}
			</div>
		</div>
	)
}

{
	isTienda && (
		<div
			class="bg-white/5 backdrop-blur-sm p-4 rounded-3xl border border-white/10 hover:border-white/20 transition-all group hover:bg-white/10"
			data-item-id={item.id}
		>
			<div class="flex gap-4">
				{/* Image */}
				<div class="relative shrink-0">
					{item.image ? (
						<div class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden shadow-xl ring-2 ring-white/10">
							<Image
								src={item.image}
								alt={item.name}
								width={400}
								height={400}
								class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
								loading="lazy"
								format="webp"
								quality={80}
							/>
						</div>
					) : (
						<div class="w-24 h-24 rounded-2xl bg-white/5 flex items-center justify-center text-white/30">
							<span class="text-3xl">🍽️</span>
						</div>
					)}
					{enableCart && (
						<button
							class="cart-add-btn absolute -bottom-2 -right-2 w-8 h-8 bg-red-500 text-white rounded-xl shadow-lg flex items-center justify-center hover:scale-110 active:scale-95 transition-transform"
							data-item={JSON.stringify(item)}
						>
							<span class="text-lg font-black">+</span>
						</button>
					)}
				</div>

				{/* Content */}
				<div class="flex-1 min-w-0 flex flex-col justify-between">
					<div>
						<h3 class="font-bold text-white text-base mb-1 line-clamp-1">
							{item.name}
						</h3>
						{item.description && (
							<div class="line-clamp-2 leading-relaxed">
								<MarkdownBlock
									client:load
									content={item.description}
									className="text-gray-400 text-xs !m-0"
								/>
							</div>
						)}
						{item.options && item.options.length > 0 && (
							<div class="mt-2 flex flex-wrap gap-1">
								{item.options.map((opt: any) => (
									<div class="bg-white/10 text-[9px] text-white/70 px-2 py-0.5 rounded-lg font-bold uppercase border border-white/5">
										{opt.name}: {opt.values.join(", ")}
									</div>
								))}
							</div>
						)}
					</div>
					<div class="flex items-center gap-3 mt-2">
						{showPrices && item.price > 0 && (
							<span class="text-red-400 font-black text-lg">${item.price}</span>
						)}
						{item.features && item.features.length > 0 && (
							<div class="flex gap-1">
								{item.features.slice(0, 2).map((feature: string) => (
									<span class="text-[8px] bg-white/10 text-white/60 px-2 py-0.5 rounded-full uppercase tracking-wider font-bold">
										{feature}
									</span>
								))}
							</div>
						)}
					</div>
				</div>
			</div>
		</div>
	)
}

{
	!isMariscos && !isVibrant && !isUber && !isDidi && !isTienda && (
		<div
			class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-x-8 items-start group/item mb-12"
			data-item-id={item.id}
		>
			<div class="order-2 sm:order-1">
				<div class="flex justify-between items-baseline mb-1">
					<h3 class="text-lg font-bold tracking-tight">{item.name}</h3>
					{showPrices && (
						<span class="text-sm font-bold text-stone-500 ml-4">
							${item.price}
						</span>
					)}
				</div>
				{item.description && (
					<div class="mb-4">
						<MarkdownBlock
							client:load
							content={item.description}
							className="text-stone-400 text-sm font-light leading-relaxed !m-0"
						/>
					</div>
				)}
				{item.options && item.options.length > 0 && (
					<div class="mb-4 space-y-1">
						{item.options.map((opt: any) => (
							<div class="text-[11px] text-stone-500 italic">
								<span class="font-bold not-italic text-stone-700 capitalize">
									{opt.name}:
								</span>{" "}
								{opt.values.join(", ")}
							</div>
						))}
					</div>
				)}
				{enableCart && item.price > 0 && (
					<div class="flex gap-2 mt-3">
						<button
							class="cart-add-btn px-6 py-2 bg-black text-white text-xs font-medium uppercase tracking-wider rounded-full transition-all hover:scale-105 active:scale-95 shadow-sm"
							data-item={JSON.stringify(item)}
						>
							Agregar al Pedido
						</button>
					</div>
				)}
			</div>

			{item.image && item.image.trim() !== "" && (
				<div class="order-1 sm:order-2 mb-4 sm:mb-0 overflow-hidden rounded-xl ">
					<Image
						src={item.image}
						alt={item.name}
						width={500}
						height={500}
						class="w-full sm:w-40 h-56 sm:h-40 object-cover transition-all duration-700 hover:scale-110"
						loading="lazy"
						format="webp"
						quality={85}
					/>
				</div>
			)}
		</div>
	)
}
