---
import { Image } from "astro:assets";

interface Props {
	item: any;
	template: string;
	placeSlug?: string;
	categorySlug?: string;
	showPrices: boolean;
	enableCart: boolean;
	whatsappNumber: string;
	placeName?: string;
	/**
	 * "tile" apila foto cuadrada, nombre y precio. "row" es la lista compacta
	 * de nombre y precio para secciones sin fotos, tipo "Complementos". Lo
	 * decide la sección, no el producto: mezclar las dos formas en la misma
	 * rejilla se ve roto.
	 */
	layout?: "tile" | "row";
	/** Forma de las esquinas. Va aparte de la plantilla: el tema decide el
	 *  color, no la forma, para no multiplicar plantillas por combinación. */
	corners?: "redondo" | "cuadrado";
	/** Efecto heredado del lugar. `item.effect` lo pisa: es el nivel más
	 *  específico, y sirve para destacar un platillo sin tocar los demás. */
	effect?: string;
	imageFit?: "contain" | "cover";
}

import MarkdownBlock from "../../MarkdownBlock";

const {
	item,
	template,
	placeSlug = "",
	categorySlug = "",
	showPrices,
	enableCart,
	whatsappNumber,
	placeName = "",
	layout = "row",
	corners = "redondo",
	effect = "ninguno",
	imageFit = "contain",
} = Astro.props;

const isVibrant = false;
const isUber = false;
const isDidi = false;
const isTienda = template === "tienda";
const isMariscos = false;
const isCafesoso = false;
const hasImage = typeof item?.image === "string" && item.image.trim() !== "";
const showCartButton = enableCart && item.price > 0;
const isTile = layout === "tile" && hasImage;
const cornerClass = corners === "cuadrado" ? "rounded-none" : "rounded-xl";

// Los efectos se declaran con las variables del tema, nunca con colores fijos:
// un vidrio con `bg-white/10` quemado se ve bien en oscuro y desaparece en
// claro. Así el mismo efecto funciona en las tres plantillas.
const EFFECTS: Record<string, string> = {
	ninguno: "",
	vidrio: "bg-[var(--m-glass)] backdrop-blur-md ring-1 ring-[var(--m-border)]",
	sombra: "bg-[var(--m-surface)] shadow-lg shadow-black/10",
	borde: "ring-1 ring-[var(--m-border)]",
};
// El producto pisa al lugar. Si trae un efecto que no existe, se ignora en vez
// de romper: un nombre mal escrito en el editor no debe vaciar la vitrina.
const effectKey = item?.effect || effect;

// Misma cascada que el efecto: el producto puede pisar al lugar. Sirve para el
// caso real de un menú con fotografía a sangre que trae dos o tres productos
// recortados sobre blanco, o al revés.
const fitKey: "contain" | "cover" =
	item?.image_fit === "cover" || item?.image_fit === "contain"
		? item.image_fit
		: imageFit;
const fitClass = fitKey === "cover" ? "object-cover" : "object-contain";
const effectClass = EFFECTS[effectKey] ?? "";
const toItemSlug = (value: string) =>
	(value || "")
		.toString()
		.normalize("NFD")
		.replace(/[\u0300-\u036f]/g, "")
		.toLowerCase()
		.trim()
		.replace(/\s+/g, "-")
		.replace(/[^a-z0-9-]/g, "")
		.replace(/-+/g, "-")
		.replace(/^-|-$/g, "");
const tiendaItemUrl =
	placeSlug && categorySlug
		? `/tienda/${encodeURIComponent(placeSlug)}/${encodeURIComponent(categorySlug)}/${encodeURIComponent(toItemSlug(item.slug || item.name || "") || "producto")}`
		: "#";
---

{
	isMariscos && (
		<div
			class="bg-white p-6 rounded-[2.5rem] shadow-xl shadow-blue-900/5 mb-8 relative overflow-hidden group"
			data-item-id={item.id}
		>
			<div class="flex flex-col sm:flex-row gap-8">
				{item.image && (
					<div class="relative shrink-0 w-full sm:w-48 h-48 sm:h-48 max-w-[250px] max-h-[250px] overflow-hidden bg-gray-50 flex items-center justify-center border-0 rounded-none">
						<Image
							src={item.image}
							alt={placeName ? `${item.name} - ${placeName}` : item.name}
							width={600}
							height={600}
							class="w-full h-full object-cover transition-none rounded-[1.5rem]"
							loading="lazy"
							format="webp"
							quality={90}
						/>
					</div>
				)}

				<div class="flex-1 min-w-0 flex flex-col justify-between py-2">
					<div>
						<div class="flex justify-between items-start mb-3">
							<h3 class="text-2xl font-black text-[#002B5B] tracking-tight leading-none uppercase">
								{item.name}
							</h3>
							{showPrices && item.price > 0 && (
								<div class="bg-[#FF6F00] text-white px-4 py-1.5 font-black text-xl shadow-lg shadow-orange-100">
									${item.price}
								</div>
							)}
						</div>

						{item.description && (
							<div class="mb-5 line-clamp-3">
								<MarkdownBlock
									client:load
									content={item.description}
									className="text-slate-500 text-sm font-medium leading-relaxed !m-0"
								/>
							</div>
						)}

						{item.options && item.options.length > 0 && (
							<div class="mb-5 flex flex-wrap gap-2">
								{item.options.map((opt: any) => (
									<div class="bg-blue-50 text-[10px] text-[#004AAD] px-3 py-1 font-black uppercase tracking-wider border border-blue-100">
										{opt.name}: {opt.values.join(", ")}
									</div>
								))}
							</div>
						)}
					</div>

					{enableCart && whatsappNumber && item.price > 0 && (
						<div class="flex justify-end pt-4">
							<button
								class="cart-add-btn group/btn px-8 py-3 bg-[#004AAD] text-white text-xs font-black uppercase tracking-[0.2em] transition-all hover:bg-[#FF6F00] active:scale-95 shadow-xl shadow-blue-100 hover:shadow-orange-100 flex items-center gap-3 rounded-[2rem]"
								aria-label={`Agregar ${item.name} al pedido`}
								data-item={JSON.stringify(item)}
							>
								<span class="w-5 h-5 bg-white/20 flex items-center justify-center group-hover/btn:bg-white/40 font-mono text-lg">
									+
								</span>
								Agregar
							</button>
						</div>
					)}
				</div>
			</div>

			{/* Decorative Elements - Subtle */}
			<div class="absolute top-0 right-0 w-32 h-32 bg-blue-50/50 -mr-16 -mt-16 -z-10" />
			<div class="absolute bottom-0 left-0 w-24 h-24 bg-[#FF6F00]/5 -ml-12 -mb-12 -z-10" />
		</div>
	)
}

{
	isVibrant && (
		<div
			class="bg-white p-6 rounded-[32px] shadow-sm border border-emerald-50 mb-6 relative overflow-hidden group hover:shadow-md transition-shadow"
			data-item-id={item.id}
		>
			<div class="flex justify-between items-center gap-6">
				<div class="flex-1 min-w-0">
					<h3 class="text-xl font-black tracking-tight text-slate-800 mb-2">
						{item.name}
					</h3>
					{item.description && (
						<div class="mb-4 line-clamp-2">
							<MarkdownBlock
								client:load
								content={item.description}
								className="text-slate-500 text-sm font-light leading-relaxed !m-0"
							/>
						</div>
					)}

					{item.options && item.options.length > 0 && (
						<div class="mb-4 flex flex-wrap gap-1.5">
							{item.options.map((opt: any) => (
								<div class="bg-emerald-50 text-[10px] text-emerald-700 px-2 py-1 rounded-lg font-bold uppercase tracking-tight border border-emerald-100">
									{opt.name}: {opt.values.join(", ")}
								</div>
							))}
						</div>
					)}

					{item.image && (
						<div class="w-28 h-28 sm:w-32 sm:h-32 max-w-[250px] max-h-[250px] rounded-[2rem] overflow-hidden shadow-sm border-4 border-white">
							<Image
								src={item.image}
								alt={placeName ? `${item.name} - ${placeName}` : item.name}
								width={600}
								height={600}
								class="w-full h-full object-cover"
								loading="lazy"
								format="webp"
								quality={90}
							/>
						</div>
					)}
				</div>

				<div class="flex flex-col items-end gap-4 shrink-0">
					{showPrices && item.price > 0 && (
						<div class="bg-[#FF4D00] text-white px-5 py-2 rounded-2xl font-black text-2xl shadow-xl shadow-orange-100 italic transform transition-transform group-hover:scale-110">
							${item.price}
						</div>
					)}
					{enableCart && item.price > 0 && (
						<button
							class="cart-add-btn px-6 py-2 bg-slate-900 text-white text-[10px] font-black uppercase tracking-widest rounded-full transition-all hover:scale-105 active:scale-95 shadow-lg shadow-slate-200"
							aria-label={`Agregar ${item.name} al pedido`}
							data-item={JSON.stringify(item)}
						>
							+ Agregar
						</button>
					)}
				</div>
			</div>
		</div>
	)
}

{
	isUber && (
		<div
			class="flex justify-between items-start gap-4 p-5 border-b border-white/10 hover:bg-white/5 transition-colors group"
			data-item-id={item.id}
		>
			<div class="flex-1 min-w-0">
				<h3 class="font-bold text-white text-lg mb-1">{item.name}</h3>
				{item.description && (
					<div class="mb-3 line-clamp-2 flex-grow">
						<MarkdownBlock
							client:load
							content={item.description}
							className="text-gray-400 text-sm !m-0"
						/>
					</div>
				)}
				{item.options && item.options.length > 0 && (
					<div class="mb-3 space-y-1">
						{item.options.map((opt: any) => (
							<div class="text-[10px] text-gray-500 uppercase tracking-wider font-medium">
								<span class="text-white/40">{opt.name}:</span>{" "}
								{opt.values.join(", ")}
							</div>
						))}
					</div>
				)}
				<div class="mt-auto flex items-center gap-4">
					{showPrices && (
						<span class="text-white font-bold text-lg">${item.price}</span>
					)}
					{enableCart && item.price > 0 && (
						<button
							class="cart-add-btn text-[10px] uppercase font-black tracking-widest text-emerald-400 hover:text-emerald-300"
							aria-label={`Agregar ${item.name} al pedido`}
							data-item={JSON.stringify(item)}
						>
							Agregar
						</button>
					)}
				</div>
			</div>
			<div class="relative shrink-0">
				{item.image && (
					<div class="w-32 h-32 sm:w-40 sm:h-40 rounded-xl overflow-hidden shadow-2xl">
						<Image
							src={item.image}
							alt={placeName ? `${item.name} - ${placeName}` : item.name}
							width={500}
							height={500}
							class="w-full h-full object-cover"
							loading="lazy"
							format="webp"
							quality={85}
						/>
					</div>
				)}
				{enableCart && (
					<button
						class="cart-add-btn absolute -bottom-2 -right-2 w-10 h-10 bg-white text-black rounded-full shadow-2xl flex items-center justify-center hover:scale-110 active:scale-90 transition-transform"
						aria-label={`Agregar ${item.name} al pedido`}
						data-item={JSON.stringify(item)}
					>
						<span class="text-2xl font-light">+</span>
					</button>
				)}
			</div>
		</div>
	)
}

{
	isDidi && (
		<div
			class="bg-white p-4 rounded-2xl shadow-sm border border-orange-50 mb-4 flex gap-4 hover:shadow-md transition-all group"
			data-item-id={item.id}
		>
			<div class="flex-1 min-w-0 flex flex-col justify-between">
				<div>
					<h3 class="font-black text-slate-800 text-lg mb-1">{item.name}</h3>
					{item.description && (
						<div class="line-clamp-2 leading-relaxed">
							<MarkdownBlock
								client:load
								content={item.description}
								className="text-slate-500 text-xs !m-0"
							/>
						</div>
					)}
					{item.options && item.options.length > 0 && (
						<div class="mt-2 flex flex-wrap gap-1">
							{item.options.map((opt: any) => (
								<div class="bg-orange-50 text-[9px] text-[#FF5B00] px-2 py-0.5 rounded-full font-black uppercase border border-orange-100">
									{opt.name}: {opt.values.join(", ")}
								</div>
							))}
						</div>
					)}
				</div>
				<div class="flex items-center gap-2 mt-4">
					{showPrices && (
						<>
							<span class="text-[#FF5B00] font-black text-xl italic">
								${item.price}
							</span>
							<span class="text-xs text-slate-300 line-through font-bold">
								${(item.price * 1.2).toFixed(0)}
							</span>
						</>
					)}
				</div>
			</div>

			<div class="relative shrink-0 self-center">
				{item.image ? (
					<div class="w-32 h-32 sm:w-36 sm:h-36 max-w-[250px] max-h-[250px] rounded-3xl overflow-hidden shadow-inner border border-slate-50">
						<Image
							src={item.image}
							alt={placeName ? `${item.name} - ${placeName}` : item.name}
							width={400}
							height={400}
							class="w-full h-full object-cover"
							loading="lazy"
							format="webp"
							quality={80}
						/>
					</div>
				) : (
					<div class="w-28 h-28 rounded-3xl bg-slate-50 flex items-center justify-center text-slate-200">
						<span class="text-4xl">+</span>
					</div>
				)}
				{enableCart && (
					<button
						class="cart-add-btn absolute -bottom-1 -right-1 w-9 h-9 bg-[#FF5B00] text-white rounded-2xl shadow-lg flex items-center justify-center hover:rotate-90 transition-transform"
						aria-label={`Agregar ${item.name} al pedido`}
						data-item={JSON.stringify(item)}
					>
						<span class="text-xl font-black">+</span>
					</button>
				)}
			</div>
		</div>
	)
}

{
	isTienda && (
		<div
			class="relative bg-[#242424] border border-white/10 rounded-2xl overflow-hidden hover:border-white/20 transition-all group h-full flex flex-col"
			data-item-id={item.id}
		>
			{placeSlug && (
				<a
					href={tiendaItemUrl}
					class="absolute inset-0 z-10"
					aria-label={`Ver ${item.name}`}
				/>
			)}
			<div class="relative aspect-square bg-black/20 overflow-hidden">
				{item.image ? (
					<Image
						src={item.image}
						alt={placeName ? `${item.name} - ${placeName}` : item.name}
						width={640}
						height={640}
						class="w-full h-full max-w-[250px] max-h-[250px] object-cover group-hover:scale-105 transition-transform duration-500"
						loading="lazy"
						format="webp"
						quality={85}
					/>
				) : (
					<div class="w-full h-full bg-white/5" />
				)}
			</div>

			<div class="p-3 sm:p-4 flex-1 flex flex-col relative z-20">
				<h3 class="font-black text-white text-sm sm:text-base line-clamp-2 min-h-[2.5rem]">
					{item.name}
				</h3>

				{item.description && (
					<div class="mt-1 line-clamp-2 min-h-[2rem]">
						<MarkdownBlock
							client:load
							content={item.description}
							className="text-gray-400 text-[11px] leading-relaxed !m-0"
						/>
					</div>
				)}

				<div class="mt-3 pt-3 border-t border-white/10 flex items-center justify-between gap-2">
					{showPrices && item.price > 0 ? (
						<span class="text-red-400 font-black text-base sm:text-lg">
							${item.price}
						</span>
					) : (
						<span class="text-white/40 text-xs font-bold uppercase">
							Sin precio
						</span>
					)}

					{enableCart && (
						<button
							onclick="event.stopPropagation()"
							class="cart-add-btn px-3 py-1.5 bg-red-500 text-white rounded-lg text-[10px] font-black uppercase tracking-widest hover:bg-red-600 active:scale-95 transition-all"
							aria-label={`Agregar ${item.name} al pedido`}
							data-item={JSON.stringify(item)}
						>
							Agregar
						</button>
					)}
				</div>
			</div>
		</div>
	)
}

{
	isCafesoso && (
		<div
			class="bg-[#FFF8F1] border border-[#E6D5C4] p-4 sm:p-5 rounded-2xl mb-5"
			data-item-id={item.id}
		>
			<div class="flex gap-4 items-start">
				<div class="flex-1 min-w-0">
					<div class="flex items-start justify-between gap-3 mb-2">
						<h3 class="text-lg font-black tracking-tight text-[#3E2723]">
							{item.name}
						</h3>
						{showPrices && item.price > 0 && (
							<span class="text-base font-black text-[#6D4C41]">
								${item.price}
							</span>
						)}
					</div>
					{item.description && (
						<div class="mb-3">
							<MarkdownBlock
								client:load
								content={item.description}
								className="text-[#6D4C41] text-sm leading-relaxed !m-0"
							/>
						</div>
					)}
					{item.options && item.options.length > 0 && (
						<div class="mb-3 flex flex-wrap gap-1.5">
							{item.options.map((opt: any) => (
								<div class="bg-[#F3E5D7] text-[10px] text-[#5D4037] px-2 py-1 rounded-lg font-bold uppercase tracking-tight border border-[#E6D5C4]">
									{opt.name}: {opt.values.join(", ")}
								</div>
							))}
						</div>
					)}
					{enableCart && item.price > 0 && (
						<button
							class="cart-add-btn px-5 py-2 bg-[#6D4C41] text-white text-[11px] font-black uppercase tracking-wider rounded-full hover:bg-[#5D4037] transition-colors"
							aria-label={`Agregar ${item.name} al pedido`}
							data-item={JSON.stringify(item)}
						>
							Agregar
						</button>
					)}
				</div>

				{item.image && item.image.trim() !== "" && (
					<div class="w-24 h-24 sm:w-28 sm:h-28 max-w-[250px] max-h-[250px] rounded-xl overflow-hidden border border-[#E6D5C4] shrink-0">
						<Image
							src={item.image}
							alt={placeName ? `${item.name} - ${placeName}` : item.name}
							width={500}
							height={500}
							class="w-full h-full object-cover"
							loading="lazy"
							format="webp"
							quality={85}
						/>
					</div>
				)}
			</div>
		</div>
	)
}

{
	!isMariscos &&
		!isVibrant &&
		!isUber &&
		!isDidi &&
		!isTienda &&
		!isCafesoso && (
			<div
				class:list={[
					// Mosaico: foto cuadrada arriba, nombre y precio debajo.
					isTile && "flex flex-col gap-2",
					// Sin efecto la pieza va suelta sobre el fondo. Con efecto necesita
					// caja: relleno para que el vidrio o la sombra se vean, y el mismo
					// radio que la foto para que no queden dos formas distintas.
					isTile && !effectClass && "pb-4",
					isTile && effectClass && ["p-2", cornerClass, effectClass],
					// Renglón: sin foto son dos líneas de texto, y darles el alto de un
					// mosaico deja huecos enormes — una sección como "Complementos"
					// termina flotando en la pantalla.
					!isTile && "grid gap-3 md:gap-4 py-2 items-baseline",
					!isTile && showCartButton && "grid-cols-[1fr_auto]",
					!isTile && !showCartButton && "grid-cols-1",
				]}
				data-item-id={item.id}
			>
				{isTile && (
					<div
						class:list={[
							// El fondo importa ahora que la imagen no recorta: es lo que se ve
							// en las bandas que deja object-contain, y como casi todas las fotos
							// de producto vienen sobre blanco, --m-surface las hace ver como si
							// flotaran en la tarjeta.
							"order-1 relative w-full aspect-square overflow-hidden bg-[var(--m-image-bg)]",
							cornerClass,
						]}
					>
						<Image
							src={item.image}
							alt={placeName ? `${item.name} - ${placeName}` : item.name}
							width={500}
							height={500}
							class:list={[fitClass, "w-full h-full transition-transform duration-500 hover:scale-105"]}
							loading="lazy"
							format="webp"
							quality={85}
						/>
						{item.price > 0 && showPrices && (
							// El precio va sobre la foto, no debajo del nombre: libera un
							// renglón por tarjeta y deja de disputarle al nombre la misma
							// columna de texto. Cae en la banda que deja object-contain, que
							// en estas fotos de producto casi siempre está vacía.
							<span
								class:list={[
									"absolute top-2 right-2 px-2 py-1 rounded-full text-sm font-semibold tracking-tight",
									"bg-[var(--m-accent)] text-[var(--m-on-accent)]",
								]}
							>
								${item.price}
							</span>
						)}
					</div>
				)}

				<div class="order-2 min-w-0">
					<h3
						class:list={[
							// El nombre manda y el precio lo acompaña. Al quitarle la
							// descripción al mosaico, nombre y precio quedaron pegados con el
							// mismo tamaño y color, y el precio además en font-bold: se leían
							// como dos renglones sueltos, no como producto + precio.
							"text-[15px] md:text-base font-medium tracking-tight line-clamp-2 leading-snug",
							"text-[var(--m-text)] font-bold",
						]}
					>
						{item.name}
					</h3>
					{item.options && item.options.length > 0 ? (
						<div class="mb-4 space-y-1">
							{item.options.map((opt: any) => (
								<div
									class:list={["text-[11px] italic", "text-[var(--m-muted)]"]}
								>
									<span
										class:list={[
											"font-bold not-italic capitalize",
											"text-[var(--m-text)]",
										]}
									>
										{opt.name}:
									</span>{" "}
									{opt.values.join(", ")}
								</div>
							))}
						</div>
					) : (
						!isTile &&
						item.description && (
							// El mosaico va sin descripción a propósito. Fuera de él se
							// recorta a dos líneas: las descripciones scrapeadas llegan a
							// tener tres renglones y empujan el precio fuera de vista. El
							// texto completo sigue en el DOM para SEO.
							<div class="mb-2 overflow-hidden max-h-[2.85rem]">
								<MarkdownBlock
									client:load
									content={item.description}
									className={
										"text-[var(--m-muted)] text-sm font-light leading-relaxed !m-0"
									}
								/>
							</div>
						)
					)}
					{!isTile && item.price > 0 && showPrices && (
						<span
							class:list={[
								// Solo en filas: en el mosaico el precio vive sobre la foto. Atenuado y un punto más chico: es el dato secundario de la
								// pieza. Así la jerarquía es foto → nombre → precio.
								"block mt-1 text-[13px] md:text-sm font-semibold tracking-tight",
								"text-[var(--m-muted)]",
							]}
						>
							${item.price}
						</span>
					)}
				</div>

				{showCartButton && (
					<div class="order-3 self-center justify-self-end">
						<button
							class="cart-add-btn w-9 h-9 md:w-10 md:h-10 bg-[#3A342E] text-[#f6f3f3] border border-[#2F2A25] transition-all hover:bg-[#2F2A25] active:scale-95 flex items-center justify-center rounded-full"
							aria-label={`Agregar ${item.name} al pedido`}
							data-item={JSON.stringify(item)}
							title="Agregar al pedido"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M12 5v14M5 12h14" />
							</svg>
						</button>
					</div>
				)}
			</div>
		)
}
