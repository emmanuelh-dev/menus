    amenities: ["WiFi gratis", "Estacionamiento", "Aire acondicionado", "Cochera cerrada"]
  }
];

const allMoteles = moteles.length > 0 ? moteles : featuredMoteles;

// Generate structured data for motel business listings
const generateMotelBusinessSchema = (motel: any) => {
  return {
    "@type": "LodgingBusiness",
    "name": motel.name,
    "address": {
      "@type": "PostalAddress", 
      "streetAddress": motel.address,
      "addressLocality": "Monterrey",
      "addressRegion": "Nuevo León",
      "addressCountry": "MX"
    },
    "aggregateRating": motel.rating ? {
      "@type": "AggregateRating",
      "ratingValue": motel.rating,
      "reviewCount": motel.reviewCount || 10,
      "bestRating": 5,
      "worstRating": 1
    } : undefined,
    "priceRange": motel.priceRange || "$$",
    "openingHours": ["Mo-Su 00:00-23:59"],
    "telephone": motel.phone,
    "acceptsReservations": false,
    "paymentAccepted": ["Cash", "Credit Card"],
    "checkinTime": "00:00",
    "checkoutTime": "23:59",
    "amenityFeature": motel.amenities?.map((amenity: string) => ({
      "@type": "LocationFeatureSpecification",
      "name": amenity
    })) || [],
    "starRating": {
      "@type": "Rating",
      "ratingValue": motel.rating || 4.0
    },
    "petsAllowed": false
  };
};

const schemaData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Mejores Moteles en Monterrey",
  "description": "Lista completa de los mejores moteles en Monterrey con información de precios, ubicaciones y amenidades",
  "numberOfItems": allMoteles.length,
  "itemListElement": allMoteles.map((motel, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@context": "https://schema.org",
      ...generateMotelBusinessSchema(motel)
    }
  }))
};

// Main organization schema for motel directory
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": "Menús Monterrey - Guía de Moteles",
  "url": "https://menusmty.com/moteles",
  "description": "Guía completa de moteles en Monterrey con recomendaciones, precios y ubicaciones verificadas",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Monterrey", 
    "addressRegion": "Nuevo León",
    "addressCountry": "MX"
  },
  "areaServed": {
    "@type": "GeoCircle",
    "geoMidpoint": {
      "@type": "GeoCoordinates",
      "latitude": 25.6866,
      "longitude": -100.3161
    },
    "geoRadius": "50000"
  }
};
---

<!-- Motel Business Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
