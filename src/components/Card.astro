---
interface Props {
  href?: string;
  title: string;
  description?: string;
  bgColor?: string;
  textColor?: string;
  borderColor?: string;
  hoverBgColor?: string;
  hoverTextColor?: string;
  className?: string;
  icon?: string;
  badge?: string;
  badgeColor?: string;
}

const {
  href,
  title,
  description,
  bgColor = "bg-[#1E1E1E]",
  textColor = "text-gray-300",
  borderColor = "border-pink-500/30",
  hoverBgColor = "hover:bg-pink-500",
  hoverTextColor = "hover:text-white",
  className = "",
  icon,
  badge,
  badgeColor = "bg-pink-500"
} = Astro.props;

const Tag = href ? "a" : "div";
const baseClasses = `px-4 py-2 ${bgColor} ${textColor} rounded-full border ${borderColor} ${hoverBgColor} ${hoverTextColor} transition-colors ${className}`;
---

<Tag href={href} data-astro-prefetch="hover" class={baseClasses}>
  {icon && <span set:html={icon} class="mr-2" />}
  {badge && (
    <span class={`inline-block ${badgeColor} text-white text-xs px-2 py-0.5 rounded-full mr-2`}>
      {badge}
    </span>
  )}
  <span>{title}</span>
  {description && (
    <span class="block text-sm mt-1 opacity-80">{description}</span>
  )}
</Tag>
