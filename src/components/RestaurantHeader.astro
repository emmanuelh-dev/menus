---
import { BookOpen, MapPin, MessageCircle, Phone, ChevronDown, Clock, CreditCard } from "lucide-react";
import Gallery from "./Gallery.astro";
interface Props { place: any; gallery?: any[]; }
const { place, gallery = [] } = Astro.props;
const sd = place.content?.semantic_data || {};
const address = sd.address || place.address || '';
const locality = [sd.municipality, sd.country].filter(Boolean).join(', ');
const hasLocation = Boolean(address || sd.municipality);
const description = sd.description || place.description || '';
const phone = String(sd.phone || place.phone || '').replace(/[^+\d]/g, '');
const whatsapp = String(sd.whatsapp || sd.whatsappNumber || '').replace(/\D/g, '');
const delivery = Boolean(sd.enable_delivery || sd.enableDelivery);
const orders = Boolean(sd.enable_cart || sd.enableCart || delivery);
const maps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${place.name} ${address || locality}`)}`;
const payments = Array.isArray(sd.payment_options) ? sd.payment_options.filter(Boolean) : [];
---
<header class="restaurant-header max-w-7xl mx-auto px-4 sm:px-6 py-5 sm:py-7" aria-label="Información del restaurante">
  <div class="flex items-center gap-4 sm:gap-5">
    {place.image?.trim() && <img src={place.image} alt={place.name} width="96" height="96" class="h-20 w-20 sm:h-24 sm:w-24 shrink-0 rounded-2xl object-contain bg-white p-1" fetchpriority="high" />}
    <div class="min-w-0">
      {sd.cuisine_type && <p class="text-sm mb-1 opacity-80">{sd.cuisine_type}</p>}
      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight leading-tight break-words">{place.name}</h1>
      {hasLocation ? <a href={maps} target="_blank" rel="noopener noreferrer" class="block mt-2 text-sm underline underline-offset-4 break-words">{address || locality}</a> : locality && <p class="mt-2 text-sm">{locality}</p>}
    </div>
  </div>
  {description && <p class="mt-4 text-sm sm:text-base leading-relaxed max-w-3xl line-clamp-2">{description}</p>}
  <div class="flex flex-wrap gap-2 mt-4 text-sm">
    <a href="#restaurant-menu" class="header-action primary"><BookOpen size={16} aria-hidden="true" />Ver carta</a>
    {hasLocation && <a href={maps} target="_blank" rel="noopener noreferrer" class="header-action"><MapPin size={16} aria-hidden="true" />Ver en Maps</a>}
    {whatsapp && <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener noreferrer" class="header-action"><MessageCircle size={16} aria-hidden="true" />WhatsApp</a>}
    {phone && <a href={`tel:${phone}`} class="header-action"><Phone size={16} aria-hidden="true" />Llamar</a>}
  </div>
  <p class="mt-3 text-xs opacity-80">{orders ? (delivery ? 'Pedidos en línea · Delivery disponible' : 'Pedidos en línea') : 'Carta informativa'}</p>
  {(sd.hours || payments.length > 0 || description || gallery.length > 0) && <details class="mt-3 text-sm">
    <summary class="cursor-pointer min-h-11 flex items-center underline underline-offset-4">{sd.hours ? "Horarios y más información" : "Más información"} <ChevronDown size={16} aria-hidden="true" className="ml-2 shrink-0" /></summary>
    <div class="space-y-3 pt-2 pb-1 max-w-3xl">
      {sd.hours && <p class="whitespace-pre-line"><Clock size={16} aria-hidden="true" className="inline-block mr-1 align-text-bottom" /><strong>Horario:</strong> {sd.hours}</p>}
      {description && <p class="leading-relaxed">{description}</p>}
      {gallery.length > 0 && <Gallery images={gallery} />}
      {payments.length > 0 && <p><CreditCard size={16} aria-hidden="true" className="inline-block mr-1 align-text-bottom" /><strong>Formas de pago:</strong> {payments.join(' · ')}</p>}
    </div>
  </details>}
</header>
<style>
  .restaurant-header { color: var(--m-text); }
  .header-action { display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:44px; padding:10px 16px; border:1px solid var(--m-border); border-radius:999px; background:var(--m-surface); font-weight:600; }
  .header-action.primary { background:var(--m-text); color:var(--m-bg); border-color:var(--m-text); }
  .header-action:hover { opacity:.85; }
  .header-action:focus-visible, summary:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
</style>
