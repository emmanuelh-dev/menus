---
import { Image } from "astro:assets";
import { Star, MapPin, Clock, Phone, ArrowRight, Wifi, Car, Snowflake, Waves, Utensils, Martini } from "lucide-react";

interface Props {
  motel: any;
  stateSlug?: string;
}

const { motel, stateSlug } = Astro.props;

const href = motel.short_name
  ? `/moteles/estados/${stateSlug || motel.state_slug}/${motel.short_name}`
  : null;

// El listado público sólo trae el nivel de precio ("$", "$$", "$$$"...),
// no montos por habitación (esos viven en content.blocks de la ficha).
// Si algún día llega un rango numérico ("$300-450") lo mostramos como
// "Desde $N"; si no, mostramos el nivel tal cual, nunca inventamos cifras.
const priceMatch = typeof motel.priceRange === "string" ? motel.priceRange.match(/\d+/) : null;
const fromPrice = priceMatch ? `Desde $${priceMatch[0]}` : motel.priceRange || null;

const amenityIcon = (amenity: string) => {
  const a = amenity.toLowerCase();
  if (a.includes("wifi")) return Wifi;
  if (a.includes("estacionamiento") || a.includes("cochera")) return Car;
  if (a.includes("aire")) return Snowflake;
  if (a.includes("jacuzzi") || a.includes("alberca")) return Waves;
  if (a.includes("restaurante")) return Utensils;
  if (a.includes("bar")) return Martini;
  return null;
};
---

<div
  class="motel-card group relative flex flex-col overflow-hidden rounded-2xl bg-[#161016] border border-pink-500/10 hover:border-pink-500/40 transition-all duration-300 hover:-translate-y-1"
  data-rating={motel.rating}
  data-price-range={motel.priceRange}
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <Image
      src={motel.image || "/motel.png"}
      alt={motel.name}
      width={500}
      height={375}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent"></div>

    {
      motel.featured && (
        <span class="absolute top-3 left-3 inline-flex items-center gap-1 bg-pink-500 text-white px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide">
          <Star className="w-3 h-3" fill="currentColor" />
          Recomendado
        </span>
      )
    }

    <div class="absolute top-3 right-3 flex items-center gap-1 bg-black/80 px-2 py-1 rounded-full">
      <Star className="w-3 h-3 text-pink-400" fill="currentColor" />
      <span class="text-[11px] font-semibold text-white">{motel.rating}</span>
      <span class="text-[9px] text-gray-400">({motel.reviewCount ?? motel.count ?? 0})</span>
    </div>

    <div class="absolute bottom-3 left-3 right-3">
      <h3 class="font-serif text-base sm:text-lg font-bold text-white leading-tight line-clamp-1">
        {motel.name}
      </h3>
      <div class="flex items-center gap-1.5 mt-1 text-white/80 text-xs">
        <MapPin className="w-3.5 h-3.5 shrink-0" />
        <span class="line-clamp-1">{motel.address}</span>
      </div>
    </div>
  </div>

  <div class="flex flex-col flex-1 p-3.5 sm:p-4">
    <div class="flex items-center justify-between mb-3 text-xs">
      <span class="inline-flex items-center gap-1.5 text-emerald-400 font-medium">
        <Clock className="w-3.5 h-3.5" />
        Abierto 24h
      </span>
      {fromPrice && (
        <span class="font-bold text-pink-400">{fromPrice}</span>
      )}
    </div>

    {
      motel.amenities && motel.amenities.length > 0 && (
        <div class="hidden sm:flex flex-wrap gap-1.5 mb-3">
          {motel.amenities.slice(0, 3).map((amenity: string) => {
            const Icon = amenityIcon(amenity);
            return (
              <span class="inline-flex items-center gap-1 text-[10px] text-gray-300 bg-white/5 px-2 py-1 rounded-full">
                {Icon && <Icon className="w-3 h-3 text-pink-400" />}
                <span class="truncate max-w-[7rem]">{amenity}</span>
              </span>
            );
          })}
        </div>
      )
    }

    <div class="mt-auto">
      {href ? (
        <a
          data-astro-prefetch="hover"
          href={href}
          data-umami-event={"/moteles/" + motel.short_name + " button"}
          class="w-full bg-pink-500 text-white px-3 py-2 rounded-xl font-serif text-xs sm:text-sm font-bold hover:bg-pink-400 transition-colors flex items-center justify-center gap-1.5 group/btn"
        >
          Ver habitaciones
          <ArrowRight className="w-3.5 h-3.5 group-hover/btn:translate-x-1 transition-transform" />
        </a>
      ) : motel.menu ? (
        <a
          href={motel.menu}
          class="w-full inline-block text-center py-2 bg-pink-500 text-white rounded-xl font-serif text-xs sm:text-sm font-bold hover:bg-pink-400 transition-colors"
        >
          Ver información
        </a>
      ) : motel.phone ? (
        <a
          href={`tel:${motel.phone}`}
          class="w-full bg-pink-500 text-white px-3 py-2 rounded-xl font-serif text-xs sm:text-sm font-bold hover:bg-pink-400 transition-colors flex items-center justify-center gap-1.5"
        >
          <Phone className="w-3.5 h-3.5" />
          Llamar
        </a>
      ) : (
        <button class="w-full py-2 bg-white/5 text-pink-400 rounded-xl font-serif text-xs sm:text-sm font-bold hover:bg-white/10 transition-colors">
          Ver más
        </button>
      )}
    </div>
  </div>
</div>
