---
import { ArrowRight, Zap, MessageCircle } from "lucide-react";

interface Props {
	title?: string;
	subtitle?: string;
	stateName?: string;
	badgeText?: string;
}

const {
	title,
	subtitle,
	stateName,
	// El badge decia "Inicia hoy GRATIS con tu link de negocio". Vender el
	// precio antes que el producto atrae a quien nunca va a pagar, y con
	// trafico de anuncios eso se cobra por clic. Ahora abre con el problema
	// que el producto resuelve, que es el que hace ver barato el precio.
	badgeText = "Las apps de reparto se llevan hasta 30% de cada pedido",
} = Astro.props;
---

<section
	class="relative pt-20 pb-20 md:pt-32 md:pb-40 bg-white overflow-hidden"
>
	<div class="max-w-7xl mx-auto px-6 text-center">
		<!-- Badge -->
		<div
			class="inline-flex items-center gap-2 px-4 py-2 bg-neutral-50 border border-neutral-100 rounded-full mb-10"
		>
			<Zap className="w-4 h-4 text-marca-500 fill-marca-500" />
			<p
				class="text-[11px] font-black uppercase tracking-widest text-neutral-600"
			>
				{
					stateName
						? `Oportunidad para restaurantes en ${stateName}`
						: badgeText
				}
			</p>
		</div>

		<h1
			class="text-5xl md:text-8xl font-black text-neutral-900 mb-8 leading-[0.85] tracking-tighter uppercase max-w-5xl mx-auto"
		>
			{
				title ? (
					<Fragment set:html={title} />
				) : (
					<>
						Tus pedidos,{" "}
						<span class="text-marca-600">sin comisiones</span>
					</>
				)
			}
		</h1>

		<p
			class="text-xl md:text-2xl text-neutral-500 mb-12 max-w-3xl mx-auto font-medium leading-relaxed"
		>
			{
				subtitle ? (
					<Fragment set:html={subtitle} />
				) : (
					<>
						Menú digital con QR y pedidos directos por WhatsApp.{" "}
						<span class="text-neutral-900 border-b-2 border-marca-400">
							Lo que vendes es tuyo
						</span>
						: sin intermediarios y sin porcentaje por pedido.
					</>
				)
			}
		</p>

		{/* Antes habia tres botones del mismo peso —"Inicia gratis", "Directorio
		    de servicios" y "Revisa un menú demo"— compitiendo entre ellos. Tres
		    caminos igual de fuertes es lo mismo que ninguno. Quedan dos, y el
		    directorio baja a enlace de texto para no quedarse huerfano: el pie
		    de pagina no lo enlaza. */}
		<div
			class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-6"
		>
			<a
				href="https://admin-menus.bysmax.com"
				class="group inline-flex items-center px-10 py-5 bg-neutral-900 text-white font-black rounded-[24px] hover:bg-black transition-all duration-300 uppercase tracking-widest text-xs active:scale-95"
			>
				Empieza ahora
				<ArrowRight
					className="ml-3 h-4 w-4 group-hover:translate-x-1 transition-transform"
				/>
			</a>
			<a
				href={stateName ? "#ejemplos" : "/menus"}
				class="inline-flex items-center px-10 py-5 border border-neutral-200 text-neutral-900 font-black rounded-[24px] hover:bg-neutral-50 transition-all text-xs uppercase tracking-widest active:scale-95"
			>
				{stateName ? "Ver ejemplos locales" : "Ver un menú real"}
			</a>
		</div>

		<div class="mb-24">
			<a
				href="/servicios"
				class="text-xs font-bold uppercase tracking-widest text-neutral-500 hover:text-marca-600 transition-colors"
			>
				Directorio de servicios
			</a>
		</div>

		<!-- Product Visuals Mockup -->
		<div class="relative max-w-6xl mx-auto">
			<div
				class="relative z-10 rounded-[40px] border-[12px] border-neutral-900 overflow-hidden shadow-[0_40px_100px_-20px_rgba(0,0,0,0.3)] bg-neutral-50 aspect-[16/9] group"
			>
				<div
					class="absolute inset-0 flex items-center justify-center bg-neutral-100"
				>
					<img
						src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&q=80&w=2000"
						alt="BySMax Platform Dashboard"
						class="w-full h-full object-cover opacity-90 group-hover:scale-105 transition-transform duration-1000"
					/>
					<div
						class="absolute top-10 right-10 w-64 bg-white rounded-3xl p-6 shadow-2xl border border-neutral-100 animate-float hidden md:block text-left"
					>
						<div class="flex items-center gap-3 mb-4">
							<div
								class="w-10 h-10 bg-marca-100 rounded-full flex items-center justify-center text-marca-600"
							>
								<MessageCircle className="w-5 h-5" />
							</div>
							<div>
								<p
									class="text-[10px] font-black text-neutral-400 uppercase tracking-widest"
								>
									Nuevo Pedido
								</p>
								<p class="text-xs font-bold text-neutral-900">
									1x Burger Special
								</p>
							</div>
						</div>
						<div
							class="h-2 w-full bg-neutral-100 rounded-full overflow-hidden"
						>
							<div class="h-full bg-marca-500 w-3/4"></div>
						</div>
					</div>
				</div>
			</div>
			<div
				class="absolute -top-10 -left-10 w-40 h-40 bg-marca-100 rounded-full blur-[80px] opacity-60"
			>
			</div>
			<div
				class="absolute -bottom-20 -right-20 w-80 h-80 bg-marca-100 rounded-full blur-[100px] opacity-40"
			>
			</div>
		</div>
	</div>
</section>

<style>
	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-20px);
		}
	}
	.animate-float {
		animation: float 6s ease-in-out infinite;
	}
</style>
