---
import { Star, ArrowRight } from "lucide-react";

interface Props {
	stateName: string;
	restaurants: any[];
}

const { stateName, restaurants } = Astro.props;
---

<section id="ejemplos" class="py-24 bg-neutral-50">
	<div class="max-w-7xl mx-auto px-6">
		<div
			class="flex flex-col md:flex-row justify-between items-end gap-8 mb-16"
		>
			<div class="max-w-2xl">
				<h2
					class="text-4xl md:text-6xl font-black text-neutral-900 mb-4 tracking-tighter uppercase leading-[0.9]"
				>
					Mira cómo lucen los negocios <br />
					<span class="text-marca-600">en {stateName}</span>
				</h2>
				<p class="text-neutral-500 font-medium">
					Ejemplos de cartas digitales optimizadas para máxima conversión.
				</p>
			</div>
			<div class="bg-white px-6 py-3 rounded-full border border-neutral-200">
				<p class="text-xs font-black uppercase tracking-widest text-neutral-400">
					<span class="text-marca-600">{restaurants.length}</span> Restaurantes
					listos
				</p>
			</div>
		</div>

		{
			restaurants.length > 0 ? (
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					{restaurants.map((res) => (
						<div class="group bg-white rounded-[40px] border border-neutral-100 p-2 shadow-sm hover:shadow-2xl hover:shadow-marca-500/10 transition-all duration-500 hover:-translate-y-2 overflow-hidden">
							<div class="relative h-64 rounded-[32px] overflow-hidden mb-6">
								<img
									src={res.image || "/restaurant-placeholder.jpg"}
									alt={res.name}
									class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-neutral-900/60 to-transparent" />

								<div class="absolute bottom-4 left-6 right-6 flex items-center justify-between">
									<div class="flex items-center gap-2 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full">
										<Star className="w-3 h-3 text-neutral-400 fill-neutral-400" />
										<span class="text-[10px] font-black">{res.rating}</span>
									</div>
									<div class="bg-marca-500 px-3 py-1 rounded-full text-white text-[9px] font-black uppercase tracking-widest">
										{res.type === "motel" ? "Guía Local" : "Menú Digital"}
									</div>
								</div>
							</div>

							<div class="px-6 pb-6 mt-4 text-center">
								<h3 class="text-2xl font-black text-neutral-900 mb-2 uppercase tracking-tight">
									{res.name}
								</h3>
								<p class="text-neutral-500 text-xs font-medium mb-6 line-clamp-1">
									{res.address || stateName}
								</p>

								{(() => {
									const isMotel = res.type === "motel";
									const href = isMotel
										? `/moteles/estados/${res.state_slug}/${res.short_name}`
										: res.menu || `/menus/${res.short_name}`;

									return (
										<a
											href={href}
											target={isMotel ? "_self" : "_blank"}
											class="inline-flex items-center justify-center gap-3 w-full py-4 bg-neutral-900 text-white rounded-[24px] font-black uppercase tracking-widest text-[10px] hover:bg-marca-500 transition-all active:scale-95"
										>
											{isMotel ? "Ver guía completa" : "Ver menú ejemplo"}
											<ArrowRight className="w-3.5 h-3.5" />
										</a>
									);
								})()}
							</div>
						</div>
					))}
				</div>
			) : (
				<div class="py-32 text-center bg-white rounded-[60px] border-4 border-dashed border-neutral-100 max-w-4xl mx-auto px-10">
					<h2 class="text-3xl font-black text-neutral-900 mb-4 uppercase tracking-tighter">
						Lidera la revolución digital en{" "}
						<span class="text-marca-600">{stateName}</span>
					</h2>
					<p class="text-neutral-500 max-w-lg mx-auto font-medium leading-relaxed mb-10">
						Estamos seleccionando a los restaurantes referentes de{" "}
						<strong>{stateName}</strong> para lanzar el directorio local con
						beneficios exclusivos. Sé el primero y obtén visibilidad
						prioritaria.
					</p>
					<a
						href="/admin/register"
						class="inline-flex items-center px-12 py-5 bg-marca-500 text-white font-black rounded-3xl hover:bg-marca-600 transition-all uppercase tracking-widest text-xs shadow-xl shadow-marca-500/20 active:scale-95"
					>
						¡Digitaliza tu restaurante en {stateName} hoy!
					</a>
				</div>
			)
		}
	</div>
</section>
