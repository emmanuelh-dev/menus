---
import { PlayCircle } from "lucide-react";

interface Props {
	stateName?: string;
}

const { stateName } = Astro.props;
---

<section class="py-24 bg-white">
	<div class="max-w-7xl mx-auto px-6 text-center">
		<h2
			class="text-4xl md:text-6xl font-black text-slate-900 mb-6 tracking-tighter uppercase italic"
		>
			Mira cómo funciona en 60 segundos.
		</h2>
		<p class="text-lg text-slate-500 max-w-2xl mx-auto mb-16 font-medium">
			Con BySMax, restaurantes y negocios {stateName ? `en ${stateName}` : ""} atienden
			<span class="text-emerald-600 font-black italic">3× más rápido</span> y ahorran
			50% de tiempo en gestión.
		</p>

		<div class="max-w-4xl mx-auto relative group cursor-pointer">
			<div
				class="relative aspect-video rounded-[32px] overflow-hidden bg-slate-900 shadow-2xl shadow-emerald-500/10 border-8 border-slate-50"
			>
				<img
					src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&q=80&w=1200"
					class="w-full h-full object-cover opacity-60 group-hover:scale-110 transition-transform duration-1000"
					alt="How it works video thumbnail"
				/>
				<div class="absolute inset-0 flex items-center justify-center">
					<div
						class="w-20 h-20 bg-emerald-500 rounded-full flex items-center justify-center text-white shadow-2xl group-hover:scale-110 transition-all"
					>
						<PlayCircle className="w-10 h-10" />
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
