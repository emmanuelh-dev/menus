---
import {
	MessageCircle,
	BarChart3,
	Globe,
	Monitor,
	ShoppingBag,
	ArrowRight,
} from "lucide-react";

interface Props {
	stateName?: string;
}

const { stateName } = Astro.props;
---

<section class="py-32 bg-slate-900 text-white relative overflow-hidden">
	<!-- Background Graphic -->
	<div
		class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-emerald-500/5 to-transparent"
	>
	</div>

	<div class="max-w-7xl mx-auto px-6 relative z-10">
		<h2
			class="text-4xl md:text-7xl font-black mb-20 tracking-tighter uppercase leading-[0.9]"
		>
			Con BySMax <br />
			<span class="text-emerald-400">podrás</span>
		</h2>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			<!-- WhatsApp Feature -->
			<div
				class="group bg-white/5 backdrop-blur-sm p-10 rounded-[40px] border border-white/10 hover:border-emerald-500/50 transition-all duration-500"
			>
				<div
					class="w-14 h-14 bg-emerald-500/10 text-emerald-400 rounded-2xl flex items-center justify-center mb-10 group-hover:scale-110 group-hover:bg-emerald-500 group-hover:text-white transition-all shadow-lg shadow-emerald-500/10"
				>
					<MessageCircle className="w-6 h-6" />
				</div>
				<h3 class="text-2xl font-black mb-4 uppercase tracking-tight">
					Recibir pedidos a tu WhatsApp
				</h3>
				<p class="text-slate-400 font-medium leading-relaxed">
					Sin apps ni descargas. Comparte el enlace de tu menú y te llegan tus
					pedidos a tu WhatsApp {stateName ? `en ${stateName}` : ""}.
				</p>
			</div>

			<!-- Manage Feature -->
			<div
				class="group bg-white/5 backdrop-blur-sm p-10 rounded-[40px] border border-white/10 hover:border-emerald-500/50 transition-all duration-500"
			>
				<div
					class="w-14 h-14 bg-emerald-500/10 text-emerald-400 rounded-2xl flex items-center justify-center mb-10 group-hover:scale-110 group-hover:bg-emerald-500 group-hover:text-white transition-all shadow-lg shadow-emerald-500/10"
				>
					<BarChart3 className="w-6 h-6" />
				</div>
				<h3 class="text-2xl font-black mb-4 uppercase tracking-tight">
					Administrar tu negocio más fácil
				</h3>
				<p class="text-slate-400 font-medium leading-relaxed">
					Cambia productos {stateName ? `en tu local de ${stateName}` : ""},
					revisa estadísticas de ventas y administra mensajes.
				</p>
			</div>

			<!-- Link Feature -->
			<div
				class="group bg-white/5 backdrop-blur-sm p-10 rounded-[40px] border border-white/10 hover:border-emerald-500/50 transition-all duration-500"
			>
				<div
					class="w-14 h-14 bg-emerald-500/10 text-emerald-400 rounded-2xl flex items-center justify-center mb-10 group-hover:scale-110 group-hover:bg-emerald-500 group-hover:text-white transition-all shadow-lg shadow-emerald-500/10"
				>
					<Globe className="w-6 h-6" />
				</div>
				<h3 class="text-2xl font-black mb-4 uppercase tracking-tight">
					Link único para tu negocio
				</h3>
				<p class="text-slate-400 font-medium leading-relaxed">
					Crea tu propia página web con el catálogo de productos y redes
					sociales de tu negocio.
				</p>
			</div>

			<!-- POS Feature -->
			<div
				class="group bg-white/5 backdrop-blur-sm p-10 rounded-[40px] border border-white/10 hover:border-emerald-500/50 transition-all duration-500"
			>
				<div
					class="w-14 h-14 bg-emerald-500/10 text-emerald-400 rounded-2xl flex items-center justify-center mb-10 group-hover:scale-110 group-hover:bg-emerald-500 group-hover:text-white transition-all shadow-lg shadow-emerald-500/10"
				>
					<Monitor className="w-6 h-6" />
				</div>
				<h3 class="text-2xl font-black mb-4 uppercase tracking-tight">
					Crear pedidos con tu POS
				</h3>
				<p class="text-slate-400 font-medium leading-relaxed">
					Haz ordenes y gestiona pedidos de manera rápido en un mismo lugar,
					ideal para atención en local.
				</p>
			</div>

			<!-- Inventory Feature -->
			<div
				class="group bg-white/5 backdrop-blur-sm p-10 rounded-[40px] border border-white/10 hover:border-emerald-500/50 transition-all duration-500"
			>
				<div
					class="w-14 h-14 bg-emerald-500/10 text-emerald-400 rounded-2xl flex items-center justify-center mb-10 group-hover:scale-110 group-hover:bg-emerald-500 group-hover:text-white transition-all shadow-lg shadow-emerald-500/10"
				>
					<ShoppingBag className="w-6 h-6" />
				</div>
				<h3 class="text-2xl font-black mb-4 uppercase tracking-tight">
					Controlar tu inventario
				</h3>
				<p class="text-slate-400 font-medium leading-relaxed">
					Gestiona tus productos y SKUs en un mismo lugar sin Excel, ni papel o
					apps.
				</p>
			</div>

			<!-- More Feature -->
			<div
				class="bg-gradient-to-br from-emerald-600 to-teal-700 p-10 rounded-[40px] flex flex-col justify-center items-center text-center shadow-2xl"
			>
				<h3 class="text-3xl font-black mb-4 uppercase tracking-tighter">
					y más...
				</h3>
				<a
					href="/admin/register"
					class="bg-white text-slate-900 px-6 py-3 rounded-full font-black text-[10px] uppercase tracking-widest hover:bg-slate-100 transition-all active:scale-95"
				>
					Empieza ahora
				</a>
			</div>
		</div>
	</div>
</section>
