---
interface Props {
	place: any;
	className?: string;
}

const { place, className = "" } = Astro.props;
const { semantic_data = {} } = place?.content || {};

// Si no se especifica una clase de justificación, aplicamos justify-center por defecto
const alignmentClass = className.includes("justify-") ? "" : "justify-center";

const address = semantic_data.address || place.address || "";
const mapsSearchQuery = encodeURIComponent(`${place.name} ${address || ""}`);
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsSearchQuery}`;
---

<div
	class={`flex flex-wrap gap-2 text-xs text-stone-600  justify-center  ${alignmentClass} ${className}`}
>
	{
		semantic_data.phone && (
			<a
				href={`tel:${semantic_data.phone}`}
				class="inline-flex items-center gap-1.5 px-3 py-2 bg-red-600 hover:bg-red-700 text-white rounded-full text-[10px] font-bold transition-all shadow-sm active:scale-95"
				aria-label={`Llamar a ${place.name}`}
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="w-3.5 h-3.5"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
					/>
				</svg>
				Llamar
			</a>
		)
	}

	{
		semantic_data.whatsapp && (
			<a
				href={`https://wa.me/${semantic_data.whatsapp.replace(/\D/g, "")}`}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 px-3 py-2 bg-green-600 hover:bg-green-700 text-white rounded-full text-[10px] font-bold transition-all shadow-sm active:scale-95"
				aria-label={`WhatsApp de ${place.name}`}
			>
				<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
					<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
				</svg>
				WhatsApp
			</a>
		)
	}

	{
		address && (
			<a
				href={googleMapsUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-full text-[10px] font-bold transition-all shadow-sm active:scale-95"
				aria-label={`Ubicación de ${place.name}`}
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="w-3.5 h-3.5"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
					/>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
					/>
				</svg>
				Ubicación
			</a>
		)
	}

	{
		semantic_data.price_range && (
			<span class="inline-flex items-center gap-1.5 px-3 py-2 bg-stone-100 text-stone-600 rounded-full text-[10px] font-bold border border-stone-200/50">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="w-3.5 h-3.5"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
					/>
				</svg>
				{semantic_data.price_range}
			</span>
		)
	}

	{
		semantic_data.parking && (
			<span class="inline-flex items-center gap-1.5 px-3 py-2 bg-stone-100 text-stone-600 rounded-full text-[10px] font-bold border border-stone-200/50">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="w-3.5 h-3.5"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"
					/>
				</svg>
				{semantic_data.parking}
			</span>
		)
	}

	{
		semantic_data.payment_options &&
			semantic_data.payment_options.length > 0 &&
			semantic_data.payment_options.map((payment: string) => (
				<span class="inline-flex items-center gap-1 px-3 py-2 bg-stone-100 text-stone-600 rounded-full text-[10px] font-bold border border-stone-200/50">
					{payment.toLowerCase().includes("efectivo") && "💵"}
					{payment.toLowerCase().includes("tarjeta") && "💳"}
					{payment.toLowerCase().includes("transferencia") && "🏦"}
					<span class="ml-1">{payment}</span>
				</span>
			))
	}
	{
		semantic_data.hours && (
			<span class="inline-flex items-center gap-1.5 px-3 py-2 bg-stone-100 text-stone-600 rounded-full text-[10px] font-bold border border-stone-200/50">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="w-3.5 h-3.5"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
					/>
				</svg>
				{semantic_data.hours}
			</span>
		)
	}
</div>
