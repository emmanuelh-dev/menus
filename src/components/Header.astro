---
import { Utensils, Menu, X, Zap, ArrowUp, ArrowRight } from "lucide-react";

const { textWhite, backgroundColor = "bg-white/90" } = Astro.props;

// Helper to map icon names to components (optional, but keep it simple with standard icons)
---

<header
	class={`${backgroundColor || "bg-white"} ${textWhite ? "text-white" : "text-slate-900"}  transition-all duration-300`}
>
	<div class="max-w-7xl mx-auto px-4 sm:px-6">
		<div class="flex py-3 items-center justify-between">
			<a class="flex items-center space-x-2 group shrink-0" href="/">
				<div
					class="p-1.5 bg-gradient-to-br from-emerald-600 to-emerald-400 rounded-lg shadow-emerald-500/20 group-hover:scale-105 transition-transform"
				>
					<Utensils className="h-5 w-5 text-white" />
				</div>
				<div class="flex flex-col leading-none">
					<span
						class={`font-black tracking-tight ${textWhite ? "text-white" : "text-slate-900"} text-lg sm:text-xl`}
						>BySMax</span
					>
					<span
						class="text-[9px] font-black text-emerald-600 tracking-tighter uppercase"
						>Menús IA</span
					>
				</div>
			</a>

			<div class="hidden lg:flex items-center space-x-7">
				{/* El resto de los links (soluciones, herramientas, directorio, planes,
				    nosotros, soporte) vive en el footer — este nav se queda solo con
				    lo que la gente busca primero: ver ejemplos y el blog. */}
				<a
					href="/menus"
					class={`py-2 font-bold text-[13px] uppercase tracking-wider ${textWhite ? "text-slate-200 hover:text-white" : "text-slate-600 hover:text-emerald-600"} transition-colors`}
				>
					Ver ejemplos
				</a>

				<a
					href="/blog"
					class={`py-2 font-bold text-[13px] uppercase tracking-wider ${textWhite ? "text-slate-200 hover:text-white" : "text-slate-600 hover:text-emerald-600"} transition-colors`}
				>
					Blog
				</a>
			</div>

			<div class="flex items-center space-x-2 sm:space-x-4 shrink-0">
				<a
					href="https://admin-menus.bysmax.com"
					class="inline-flex items-center px-4 py-2 sm:px-6 sm:py-2.5 bg-emerald-600 text-white font-black rounded-xl hover:bg-emerald-700 active:scale-95 transition-all shadow-emerald-500/20 text-[11px] uppercase tracking-widest border border-emerald-500/50"
				>
					<span class="sm:hidden">Crear Menú Gratis</span>
					<span class="hidden sm:inline">Crear Menú Gratis</span>
				</a>

				<button
					id="menuButton"
					class={`lg:hidden p-2 rounded-xl ${textWhite ? "bg-white/10 text-white" : "bg-slate-100 text-slate-900"} transition-colors relative z-[110] border border-slate-200 active:scale-90`}
					aria-label="Menu"
				>
					<Menu className="h-6 w-6" id="menuIcon" />
					<X className="h-6 w-6 hidden" id="closeIcon" />
				</button>
			</div>
		</div>
	</div>

	{/* Mobile Menu Overlay */}
	<div
		id="mobileNav"
		class="hidden fixed inset-0 bg-white z-[105] lg:hidden overflow-y-auto pt-24 pb-12 animate-in fade-in slide-in-from-right duration-300"
	>
		<div class="px-6 space-y-10">
			<div class="flex flex-col gap-10">
				<div>
					<a
						href="https://admin-menus.bysmax.com"
						class="mb-4 flex items-center justify-center gap-3 w-full py-5 bg-emerald-600 text-white text-center rounded-3xl font-black text-sm uppercase tracking-widest shadow-2xl shadow-emerald-500/40 active:scale-[0.98] transition-all"
					>
						Crea tu menú gratis <Zap className="w-4 h-4" />
					</a>
					{/* El resto de los links vive en el footer — ver nota arriba. */}
					<div class="space-y-3">
						<a
							href="/menus"
							class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl group active:bg-emerald-50 transition-colors"
						>
							<span
								class="text-sm font-black text-slate-900 uppercase tracking-widest"
								>Ver ejemplos</span
							>
							<ArrowRight className="w-4 h-4 text-slate-300" />
						</a>
						<a
							href="/blog"
							class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl group active:bg-emerald-50 transition-colors"
						>
							<span
								class="text-sm font-black text-slate-900 uppercase tracking-widest"
								>Blog</span
							>
							<ArrowRight className="w-4 h-4 text-slate-300" />
						</a>
					</div>
				</div>
			</div>

			<div class="px-6 mt-16 pb-12">
				<button
					id="backToTopMobile"
					class="w-full py-4 bg-slate-100 text-slate-900 rounded-2xl font-black text-xs uppercase tracking-[0.2em] flex items-center justify-center gap-3 active:scale-95 transition-all"
				>
					<ArrowUp className="w-4 h-4" />
					Volver arriba
				</button>
				<div class="mt-12 text-center text-slate-400">
					<p class="text-[10px] font-bold uppercase tracking-[0.3em]">
						BySMax Menús IA
					</p>
				</div>
			</div>
		</div>
	</div>

	<script>
		const setupMenu = () => {
			// Casting de tipos para evitar el error ts(18047)
			const menuButton = document.getElementById(
				"menuButton",
			) as HTMLButtonElement | null;
			const mobileNav = document.getElementById(
				"mobileNav",
			) as HTMLElement | null;
			const menuIcon = document.getElementById(
				"menuIcon",
			) as HTMLElement | null;
			const closeIcon = document.getElementById(
				"closeIcon",
			) as HTMLElement | null;

			if (!menuButton || !mobileNav || !menuIcon || !closeIcon) return;

			const toggleMenu = () => {
				const isHidden = mobileNav.classList.contains("hidden");
				if (isHidden) {
					mobileNav.classList.remove("hidden");
					menuIcon.classList.add("hidden");
					closeIcon.classList.remove("hidden");
					document.body.style.overflow = "hidden";
				} else {
					mobileNav.classList.add("hidden");
					menuIcon.classList.remove("hidden");
					closeIcon.classList.add("hidden");
					document.body.style.overflow = "";
				}
			};

			const backToTopBtn = document.getElementById("backToTopMobile");
			if (backToTopBtn) {
				backToTopBtn.addEventListener("click", () => {
					toggleMenu();
					window.scrollTo({ top: 0, behavior: "smooth" });
				});
			}

			menuButton.addEventListener("click", toggleMenu);
		};

		setupMenu();
		document.addEventListener("astro:page-load", setupMenu);
	</script>

	<style>
		.xs\:hidden {
			display: block;
		}
		@media (min-width: 400px) {
			.xs\:hidden {
				display: none;
			}
			.xs\:inline {
				display: inline;
			}
		}
		@media (max-width: 399px) {
			.xs\:inline {
				display: none;
			}
		}
	</style>
</header>
