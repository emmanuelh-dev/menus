---
import { Utensils, Menu, X, Zap, ChevronDown } from "lucide-react";
import { navItems, navCategories } from "../data/header-nav-links";

const { textWhite, backgroundColor = "bg-white/90" } = Astro.props;
---

<header
	class={`${backgroundColor} ${textWhite ? "text-white" : "text-black"} border-b border-slate-200/60 backdrop-blur-md sticky top-0 z-50 shadow-sm`}
>
	<div class="max-w-7xl mx-auto px-4 sm:px-6">
		<div class="flex py-3 items-center justify-between">
			<a class="flex items-center space-x-2 group shrink-0" href="/">
				<div
					class="p-1.5 bg-gradient-to-br from-emerald-600 to-emerald-400 rounded-lg shadow-emerald-500/20 shadow-lg group-hover:scale-105 transition-transform"
				>
					<Utensils className="h-5 w-5 text-white" />
				</div>
				<div class="flex flex-col leading-none">
					<span
						class={`font-bold ${textWhite ? "text-white" : "text-slate-900"} text-base sm:text-lg`}
						>BySMax</span
					>
					<span
						class="text-[10px] font-bold text-emerald-500 tracking-tighter uppercase"
						>Menús IA</span
					>
				</div>
			</a>

			<div class="hidden lg:flex items-center space-x-8">
				<div class="relative group">
					<button
						id="desktopMenuButton"
						class={`flex items-center space-x-1 py-2 font-medium text-sm ${textWhite ? "text-slate-200 hover:text-white" : "text-slate-600 hover:text-emerald-600"} transition-colors`}
					>
						<span>Soluciones</span>
						<ChevronDown
							className="h-4 w-4 group-hover:rotate-180 transition-transform"
						/>
					</button>

					<div
						id="desktopDropdown"
						class="absolute top-full left-0 mt-2 w-72 bg-white border border-slate-200 rounded-xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all transform translate-y-2 group-hover:translate-y-0 z-50"
					>
						<div class="p-3">
							{
								navCategories.map((category, idx) => (
									<div
										class={idx > 0 ? "mt-3 pt-3 border-t border-slate-100" : ""}
									>
										<p class="px-3 text-[10px] font-bold text-emerald-600 uppercase tracking-widest mb-1">
											{category.title}
										</p>
										{category.items.map((item) => (
											<a
												href={item.href}
												class="block px-3 py-2 text-sm text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 rounded-lg transition-colors"
											>
												{item.name}
											</a>
										))}
									</div>
								))
							}
						</div>
					</div>
				</div>
			</div>

			<div class="flex items-center space-x-3">
				<a
					href="/admin/dashboard"
					class="inline-flex items-center px-4 py-2 sm:px-6 sm:py-2.5 bg-gradient-to-r from-emerald-600 to-emerald-500 text-white font-bold rounded-xl hover:scale-105 active:scale-95 transition-all shadow-lg shadow-emerald-500/30 text-xs sm:text-sm border border-white/20"
				>
					<span class="hidden xs:inline">Crea tu menú digital gratis</span>
					<span class="xs:hidden">Crea tu menú digital gratis</span>
				</a>

				<button
					id="menuButton"
					class={`lg:hidden p-2 rounded-lg ${textWhite ? "hover:bg-white/10" : "hover:bg-slate-100"} transition-colors`}
					aria-label="Menu"
				>
					<Menu
						className={`h-6 w-6 ${textWhite ? "text-white" : "text-slate-700"}`}
						id="menuIcon"
					/>
					<X
						className={`h-6 w-6 ${textWhite ? "text-white" : "text-slate-700"} hidden`}
						id="closeIcon"
					/>
				</button>
			</div>
		</div>
	</div>

	<nav
		id="mobileNav"
		class="hidden fixed inset-x-0 top-[65px] bg-white/95 backdrop-blur-xl border-t border-slate-200 shadow-2xl p-6 z-40 lg:hidden animate-in fade-in slide-in-from-top-4 duration-300"
	>
		<div class="grid grid-cols-2 gap-4">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class="flex items-center p-3 rounded-xl bg-slate-50 text-slate-800 text-sm font-bold border border-slate-100 active:bg-emerald-50 active:text-emerald-600 transition-colors"
					>
						{item.name}
					</a>
				))
			}
		</div>
		<div class="mt-6 pt-6 border-t border-slate-100">
			<p class="text-center text-xs text-slate-400 font-medium">
				BySMax © 2026 - Monterrey, N.L.
			</p>
		</div>
	</nav>
</header>

<script>
	const setupMenu = () => {
		// Casting de tipos para evitar el error ts(18047)
		const menuButton = document.getElementById(
			"menuButton",
		) as HTMLButtonElement | null;
		const mobileNav = document.getElementById(
			"mobileNav",
		) as HTMLElement | null;
		const menuIcon = document.getElementById("menuIcon") as HTMLElement | null;
		const closeIcon = document.getElementById(
			"closeIcon",
		) as HTMLElement | null;

		if (!menuButton || !mobileNav || !menuIcon || !closeIcon) return;

		const toggleMenu = () => {
			const isHidden = mobileNav.classList.contains("hidden");
			if (isHidden) {
				mobileNav.classList.remove("hidden");
				menuIcon.classList.add("hidden");
				closeIcon.classList.remove("hidden");
				document.body.style.overflow = "hidden";
			} else {
				mobileNav.classList.add("hidden");
				menuIcon.classList.remove("hidden");
				closeIcon.classList.add("hidden");
				document.body.style.overflow = "";
			}
		};

		menuButton.addEventListener("click", toggleMenu);
	};

	setupMenu();
	document.addEventListener("astro:page-load", setupMenu);
</script>

<style>
	.xs\:hidden {
		display: block;
	}
	@media (min-width: 400px) {
		.xs\:hidden {
			display: none;
		}
		.xs\:inline {
			display: inline;
		}
	}
	@media (max-width: 399px) {
		.xs\:inline {
			display: none;
		}
	}
</style>
