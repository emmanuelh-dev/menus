---
import { Utensils, Menu, X, Zap } from "lucide-react";
import { navItems } from "../data/header-nav-links";

const { textWhite, backgroundColor } = Astro.props;
---

<header
    class={`${backgroundColor} ${textWhite ? "text-white" : "text-black"} border-b border-slate-200/60 backdrop-blur-sm sticky top-0 z-50 shadow-sm`}
>
    <div class="max-w-7xl mx-auto">
        <div class="flex px-6 py-4 items-center justify-between"> 
            <a class="flex items-center space-x-2 group" href="/">
                <div class="p-2 bg-gradient-to-r from-emerald-600 to-emerald-500 rounded-xl shadow-lg group-hover:shadow-emerald-500/25 transition-all duration-300">
                    <Utensils className="h-5 w-5 text-white" />
                </div>                <div class={`${textWhite ? "text-white" : "hidden sm:block"}`}>
                    <span class={`font-bold ${textWhite ? "text-white" : "text-slate-900"} text-lg`}>BySMax</span>
                    <div class={`text-xs ${textWhite ? "text-emerald-300" : "text-emerald-600"} font-medium`}>Menús GRATIS</div>
                </div>
            </a>

            <!-- CTA prominente en desktop -->
            <div class="hidden lg:flex items-center space-x-4">                <a
                    href="/contact"
                    class="inline-flex items-center px-6 py-2.5 bg-gradient-to-r from-emerald-600 to-emerald-500 text-white font-semibold rounded-xl hover:from-emerald-700 hover:to-emerald-600 transition-all duration-300 shadow-lg hover:shadow-emerald-500/25 text-sm border border-emerald-600"
                >
                    <Zap className="mr-2 h-4 w-4" />
                    Crear menú gratis ahora
                </a><a
                    href="/menus"
                    class={`text-sm font-medium ${textWhite ? "text-slate-200 hover:text-white" : "text-slate-600 hover:text-slate-900"} transition-colors duration-200`}
                >
                    Ver Casos de Éxito
                </a>
            </div>            <button
                id="menuButton"
                class={`lg:hidden p-2 rounded-lg ${textWhite ? "hover:bg-white/10" : "hover:bg-slate-100"} transition-colors duration-200`}
                aria-label="Menu"
            >
                <Menu className={`h-6 w-6 ${textWhite ? "text-white" : "text-slate-700"}`} id="menuIcon" />
                <X className={`h-6 w-6 ${textWhite ? "text-white" : "text-slate-700"} hidden`} id="closeIcon" />
            </button>
              <nav
                id="mobileNav"
                class={`hidden lg:hidden fixed top-[73px] left-0 right-0 ${backgroundColor} border-t border-slate-200/60 shadow-lg p-6 transform transition-all duration-300 ease-in-out`}
            >
                <div class="space-y-4">
                    <!-- CTA móvil prominente -->                    <a
                        href="/contact"
                        class="flex items-center justify-center px-6 py-3 bg-gradient-to-r from-emerald-600 to-emerald-500 text-white font-semibold rounded-xl hover:from-emerald-700 hover:to-emerald-600 transition-all duration-300 shadow-lg text-sm w-full"
                    >
                        <Zap className="mr-2 h-4 w-4" />
                        Crear menú gratis ahora
                    </a>
                    
                    <div class="grid grid-cols-2 gap-3 pt-2">
                        {
                            navItems.map((item) => (
                                <a
                                    class={`text-sm font-medium ${textWhite ? "text-slate-200 hover:text-emerald-400" : "text-slate-700 hover:text-emerald-600"} py-2 transition-colors duration-200`}
                                    href={item.href}
                                >
                                    {item.name}
                                </a>
                            ))
                        }
                    </div>
                </div>
            </nav>
        </div>
    </div>
</header>

<script>
    const setupMenu = () => {
        const menuButton = document.getElementById("menuButton");
        const mobileNav = document.getElementById("mobileNav");
        const menuIcon = document.getElementById("menuIcon");
        const closeIcon = document.getElementById("closeIcon");

        const closeMenu = () => {
            if (menuButton && mobileNav && menuIcon && closeIcon) {
                menuButton.classList.remove("rotate-180");
                menuIcon.classList.remove("hidden");
                closeIcon.classList.add("hidden");
                mobileNav.classList.add("hidden");
                mobileNav.classList.remove("translate-x-0", "opacity-100");
            }
        };

        const toggleMenu = (event: Event) => {
            event.stopPropagation();
            if (menuButton && mobileNav && menuIcon && closeIcon) {
                menuButton.classList.toggle("rotate-180");
                menuIcon.classList.toggle("hidden");
                closeIcon.classList.toggle("hidden");
                mobileNav.classList.toggle("hidden");
                
                if (!mobileNav.classList.contains("hidden")) {
                    mobileNav.classList.add("translate-x-0", "opacity-100");
                } else {
                    mobileNav.classList.remove("translate-x-0", "opacity-100");
                }
            }
        };

        // Cerrar menú al hacer click fuera
        document.addEventListener("click", (event) => {
            const isMenuOpen = !mobileNav?.classList.contains("hidden");
            if (isMenuOpen && !mobileNav?.contains(event.target as Node)) {
                closeMenu();
            }
        });

        // Cerrar menú al hacer scroll
        let lastScroll = window.scrollY;
        window.addEventListener("scroll", () => {
            const currentScroll = window.scrollY;
            if (Math.abs(currentScroll - lastScroll) > 10) { // Umbral de 10px para evitar cierres accidentales
                closeMenu();
            }
            lastScroll = currentScroll;
        });

        // Prevenir que los clicks dentro del nav cierren el menú
        mobileNav?.addEventListener("click", (event) => {
            event.stopPropagation();
        });

        menuButton?.addEventListener("click", toggleMenu);
    };

    // Setup on initial load and after navigation
    setupMenu();
    document.addEventListener("astro:page-load", setupMenu);
</script>