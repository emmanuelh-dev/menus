---
import { Utensils, Menu, X, Zap, ChevronDown } from "lucide-react";
import {
	navItems,
	navCategories,
	platformLinks,
	nicheLinks,
	toolLinks,
	exploreLinks,
} from "../data/header-nav-links";

const { textWhite, backgroundColor = "bg-white/90" } = Astro.props;

// Helper to map icon names to components (optional, but keep it simple with standard icons)
---

<header
	class={`${backgroundColor || "bg-white"} ${textWhite ? "text-white" : "text-slate-900"}  transition-all duration-300`}
>
	<div class="max-w-7xl mx-auto px-4 sm:px-6">
		<div class="flex py-3 items-center justify-between">
			<a class="flex items-center space-x-2 group shrink-0" href="/">
				<div
					class="p-1.5 bg-gradient-to-br from-emerald-600 to-emerald-400 rounded-lg shadow-emerald-500/20 group-hover:scale-105 transition-transform"
				>
					<Utensils className="h-5 w-5 text-white" />
				</div>
				<div class="flex flex-col leading-none">
					<span
						class={`font-black tracking-tight ${textWhite ? "text-white" : "text-slate-900"} text-lg sm:text-xl`}
						>BySMax</span
					>
					<span
						class="text-[9px] font-black text-emerald-600 tracking-tighter uppercase"
						>Menús IA</span
					>
				</div>
			</a>

			<div class="hidden lg:flex items-center space-x-7">
				{/* Standalone Link: Menús */}
				<a
					href="/menus"
					class={`py-2 font-bold text-[13px] uppercase tracking-wider ${textWhite ? "text-slate-200 hover:text-white" : "text-slate-600 hover:text-emerald-600"} transition-colors`}
				>
					Ver ejemplo
				</a>

				{/* Dropdown: Soluciones */}
				<div class="relative group">
					<button
						class={`flex items-center space-x-1 py-2 font-bold text-[13px] uppercase tracking-wider ${textWhite ? "text-slate-200 hover:text-white" : "text-slate-600 hover:text-emerald-600"} transition-colors`}
					>
						<span>Soluciones</span>
						<ChevronDown
							className="h-3.5 w-3.5 group-hover:rotate-180 transition-transform"
						/>
					</button>

					<div
						class="absolute top-full left-1/2 -translate-x-1/2 pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all transform translate-y-2 group-hover:translate-y-0 z-50 transition-delay-100"
					>
						<div
							class="w-[580px] bg-white border border-slate-200 rounded-2xl shadow-2xl overflow-hidden ring-1 ring-black/5"
						>
							<div class="grid grid-cols-2 gap-0">
								<div class="p-6 bg-slate-50/50 border-r border-slate-100">
									<p
										class="text-[10px] font-black text-emerald-600 uppercase tracking-[0.2em] mb-5"
									>
										Gestión y POS
									</p>
									<div class="space-y-5">
										{
											platformLinks.map((item) => (
												<a
													href={item.href}
													class="flex items-start gap-4 group/item"
												>
													<div class="mt-1 p-1.5 bg-white rounded-lg border border-slate-200 text-slate-400 group-hover/item:text-emerald-600 group-hover/item:border-emerald-200 transition-all shadow-sm">
														<Zap className="w-3.5 h-3.5" />
													</div>
													<div>
														<p class="text-sm font-bold text-slate-900 group-hover/item:text-emerald-700 transition-colors">
															{item.name}
														</p>
														<p class="text-[11px] text-slate-500 line-clamp-1 leading-relaxed">
															{item.description}
														</p>
													</div>
												</a>
											))
										}
									</div>
								</div>
								<div class="p-6 bg-white">
									<p
										class="text-[10px] font-black text-emerald-600 uppercase tracking-[0.2em] mb-5"
									>
										Especialidades
									</p>
									<div class="space-y-5">
										{
											nicheLinks.map((item) => (
												<a
													href={item.href}
													class="flex items-start gap-4 group/item"
												>
													<div class="mt-1 p-1.5 bg-emerald-50 rounded-lg text-emerald-600 group-hover/item:bg-emerald-600 group-hover/item:text-white transition-all">
														<Zap className="w-3.5 h-3.5" />
													</div>
													<div>
														<p class="text-sm font-bold text-slate-900 group-hover/item:text-emerald-700 transition-colors">
															{item.name}
														</p>
														<p class="text-[11px] text-slate-500 line-clamp-1 leading-relaxed">
															{item.description}
														</p>
													</div>
												</a>
											))
										}
									</div>
								</div>
							</div>
							<div
								class="bg-slate-900 p-4 flex items-center justify-between px-6"
							>
								<p class="text-[11px] text-slate-400 font-medium">
									¿Llevas prisa?
								</p>
								<a
									href="/admin/register"
									class="text-emerald-400 text-[11px] font-black uppercase tracking-widest hover:text-white transition-colors flex items-center gap-2"
								>
									Pruébalo gratis de inmediato <Zap className="w-3 h-3" />
								</a>
							</div>
						</div>
					</div>
				</div>

				{/* Dropdown: Herramientas */}
				<div class="relative group">
					<button
						class={`flex items-center space-x-1 py-2 font-bold text-[13px] uppercase tracking-wider ${textWhite ? "text-slate-200 hover:text-white" : "text-slate-600 hover:text-emerald-600"} transition-colors`}
					>
						<span>Herramientas</span>
						<ChevronDown
							className="h-3.5 w-3.5 group-hover:rotate-180 transition-transform"
						/>
					</button>

					<div
						class="absolute top-full left-0 pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all transform translate-y-2 group-hover:translate-y-0 z-50"
					>
						<div
							class="w-72 bg-white border border-slate-200 rounded-xl shadow-2xl overflow-hidden p-2 ring-1 ring-black/5"
						>
							{
								toolLinks.map((item) => (
									<a
										href={item.href}
										class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-emerald-50 group/tool transition-all"
									>
										<div class="p-2 bg-slate-50 rounded-lg text-slate-400 group-hover/tool:text-emerald-600 group-hover/tool:bg-white transition-all border border-transparent group-hover/tool:border-emerald-100">
											<Zap className="w-3.5 h-3.5" />
										</div>
										<div>
											<p class="text-xs font-bold text-slate-900 group-hover/tool:text-emerald-800">
												{item.name}
											</p>
											<p class="text-[10px] text-slate-500">
												Simplifica tu venta
											</p>
										</div>
									</a>
								))
							}
						</div>
					</div>
				</div>

				{/* Dropdown: Directorio */}
				<div class="relative group">
					<button
						class={`flex items-center space-x-1 py-2 font-bold text-[13px] uppercase tracking-wider ${textWhite ? "text-slate-200 hover:text-white" : "text-slate-600 hover:text-emerald-600"} transition-colors`}
					>
						<span>Directorio</span>
						<ChevronDown
							className="h-3.5 w-3.5 group-hover:rotate-180 transition-transform"
						/>
					</button>

					<div
						class="absolute top-full left-0 pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all transform translate-y-2 group-hover:translate-y-0 z-50 transition-delay-100"
					>
						<div
							class="w-64 bg-white border border-slate-200 rounded-xl shadow-2xl overflow-hidden p-2 ring-1 ring-black/5"
						>
							{
								exploreLinks.map((item) => (
									<a
										href={item.href}
										class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-emerald-50 group/tool transition-all"
									>
										<div class="p-2 bg-slate-50 rounded-lg text-slate-400 group-hover/tool:text-emerald-600 group-hover/tool:bg-white transition-all border border-transparent group-hover/tool:border-emerald-100">
											<Zap className="w-3.5 h-3.5" />
										</div>
										<p class="text-xs font-bold text-slate-900 group-hover/tool:text-emerald-800">
											{item.name}
										</p>
									</a>
								))
							}
						</div>
					</div>
				</div>

				{/* Standalone: Precios */}
				<a
					href="/precios"
					class={`py-2 font-bold text-[13px] uppercase tracking-wider ${textWhite ? "text-slate-200 hover:text-white" : "text-slate-600 hover:text-emerald-600"} transition-colors`}
				>
					Precios
				</a>

				{/* Standalone Link: Blog */}
				<a
					href="/blog"
					class={`py-2 font-bold text-[13px] uppercase tracking-wider ${textWhite ? "text-slate-200 hover:text-white" : "text-slate-600 hover:text-emerald-600"} transition-colors`}
				>
					Blog
				</a>
			</div>

			<div class="flex items-center space-x-2 sm:space-x-4 shrink-0">
				<a
					href="/admin/dashboard"
					class="inline-flex items-center px-4 py-2 sm:px-6 sm:py-2.5 bg-emerald-600 text-white font-black rounded-xl hover:bg-emerald-700 active:scale-95 transition-all shadow-emerald-500/20 text-[11px] uppercase tracking-widest border border-emerald-500/50"
				>
					<span class="sm:hidden">Crear Menú Gratis</span>
					<span class="hidden sm:inline">Crear Menú Gratis</span>
				</a>

				<button
					id="menuButton"
					class={`lg:hidden p-2 rounded-xl ${textWhite ? "bg-white/10 text-white" : "bg-slate-100 text-slate-900"} transition-colors relative z-[110] border border-slate-200 active:scale-90`}
					aria-label="Menu"
				>
					<Menu className="h-6 w-6" id="menuIcon" />
					<X className="h-6 w-6 hidden" id="closeIcon" />
				</button>
			</div>
		</div>
	</div>

	{/* Mobile Menu Overlay */}
	<div
		id="mobileNav"
		class="hidden fixed inset-0 bg-white z-[105] lg:hidden overflow-y-auto pt-24 pb-12 animate-in fade-in slide-in-from-right duration-300"
	>
		<div class="px-6 space-y-10">
			<div class="flex flex-col gap-10">
				<div>
					<a
						href="/admin/register"
						class="mb-4 flex items-center justify-center gap-3 w-full py-5 bg-emerald-600 text-white text-center rounded-3xl font-black text-sm uppercase tracking-widest shadow-2xl shadow-emerald-500/40 active:scale-[0.98] transition-all"
					>
						Crea tu menú gratis <Zap className="w-4 h-4" />
					</a>
					<div class="grid grid-cols-1 gap-1">
						{
							[...platformLinks, ...nicheLinks].map((item) => (
								<a
									href={item.href}
									class="flex items-center gap-4 py-3.5 px-4 rounded-2xl hover:bg-emerald-50 active:bg-emerald-100 transition-colors"
								>
									<div class="w-10 h-10 bg-slate-50 rounded-xl flex items-center justify-center text-slate-400">
										<Zap className="w-5 h-5" />
									</div>
									<div class="flex flex-col">
										<span class="text-sm font-black text-slate-900">
											{item.name}
										</span>
										<span class="text-[11px] text-slate-500">
											{item.description}
										</span>
									</div>
								</a>
							))
						}
					</div>
					<div>
						<h3
							class="text-[10px] font-black text-emerald-600 uppercase tracking-[0.2em] mb-6 border-b border-emerald-100 pb-2"
						>
							Herramientas y Recursos
						</h3>
						<div class="grid grid-cols-2 gap-3">
							{
								[...toolLinks, ...exploreLinks].map((item) => (
									<a
										href={item.href}
										class="flex flex-col justify-center items-center py-6 px-4 rounded-2xl bg-slate-50 text-slate-900 border border-slate-100 text-center"
									>
										<Zap className="w-5 h-5 text-emerald-600 mb-3" />
										<span class="text-[11px] font-black uppercase leading-tight">
											{item.name}
										</span>
									</a>
								))
							}
						</div>
					</div>
				</div>
			</div>

			<div class="px-6 mt-16">
				<div class="mt-8 text-center">
					<p
						class="text-[10px] text-slate-400 font-bold uppercase tracking-[0.3em]"
					>
						BySMax Menús IA
					</p>
				</div>
			</div>
		</div>
	</div>

	<script>
		const setupMenu = () => {
			// Casting de tipos para evitar el error ts(18047)
			const menuButton = document.getElementById(
				"menuButton",
			) as HTMLButtonElement | null;
			const mobileNav = document.getElementById(
				"mobileNav",
			) as HTMLElement | null;
			const menuIcon = document.getElementById(
				"menuIcon",
			) as HTMLElement | null;
			const closeIcon = document.getElementById(
				"closeIcon",
			) as HTMLElement | null;

			if (!menuButton || !mobileNav || !menuIcon || !closeIcon) return;

			const toggleMenu = () => {
				const isHidden = mobileNav.classList.contains("hidden");
				if (isHidden) {
					mobileNav.classList.remove("hidden");
					menuIcon.classList.add("hidden");
					closeIcon.classList.remove("hidden");
					document.body.style.overflow = "hidden";
				} else {
					mobileNav.classList.add("hidden");
					menuIcon.classList.remove("hidden");
					closeIcon.classList.add("hidden");
					document.body.style.overflow = "";
				}
			};

			menuButton.addEventListener("click", toggleMenu);
		};

		setupMenu();
		document.addEventListener("astro:page-load", setupMenu);
	</script>

	<style>
		.xs\:hidden {
			display: block;
		}
		@media (min-width: 400px) {
			.xs\:hidden {
				display: none;
			}
			.xs\:inline {
				display: inline;
			}
		}
		@media (max-width: 399px) {
			.xs\:inline {
				display: none;
			}
		}
	</style>
</header>
