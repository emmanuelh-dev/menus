---
import QRGenerator from "../components/QRGenerator.tsx";
import { QrCode, Check, Zap, Shield, Palette } from "lucide-react";
import DefaultLayout from "../layouts/DefaultLayout.astro";

const seoData = {
	title: "Generador de Código QR para Menú de Restaurante Gratis | BySMax",
	description:
		"Crea códigos QR para la carta de tu restaurante gratis. Personaliza colores, sin registro y descarga en alta calidad. El mejor generador de QR para menú digital.",
	keywords:
		"generador de menu qr, crear qr carta restaurante, hacer qr carta restaurante, código qr menú restaurante, carta con codigo qr, generar qr gratis",
};

const qrSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Generador QR BySMax",
	operatingSystem: "Web",
	applicationCategory: "BusinessApplication",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "MXN",
	},
	description: seoData.description,
};
---

<DefaultLayout
	title={seoData.title}
	description={seoData.description}
	keywords={seoData.keywords}
	showAds={false}
	schema={qrSchema}
>
	<div>
		<main class="flex-1 bg-neutral-50">
			<!-- Hero & Tool -->
			<section class="py-20 md:py-24">
				<div class="max-w-5xl mx-auto px-6 text-center">
					<div
						class="inline-flex items-center justify-center p-3 bg-white text-neutral-900 rounded-2xl shadow-sm mb-8 border border-neutral-100"
					>
						<QrCode className="w-6 h-6 mr-2" />
						<span class="font-bold">Generador QR 100% Gratis</span>
					</div>

					<h1
						class="text-4xl md:text-5xl font-bold text-neutral-900 mb-6 tracking-tight"
					>
						Crea tu Código QR <br />
						<span class="text-marca-600">Personalizado</span>
					</h1>
					<p
						class="text-lg text-neutral-600 mb-12 max-w-2xl mx-auto leading-relaxed"
					>
						Sin registro, sin límites de escaneos y sin caducidad. Introduce tu
						enlace, personaliza el estilo y descarga.
					</p>

					<!-- React Component Wrapper -->
					<div class="max-w-4xl mx-auto mb-20 text-left">
						<QRGenerator client:load />
					</div>

					<!-- Features -->
					<div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
						<div
							class="bg-white p-8 rounded-3xl border border-neutral-100 shadow-sm hover:shadow-md transition-shadow"
						>
							<div
								class="w-12 h-12 bg-marca-50 text-marca-600 rounded-xl flex items-center justify-center mb-6"
							>
								<Zap className="w-6 h-6" />
							</div>
							<h3 class="font-bold text-neutral-900 mb-3 text-lg">
								Para Siempre
							</h3>
							<p class="text-neutral-500 text-sm leading-relaxed">
								Tu código QR nunca caduca. Úsalo todo el tiempo que quieras
								totalmente gratis, sin suscripciones ni costos ocultos.
							</p>
						</div>
						<div
							class="bg-white p-8 rounded-3xl border border-neutral-100 shadow-sm hover:shadow-md transition-shadow"
						>
							<div
								class="w-12 h-12 bg-neutral-50 text-neutral-600 rounded-xl flex items-center justify-center mb-6"
							>
								<Shield className="w-6 h-6" />
							</div>
							<h3 class="font-bold text-neutral-900 mb-3 text-lg">
								Alta Calidad
							</h3>
							<p class="text-neutral-500 text-sm leading-relaxed">
								Descarga en formato PNG de alta resolución. Perfecto para
								imprimir en gran formato, menús de mesa o escaparates.
							</p>
						</div>
						<div
							class="bg-white p-8 rounded-3xl border border-neutral-100 shadow-sm hover:shadow-md transition-shadow"
						>
							<div
								class="w-12 h-12 bg-neutral-50 text-neutral-600 rounded-xl flex items-center justify-center mb-6"
							>
								<Palette className="w-6 h-6" />
							</div>
							<h3 class="font-bold text-neutral-900 mb-3 text-lg">
								Personalizable
							</h3>
							<p class="text-neutral-500 text-sm leading-relaxed">
								Ajusta los colores para que coincidan con la identidad visual de
								tu marca. ¡Haz que tu QR destaque!
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- SEO Content & Guide -->
			<section class="py-24 bg-white border-t border-neutral-100">
				<div class="max-w-4xl mx-auto px-6">
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
						<div>
							<h2 class="text-3xl font-black text-neutral-900 mb-8">
								Cómo usar el generador QR
							</h2>
							<div class="space-y-8">
								<div class="flex gap-4">
									<div
										class="flex-shrink-0 w-8 h-8 bg-marca-600 text-white rounded-full flex items-center justify-center font-bold text-sm"
									>
										1
									</div>
									<div>
										<h4 class="font-bold text-neutral-900 mb-1">
											Ingresa el enlace
										</h4>
										<p class="text-neutral-500 text-sm">
											Pega la URL de tu menú digital o sitio web en el campo de
											texto.
										</p>
									</div>
								</div>
								<div class="flex gap-4">
									<div
										class="flex-shrink-0 w-8 h-8 bg-marca-600 text-white rounded-full flex items-center justify-center font-bold text-sm"
									>
										2
									</div>
									<div>
										<h4 class="font-bold text-neutral-900 mb-1">
											Elige tus colores
										</h4>
										<p class="text-neutral-500 text-sm">
											Personaliza el color del código y del fondo para que
											combine con tu negocio.
										</p>
									</div>
								</div>
								<div class="flex gap-4">
									<div
										class="flex-shrink-0 w-8 h-8 bg-marca-600 text-white rounded-full flex items-center justify-center font-bold text-sm"
									>
										3
									</div>
									<div>
										<h4 class="font-bold text-neutral-900 mb-1">
											Descarga y usa
										</h4>
										<p class="text-neutral-500 text-sm">
											Haz clic en descargar y coloca tu código QR donde tus
											clientes puedan verlo.
										</p>
									</div>
								</div>
							</div>
						</div>

						<div class="bg-neutral-50 p-8 rounded-[32px] border border-neutral-100">
							<h3 class="text-xl font-bold text-neutral-900 mb-6">
								Preguntas Frecuentes
							</h3>
							<div class="space-y-6">
								<div>
									<h4 class="font-bold text-sm text-neutral-900 mb-2">
										¿Es realmente gratis?
									</h4>
									<p class="text-xs text-neutral-500">
										Sí, no pedimos registro ni tarjeta. Generas, descargas y
										listo.
									</p>
								</div>
								<div>
									<h4 class="font-bold text-sm text-neutral-900 mb-2">
										¿Los códigos caducan?
									</h4>
									<p class="text-xs text-neutral-500">
										No. Son códigos QR estáticos que duran para siempre.
									</p>
								</div>
								<div>
									<h4 class="font-bold text-sm text-neutral-900 mb-2">
										¿Necesito un menú digital?
									</h4>
									<p class="text-xs text-neutral-500">
										Si aún no tienes uno, puedes <a
											href="/crear-menu-digital"
											class="text-marca-600 font-bold"
											>crear tu menú digital aquí</a
										> gratis.
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Final CTA -->
			<section class="py-24 bg-marca-600">
				<div class="max-w-4xl mx-auto px-6 text-center">
					<h2 class="text-3xl font-black text-white mb-6">
						¿Quieres ir más allá de un simple QR?
					</h2>
					<p class="text-marca-100 mb-10 text-lg">
						Obtén un menú digital interactivo con pedidos por WhatsApp, gestión
						de inventario y mucho más.
					</p>
					<a
						href="/admin/register"
						class="inline-flex items-center px-8 py-4 bg-white text-marca-600 font-bold rounded-2xl hover:bg-marca-50 transition-all shadow-xl"
					>
						Crear Menú Digital Gratis
					</a>
				</div>
			</section>
		</main>
	</div>
</DefaultLayout>
