---
export const prerender = false;

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=31536000, stale-while-revalidate=86400",
);
Astro.response.headers.set("Vercel-Cache-Tag", "places-all");

import DefaultLayout from "../../../../layouts/DefaultLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import { getRestaurants, getStates } from "../../../../lib/api";
import { Image } from "astro:assets";

const { state } = Astro.params;
const states = await getStates();
const currentState = states.find((s) => s.slug === state);

if (!currentState) {
  return Astro.redirect("/tienda");
}

const allPlaces = await getRestaurants({ type: "restaurant", state_id: currentState.id });
const stores = allPlaces.filter((place: any) => {
  const template = place?.content?.view_settings?.template;
  return place.short_name && template === "tienda";
});

const seoTitle = `Tiendas Digitales en ${currentState.name} | BySMax`;
const seoDescription = `Explora ${stores.length} tiendas digitales en ${currentState.name} publicadas con BySMax.`;
---

<DefaultLayout title={seoTitle} description={seoDescription} showAds={false}>
  <main class="max-w-6xl mx-auto px-6 py-10">
    <Breadcrumbs
      items={[
        { label: "Inicio", href: "/tienda" },
        { label: "Tienda", href: "/tienda" },
        { label: currentState.name },
      ]}
    />

    <header class="mt-8 mb-8">
      <h1 class="text-3xl md:text-4xl font-black text-neutral-900">Tiendas en {currentState.name}</h1>
      <p class="text-sm text-neutral-600 mt-2">{stores.length} tiendas encontradas.</p>
    </header>

    {stores.length === 0 ? (
      <div class="bg-neutral-50 border border-neutral-200 rounded-2xl p-8 text-center">
        <p class="text-sm font-bold text-neutral-600">Aún no hay tiendas publicadas en este estado.</p>
      </div>
    ) : (
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {stores.map((store: any) => (
          <a href={`/tienda/estados/${state}/${store.short_name}`} class="block bg-white border border-neutral-200 rounded-2xl overflow-hidden hover:border-neutral-400 transition-all">
            <div class="aspect-square bg-neutral-100">
              {store.image ? (
                <Image src={store.image} alt={store.name} width={500} height={500} class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <div class="w-full h-full bg-neutral-100" />
              )}
            </div>
            <div class="p-3">
              <p class="text-sm font-black text-neutral-900 line-clamp-2">{store.name}</p>
              {store.address && <p class="text-xs text-neutral-500 mt-1 line-clamp-1">{store.address}</p>}
            </div>
          </a>
        ))}
      </div>
    )}
  </main>
</DefaultLayout>
