---
export const prerender = false;

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=300, stale-while-revalidate=60",
);

const { name } = Astro.params;

import RestaurantLayout from "../../../layouts/RestaurantLayout.astro";
import Gallery from "../../../components/Gallery.astro";
import { Image } from "astro:assets";
import { supabase } from "../../../lib/supabase";
import CartManager from "../../../components/CartManager.tsx";
import FavoritesManager from "../../../components/FavoritesManager.tsx";
import Carousel from "../../../components/Carousel.tsx";

if (!name) {
	throw new Error("No se ha especificado el nombre del restaurante");
}
const { data: place } = await supabase
	.from("places")
	.select("*")
	.eq("short_name", name)
	.single();

if (!place) {
	throw new Error(`No se encontró el restaurante: ${name}`);
}

let { blocks = [], view_settings = {} } = place.content || {};
const enableCart = place.content?.semantic_data?.enable_cart || false;
const whatsappNumber = place.content?.semantic_data?.whatsapp || "";

// Limpieza de bloques
blocks = blocks.map((block) => {
	if (block.type === "gallery" && block.data.images) {
		const imagesWithAlt = block.data.images.map((img, idx) => ({
			...img,
			alt: img.alt || `${place.name} - Galería ${idx + 1}`,
		}));
		return { ...block, data: { ...block.data, images: imagesWithAlt } };
	}
	return block;
});

const address = place.content?.semantic_data?.address || place.address || "";
const mapsSearchQuery = encodeURIComponent(`${place.name} ${address || ""}`);
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsSearchQuery}`;

// Find first carousel block for hero
const heroCarousel = blocks.find((block) => block.type === "carrusel");
---

<RestaurantLayout
	description={place?.content?.semantic_data?.description ||
		place?.description ||
		place.name}
	title={place.name}
	place={place}
	backgroundColor="bg-[#FCFCFC]"
>
	<div class="min-h-screen bg-[#FCFCFC] text-[#1A1A1A]">
		{/* Hero Section with Carousel or Image */}
		<div class="relative h-[60vh] min-h-[400px] overflow-hidden bg-stone-900">
			{
				heroCarousel && heroCarousel.data.items?.length > 0 ? (
					<div class="absolute inset-0">
						<Carousel client:load items={heroCarousel.data.items} />
					</div>
				) : place.image?.trim() ? (
					<Image
						src={place.image}
						alt={`${place.name} - ${place.content?.semantic_data?.description || place.description || "Restaurante"}`}
						width={1200}
						height={800}
						class="w-full h-full object-cover"
						loading="eager"
						format="webp"
					/>
				) : null
			}
			<div
				class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent pointer-events-none"
			>
			</div>

			<div class="absolute inset-0 flex flex-col justify-end p-6 md:p-12">
				<div class="max-w-4xl mx-auto w-full text-center">
					<h1
						class="text-4xl md:text-6xl font-bold text-white mb-3 serif italic drop-shadow-lg"
					>
						{place.name}
					</h1>
					<p class="text-lg md:text-xl text-white/90 mb-2">
						{
							place?.content?.semantic_data?.description ||
								place?.description ||
								place.name
						}
					</p>
					{
						address && (
							<a
								href={googleMapsUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="flex items-center justify-center gap-2 text-white/80 text-sm md:text-base hover:text-white transition-colors"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="w-4 h-4"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
									/>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
									/>
								</svg>
								<span class="underline decoration-white/20 underline-offset-4">
									{address}
								</span>
							</a>
						)
					}
				</div>
			</div>
		</div>

		<div class="max-w-2xl mx-auto px-6 mt-4">
			{/* Info compacta en una sola línea de chips */}
			{
				place.content?.semantic_data && (
					<section class="mb-8" aria-label="Información del restaurante">
						<div class="flex flex-wrap justify-center gap-2 text-xs text-stone-600">
							{place.content.semantic_data.phone && (
								<a
									href={`tel:${place.content.semantic_data.phone}`}
									class="inline-flex items-center gap-1.5 px-3 py-2 bg-red-500 hover:bg-red-600 text-white rounded-full text-xs font-bold transition-all"
									aria-label={`Llamar a ${place.name} al teléfono ${place.content.semantic_data.phone}`}
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="w-4 h-4"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
										/>
									</svg>
									Llamar
								</a>
							)}

							{place.content.semantic_data.whatsapp && (
								<a
									href={`https://wa.me/${place.content.semantic_data.whatsapp.replace(/\D/g, "")}?text=${encodeURIComponent(`Hola, me gustaría hacer una reservación en ${place.name}`)}`}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1.5 px-3 py-2 bg-green-500 hover:bg-green-600 text-white rounded-full text-xs font-bold transition-all"
									aria-label={`Enviar mensaje de WhatsApp a ${place.name}`}
								>
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
										<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
									</svg>
									WhatsApp
								</a>
							)}

							{address && (
								<a
									href={googleMapsUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1.5 px-3 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-full text-xs font-bold transition-all"
									aria-label={`Ver ubicación de ${place.name} en Google Maps: ${address}`}
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="w-4 h-4"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
										/>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
										/>
									</svg>
									Ubicación
								</a>
							)}
							{place.content.semantic_data.hours && (
								<span class="inline-flex items-center gap-1 px-3 py-1.5 bg-stone-100 rounded-full">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="w-3.5 h-3.5"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
										/>
									</svg>
									<span class="font-medium">
										{place.content.semantic_data.hours}
									</span>
								</span>
							)}

							{place.content.semantic_data.price_range && (
								<span class="inline-flex items-center gap-1 px-3 py-1.5 bg-stone-100 rounded-full">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="w-3.5 h-3.5"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
										/>
									</svg>
									<span class="font-medium">
										{place.content.semantic_data.price_range}
									</span>
								</span>
							)}

							{place.content.semantic_data.parking && (
								<span class="inline-flex items-center gap-1 px-3 py-1.5 bg-stone-100 rounded-full">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="w-3.5 h-3.5"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"
										/>
									</svg>
									<span class="font-medium">
										{place.content.semantic_data.parking}
									</span>
								</span>
							)}

							{place.content.semantic_data.payment_options &&
								place.content.semantic_data.payment_options.length > 0 && (
									<>
										{place.content.semantic_data.payment_options.map(
											(payment) => (
												<span class="inline-flex items-center gap-1 px-3 py-1.5 bg-stone-100 rounded-full">
													{payment.toLowerCase().includes("efectivo") && "💵"}
													{payment.toLowerCase().includes("tarjeta") && "💳"}
													{payment.toLowerCase().includes("transferencia") &&
														"🏦"}
													<span class="font-medium">{payment}</span>
												</span>
											),
										)}
									</>
								)}
						</div>
					</section>
				)
			}

			{/* Favorites Manager - Always visible */}
			<FavoritesManager client:load placeSlug={name} blocks={blocks} />

			{/* Cart Manager - Only when enabled */}
			{
				enableCart && whatsappNumber && (
					<CartManager
						client:load
						placeName={place.name}
						placeSlug={name}
						whatsappNumber={whatsappNumber}
						blocks={blocks}
					/>
				)
			}

			{/* Menú con Acordeón Nativo y Lógica de Apertura */}
			<div class="space-y-8">
				{
					(() => {
						let sectionCounter = 0;
						return blocks.map((block) => {
							if (block.type === "section") {
								const isOpen = sectionCounter < 2;
								sectionCounter++;

								return (
									<details
										class="group border-b border-stone-100 pb-4"
										open={isOpen}
									>
										<summary class="flex justify-between items-center cursor-pointer list-none sticky top-0 bg-[#FCFCFC]/95 backdrop-blur-md z-10 py-6 outline-none">
											<h2 class="text-xl uppercase tracking-[0.3em] font-black text-stone-800 transition-all group-open:text-red-900">
												{block.data.title}
											</h2>
											<div class="text-black transition-transform duration-300 group-open:rotate-180">
												<svg
													xmlns="http://www.w3.org/2000/svg"
													class="h-5 w-5"
													fill="none"
													viewBox="0 0 24 24"
													stroke="currentColor"
												>
													<path
														stroke-linecap="round"
														stroke-linejoin="round"
														stroke-width="2"
														d="M19 9l-7 7-7-7"
													/>
												</svg>
											</div>
										</summary>

										<div class="space-y-12 pt-8 animate-in fade-in slide-in-from-top-2 duration-500 overflow-hidden">
											{block.data.description && (
												<p class="text-stone-400 text-sm font-light italic mb-8 border-l-2 border-red-50 px-4">
													{block.data.description}
												</p>
											)}

											{block.data.items?.map((item) => (
												<div class="space-y-4" data-item-id={item.id}>
													<div class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-x-8 items-start group/item">
														<div class="order-2 sm:order-1">
															<div class="flex justify-between items-baseline mb-1">
																<h3 class="text-lg font-medium tracking-tight group-hover/item:text-red-900 transition-colors">
																	{item.name}
																</h3>
																<span class="text-sm font-light text-stone-400 ml-4">
																	{view_settings.show_prices &&
																		item.price > 0 &&
																		`$${item.price}`}
																</span>
															</div>
															{item.description && (
																<p class="text-stone-400 text-sm font-light leading-relaxed">
																	{item.description}
																</p>
															)}
															{enableCart &&
																whatsappNumber &&
																item.price > 0 && (
																	<div class="flex gap-2 mt-3">
																		<button
																			class="cart-add-btn flex-1 px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-bold rounded-lg transition-colors"
																			data-item={JSON.stringify({
																				id: item.id,
																				name: item.name,
																				price: item.price,
																				image: item.image,
																			})}
																		>
																			Agregar
																		</button>
																		<button
																			class="favorite-btn p-2 border border-stone-300 hover:border-red-500 rounded-lg transition-colors"
																			data-item={JSON.stringify({
																				id: item.id,
																				name: item.name,
																				slug: name,
																			})}
																		>
																			<svg
																				xmlns="http://www.w3.org/2000/svg"
																				class="h-5 w-5 text-stone-400"
																				fill="none"
																				viewBox="0 0 24 24"
																				stroke="currentColor"
																			>
																				<path
																					stroke-linecap="round"
																					stroke-linejoin="round"
																					stroke-width="2"
																					d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
																				/>
																			</svg>
																		</button>
																	</div>
																)}
														</div>

														{item.image && item.image.trim() !== "" && (
															<div class="order-1 sm:order-2 mb-4 sm:mb-0 overflow-hidden rounded-lg">
																<Image
																	src={item.image}
																	alt={item.name}
																	width={96}
																	height={96}
																	class="w-full sm:w-24 h-48 sm:h-24 object-cover saturate-[0.8] group-hover/item:saturate-100 transition-all duration-500"
																	loading="lazy"
																	format="webp"
																/>
															</div>
														)}
													</div>

													{item.gallery && item.gallery.length > 0 && (
														<div class="mt-4">
															<Gallery images={item.gallery} />
														</div>
													)}
												</div>
											))}
										</div>
									</details>
								);
							}

							if (block.type === "gallery") {
								return (
									<div class="py-12">
										<Gallery images={block.data.images || []} />
									</div>
								);
							}

							if (block.type === "carrusel") {
								// Skip if this is the hero carousel
								if (heroCarousel && block === heroCarousel) {
									return null;
								}
								return (
									<div class="py-8">
										<Carousel client:load items={block.data.items || []} />
									</div>
								);
							}
						});
					})()
				}
			</div>

			<footer class="mt-32 pb-16 text-center border-t border-stone-100 pt-16">
				<p class="text-[10px] text-stone-300 uppercase tracking-widest">
					Potenciado por BYSMAX • {place.name}
				</p>
			</footer>
		</div>
	</div>
</RestaurantLayout>

<style>
	@import url("https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400;1,700&display=swap");
	.serif {
		font-family: "Playfair Display", serif;
	}

	/* Quita la flecha nativa de details en Safari/Chrome */
	summary::-webkit-details-marker {
		display: none;
	}
</style>
