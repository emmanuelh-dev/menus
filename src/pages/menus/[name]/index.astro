---
export const prerender = false;

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=31536000, stale-while-revalidate=86400",
);

const { name } = Astro.params;

if (!name) {
	throw new Error("No se ha especificado el nombre del restaurante");
}

const placeTag = `place-${name}`;
Astro.response.headers.set("Vercel-Cache-Tag", placeTag);

import MenuPageRenderer from "../../../components/templates/MenuPageRenderer.astro";
import { getRestaurantByName } from "../../../lib/api";
const [place] = await getRestaurantByName({ name });

if (!place) {
	throw new Error(`No se encontró el restaurante: ${name}`);
}
---

<MenuPageRenderer place={place} name={name} />
