---
export const prerender = false;
const {name} = Astro.params;

import RestaurantLayout from "../../../layouts/RestaurantLayout.astro";
import Gallery from "../../../components/Gallery.astro";
import WhatsappButton from "../../../components/WhatsappButton";
import CopyClabe from "../../../components/CopyClabe";
import {getRestaurantByName, supabase} from "../../../lib/supabase";

if (!name) {
  throw new Error("No se ha especificado el nombre del restaurante");
}
const { data: place } = await supabase
  .from("places")
  .select("*")
  .eq("short_name", name)
  .single();

const { blocks = [], view_settings = {} } = place.content || {};

const socialMedia = {
  instagram: { name: "antojitos_tauro", url: "#" },
  facebook: { name: "Antojitos Tauro", url: "#" },
};

const contactInfo = {
  whatsapp: "8180000000",
  clabes: [],
};
---
<RestaurantLayout 
  description={place.description}
  title={place.name}
  backgroundColor="bg-[#FCFCFC]"
>
  <div class="min-h-screen bg-[#FCFCFC] text-[#1A1A1A] selection:bg-red-50">
    <div class="max-w-2xl mx-auto px-6 py-20">
      
      {/* Header con Aire de Revista */}
      <header class="mb-24 flex flex-col items-center">
        <div class="relative mb-8">
           <img 
            src={place.image} 
            alt={place.name} 
            class="size-48 rounded-full transition-all duration-700 object-cover ring-1 ring-stone-200 ring-offset-4"
          />
        </div>
        <h1 class="text-5xl text-center font-light tracking-tighter serif italic mb-2">
          {place.name}
        </h1>
        <p class="text-[10px] uppercase tracking-[0.4em] text-stone-400 font-semibold mb-8">
          Mesa Tradicional • San Nicolás
        </p>
        
        <div class="h-[1px] w-12 bg-stone-200"></div>
      </header>

      {/* Menú Refinado */}
      <div class="space-y-24">
        {blocks.map((block) => {
          if (block.type === 'section') {
            return (
              <section class="relative">
                <div class="sticky top-0 bg-[#FCFCFC]/80 backdrop-blur-md z-10 py-4 border-b border-stone-100 tex-2xl">
                  <h2 class="text-2xl uppercase tracking-[0.3em] font-black text-stone-800">
                    {block.data.title}
                  </h2>
                </div>

                <div class="space-y-12">
                  {block.data.image && (
                    <img src={block.data.image} alt={block.data.title} class="mt-2 rounded-sm" />
                  )}                  
                  {block.data.description && (
                    <p class="text-stone-400 text-sm font-light mt-2">
                      {block.data.description}
                    </p>
                  )}
                  {block.data.items?.map((item) => (
                    <div class="group grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-x-8 items-start">
                      <div class="order-2 sm:order-1">
                        <div class="flex justify-between items-baseline mb-1">
                          <h3 class="text-lg font-medium tracking-tight group-hover:text-red-900 transition-colors">
                            {item.name}
                          </h3>
                          <span class="text-sm font-light text-stone-400 ml-4">
                            {view_settings.show_prices && `$${item.price}`}
                          </span>
                        </div>
                        {item.description && (
                          <p class="text-stone-400 text-sm font-light leading-relaxed">
                            {item.description}
                          </p>
                        )}
                      </div>
                      
                      {item.image && (
                        <div class="order-1 sm:order-2 mb-4 sm:mb-0 overflow-hidden rounded-sm">
                          <img 
                            src={item.image} 
                            alt={item.name}
                            class="w-full sm:w-20 h-40 sm:h-20 object-cover saturate-[0.8] hover:saturate-100 transition-all duration-500 scale-100 group-hover:scale-105"
                          />
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </section>
            );
          }


          if (block.type === 'gallery') {
            return (
              <Gallery 
                images={block.data.images || []} 
                buttonClasses="inline-block font-oswald bg-red-900 text-white text-3xl font-black uppercase py-2 px-8 mb-6 relative after:content-[''] after:absolute after:right-[-15px] after:top-0 after:bottom-0 after:w-[30px] after:bg-red-900 after:skew-x-[20deg] after:-z-10" 
              />
            );
          }
        })}
      </div>

      <footer class="mt-32 pb-16 text-center">
        <p class="text-[10px] text-stone-300 uppercase tracking-widest">
          {place.name} • 2026
        </p>
      </footer>
    </div>
  </div>
</RestaurantLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400;1,700&display=swap');
  .serif { font-family: 'Playfair Display', serif; }
</style>