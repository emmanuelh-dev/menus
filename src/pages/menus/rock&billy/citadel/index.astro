---
export const prerender = false;

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=300, stale-while-revalidate=60",
);


import MenuPageRenderer from "../../../../components/templates/MenuPageRenderer.astro";
import { getRestaurantByName } from "../../../../lib/api";
const [place] = await getRestaurantByName({ name: "rock&billy" });
const placeTag = `place-${place.name}`;
Astro.response.headers.set("Vercel-Cache-Tag", placeTag);

if (!place) {
	throw new Error(`No se encontró el restaurante: ${place.name}`);
}
---

<MenuPageRenderer place={place} name={place.name} />
