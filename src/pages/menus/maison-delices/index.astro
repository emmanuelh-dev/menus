---


import RecommendationButton from "../../../components/RecommendationButton";
import RestaurantLayout from "../../../layouts/RestaurantLayout.astro";
import CategoryNavigation from "../../../components/CategoryNavigation";
import ImageModal from "../../../components/ImageModal.astro";
import { supabase } from "../../../lib/supabase";
import { menu } from "./menu";

const { data: restaurant } = await supabase
  .from("restaurants")
  .select("*")
  .eq("menu", 'maison-delices')
  .single();

const { data: menu_data } = await supabase
  .from("menus")
  .select("*")
  .eq("restaurant_id", restaurant?.id)
  .eq("is_active", true)
  .single();

const { data: categoriesData } = await supabase
  .from("menu_categories")
  .select(`
    *,
    menu_items (
      *
    )
  `)
  .eq("restaurant_id", restaurant.id)
  .eq("is_active", true)
  .order("display_order");

const categoryColors = [
  "text-blue-400",
  "text-orange-500", 
  "text-cyan-400",
  "text-red-500",
  "text-purple-500",
  "text-green-400",
  "text-pink-400",
  "text-yellow-500",
  "text-indigo-500",
  "text-teal-500"
];

const menuItems = categoriesData?.flatMap((category, categoryIndex) => {
  const categoryItem = {
    id: `category-${category.id}`,
    name: category.name.toUpperCase(),
    category: true,
    color: categoryColors[categoryIndex % categoryColors.length],
    description: category.description,
    image: category.image
  };

  const items = category.menu_items
    ?.filter((item: any) => item.is_active)
    ?.sort((a: any, b: any) => a.display_order - b.display_order)
    ?.map((item: any) => ({
      name: item.name,
      price: item.base_price,
      color: "text-white",
      description: item.description,
      category: false,
      is_vegetarian: item.is_vegetarian,
      is_vegan: item.is_vegan,
      is_gluten_free: item.is_gluten_free,
      is_spicy: item.is_spicy,
      allergens: item.allergens,
      ingredients: item.ingredients,
      weight: item.weight,
      image: item.image
    })) || [];

  return [categoryItem, ...items];
}) || [];

// Crear lista de categorías para navegación
const navigationCategories = categoriesData?.map((category, categoryIndex) => ({
  id: `category-${category.id}`,
  name: category.name,
  color: categoryColors[categoryIndex % categoryColors.length],
  description: category.description
})) || [];

const restaurantData = {
  name: restaurant?.name || "Maison Délices",
  description: restaurant?.description || "Deliciosos postres y galletas artesanales",
};


const schemaEnrichment = {
    address: {
        streetAddress: restaurant?.address || "Av. del Roble 535",
        addressLocality: "San Pedro Garza García", 
        addressRegion: "N.L.",
        postalCode: "66266",
        addressCountry: "MX"
    },
    name: restaurant?.name || restaurantData.name,
    telephone: "+52 81 2702 8078",
    priceRange: restaurant?.priceRange || "$$",  
    servesCuisine: ["Bakery", "Desserts", "Coffee"],
    openingHours: restaurant?.hours || "09:00-21:00",
    acceptsReservations: false,
    paymentAccepted: ["Credit Card", "Cash"],
    currenciesAccepted: ["MXN"],
    aggregateRating: {
        ratingValue: restaurant?.rating || 4.8,
        reviewCount: 1
    },
    email: "",
    delivery: {
        available: true
    },
    socialMedia: {
        instagram: "@maisondelicesmx"
    }
};

---

<RestaurantLayout title={restaurantData.name} description={restaurantData.description}
    schemaEnrichment={schemaEnrichment} backgroundColor="bg-orange-50" textWhite={false}>

    <head>
        <!-- Fuente More Sugar para Maison Délices -->
        <link rel="stylesheet" href="/maison-delices/fonts.css">
        
    </head>

    <!-- Componentes de navegación -->
    <CategoryNavigation 
        client:load 
        categories={navigationCategories} 
        backgroundColor="bg-white" 
        textColor="text-[#A76633]" 
    />
    
    <!-- HEADER -->
    <div class="bg-gradient-to-br from-orange-50 to-white min-h-screen">
        <div class="max-w-3xl mx-auto px-4 py-8">
            <!-- Header del restaurante -->
            <div class="text-center mb-12">
                <div class="inline-flex items-center justify-center w-24 h-24 bg-orange-200 rounded-full mb-6">
                    <span class="text-3xl">🧁</span>
                </div>
                <h1 class="text-4xl md:text-5xl font-more-sugar text-[#A76633] mb-4">
                    {restaurantData.name}
                </h1>
                <p class="text-lg text-orange-600 max-w-2xl mx-auto">
                    {restaurantData.description}
                </p>
            </div>

            <!-- Menú -->
            <div class="space-y-16">
                {menuItems.map((item) => {
                    if (item.category) {
                        return (
                            <div id={item.id} class="scroll-mt-20">
                                <!-- Header de categoría -->
                                <div class="relative overflow-hidden rounded-full bg-[#A76633] mb-8">
                                    {item.image && (
                                        <div class="absolute inset-0">
                                            <img 
                                                src={item.image} 
                                                alt={item.name}
                                                class="w-full h-full object-cover opacity-30"
                                            />
                                            <div class="absolute inset-0 bg-orange-500/70"></div>
                                        </div>
                                    )}
                                    <div class="relative p-4 text-center">
                                        <h2 class="text-3xl md:text-4xl font-more-sugar text-white mb-4">
                                            {item.name}
                                        </h2>
                                        {item.description && (
                                            <p class="text-white text-lg max-w-2xl mx-auto">
                                                {item.description}
                                            </p>
                                        )}
                                    </div>
                                </div>
                            </div>
                        );
                    } else {
                        return (
                            <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden">
                                <div class="p-6">
                                    <div class="flex flex-col md:flex-row gap-6">
                                        <!-- Información del producto -->
                                        <div class="flex-1">
                                            <div class="flex items-start justify-between mb-3">
                                                <h3 class="text-xl font-more-sugar text-[#A76633] leading-tight">
                                                    {item.name}
                                                </h3>
                                                {item.price && (
                                                    <span class="text-2xl font-bold text-orange-600 ml-4 flex-shrink-0">
                                                        ${item.price}
                                                    </span>
                                                )}
                                            </div>
                                            
                                            {item.description && (
                                                <p class="text-gray-600 mb-3 leading-relaxed">
                                                    {item.weight && <span class="font-medium">{item.weight} </span>}
                                                    {item.description}
                                                </p>
                                            )}
                                            
                                            {item.ingredients && (
                                                <p class="text-sm text-gray-500 mb-3">
                                                    <span class="font-medium">Ingredientes:</span> {item.ingredients.join(", ")}
                                                </p>
                                            )}
                                            
                                            {item.allergens && item.allergens.length > 0 && (
                                                <p class="text-sm text-orange-600 mb-3">
                                                    <span class="font-medium">⚠️ Contiene:</span> {item.allergens.join(", ")}
                                                </p>
                                            )}
                                            
                                            {(item.is_vegetarian || item.is_vegan || item.is_gluten_free || item.is_spicy) && (
                                                <div class="flex gap-2 mt-3">
                                                    {item.is_vegetarian && (
                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800" title="Vegetariano">
                                                            🌱 Vegetariano
                                                        </span>
                                                    )}
                                                    {item.is_vegan && (
                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800" title="Vegano">
                                                            🌿 Vegano
                                                        </span>
                                                    )}
                                                    {item.is_gluten_free && (
                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800" title="Sin Gluten">
                                                            🚫🌾 Sin Gluten
                                                        </span>
                                                    )}
                                                    {item.is_spicy && (
                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800" title="Picante">
                                                            🌶️ Picante
                                                        </span>
                                                    )}
                                                </div>
                                            )}
                                        </div>
                                        
                                        <!-- Imagen del producto -->
                                        {item.image && (
                                            <div class="flex-shrink-0">
                                                <div class="item-image cursor-pointer group" data-image-title={item.name}>
                                                    <img 
                                                        src={item.image} 
                                                        alt={item.name}
                                                        class="w-32 h-32 md:w-40 md:h-40 object-cover rounded-lg group-hover:scale-105 transition-transform duration-300 shadow-md"
                                                    />
                                                    <p class="text-center mt-2 text-sm text-gray-600" data-image-title>{item.name}</p>
                                                </div>
                                            </div>
                                        )}
                                    </div>
                                </div>
                            </div>
                        );
                    }
                })}
            </div>
            
            <!-- Footer con información de contacto -->
            <div class="mt-16 bg-white rounded-xl shadow-md p-8">
                <div class="text-center">
                    <h3 class="text-2xl font-more-sugar text-[#A76633] mb-6">Pedidos</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto">
                        <div class="flex items-center justify-center gap-3">
                            <span class="text-2xl">📞</span>
                            <div>
                                <p class="font-semibold text-gray-800">81 2702 8078</p>
                                <p class="text-sm text-gray-600">81 1552 3451</p>
                            </div>
                        </div>
                        <div class="flex items-center justify-center gap-3">
                            <span class="text-2xl">📱</span>
                            <div>
                                <p class="font-semibold text-gray-800">@maisondelicesmx</p>
                                <p class="text-sm text-gray-600">Instagram</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-8 p-4 bg-orange-50 rounded-lg">
                        <p class="text-sm text-gray-600 leading-relaxed">
                            <strong>Importante:</strong> Una vez realizado el pedido no se podrán hacer cambios. 
                            Personas alérgicas favor de preguntar por ingredientes.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para imágenes -->
    <ImageModal id="maisonModal" />

    <script>
        function initMaisonDelices() {
            console.log('Iniciando Maison Délices');
            
            // Función para esperar a que createImageModal esté disponible
            const waitForImageModal = () => {
                if (typeof (window as any).createImageModal === 'function') {
                    console.log('✅ createImageModal disponible');
                    
                    // Crear instancia del modal
                    const imageModal = (window as any).createImageModal({ 
                        modalId: 'maisonModal'
                    });
                    
                    if (imageModal) {
                        // Adjuntar a las imágenes
                        imageModal.attachToElements('.item-image');
                        console.log('✅ Modal adjuntado a imágenes');
                    } else {
                        console.error('❌ Error al crear modal');
                    }
                } else {
                    console.log('⏳ Esperando createImageModal...');
                    setTimeout(waitForImageModal, 100);
                }
            };
            
            // Esperar un poco antes de intentar
            setTimeout(waitForImageModal, 500);
        }

        // Ejecutar cuando el DOM esté listo
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initMaisonDelices);
        } else {
            initMaisonDelices();
        }

        // También ejecutar en navegación de Astro
        document.addEventListener('astro:page-load', initMaisonDelices);
    </script>
</RestaurantLayout>
