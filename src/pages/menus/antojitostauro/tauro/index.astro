---
export const prerender = false;

import RestaurantLayout from "../../../../layouts/RestaurantLayout.astro";
import Gallery from "../../../../components/Gallery.astro";
import WhatsappButton from "../../../../components/WhatsappButton";
import CopyClabe from "../../../../components/CopyClabe";
import { supabase } from "../../../../lib/supabase";
import { Facebook, Instagram } from "lucide-react";

const { data: place } = await supabase
  .from("places")
  .select("*")
  .eq("short_name", 'antojitos-tauro-comida-mexicana')
  .single();

const { blocks = [], view_settings = {} } = place.content || {};

const socialMedia = {
  instagram: { name: "antojitos_tauro", url: "#" },
  facebook: { name: "Antojitos Tauro", url: "#" },
};

const contactInfo = {
  whatsapp: "8180000000",
  clabes: [],
};
---

<RestaurantLayout 
  title={place.name}
  description={`Menú de ${place.name} - Auténtica comida mexicana`}
  image={place.image}
  textWhite={false}
  backgroundColor="bg-stone-50"
>
  <div class="min-h-screen bg-stone-50 font-sans antialiased text-stone-900">
    <div class="max-w-3xl mx-auto px-6 py-12">
      
      {/* Header Minimalista */}
      <header class="flex flex-col items-center mb-16 text-center">
        <img 
          src={place.image} 
          alt={place.name} 
          class="w-32 h-32 rounded-full object-cover mb-6 shadow-sm border border-stone-200"
        />
        
        <h1 class="text-4xl font-bold tracking-tight text-stone-900 mb-2">
          {place.name}
        </h1>
        <p class="text-stone-500 text-sm mb-6 uppercase tracking-widest font-medium">Comida Mexicana Tradicional</p>

        <div class="flex gap-4">
          <a href={socialMedia.instagram.url} class="p-2 text-stone-600 hover:text-stone-900 transition-colors">
            <Instagram size={20} />
          </a>
          <a href={socialMedia.facebook.url} class="p-2 text-stone-600 hover:text-stone-900 transition-colors">
            <Facebook size={20} />
          </a>
        </div>

        {contactInfo.clabes.length > 0 && (
          <div class="mt-4">
            <CopyClabe client:load clabes={contactInfo.clabes}/>
          </div>
        )}
      </header>

      {/* Menú */}
      <div class="space-y-16">
        {blocks.map((block) => {
          if (block.type === 'section') {
            return (
              <section>
                <div class="mb-8 border-b border-stone-200 pb-2">
                  <h2 class="text-2xl font-bold text-stone-800 uppercase tracking-wider">
                    {block.data.title}
                  </h2>
                  {block.data.description && (
                    <p class="text-stone-500 text-sm mt-1 italic">
                      {block.data.description}
                    </p>
                  )}
                </div>

                <div class="grid gap-y-8">
                  {block.data.items?.map((item) => (
                    <div class="flex gap-6 group">
                      {item.image && (
                        <div class="flex-shrink-0">
                          <img 
                            src={item.image} 
                            alt={item.name}
                            class="w-24 h-24 object-cover rounded-lg bg-stone-200 shadow-sm"
                          />
                        </div>
                      )}
                      
                      <div class="flex-1">
                        <div class="flex justify-between items-baseline gap-4 mb-1">
                          <h3 class="text-lg font-semibold text-stone-900 group-hover:text-red-800 transition-colors">
                            {item.name}
                          </h3>
                          <div class="flex-1 border-b border-dotted border-stone-300 mx-2 hidden sm:block"></div>
                          {view_settings.show_prices && item.price > 0 && (
                            <span class="text-lg font-medium text-stone-900">
                              ${item.price}
                            </span>
                          )}
                        </div>
                        
                        {item.description && (
                          <p class="text-stone-500 text-sm leading-relaxed max-w-xl">
                            {item.description}
                          </p>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            );
          }
          
          if (block.type === 'gallery') {
            return (
              <div class="py-8">
                <h3 class="text-sm font-bold text-stone-400 uppercase tracking-[0.2em] mb-6 text-center">Nuestros Platos</h3>
                <Gallery images={block.data.images || []} />
              </div>
            );
          }
        })}
      </div>

      <footer class="mt-20 py-8 border-t border-stone-200 text-center">
        <p class="text-stone-400 text-xs tracking-widest uppercase">Hecho con estructura, no con adornos.</p>
      </footer>

      <WhatsappButton client:load phone={Number(contactInfo.whatsapp)} />
    </div>
  </div>
</RestaurantLayout>