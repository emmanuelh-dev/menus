---
export const prerender = false;

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=300, stale-while-revalidate=60",
);

import RestaurantLayout from "../../layouts/RestaurantLayout.astro";
import { ArrowRight } from "lucide-react";
import { getRestaurants } from "../../lib/supabase";
import { formater } from "../../types/app";
import { Image } from "astro:assets";

type Industry = "Todos" | "Restaurante" | "Café" | "Bar" | "Hotel";
type BusinessType = "Todos" | "Casual" | "Formal" | "Fast Food" | "Buffet";
type Capacity = "Todos" | "0-50" | "51-100" | "101-200" | "200+";

const industries: Industry[] = ["Todos", "Restaurante", "Café", "Bar", "Hotel"];
const types: BusinessType[] = [
	"Todos",
	"Casual",
	"Formal",
	"Fast Food",
	"Buffet",
];
const capacities: Capacity[] = ["Todos", "0-50", "51-100", "101-200", "200+"];

const restaurants = (await getRestaurants({ type: null })).filter(
	(r) => r.type !== "motel",
);

const seoData = {
	title: "Ejemplos de Menús Digitales y Cartas QR Reales | BySMax",
	description:
		"Inspírate con ejemplos reales de menús digitales y cartas QR. Mira cómo otros restaurantes han digitalizado su carta con éxito en México.",
	keywords:
		"ejemplos menu digital, ideas carta qr, ver menu qr online, catálogo digital restaurantes",
};
---

<RestaurantLayout
	title={seoData.title}
	description={seoData.description}
	backgroundColor="bg-gray-50"
>
	<div class="bg-gradient-to-b from-gray-50 to-white min-h-screen py-16">
		<div class="max-w-[85%] mx-auto">
			<h2
				class="text-4xl font-bold text-gray-900 mb-12 text-center bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-600"
			>
				Los restaurantes que usan nuestros menús.
			</h2>

			<div class="mb-8 flex flex-wrap gap-4 justify-center">
				<select
					id="industry-filter"
					class="px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-200"
				>
					{
						industries.map((industry) => (
							<option value={industry}>{industry}</option>
						))
					}
				</select>

				<select
					id="type-filter"
					class="px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-200"
				>
					{types.map((type) => <option value={type}>{type}</option>)}
				</select>

				<select
					id="sort-filter"
					class="px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-200"
				>
					<option value="popular">Más populares</option>
					<option value="recent">Más recientes</option>
					<option value="rating">Mejor calificados</option>
				</select>
			</div>

			<div
				id="restaurants-grid"
				class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 max-w-7xl mx-auto"
			>
				{
					restaurants.map((restaurant) => {
						const restaurantUrl = `/menus/${restaurant.short_name}`;
						const restaurantImage =
							restaurant.image && restaurant.image.trim() !== ""
								? restaurant.image
								: "https://menus.bysmax.com/images/landing/hero-free.png"; // Fallback a una imagen interna válida

						return (
							<div
								class="restaurant-card p-6 border border-gray-200 hover:border-gray-300 transition-all duration-300 bg-white shadow-sm hover:shadow-md"
								data-industry={restaurant.category || "Restaurante"}
								data-type={restaurant.type || "Casual"}
								data-rating={restaurant.rating || 0}
								data-reviews={restaurant.reviewCount || 0}
								data-created={restaurant.created_at || ""}
							>
								<div class="aspect-square relative overflow-hidden rounded-lg mb-6">
									{restaurant.short_name ? (
										<a href={restaurantUrl}>
											<Image
												src={restaurantImage}
												alt={restaurant.name}
												width={400}
												height={400}
												class="object-cover object-bottom w-full h-full transform group-hover:scale-105 transition-transform duration-300 cursor-pointer"
											/>
										</a>
									) : (
										<Image
											src={restaurantImage}
											alt={restaurant.name}
											width={400}
											height={400}
											class="object-cover object-bottom w-full h-full transform group-hover:scale-105 transition-transform duration-300"
										/>
									)}
								</div>
								<h2 class="text-xl font-semibold text-gray-800 mb-2">
									<a href={restaurantUrl}>{restaurant.name}</a>
								</h2>
								<div class="flex items-center gap-2 mb-2">
									<span class="text-amber-500 text-sm font-bold">
										★ {restaurant.rating}
									</span>
									<span class="text-gray-400 text-xs text-uppercase">
										({restaurant.reviewCount} reseñas)
									</span>
								</div>
								<p class="text-gray-600 text-sm">{restaurant.address}</p>
								<div class="mt-4 flex flex-wrap gap-2" />
								{restaurant.short_name && (
									<a href={restaurantUrl} class="group mt-4 block">
										<span class="flex items-center justify-between">
											Leer la historia completa
											<div class="p-1 rounded-full border border-gray-200 group-hover:border-gray-300 transition-all duration-300">
												<ArrowRight />
											</div>
										</span>
									</a>
								)}
							</div>
						);
					})
				}
			</div>
		</div>
	</div>
</RestaurantLayout>

<script>
	type FilterValue = string | null;

	interface HTMLElementWithDataset extends HTMLElement {
		dataset: {
			industry: string;
			type: string;
			capacity: string;
		};
	}

	class RestaurantFilter {
		private industryFilter: HTMLSelectElement;
		private typeFilter: HTMLSelectElement;
		private sortFilter: HTMLSelectElement;
		private grid: HTMLElement;

		constructor() {
			const industryElement = document.getElementById("industry-filter");
			const typeElement = document.getElementById("type-filter");
			const sortElement = document.getElementById("sort-filter");
			const gridElement = document.getElementById("restaurants-grid");

			if (!industryElement || !typeElement || !sortElement || !gridElement) {
				return;
			}

			this.industryFilter = industryElement as HTMLSelectElement;
			this.typeFilter = typeElement as HTMLSelectElement;
			this.sortFilter = sortElement as HTMLSelectElement;
			this.grid = gridElement;

			this.initializeEventListeners();
			// Initial sort
			this.filterAndSort();
		}

		private initializeEventListeners(): void {
			const filters = [this.industryFilter, this.typeFilter, this.sortFilter];
			filters.forEach((filter) => {
				filter.addEventListener("change", () => this.filterAndSort());
			});
		}

		private filterAndSort(): void {
			const industryValue = this.industryFilter.value;
			const typeValue = this.typeFilter.value;
			const sortValue = this.sortFilter.value;

			const cards = Array.from(
				document.querySelectorAll(".restaurant-card"),
			) as HTMLElement[];

			// Filter
			cards.forEach((card) => {
				const industry = card.dataset.industry || "Restaurante";
				const type = card.dataset.type || "Casual";

				const matchIndustry =
					industryValue === "Todos" || industry === industryValue;
				const matchType =
					typeValue === "Todos" ||
					(typeValue === "Casual" && type === "restaurant") ||
					type === typeValue;

				card.style.display = matchIndustry && matchType ? "block" : "none";
			});

			// Sort
			const visibleCards = cards.filter(
				(card) => card.style.display !== "none",
			);
			const hiddenCards = cards.filter((card) => card.style.display === "none");

			visibleCards.sort((a, b) => {
				if (sortValue === "recent") {
					const dateA = new Date(a.dataset.created || 0).getTime();
					const dateB = new Date(b.dataset.created || 0).getTime();
					return dateB - dateA;
				}
				if (sortValue === "rating") {
					return (
						parseFloat(b.dataset.rating || "0") -
						parseFloat(a.dataset.rating || "0")
					);
				}
				if (sortValue === "popular") {
					const scoreA =
						parseFloat(a.dataset.rating || "0") *
						parseInt(a.dataset.reviews || "0");
					const scoreB =
						parseFloat(b.dataset.rating || "0") *
						parseInt(b.dataset.reviews || "0");
					return scoreB - scoreA;
				}
				return 0;
			});

			// Re-append in order
			const allCardsInOrder = [...visibleCards, ...hiddenCards];
			allCardsInOrder.forEach((card) => this.grid.appendChild(card));
		}
	}

	document.addEventListener("DOMContentLoaded", () => {
		new RestaurantFilter();
	});
</script>
