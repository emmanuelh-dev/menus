---
import RestaurantLayout from "../../layouts/RestaurantLayout.astro";
import { ArrowRight, MapPin } from "lucide-react";
import { getStates, supabase } from "../../lib/supabase";
import { formater } from "../../types/app";
import { Image } from "astro:assets";

type Industry = "Todos" | "Restaurante" | "Café" | "Bar" | "Hotel";
type BusinessType = "Todos" | "Casual" | "Formal" | "Fast Food" | "Buffet";
type Capacity = "Todos" | "0-50" | "51-100" | "101-200" | "200+";

const industries: Industry[] = ["Todos", "Restaurante", "Café", "Bar", "Hotel"];
const types: BusinessType[] = [
	"Todos",
	"Casual",
	"Formal",
	"Fast Food",
	"Buffet",
];
const capacities: Capacity[] = ["Todos", "0-50", "51-100", "101-200", "200+"];

const pageSize = 9;
const searchParams = Astro.url.searchParams;
const currentPage = Math.max(1, Number(searchParams.get("page") || "1"));
const selectedIndustry = (searchParams.get("industry") || "Todos") as Industry;
const selectedType = (searchParams.get("type") || "Todos") as BusinessType;
const selectedSort = searchParams.get("sort") || "popular";

let restaurantsQuery = supabase
	.from("places")
	.select("*, states(*)", { count: "exact" })
	.neq("type", "motel");

if (selectedIndustry !== "Todos") {
	restaurantsQuery = restaurantsQuery.eq("category", selectedIndustry);
}

if (selectedType !== "Todos") {
	if (selectedType === "Casual") {
		restaurantsQuery = restaurantsQuery.eq("type", "restaurant");
	} else {
		restaurantsQuery = restaurantsQuery.eq("type", selectedType);
	}
}

if (selectedSort === "recent") {
	restaurantsQuery = restaurantsQuery.order("created_at", { ascending: false });
} else if (selectedSort === "rating") {
	restaurantsQuery = restaurantsQuery
		.order("rating", { ascending: false })
		.order("created_at", { ascending: false });
} else {
	restaurantsQuery = restaurantsQuery
		.order("rating", { ascending: false })
		.order("created_at", { ascending: false });
}

const from = (currentPage - 1) * pageSize;
const to = from + pageSize - 1;

restaurantsQuery = restaurantsQuery.range(from, to);

const [restaurantsResult, states] = await Promise.all([
	restaurantsQuery,
	getStates().then((list) =>
		list.filter((s) => s.total_places > 0 || s.slug === "nuevo-leon"),
	),
]);

let restaurantsData = restaurantsResult.data;
let totalRestaurants = restaurantsResult.count;

if (restaurantsResult.error) {
	console.error(
		"Error loading /menus with selected filters:",
		restaurantsResult.error,
	);

	const fallbackResult = await supabase
		.from("places")
		.select("*, states(*)", { count: "exact" })
		.neq("type", "motel")
		.order("created_at", { ascending: false })
		.range(from, to);

	restaurantsData = fallbackResult.data;
	totalRestaurants = fallbackResult.count;
}

const restaurants = (restaurantsData || []).map((place: any) => ({
	...place,
	state_slug: place.states?.slug || "nuevo-leon",
	rating: place.rating || 4.0,
	reviewCount: place.reviewCount || 0,
	priceRange: place.priceRange || "$$",
	address: place.address || "",
	hours: place.hours || "24 horas",
	amenities: place.amenities || [],
	specialties: place.specialties || [],
	destacado: place.featured,
}));

const totalPages = Math.max(1, Math.ceil((totalRestaurants || 0) / pageSize));
const safeCurrentPage = Math.min(currentPage, totalPages);
const summaryFrom = totalRestaurants ? (safeCurrentPage - 1) * pageSize + 1 : 0;
const summaryTo = totalRestaurants
	? Math.min(
			(safeCurrentPage - 1) * pageSize + restaurants.length,
			totalRestaurants,
		)
	: 0;

const buildQueryString = (page: number) => {
	const params = new URLSearchParams();
	params.set("page", String(page));
	params.set("industry", selectedIndustry);
	params.set("type", selectedType);
	params.set("sort", selectedSort);
	return `/menus?${params.toString()}`;
};

const getPageItems = (
	pages: number,
	current: number,
): Array<number | "ellipsis"> => {
	if (pages <= 7) {
		return Array.from({ length: pages }, (_, index) => index + 1);
	}

	const visiblePages = new Set<number>([
		1,
		pages,
		current,
		Math.max(1, current - 1),
		Math.min(pages, current + 1),
	]);

	const sorted = [...visiblePages].sort((a, b) => a - b);
	const result: Array<number | "ellipsis"> = [];

	sorted.forEach((value, index) => {
		const previous = sorted[index - 1];
		if (previous && value - previous > 1) {
			result.push("ellipsis");
		}
		result.push(value);
	});

	return result;
};

const pageItems = getPageItems(totalPages, safeCurrentPage);

const seoData = {
	title: "Ejemplos de Menús Digitales y Cartas QR Reales | BySMax",
	description:
		"Inspírate con ejemplos reales de menús digitales y cartas QR. Mira cómo otros restaurantes han digitalizado su carta con éxito en México.",
	keywords:
		"ejemplos menu digital, ideas carta qr, ver menu qr online, catálogo digital restaurantes",
};
---

<RestaurantLayout
	title={seoData.title}
	description={seoData.description}
	backgroundColor="bg-gray-50"
>
	<div class="bg-gradient-to-b from-gray-50 to-white min-h-screen py-16">
		<div class="max-w-[85%] mx-auto">
			<h2
				class="text-4xl font-bold text-gray-900 mb-12 text-center bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-600"
			>
				Los restaurantes que usan nuestros menús.
			</h2>

			<div class="mb-8 flex flex-wrap gap-4 justify-center">
				<form
					method="get"
					action="/menus"
					class="mb-8 flex flex-wrap gap-4 justify-center"
				>
					<select
						name="industry"
						class="px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-200"
					>
						{
							industries.map((industry) => (
								<option
									value={industry}
									selected={selectedIndustry === industry}
								>
									{industry}
								</option>
							))
						}
					</select>

					<select
						name="type"
						class="px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-200"
					>
						{
							types.map((type) => (
								<option value={type} selected={selectedType === type}>
									{type}
								</option>
							))
						}
					</select>

					<select
						name="sort"
						class="px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-200"
					>
						<option value="popular" selected={selectedSort === "popular"}
							>Más populares</option
						>
						<option value="recent" selected={selectedSort === "recent"}
							>Más recientes</option
						>
						<option value="rating" selected={selectedSort === "rating"}
							>Mejor calificados</option
						>
					</select>

					<button
						type="submit"
						class="px-4 py-2 border border-gray-900 bg-gray-900 text-white rounded-md text-sm font-bold hover:bg-black"
					>
						Aplicar
					</button>
				</form>
			</div>

			<div
				id="restaurants-grid"
				class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-3 sm:gap-6 max-w-7xl mx-auto"
			>
				{
					restaurants.map((restaurant) => {
						const restaurantUrl = `/menus/${restaurant.short_name}`;
						const restaurantImage =
							restaurant.image && restaurant.image.trim() !== ""
								? restaurant.image
								: "https://menus.bysmax.com/images/landing/hero-free.png"; // Fallback a una imagen interna válida

						return (
							<div
								class="restaurant-card p-3 sm:p-5 border border-gray-100 hover:border-gray-200 transition-all duration-300 bg-white shadow-sm hover:shadow-md rounded-xl flex flex-col justify-between"
								data-industry={restaurant.category || "Restaurante"}
								data-type={restaurant.type || "Casual"}
								data-rating={restaurant.rating || 0}
								data-reviews={restaurant.reviewCount || 0}
								data-created={restaurant.created_at || ""}
							>
								<div>
									<div class="aspect-square relative overflow-hidden rounded-lg mb-3 sm:mb-4">
										{restaurant.short_name ? (
											<a href={restaurantUrl}>
												<Image
													src={restaurantImage}
													alt={restaurant.name}
													width={400}
													height={400}
													class="object-cover object-bottom w-full h-full transform group-hover:scale-105 transition-transform duration-300 cursor-pointer"
												/>
											</a>
										) : (
											<Image
												src={restaurantImage}
												alt={restaurant.name}
												width={400}
												height={400}
												class="object-cover object-bottom w-full h-full transform group-hover:scale-105 transition-transform duration-300"
											/>
										)}
									</div>
									<h2 class="text-sm sm:text-lg md:text-xl font-bold text-gray-800 mb-1 sm:mb-1.5 line-clamp-1">
										<a href={restaurantUrl}>{restaurant.name}</a>
									</h2>
									<div class="flex items-center gap-1.5 mb-1.5">
										<span class="text-amber-500 text-xs sm:text-sm font-bold">
											★ {restaurant.rating}
										</span>
										<span class="text-gray-400 text-[10px] sm:text-xs">
											({restaurant.reviewCount} reseñas)
										</span>
									</div>
									<p class="text-gray-500 text-[11px] sm:text-xs md:text-sm line-clamp-1">
										{restaurant.address}
									</p>
								</div>

								{restaurant.short_name && (
									<a
										href={restaurantUrl}
										class="group mt-3 block text-xs sm:text-sm text-emerald-600 font-bold hover:text-emerald-700 transition-colors"
									>
										<span class="flex items-center justify-between">
											Ver Menú
											<div class="p-1 rounded-full border border-emerald-100 group-hover:border-emerald-200 bg-emerald-50/50 transition-all duration-300">
												<ArrowRight className="w-3.5 h-3.5" />
											</div>
										</span>
									</a>
								)}
							</div>
						);
					})
				}
			</div>

			<div
				id="pagination-controls"
				class="mt-10 flex flex-col items-center gap-4"
			>
				<div class="flex items-center gap-2">
					<a
						href={buildQueryString(Math.max(1, safeCurrentPage - 1))}
						class={`px-4 py-2 border border-gray-300 rounded-md text-sm font-bold text-gray-700 hover:bg-gray-50 ${safeCurrentPage <= 1 ? "pointer-events-none opacity-40" : ""}`}
					>
						Anterior
					</a>

					<div id="pagination-numbers" class="flex items-center gap-2">
						{
							pageItems.map((item) =>
								item === "ellipsis" ? (
									<span class="w-9 h-9 flex items-center justify-center text-gray-400 font-bold">
										…
									</span>
								) : (
									<a
										href={buildQueryString(item)}
										class={`w-9 h-9 rounded-md text-sm font-bold transition-colors flex items-center justify-center ${
											item === safeCurrentPage
												? "bg-gray-900 text-white"
												: "border border-gray-300 text-gray-700 hover:bg-gray-50"
										}`}
									>
										{item}
									</a>
								),
							)
						}
					</div>

					<a
						href={buildQueryString(Math.min(totalPages, safeCurrentPage + 1))}
						class={`px-4 py-2 border border-gray-300 rounded-md text-sm font-bold text-gray-700 hover:bg-gray-50 ${safeCurrentPage >= totalPages ? "pointer-events-none opacity-40" : ""}`}
					>
						Siguiente
					</a>
				</div>

				<p
					id="pagination-summary"
					class="text-xs font-bold uppercase tracking-widest text-gray-400"
				>
					{
						totalRestaurants
							? `Mostrando ${summaryFrom}-${summaryTo} de ${totalRestaurants}`
							: "Sin resultados"
					}
				</p>
			</div>

			<!-- Nueva sección: Menús por Estado -->
			<div class="mt-32 mb-16 px-4 md:px-0">
				<div
					class="flex items-end justify-between mb-10 pb-6 border-b border-gray-100 max-w-7xl mx-auto"
				>
					<div>
						<h2
							class="text-3xl font-black text-gray-900 tracking-tighter uppercase leading-none mb-2"
						>
							Explora por <span class="text-emerald-600">Estado</span>
						</h2>
						<p
							class="text-gray-400 text-sm font-bold uppercase tracking-widest leading-none"
						>
							Encuentra restaurantes cerca de ti
						</p>
					</div>
					<a
						href="/menus/estados"
						class="hidden md:flex items-center gap-2 text-emerald-600 font-bold uppercase tracking-widest text-xs hover:text-emerald-700 transition-colors"
					>
						Ver todos los estados
						<ArrowRight className="w-4 h-4" />
					</a>
				</div>

				<div
					class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-7xl mx-auto"
				>
					{
						states.slice(0, 8).map((state) => (
							<a
								href={`/menus/estados/${state.slug}`}
								class="group p-6 bg-white border border-gray-100 hover:border-emerald-200 rounded-[2rem] transition-all duration-300 hover:shadow-xl hover:shadow-emerald-900/5"
							>
								<div class="flex items-center justify-between mb-4">
									<div class="w-10 h-10 bg-emerald-50 rounded-xl flex items-center justify-center group-hover:bg-emerald-600 transition-colors duration-300">
										<MapPin className="w-5 h-5 text-emerald-600 group-hover:text-white transition-colors" />
									</div>
									<span class="text-2xl font-black text-gray-900 leading-none">
										{state.total_places}
									</span>
								</div>
								<h3 class="text-lg font-black text-gray-900 tracking-tighter uppercase group-hover:text-emerald-600 transition-colors">
									{state.name}
								</h3>
								<p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-1">
									Negocios Activos
								</p>
							</a>
						))
					}
				</div>

				{
					states.length > 8 && (
						<div class="text-center mt-12 md:hidden">
							<a
								href="/menus/estados"
								class="inline-flex items-center gap-2 px-8 py-3 bg-emerald-600 text-white rounded-full font-black uppercase tracking-widest text-xs shadow-lg shadow-emerald-900/20"
							>
								Ver todos los estados
							</a>
						</div>
					)
				}
			</div>
		</div>
	</div>
</RestaurantLayout>
