---
import { Image } from "astro:assets";
import logo from "./logo.jpg";
import RestaurantLayout from "../../../layouts/RestaurantLayout.astro";
import { Facebook, Instagram } from "lucide-react";
import menuImage from "./menu.jpg";
import CopyClabe from "../../../components/CopyClabe";
import { FaWhatsapp } from "react-icons/fa";
import WhatsappButton from "../../../components/WhatsappButton";
import RecommendationButton from "../../../components/RecommendationButton";
import { supabase } from "../../../lib/supabase";

const { data: restaurant } = await supabase
  .from("restaurants")
  .select("*")
  .eq("menu", 'elpapirey')
  .single();

const { data: menu } = await supabase
  .from("menus")
  .select("*")
  .eq("restaurant_id", restaurant?.id)
  .eq("is_active", true)

const { data: categoriesData } = await supabase
  .from("menu_categories")
  .select(`
    *,
    menu_items (
      *
    )
  `)
  .eq("restaurant_id", restaurant.id)
  .eq("is_active", true)
  .order("display_order");

const categoryColors = [
  "text-orange-500",
  "text-cyan-400", 
  "text-red-500",
  "text-purple-500",
  "text-green-400",
  "text-pink-400",
  "text-blue-500",
  "text-yellow-500",
  "text-indigo-500",
  "text-teal-500"
];

const menuItems = categoriesData?.flatMap((category, categoryIndex) => {
  const categoryItem = {
    name: category.name.toUpperCase(),
    category: true,
    color: categoryColors[categoryIndex % categoryColors.length],
    description: category.description
  };

  const items = category.menu_items
    ?.filter(item => item.is_active)
    ?.sort((a, b) => a.display_order - b.display_order)
    ?.map(item => ({
      name: item.name,
      price: item.base_price,
      color: "text-white",
      description: item.description,
      category: false,
      is_vegetarian: item.is_vegetarian,
      is_vegan: item.is_vegan,
      is_gluten_free: item.is_gluten_free,
      is_spicy: item.is_spicy,
      allergens: item.allergens,
      ingredients: item.ingredients
    })) || [];

  return [categoryItem, ...items];
}) || [];

const socialMedia = {
  instagram: {
    name: "Elpapi_rey_05",
    url: "https://instagram.com/Elpapi_rey_05",
  },
  facebook: {
    name: "EL papi rey",
    url: "https://www.facebook.com/profile.php?id=100090381744195",
  },
};

const contactInfo = {
  clabe: "722969020525470158",
  clabe2: "728969000034765417",
  beneficiary2: "Yazmin Ayala",
  bank2: "STP", // Nuevo banco
  delivery: "$25 - $35",
  hours: "Jueves a Martes de 6:30pm-12:30am",
  address: "Calzada Union #231, Talaverna Croc",
  whatsapp: "8133906548",
};

const restaurantData = {
  name: "El Papi Rey",
  description: "Hamburguesas, Hot Dogs y Antojitos Mexicanos",
};

const schemaEnrichment = {
  address: {
    streetAddress: "Calzada Union #231",
    addressLocality: "San Nicolás de los Garza",
    addressRegion: "N.L.",
    postalCode: "66473",
    addressCountry: "MX",
  },
  telephone: "+52 81 3390 6548",
  priceRange: "$",
  servesCuisine: [
    "Hamburguesas",
    "Hot Dogs",
    "Papas a la Francesa",
    "Tortas",
    "Tacos Dorados",
    "Salchipapas",
  ],
  openingHours: "Jueves a Martes 18:30-00:30",
  acceptsReservations: false,
  paymentAccepted: ["Cash", "Bank Transfer"],
  currenciesAccepted: ["MXN"],
  delivery: {
    available: true,
    cost: "25-35",
  },
  socialMedia: {
    instagram: "https://instagram.com/Elpapi_rey_05",
    facebook: "https://www.facebook.com/profile.php?id=100090381744195",
  },
};

---

<RestaurantLayout  title={restaurantData.name}
  description={restaurantData.name}
  schemaEnrichment={schemaEnrichment}
  image={restaurant?.image}
  favicon={logo.src}
  textWhite={true}
  backgroundColor="bg-black"
>
  <div
    class="min-h-screen bg-black flex items-center justify-center p-8 permanent-marker-regular text-xl"
  >
    <div class="w-full max-w-2xl bg-black  rounded-lg">
      <!-- Header with Logo and Social Media -->
      <div class="flex flex-col items-center mb-8">
        <div class="flex items-center gap-4 mb-4">
          <Image src={restaurant.image} alt="El Papi Rey Logo" width="500" height="500" class="w-full max-w-[500px]"/>
        </div>
        <div class="flex gap-4 text-white mb-4">
          <a href={socialMedia.instagram.url} class="flex items-center gap-2 font-bold">
            <Instagram className="text-pink-500" />
            {socialMedia.instagram.name}
          </a>
          <a href={socialMedia.facebook.url} class="flex items-center gap-2 font-bold">
            <Facebook className="text-blue-500" />
            {socialMedia.facebook.name}
          </a>
        </div>
        <h1
          class="sr-ony hidden text-orange-500 text-4xl font-bold text-center mb-2"
        >
          EL PAPI REY
        </h1>
        <p class="sr-ony hidden text-orange-500 text-xl">DEJATE CAYETANO</p>
      </div>
      <CopyClabe client:load clabes={[contactInfo.clabe, contactInfo.clabe2]}/>      <!-- Menu Items -->
      <div class="space-y-6 mb-8">
        {
          menuItems.map((item) => (
            <div class={`${item.category ? "mt-6" : "px-4"}`}>
              <div class="flex justify-between items-start">
                <div class="flex-1">
                  <div class="flex items-center gap-2">
                    <span
                      class={`${item.color} ${item.category ? "text-xl font-bold" : "text-lg"} font-medium tracking-wide`}
                    >
                      {item.name}
                    </span>
                    {!item.category && (
                      <div class="flex gap-1">
                        {item.is_vegetarian && (
                          <span class="text-green-400 text-xs" title="Vegetariano">🌱</span>
                        )}
                        {item.is_vegan && (
                          <span class="text-green-500 text-xs" title="Vegano">🌿</span>
                        )}
                        {item.is_gluten_free && (
                          <span class="text-blue-400 text-xs" title="Sin Gluten">🚫🌾</span>
                        )}
                        {item.is_spicy && (
                          <span class="text-red-400 text-xs" title="Picante">🌶️</span>
                        )}
                      </div>
                    )}
                  </div>
                  {!item.category && item.description && (
                    <p class="text-gray-400 text-sm mt-1">{item.description}</p>
                  )}
                  {item.category && item.description && (
                    <p class="text-gray-400 text-sm mt-1">{item.description}</p>
                  )}
                  {!item.category && item.ingredients && (
                    <p class="text-gray-500 text-xs mt-1">
                      Ingredientes: {item.ingredients.join(", ")}
                    </p>
                  )}
                  {!item.category && item.allergens && item.allergens.length > 0 && (
                    <p class="text-orange-400 text-xs mt-1">
                      ⚠️ Contiene: {item.allergens.join(", ")}
                    </p>
                  )}
                </div>
                <span class="text-yellow-400 text-xl font-bold ml-4">
                  {item.price ? `$${item.price}` : null}
                </span>
              </div>
            </div>
          ))
        }
      </div>

      {/* WhatsApp Floating Button */}
      <WhatsappButton client:load phone={Number(contactInfo.whatsapp)} />
      
      {/* AI Recommendation Button */}
      <RecommendationButton client:load menuItems={menuItems} menuText={null} restaurantName={restaurantData.name} />
    </div>
  </div>
</RestaurantLayout>
