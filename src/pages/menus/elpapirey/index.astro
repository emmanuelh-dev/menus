---
import { Image } from "astro:assets";
import logo from "./logo.jpg";
import RestaurantLayout from "../../../layouts/RestaurantLayout.astro";
import { Facebook, Instagram } from "lucide-react";
import CopyClabe from "../../../components/CopyClabe";
import WhatsappButton from "../../../components/WhatsappButton";
import RecommendationButton from "../../../components/RecommendationButton";
import { supabase } from "../../../lib/supabase";
import Gallery from "../../../components/Gallery.astro";

const { data: place } = await supabase
  .from("places")
  .select("*")
  .eq("short_name", 'elpapirey')
  .single();

const { blocks = [], view_settings = {} } = place.content || {};

const categoryColors = [
  "text-orange-500", "text-cyan-400", "text-red-500", "text-purple-500",
  "text-green-400", "text-pink-400", "text-blue-500", "text-yellow-500",
  "text-teal-500"
];

const socialMedia = {
  instagram: { name: "Elpapi_rey_05", url: "https://instagram.com/Elpapi_rey_05" },
  facebook: { name: "EL papi rey", url: "https://www.facebook.com/profile.php?id=100090381744195" },
};

const contactInfo = {
  clabes: ["722969020525470158", "728969000034765417"],
  whatsapp: "8133906548",
};
---

<RestaurantLayout 
  title={place.name}
  description={place.name}
  image={place.image}
  favicon={logo.src}
  textWhite={true}
  backgroundColor="bg-black"
>
  <div class="min-h-screen bg-black flex items-center justify-center p-8 permanent-marker-regular text-xl">
    <div class="w-full max-w-2xl bg-black rounded-lg">
      
      <div class="flex flex-col items-center mb-8">
        <Image src={place.image} alt={place.name} width="500" height="500" class="w-full max-w-[500px] mb-4"/>
        <div class="flex gap-4 text-white mb-4">
          <a href={socialMedia.instagram.url} class="flex items-center gap-2 font-bold">
            <Instagram className="text-pink-500" /> {socialMedia.instagram.name}
          </a>
          <a href={socialMedia.facebook.url} class="flex items-center gap-2 font-bold">
            <Facebook className="text-blue-500" /> {socialMedia.facebook.name}
          </a>
        </div>
      </div>

      <CopyClabe client:load clabes={contactInfo.clabes}/>

      <div class="space-y-6 mb-8">
        {blocks.map((block, blockIdx) => {
          if (block.type === 'section') {
            return (
              <div class="mt-6">
                <h2 class={`${categoryColors[blockIdx % categoryColors.length]} text-xl font-bold tracking-wide mb-4`}>
                  {block.data.title.toUpperCase()}
                </h2>

                <div class="space-y-4">
                  {block.data.items?.map((item) => (
                    <div class="px-4 flex justify-between items-start">
                      <div class="flex-1">
                        <span class="text-white text-lg font-medium">{item.name}</span>
                        {item.description && <p class="text-gray-400 text-sm mt-1">{item.description}</p>}
                      </div>
                      {view_settings.show_prices && item.price > 0 && (
                        <span class="text-yellow-400 text-xl font-bold ml-4">${item.price}</span>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            );
          }
          
          if (block.type === 'gallery') {
            return (
              <Gallery 
                images={block.data.images || []} 
                buttonClasses="inline-block font-oswald bg-[#f61519] text-white text-3xl font-black uppercase py-2 px-8 mb-6 relative after:content-[''] after:absolute after:right-[-15px] after:top-0 after:bottom-0 after:w-[30px] after:bg-[#f61519] after:skew-x-[20deg] after:-z-10" 
              />
            );
          }
        })}
      </div>
      
      <WhatsappButton client:load phone={Number(contactInfo.whatsapp)} />
    </div>
  </div>
</RestaurantLayout>