---


import { Heart, Star } from "lucide-react";
import RestaurantLayout from "../../../layouts/RestaurantLayout.astro";

const restaurantData = {
    name: "La Santa Kitchen Bar - Menú San Pedro, San Nicolás, Nogalar | Hamburguesas, Alitas, Mariscos",
    description: "Menú de La Santa Kitchen Bar en San Pedro, San Nicolás, Nogalar, Plaza Sienna, Paseo Tec y Citadel. Hamburguesas, alitas, boneless, mariscos y tacos artesanales. Precios desde $90. Horarios Viernes-Domingo 12:00-23:00.",
    locations: [
        "San Pedro",
        "San Nicolás", 
        "Nogalar",
        "Plaza Sienna", 
        "Paseo Tec",
        "Citadel"
    ]
};
const schemaEnrichment = {
  address: {
    streetAddress: "Alondra 101, San Nicolas De Los Garza, LATAM 66450",
    addressLocality: "San Nicolas De Los Garza, N.L.",
    postalCode: "66450 ",
    addressCountry: "MX",
  },
  email: "info@bysmax.com",
  priceRange: "$$",
  servesCuisine: ["American", "Hamburguesas", "Alitas", "Boneless", "Mariscos", "Tacos"],
  openingHours: "Viernes-Domingo 12:00-23:00",
  acceptsReservations: true,
  paymentAccepted: ["Cash", "Credit Card"],
  currenciesAccepted: ["MXN", "USD"],
  aggregateRating: {
    ratingValue: 4.5,
    reviewCount: 123,
  },
};
---
<RestaurantLayout
    title={restaurantData.name}
    description={restaurantData.description}
    textWhite={true}
    backgroundColor="bg-black"
    schemaEnrichment={schemaEnrichment}
>

<div class="bg-black color-white">
    <div class="max-w-4xl mx-auto text-white max-sm:p-4">
        <!-- Header optimizado para SEO -->
        <header class="mb-8">
            <h1 class="text-4xl font-bold mb-4">
                Menú La Santa Kitchen Bar
                <br /> 
                <span class="text-2xl text-gray-300">San Pedro | San Nicolás | Nogalar | Plaza Sienna</span>
            </h1>
            

            <p class="text-gray-400 mb-4">
                {restaurantData.description}
            </p>
        </header>

    </div>
    <div class="min-h-screen p-4 font-serif relative overflow-hidden">
        <div class="max-w-4xl mx-auto">

          <!-- Contenedor principal del menú -->
          <section>
            <h2 class="text-3xl font-bold text-center mb-8 text-yellow-400">
              💫 Menú Completo La Santa Kitchen Bar 2024
            </h2>
            <p class="text-center text-gray-400 mb-8">
              Descubre nuestro menú completo con precios actualizados. Desde entradas hasta postres, todo preparado con ingredientes frescos y de la más alta calidad.
            </p>
          
          <div class="flex flex-col md:flex-row">
            <!-- Columna izquierda con la imagen -->
            <div class="w-full md:w-1/3 mb-8 md:mb-0">
              <div class="h-80 md:h-full w-full bg-cover bg-center" 
                   style="background-image: url('https://hebbkx1anhila5yf.public.blob.vercel-storage.com/image-zvoxajLzDxzxi6c0uRyVGNg8wzoWOd.png'); background-position: left center; background-size: cover;">
              </div>
            </div>
            
            <!-- Columna derecha con el menú -->
            <div class="w-full md:w-2/3 pl-0 md:pl-8">
              <!-- ENTRADAS -->
              <div class="mb-16 relative">
                <div class="absolute -left-8 top-1/2 transform -translate-y-1/2">
                  <h2 class="transform -rotate-90 origin-center text-gray-400 whitespace-nowrap text-sm">ENTRADAS</h2>
                </div>
                
                <div class="ml-6 space-y-6">
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">COSTILLITAS DE ELOTE</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">CON MANTEQUILLA, SALSA BUFFALO, ADEREZO PARA ELOTE & TOSTITOS</p>
                    <p class="text-right mt-1 text-white font-bold">119 $</p>
                  </div>
                  
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">QUESITOS</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">3 DEDOS DE QUESO MANCHEGO, CHEDDAR EMPANIZADOS & ADEREZOS MÁGICOS</p>
                    <p class="text-right mt-1 text-white font-bold">155 $</p>
                  </div>
                  
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">COLIFLOR</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">QUESO PARMESANO, PISTACHE, ADEREZO DE AJO & CHIPOTLE</p>
                    <p class="text-right mt-1 text-white font-bold">155 $</p>
                  </div>
                  
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">CAMARONES ROCA</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">CAMARONES CAPEADOS, MAYO-SRIRACHA & PARMESANO</p>
                    <p class="text-right mt-1 text-white font-bold">185 $</p>
                  </div>
                  
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">EL SAGRADO</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">CHICHARRÓN DE FLECHITA DE LA RAMOS CON GUACAMOLE</p>
                    <p class="text-right mt-1 text-white font-bold">185 $</p>
                  </div>
                  
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">CAMARONES ZARANDEADOS</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">220 GRS DE DELICIOSOS CAMARONES ZARANDEADOS CON NUESTRO ADOBO MÁGICO</p>
                    <p class="text-right mt-1 text-white font-bold">245 $</p>
                  </div>
                  
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">ATRAER EL AMOR</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">PAPAS CON MUCHOS QUESOS, ARRACHERA, GUACAMOLE & PICO DE GALLO</p>
                    <p class="text-right mt-1 text-white font-bold">175 $</p>
                  </div>
                  
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">PAPAS MAMA MIA</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">PAPAS FRITAS CON SALSA DE PIZZA, MOZARELLA & PEPPERONI</p>
                    <p class="text-right mt-1 text-white font-bold">155 $</p>
                  </div>
                  
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">LAS EQUIS</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">PAPAS FRITAS ASÍ SIN NADA, NI QUESO NI NADA ASÍ EQUIS</p>
                    <p class="text-right mt-1 text-white font-bold">90 $</p>
                  </div>
                </div>
              </div>
              
              <!-- LAS TORRES -->
              <div class="mb-16 relative">
                <div class="absolute -left-8 top-1/2 transform -translate-y-1/2">
                  <h2 class="transform -rotate-90 origin-center text-gray-400 whitespace-nowrap text-sm">LAS TORRES</h2>
                </div>
                
                <div class="ml-6 space-y-6">
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">LA FREGONA</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">TORRE DE MARISCOS CON CAMARÓN, ATÚN, PULPO, PESCADO, AGUACATE, PEPINO, CEBOLLA MORADA, SALSAS CON VIBRAS ORIENTALES & SALSA MANGO SPICY</p>
                    <p class="text-right mt-1 text-white font-bold">333 $</p>
                  </div>
                  
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">MAGIA NEGRA</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">TORRE DE MARISCOS BAÑADA CON NUESTRA POCIÓN MÁGICA HECHA DE SALSAS NEGRAS PARA DOMINAR A LA PERSONA QUE TÚ QUIERAS! LA TORRE LLEVA CAMARÓN, ATÚN, PULPO, PESCADO, AGUACATE, PEPINO, CEBOLLA MORADA & TOSTITOS FLAMING HOT</p>
                    <p class="text-right mt-1 text-white font-bold">333 $</p>
                  </div>
                </div>
              </div>
              
              <!-- TACOS ARTESANALES -->
              <div class="mb-16 relative">
                <div class="absolute -left-8 top-1/2 transform -translate-y-1/2">
                <h2 class="transform -rotate-90 origin-center  text-gray-400 whitespace-nowrap text-sm">TACOS ARTESANALES</h2>
              </div>
                
                <div class="ml-6 space-y-6">
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">LOS ENSENADA</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">3 TACOS DE BUEN TAMAÑO EN TORTILLA RECIEN HECHA CAMARON CAPEADO, MANCHEGO, ENSALADA DE COL, ADEREZO DE CILANTRO, AGUACATE & PAPAS FRITAS</p>
                    <p class="text-right mt-1 text-white font-bold">219 $</p>
                  </div>
                  
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">HECHIZADOS</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">3 TACOS EN TORTILLA RECIEN HECHA, CAMARONES PLANCHADOS, MANCHEGO, AGUACATE, JALAPEÑO, ARUGULA, ADEREZO DE AJO & PAPAS FRITAS</p>
                    <p class="text-right mt-1 text-white font-bold">190 $</p>
                  </div>
                  
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">LOS SAGRADOS</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">ORDEN DE 3 TACOS EN TORTILLA RECIEN HECHA, ARRACHERA, QUESO MANCHEGO, AGUACATE, CEBOLLA & PAPAS FRITAS</p>
                    <p class="text-right mt-1 text-white font-bold">219 $</p>
                  </div>
                  
                  <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">LOS BENDITOS</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">ORDEN DE 3 TACOS EN TORTILLA RECIEN HECHA DE CHICHARRON DE LA RAMOS, ARRACHERA, QUESO MANCHEGO, AGUACATE, CEBOLLA & PAPAS FRITAS</p>
                    <p class="text-right mt-1 text-white font-bold">219 $</p>
                  </div>
                    <div class="menu-item">
                    <h3 class="text-xl tracking-[0.15em] font-light text-white">LA COSTRA</h3>
                    <p class="text-xs tracking-wider text-gray-400 mt-1">TACO GIGANTE EN TORTILLA DE QUESO MANCHEGO, ARRACHERA, CHAMPIÑONES, AGUACATE, MORRON & PAPAS FRITAS</p>
                    <p class="text-right mt-1 text-white font-bold">219 $</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </section>
          
          <!-- Información de contacto y horarios -->
          <footer class="mt-12 bg-gray-900 p-6 rounded-lg">
            <h2 class="text-2xl font-bold text-yellow-400 mb-6 text-center">📞 Información de Contacto La Santa Kitchen Bar</h2>
            
            <div class="grid md:grid-cols-3 gap-6">
              <div class="text-center">
                <h3 class="font-semibold text-white mb-3">🕒 Horarios de Servicio</h3>
                <div class="text-gray-300 space-y-1">
                  <p><strong>Viernes:</strong> 12:00 - 23:00</p>
                  <p><strong>Sábado:</strong> 12:00 - 23:00</p>
                  <p><strong>Domingo:</strong> 12:00 - 23:00</p>
                  <p class="text-yellow-400 mt-2"><strong>Lunes a Jueves:</strong> Cerrado</p>
                </div>
              </div>
              
              <div class="text-center">
                <h3 class="font-semibold text-white mb-3">💰 Rango de Precios</h3>
                <div class="text-gray-300 space-y-1">
                  <p><strong>Entradas:</strong> $90 - $245</p>
                  <p><strong>Torres:</strong> $333</p>
                  <p><strong>Tacos:</strong> $190 - $219</p>
                  <p class="text-green-400 mt-2"><strong>Nivel de precios:</strong> $$ (Moderado)</p>
                </div>
              </div>
              
              <div class="text-center">
                <h3 class="font-semibold text-white mb-3">📧 Contacto y Reservas</h3>
                <div class="text-gray-300 space-y-1">
                  <p><strong>Email:</strong> info@bysmax.com</p>
                  <p><strong>Reservaciones:</strong> Disponibles</p>
                  <p><strong>Pagos:</strong> Efectivo y Tarjeta</p>
                  <p class="text-yellow-400 mt-2"><strong>Monedas:</strong> MXN y USD</p>
                </div>
              </div>
            </div>
              <!-- SEO Keywords section -->
            <div class="mt-8 pt-6 border-t border-gray-700">
              <h3 class="text-lg font-semibold text-yellow-400 mb-3">🔍 Búsquedas Relacionadas</h3>
              <div class="flex flex-wrap gap-2 text-sm">
                <span class="bg-gray-800 px-3 py-1 rounded-full text-gray-300">menú la santa kitchen bar</span>
                <span class="bg-gray-800 px-3 py-1 rounded-full text-gray-300">la santa san pedro</span>
                <span class="bg-gray-800 px-3 py-1 rounded-full text-gray-300">la santa san nicolás</span>
                <span class="bg-gray-800 px-3 py-1 rounded-full text-gray-300">la santa nogalar</span>
                <span class="bg-gray-800 px-3 py-1 rounded-full text-gray-300">la santa precios</span>
                <span class="bg-gray-800 px-3 py-1 rounded-full text-gray-300">la santa menu pdf</span>
                <span class="bg-gray-800 px-3 py-1 rounded-full text-gray-300">hamburguesas la santa</span>
                <span class="bg-gray-800 px-3 py-1 rounded-full text-gray-300">alitas la santa</span>
              </div>
            </div>
                      
          <!-- Información adicional SEO -->
          <section class="mb-8 bg-gray-900 p-6 rounded-lg">
            <h2 class="text-2xl font-bold text-yellow-400 mb-4">🎯 ¿Por qué elegir La Santa Kitchen Bar?</h2>
            <div class="grid md:grid-cols-2 gap-6 text-gray-300">
              <div>
                <h3 class="font-semibold text-white mb-2">🍔 Especialidades únicas</h3>
                <ul class="space-y-1 text-sm">
                  <li>• Hamburguesas gourmet con ingredientes premium</li>
                  <li>• Alitas y boneless con salsas especiales</li>
                  <li>• Torres de mariscos frescos del día</li>
                  <li>• Tacos artesanales con tortillas hechas a mano</li>
                </ul>
              </div>
              <div>
                <h3 class="font-semibold text-white mb-2">📍 Múltiples ubicaciones</h3>
                <ul class="space-y-1 text-sm">
                  <li>• La Santa Kitchen Bar San Pedro</li>
                  <li>• La Santa Kitchen Bar San Nicolás</li>
                  <li>• La Santa Kitchen Bar Nogalar</li>
                  <li>• La Santa Kitchen Bar Plaza Sienna</li>
                  <li>• La Santa Kitchen Bar Paseo Tec</li>
                  <li>• La Santa Kitchen Bar Citadel</li>
                </ul>
              </div>
            </div>
          </section>
            <!-- Información clave para SEO -->
            <div class="bg-gray-900 p-4 rounded-lg mb-6">
                <h2 class="text-xl font-semibold mb-3 text-yellow-400">🍔 Especialidades: Hamburguesas, Alitas, Boneless y Mariscos</h2>
                <div class="grid md:grid-cols-2 gap-4 text-sm">
                    <div>
                        <p class="mb-2"><strong>📍 Ubicaciones:</strong></p>
                        <ul class="text-gray-300 space-y-1">
                            {restaurantData.locations.map(location => (
                                <li>• La Santa Kitchen Bar {location}</li>
                            ))}
                        </ul>
                    </div>
                    <div>
                        <p class="mb-2"><strong>🕒 Horarios:</strong> Viernes a Domingo 12:00 - 23:00</p>
                        <p class="mb-2"><strong>💰 Precios:</strong> Desde $90 hasta $333 pesos</p>
                        <p class="mb-2"><strong>📱 Reservaciones:</strong> Disponibles</p>
                        <p class="text-green-400"><strong>💳 Formas de pago:</strong> Efectivo y Tarjeta</p>
                    </div>
                </div>
            </div>
            
            <!-- FAQ Section para SEO adicional -->
            <div class="mt-8 pt-6 border-t border-gray-700">
              <h3 class="text-lg font-semibold text-yellow-400 mb-4">❓ Preguntas Frecuentes</h3>
              <div class="space-y-4 text-sm">
                <div>
                  <h4 class="font-semibold text-white mb-1">¿Cuánto cuesta comer en La Santa Kitchen Bar?</h4>
                  <p class="text-gray-300">Los precios van desde $90 para entradas hasta $333 para torres de mariscos. El rango promedio está entre $150-$220 pesos por persona.</p>
                </div>
                <div>
                  <h4 class="font-semibold text-white mb-1">¿En qué ubicaciones está La Santa Kitchen Bar?</h4>
                  <p class="text-gray-300">Tenemos 6 ubicaciones: San Pedro, San Nicolás, Nogalar, Plaza Sienna, Paseo Tec y Citadel. Todas con el mismo menú y calidad.</p>
                </div>
                <div>
                  <h4 class="font-semibold text-white mb-1">¿Puedo descargar el menú en PDF?</h4>
                  <p class="text-gray-300">Sí, ofrecemos nuestro menú completo en formato PDF con todos los precios actualizados para descargar.</p>
                </div>
                <div>
                  <h4 class="font-semibold text-white mb-1">¿Cuáles son los horarios de La Santa Kitchen Bar?</h4>
                  <p class="text-gray-300">Abrimos Viernes, Sábado y Domingo de 12:00 a 23:00 horas. Lunes a Jueves permanecemos cerrados.</p>
                </div>
                <div>
                  <h4 class="font-semibold text-white mb-1">¿Qué especialidades tiene La Santa Kitchen Bar?</h4>
                  <p class="text-gray-300">Somos especialistas en hamburguesas gourmet, alitas buffalo, boneless, torres de mariscos frescos y tacos artesanales con tortillas hechas a mano.</p>
                </div>
              </div>
            </div>
          </footer>
        </div>
      </div>
</div>
</RestaurantLayout>