---

import RecommendationButton from "../../../components/RecommendationButton";
import RestaurantLayout from "../../../layouts/RestaurantLayout.astro";
import CategoryNavigation from "../../../components/CategoryNavigation";
import Gallery from "../../../components/Gallery.astro";
import { supabase } from "../../../lib/supabase";
import { menu } from "./menu";

const { data: place } = await supabase
  .from("places")
  .select("*")
  .eq("short_name", 'campomar')
  .single();

const { blocks = [], view_settings = {} } = place.content || {};

const categoryColors = [
  "text-blue-400",
  "text-orange-500", 
  "text-cyan-400",
  "text-red-500",
  "text-purple-500",
  "text-green-400",
  "text-pink-400",
  "text-yellow-500",
  "text-indigo-500",
  "text-teal-500"
];

const restaurantData = {
  name: place?.name || "Campomar San Pedro Garza García",
  description: "La mejor comida de mariscos en San Pedro",
};


const schemaEnrichment = {
    address: {
        streetAddress: place?.address || "Av. del Roble 535",
        addressLocality: "San Pedro Garza García", 
        addressRegion: "N.L.",
        postalCode: "66266",
        addressCountry: "MX"
    },
    name: place?.name || restaurantData.name,
    telephone: "+52 81 3675 1161",
    priceRange: place?.priceRange || "$$$",  
    servesCuisine: ["Mariscos", "Seafood", "Mexican"],
    openingHours: place?.hours || "12:30-23:00",
    acceptsReservations: true,
    paymentAccepted: ["Credit Card", "Cash"],
    currenciesAccepted: ["MXN"],
    aggregateRating: {
        ratingValue: place?.rating || 4.5,
        reviewCount: 1
    },
    email: "",
    delivery: {
        available: false
    },
    socialMedia: {
        website: "grupomandala.com.mx"
    }
};

---

<RestaurantLayout title={restaurantData.name} description={restaurantData.description}
    schemaEnrichment={schemaEnrichment} backgroundColor="bg-gray-900" textWhite={true}>

    <head>
        <link href="/campomar/css" rel="stylesheet" />
        <link href="/campomar/css(1)" rel="stylesheet" />
        <link href="/campomar/icon" rel="stylesheet" />
        <link href="https://grupocampomar.com/menu/assets/media/iconos/favicon-campomar.png" rel="icon"
            type="image/png" />
        <link rel="apple-touch-icon" href="https://grupocampomar.com/menu/assets/media/iconos/favicon-campomar.png" />
        <link rel="apple-touch-icon" sizes="60x60"
            href="https://grupocampomar.com/menu/assets/media/iconos/touch-campomar-60.png" />
        <link rel="apple-touch-icon" sizes="120x120"
            href="https://grupocampomar.com/menu/assets/media/iconos/touch-campomar-120.png" />
        <link rel="icon" sizes="192x192"
            href="https://grupocampomar.com/menu/assets/media/iconos/touch-campomar-android.png" />
        <link rel="stylesheet" href="/campomar/swiper.min.css" />
        <link rel="stylesheet" href="/campomar/nouislider.min.css" />
        <link rel="stylesheet" href="/campomar/swiper.min.css" />
        <link rel="stylesheet" href="/campomar/photoswipe.min.css" />
        <link rel="stylesheet" href="/campomar/default-skin.min.css" />
        <link rel="stylesheet" href="/campomar/productos-estilos.css" />
        <link rel="stylesheet" href="/campomar/estilos_campomar_planti7.css" />
        <link rel="stylesheet" href="/campomar/wow.css" />    </head>
    
    <!-- Componentes de navegación -->
    <!-- <CategoryNavigation 
        client:load 
        categories={navigationCategories} 
        backgroundColor="bg-gray-900" 
        textColor="text-white" 
    /> -->
    <!-- HEADER -->
    <div class="bg-[#ebebeb]">
        <div class="max-w-4xl mx-auto">
            <div>
                <div class="font_3 centrar_texto">
                    <h2 class="font_3 campom_prod text-center pt-4">{restaurantData.name}<br /></h2>
                    <br />
                </div>
                <div id="tmpWrapper">
                  {blocks.map((block, blockIdx) => {
                    if (block.type === 'section') {
                      return (
                        <>
                          <div id={`category-${blockIdx}`}>
                            <table class="rwd_auto fontsize container-fluid fondo_p7">
                              <tbody>
                                <tr>
                                  <td style="padding: 0px !important;" class="fondo_img">
                                  </td>
                                </tr>
                                <tr>
                                  <td class="td_prod">
                                    <div class="font_3 centrar_texto">
                                      <h2 class="font_3 campom_prod">{block.data.title.toUpperCase()}<br /></h2>
                                      {block.data.description && (
                                        <p class="text-gray-600 text-sm mt-2">{block.data.description}</p>
                                      )}
                                      <br />
                                    </div>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </div>
                          
                          {block.data.items?.map((item: any) => (
                            <table class="rwd_auto fontsize container-fluid">
                              <tbody>
                                <tr>
                                  <td>
                                    <div class="font_3 centrar_texto prod_cat_campomar">
                                      <div class="row justify-content-center">
                                        <div class="col-lg-12 nom_prod_camp" style="padding-bottom: 15px;">
                                          <div class="prod_camp_t">
                                            <h3 class="font_3 campom_prod_cat" style="margin-top: -3px;">
                                              {item.name}
                                              <br />
                                              {item.description && (
                                                <span class="font_5" style="margin-top: -3px;">
                                                  <span class="aster">*</span>{item.weight && `${item.weight} `}{item.description}
                                                </span>
                                              )}
                                              {item.ingredients && (
                                                <span class="font_5 text-gray-600" style="margin-top: -3px;">
                                                  <br />Ingredientes: {item.ingredients.join(", ")}
                                                </span>
                                              )}
                                              {item.allergens && item.allergens.length > 0 && (
                                                <span class="font_5 text-orange-500" style="margin-top: -3px;">
                                                  <br />⚠️ Contiene: {item.allergens.join(", ")}
                                                </span>
                                              )}
                                              {(item.is_vegetarian || item.is_vegan || item.is_gluten_free || item.is_spicy) && (
                                                <div class="flex gap-1 justify-center mt-2">
                                                  {item.is_vegetarian && (
                                                    <span class="text-green-400 text-sm" title="Vegetariano">🌱</span>
                                                  )}
                                                  {item.is_vegan && (
                                                    <span class="text-green-500 text-sm" title="Vegano">🌿</span>
                                                  )}
                                                  {item.is_gluten_free && (
                                                    <span class="text-blue-400 text-sm" title="Sin Gluten">🚫🌾</span>
                                                  )}
                                                  {item.is_spicy && (
                                                    <span class="text-red-400 text-sm" title="Picante">🌶️</span>
                                                  )}
                                                </div>
                                              )}
                                            </h3>
                                          </div>
                                          <div class="prod_precio_cam">
                                            <span class="font_4"><span class="txt_colum"></span></span>
                                          </div>
                                          <div class="prod_precio_cam">
                                            <span class="font_4">
                                              <span class="font_camp_precio">
                                                {view_settings.show_prices && item.price ? `$ ${item.price}` : ''}
                                              </span>
                                            </span>
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          ))}
                        </>
                      );
                    }
                    
                    if (block.type === 'gallery') {
                      return (
                        <div class="my-8">
                          <Gallery 
                            images={block.data.images || []} 
                            buttonClasses="inline-block font-oswald bg-[#f61519] text-white text-3xl font-black uppercase py-2 px-8 mb-6 relative after:content-[''] after:absolute after:right-[-15px] after:top-0 after:bottom-0 after:w-[30px] after:bg-[#f61519] after:skew-x-[20deg] after:-z-10" 
                          />
                        </div>
                      );
                    }
                  })}
                    
                    <!-- Aviso final -->
                    <div class="cont_aviso" style="background: #ebebeb !important;">
                        <div class="aviso">
                            <h1>
                                *(CONSUMIR CARNES, AVES, PESCADOS, MARISCOS O HUEVOS CRUDOS O
                                POCO COCIDOS PUEDE AUMENTAR SU RIESGO DE CONTRAER ENFERMEDADES
                                TRANSMITIDAS POR ALIMENTOS).<br />*UNA VEZ YA INGRESADO EL
                                PEDIDO NO SE PODRÁ HACER CAMBIOS<br />*PERSONAS ALÉRGICAS
                                PREGUNTAR POR INGREDIENTES<br />*NO HAY MEDIAS ORDENES
                            </h1>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</RestaurantLayout>
