---
import { Image } from "astro:assets";
import MotelLayout from "../../layouts/MotelLayout.astro";
import MotelBusinessSchema from "../../components/MotelBusinessSchema.astro";
import MotelBreadcrumbSchema from "../../components/MotelBreadcrumbSchema.astro";
import Card from "../../components/Card.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getRestaurants, getStates } from "../../lib/api";
import { Bed, MapPin, Clock, Star, DollarSign, Phone, ArrowRight, Wifi, Car, Snowflake, Waves, Utensils, Martini } from "lucide-react";
import type { SupabasePlace } from "../../types/app";


const [motelesList, states] = await Promise.all([
  getRestaurants({ type: 'motel' }),
  getStates()
]);

const url = new URL(Astro.request.url);
const zona = url.searchParams.get('zona') || undefined;
const tipo = url.searchParams.get('tipo') || undefined;

const getDynamicSEO = () => {
  const baseTitle = "Mejores Moteles en Monterrey 2026";
  const baseDescription = "Guía completa de moteles en Monterrey";
  const baseKeywords = ["moteles monterrey", "motel monterrey"];
  const baseUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();

  // SEO por zona específica
  if (zona) {
    switch (zona.toLowerCase()) {
      case 'centro':
        return {
          title: `Moteles en Centro de Monterrey 2026 | Hotel Los Angeles y Más`,
          description: `Mejores moteles en el centro de Monterrey. Hotel Los Angeles, opciones económicas y ubicación céntrica. Guía completa con precios.`,
          keywords: [...baseKeywords, "moteles en el centro de monterrey", "motel en monterrey centro", "moteles centro monterrey", "hotel los angeles monterrey"],
          heading: "Moteles en Centro de Monterrey",
          subheading: "Los mejores moteles en el corazón de la ciudad",
          canonical: `${baseUrl}?zona=centro`,
          ogUrl: `${baseUrl}?zona=centro`
        };
      
      case 'universidad':
        return {
          title: `Moteles cerca de Universidad Monterrey 2026 | Motel Love Recomendado`,
          description: `Moteles cerca de Universidad en Monterrey. Motel Love (favorito del autor), opciones premium y ubicación conveniente. Precios y horarios.`,
          keywords: [...baseKeywords, "motel cerca universidad monterrey", "motel love monterrey", "moteles universidad"],
          heading: "Moteles cerca de Universidad",
          subheading: "Opciones premium cerca de la zona universitaria",
          canonical: `${baseUrl}?zona=universidad`,
          ogUrl: `${baseUrl}?zona=universidad`
        };
        
      case 'cumbres':
        return {
          title: `Moteles en Cumbres Monterrey 2026 | Hacienda Cumbres y Más`,
          description: `Moteles en zona Cumbres, Monterrey. Motel Hacienda Cumbres, opciones de lujo y privacidad. Guía con precios actualizados.`,
          keywords: [...baseKeywords, "moteles cumbres monterrey", "motel hacienda cumbres", "moteles zona cumbres"],
          heading: "Moteles en Cumbres",
          subheading: "Opciones premium en la zona más exclusiva",
          canonical: `${baseUrl}?zona=cumbres`,
          ogUrl: `${baseUrl}?zona=cumbres`
        };
    }
  }

  // SEO por tipo de motel
  if (tipo) {
    switch (tipo.toLowerCase()) {
      case 'baratos':
        return {
          title: `Moteles Baratos en Monterrey 2026 | Desde $300 por 4 Horas`,
          description: `Moteles baratos en Monterrey con los mejores precios. Hotel White, Grand Motel y más opciones económicas. Guía de precios 2026.`,
          keywords: [...baseKeywords, "moteles baratos en monterrey", "motel barato monterrey", "moteles economicos monterrey", "moteles precio bajo"],
          heading: "Moteles Baratos en Monterrey",
          subheading: "Las mejores opciones económicas sin sacrificar calidad",
          canonical: `${baseUrl}?tipo=baratos`,
          ogUrl: `${baseUrl}?tipo=baratos`
        };
      
      case 'jacuzzi':
        return {
          title: `Moteles con Jacuzzi en Monterrey 2026 | Marbella, Canarias y Más`,
          description: `Moteles con jacuzzi en Monterrey. Motel Marbella, Canarias y opciones de lujo con jacuzzi privado. Precios y ubicaciones.`,
          keywords: [...baseKeywords, "motel con jacuzzi monterrey", "moteles con jacuzzi en monterrey", "motel jacuzzi privado", "moteles lujo jacuzzi"],
          heading: "Moteles con Jacuzzi en Monterrey",
          subheading: "Experiencia de lujo con jacuzzi privado",
          canonical: `${baseUrl}?tipo=jacuzzi`,
          ogUrl: `${baseUrl}?tipo=jacuzzi`
        };
        
      case '12-horas':
        return {
          title: `Moteles de 12 Horas en Monterrey 2026 | Hotel White y Más`,
          description: `Moteles con estancia de 12 horas en Monterrey. Hotel White y opciones para escapadas largas. Precios especiales para 12 horas.`,
          keywords: [...baseKeywords, "motel 12 horas monterrey", "motel de 12 horas en monterrey", "estancia larga motel"],
          heading: "Moteles de 12 Horas",
          subheading: "Escapadas largas con los mejores precios",
          canonical: `${baseUrl}?tipo=12-horas`,
          ogUrl: `${baseUrl}?tipo=12-horas`
        };
    }
  }

  // SEO por defecto optimizado
  return {
    title: baseTitle + " | Motel Love, Kyoto y Más",
    description: baseDescription + ". Encuentra moteles baratos, con jacuzzi y los mejores de la ciudad. Motel Love (recomendado), Kyoto Suites, Marbella y más. Precios, ubicaciones y recomendaciones actualizadas.",
    keywords: [
      ...baseKeywords,
      "moteles baratos en monterrey",
      "motel con jacuzzi monterrey", 
      "mejores moteles en monterrey",
      "moteles con jacuzzi en monterrey",
      "motel en monterrey centro",
      "moteles en el centro de monterrey",
      "moteles mty",
      "moteles en mty",
      "mejores moteles monterrey",
      "motel barato monterrey",
      "motel de 12 horas en monterrey",
      "kyoto motel mty",
      "kyoto suites monterrey",
      "grand motel monterrey",
      "marbella motel monterrey",
      "motel love monterrey"
    ],
    heading: "Mejores Moteles en Monterrey 2026",
    subheading: "Encuentra el lugar perfecto para tu escapada romántica en la ciudad",
    canonical: baseUrl,
    ogUrl: baseUrl
  };
};

const seoData = getDynamicSEO();

// Generar breadcrumbs dinámicos
const getBreadcrumbs = () => {
  const breadcrumbs = [
    { label: 'Inicio', href: '/' },
    { label: 'Moteles', href: '/moteles' }
  ];

  if (zona) {
    const zonaLabels = {
      'centro': 'Centro',
      'universidad': 'Universidad',
      'cumbres': 'Cumbres'
    };
    breadcrumbs.push({ label: zonaLabels[zona.toLowerCase()] || zona } as any);
  } else if (tipo) {
    const tipoLabels = {
      'baratos': 'Moteles Baratos',
      'jacuzzi': 'Con Jacuzzi',
      '12-horas': '12 Horas'
    };
    breadcrumbs.push({ label: tipoLabels[tipo.toLowerCase()] || tipo } as any);
  }

  return breadcrumbs;
};

const breadcrumbItems = getBreadcrumbs();

// Configuración para Schema.org
const schemaEnrichment = {
  address: {
    addressLocality: "Monterrey",
    addressRegion: "Nuevo León", 
    addressCountry: "MX",
  },
};

---

<MotelLayout 
  title={seoData.title}
  description={seoData.description}
  schemaEnrichment={schemaEnrichment}
  backgroundColor="bg-gradient-to-r from-[#4a5568] to-[#553c7b]"
  textWhite={true}
  canonical={seoData.canonical}
  ogUrl={seoData.ogUrl}
><!-- Motel Business Structured Data -->
  <MotelBusinessSchema moteles={motelesList} />
  
  <!-- Breadcrumb Structured Data -->
  <MotelBreadcrumbSchema zona={zona} tipo={tipo} />

<main>
    <section class="min-h-screen bg-black text-white pt-6 pb-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          
          <Breadcrumbs items={breadcrumbItems} />
          
          <!-- Cabecera Minimalista -->
          <div class="mt-6 mb-10">
            <h1 class="text-3xl md:text-5xl font-bold text-pink-400 font-serif tracking-tight mb-3">{seoData.heading}</h1>
            <p class="text-base md:text-lg text-gray-300 max-w-3xl">{seoData.subheading}. Guía con precios actualizados, fotos de habitaciones y ubicaciones en mapa.</p>
          </div>
          
          <!-- Filtros interactivos -->
          <!-- <div class="mb-12 space-y-4">
            <div class="flex flex-wrap justify-center gap-4">
              <button id="filter-all" class="filter-btn px-6 py-2 bg-pink-500 text-white rounded-full font-serif hover:bg-pink-400 transition-colors" data-filter="all">Todos</button>
              <button id="filter-premium" class="filter-btn px-6 py-2 bg-[#1E1E1E] text-gray-300 rounded-full font-serif hover:bg-pink-500 hover:text-white transition-colors" data-filter="premium">Premium</button>
              <button id="filter-rated" class="filter-btn px-6 py-2 bg-[#1E1E1E] text-gray-300 rounded-full font-serif hover:bg-pink-500 hover:text-white transition-colors" data-filter="rated">Mejor calificados</button>
              <button id="filter-amenities" class="filter-btn px-6 py-2 bg-[#1E1E1E] text-gray-300 rounded-full font-serif hover:bg-pink-500 hover:text-white transition-colors" data-filter="amenities">Con amenidades</button>
            </div>
            
            <div class="flex flex-wrap justify-center gap-3 text-sm">
              <Card 
                href="?tipo=baratos"
                title="💰 Moteles Baratos"
                bgColor="bg-green-900/30"
                textColor="text-green-400"
                borderColor="border-green-500/30"
                hoverBgColor="hover:bg-green-500"
              />
              <Card 
                href="?tipo=jacuzzi"
                title="🛁 Con Jacuzzi"
                bgColor="bg-blue-900/30"
                textColor="text-blue-400"
                borderColor="border-blue-500/30"
                hoverBgColor="hover:bg-blue-500"
              />
              <Card 
                href="?tipo=12-horas"
                title="⏰ 12 Horas"
                bgColor="bg-purple-900/30"
                textColor="text-purple-400"
                borderColor="border-purple-500/30"
                hoverBgColor="hover:bg-purple-500"
              />
              <Card 
                href="?zona=centro"
                title="🏛️ Centro"
                bgColor="bg-orange-900/30"
                textColor="text-orange-400"
                borderColor="border-orange-500/30"
                hoverBgColor="hover:bg-orange-500"
              />
              <Card 
                href="?zona=universidad"
                title="🎓 Universidad"
                bgColor="bg-yellow-900/30"
                textColor="text-yellow-400"
                borderColor="border-yellow-500/30"
                hoverBgColor="hover:bg-yellow-500"
              />
              <Card 
                href="?zona=cumbres"
                title="🏔️ Cumbres"
                bgColor="bg-indigo-900/30"
                textColor="text-indigo-400"
                borderColor="border-indigo-500/30"
                hoverBgColor="hover:bg-indigo-500"
              />
            </div>
          </div> -->

          <!-- Banner: Califica y ayuda a otros -->
          <div class="mb-8 bg-[#1a0a1a] border border-pink-500/20 rounded-xl px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class="text-2xl">⭐</div>
              <div>
                <p class="text-white font-bold text-sm">¿Ya fuiste a un motel? Deja tu calificación</p>
                <p class="text-gray-400 text-xs mt-0.5">Tus reseñas ayudan a otros usuarios a elegir mejor</p>
              </div>
            </div>
            <p class="text-pink-400 text-xs font-semibold tracking-wide text-center sm:text-right shrink-0">
              Entra al motel y<br class="hidden sm:block" /> califica abajo 👇
            </p>
          </div>

          <!-- Grid de moteles -->
          <div id="moteles-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-6">
            {motelesList.sort((a, b) => {
              if (a.featured !== b.featured) {
                  return a.featured ? -1 : 1; 
              }
              return b.rating - a.rating;
            }).sort((a,b) => a.featured < b.featured ? 1 : -1).map((motel) => (
              <div 
                class={`motel-card group relative overflow-hidden rounded-xl bg-[#1E1E1E] shadow-md hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 ${motel.highlight ? '  bg-gradient-to-br from-pink-900/20 to-purple-900/20' : 'border-pink-500/20'} hover:border-pink-500/50`}
                data-rating={motel.rating}
                data-price-range={motel.priceRange}
                data-has-amenities={motel.amenities.length > 3 ? "true" : "false"}
              >
                <!-- Imagen con overlay -->
                <div class="relative h-32 sm:h-48 overflow-hidden">
                  <Image
                    src={motel.image || '/motel.png'} 
                    alt={motel.name}
                    width={500}
                    height={300}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-70"></div>
                  
                  <!-- Calificación y precio -->
                  <div class="absolute bottom-2.5 left-2.5 flex items-center space-x-1.5">
                    <div class="flex items-center bg-black/90 px-1.5 py-0.5 rounded-full">
                      <Star className="w-3 h-3 text-pink-400 mr-0.5" />
                      <span class="text-[11px] font-medium text-white">{motel.rating}</span>
                      <span class="text-[9px] text-gray-400 ml-0.5">({motel.reviewCount})</span>
                    </div>
                    <div class="bg-black/90 px-1.5 py-0.5 rounded-full">
                      <span class="text-[11px] font-medium text-white">{motel.priceRange}</span>
                    </div>
                  </div>
    
                  <!-- Destacado -->
                  {motel.highlight && (
                    <div class="absolute top-2 left-2 bg-pink-500 text-white px-1.5 py-0.5 rounded-full text-[9px] font-semibold animate-pulse">
                      ⭐ Recomendado
                    </div>
                  )}
                </div>
    
                <!-- Contenido de la tarjeta -->
                <div class="p-3 sm:p-5 flex flex-col justify-between h-[calc(100%-8rem)] sm:h-[calc(100%-12rem)]">
                  <div>
                    <h3 class="font-serif text-[15px] sm:text-lg font-bold text-pink-400 mb-1.5 group-hover:text-pink-300 transition-colors line-clamp-1">
                      {motel.name}
                    </h3>
                    
                    <!-- Estado (24 horas) -->
                    <div class="flex items-center mb-1.5">
                      <Clock className="w-3.5 h-3.5 text-gray-400 mr-1.5 flex-shrink-0" />
                      <span class="text-xs text-green-400">Abierto 24h</span>
                    </div>
                    
                    <!-- Dirección -->
                    <div class="flex items-start mb-1.5">
                      <MapPin className="w-3.5 h-3.5 text-gray-400 mr-1.5 mt-0.5 flex-shrink-0" />
                      <span class="text-xs text-gray-300 line-clamp-1">{motel.address}</span>
                    </div>
  
                    <!-- Teléfono -->
                    {motel.phone && (
                      <div class="flex items-center mb-2">
                        <Phone className="w-3.5 h-3.5 text-gray-400 mr-1.5 flex-shrink-0" />
                        <a href={`tel:${motel.phone}`} class="text-xs text-pink-400 hover:text-pink-300 transition-colors truncate">
                          {motel.phone}
                        </a>
                      </div>
                    )}
      
                    <!-- Especialidades -->
                    {motel.specialties && motel.specialties.length > 0 && (
                      <div class="flex flex-wrap gap-1 mt-1.5 mb-1.5">
                        {motel.specialties.slice(0, 2).map((specialty) => (
                          <span class="text-[9px] sm:text-xs bg-[#2A2A2A] text-pink-400 px-1.5 py-0.5 rounded-full">{specialty}</span>
                        ))}
                      </div>
                    )}
      
                    <!-- Amenidades disponibles con iconos (Ocultas en móviles para minimalismo) -->
                    <div class="hidden sm:grid grid-cols-2 gap-1.5 mt-3">
                      {motel.amenities && motel.amenities.slice(0, 4).map((amenity) => (
                        <div class="flex items-center text-[11px] text-gray-300">
                          {amenity.toLowerCase().includes('wifi') && <Wifi className="w-3 h-3 mr-1 text-blue-400" />}
                          {amenity.toLowerCase().includes('estacionamiento') && <Car className="w-3 h-3 mr-1 text-green-400" />}
                          {amenity.toLowerCase().includes('aire') && <Snowflake className="w-3 h-3 mr-1 text-cyan-400" />}
                          {amenity.toLowerCase().includes('alberca') && <Waves className="w-3 h-3 mr-1 text-blue-400" />}
                          {amenity.toLowerCase().includes('restaurante') && <Utensils className="w-3 h-3 mr-1 text-orange-400" />}
                          {amenity.toLowerCase().includes('bar') && <Martini className="w-3 h-3 mr-1 text-purple-400" />}
                          <span class="truncate">{amenity}</span>
                        </div>
                      ))}
                    </div>
      
                    <!-- Información adicional -->
                    {motel.distance && (
                      <div class="mt-2 p-1.5 bg-[#2A2A2A] rounded-lg hidden sm:block">
                        <p class="text-[10px] text-yellow-400">ℹ️ {motel.distance}</p>
                      </div>
                    )}
                  </div>
    
                  <!-- Botón de acción -->
                  <div class="mt-3.5">
                    {motel.short_name ? (
                      <a 
                        data-astro-prefetch="hover"
                        href={`/moteles/estados/${motel.state_slug}/${motel.short_name}`}
                        data-umami-event={'/moteles/' + motel.short_name + ' button'}
                        class="w-full bg-pink-500 text-white px-3 py-1.5 rounded-lg font-serif text-xs sm:text-sm font-bold hover:bg-pink-400 transition-colors flex items-center justify-center group"
                      >
                        Habitaciones
                        <ArrowRight className="ml-1 w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                      </a>
                    ) : motel.menu ? (
                      <a 
                        href={motel.menu} 
                        data-umami-event={'/moteles/' + motel.short_name + ' button'}
                        class="inline-block w-full text-center py-1.5 bg-pink-500 text-white rounded-lg font-serif text-xs sm:text-sm hover:bg-pink-400 transition-colors"
                      >
                        Información
                      </a>
                    ) : motel.phone ? (
                      <a 
                        href={`tel:${motel.phone}`}
                        data-umami-event={'/moteles/' + motel.short_name + ' button'}
                        class="w-full bg-pink-500 text-white px-3 py-1.5 rounded-lg font-serif text-xs sm:text-sm font-bold hover:bg-pink-400 transition-colors flex items-center justify-center group"
                      >
                        <Phone className="mr-1 w-3.5 h-3.5" />
                        Llamar
                      </a>
                    ) : (
                      <button 
                        class="w-full py-1.5 bg-[#2A2A2A] text-pink-400 rounded-lg font-serif text-xs sm:text-sm hover:bg-[#3A3A3A] transition-colors"
                      >
                        Ver más
                      </button>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
    
          <div class="mt-20 mb-16">
            <h2 class="text-3xl md:text-4xl font-serif font-bold text-pink-400 mb-8 text-center">Moteles por Estado</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              <Card 
                  href={`/moteles/estados/nuevo-leon`}
                  title={'Nuevo León'}
                  bgColor="bg-[#2A2A2A]"
                  textColor="text-pink-300"
                  borderColor="border-pink-500/20"
                  hoverBgColor="hover:bg-pink-900/30"
                  className="text-center font-serif"
                />
              {states.slice(0, 6).map(state =>(
                <Card 
                  href={`/moteles/estados/${state.slug}`}
                  title={state.name}
                  bgColor="bg-[#2A2A2A]"
                  textColor="text-pink-300"
                  borderColor="border-pink-500/20"
                  hoverBgColor="hover:bg-pink-900/30"
                  className="text-center font-serif"
                />
              ))}
            </div>
            
            {states.length > 6 && (
              <div class="text-center mt-8">
                <a 
                  href="/moteles/estados"
                  class="inline-block px-8 py-3 bg-pink-500 text-white rounded-lg font-serif hover:bg-pink-400 transition-colors"
                >
                  Ver todos los estados
                </a>
              </div>
            )}
          </div>

          <!-- Guía de precios y consejos -->
          <div class="bg-[#1E1E1E] rounded-xl p-8 shadow-md mt-16 border border-pink-500/20">
            <h2 class="text-2xl md:text-3xl font-serif font-bold text-pink-400 mb-6 text-center">Guía de Precios y Consejos</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div>
                <h3 class="text-xl font-semibold text-pink-300 mb-4">💰 Rangos de Precios</h3>
                <ul class="space-y-2 text-gray-300">
                  <li><span class="text-green-400">$</span> - $300-450 por 4 horas</li>
                  <li><span class="text-yellow-400">$$</span> - $450-600 por 4 horas</li>
                  <li><span class="text-orange-400">$$$</span> - $600-800 por sesión</li>
                  <li><span class="text-red-400">$$$$</span> - $800+ por sesión premium</li>
                </ul>
              </div>
              
              <div>
                <h3 class="text-xl font-semibold text-pink-300 mb-4">💡 Consejos Útiles</h3>
                <ul class="space-y-2 text-gray-300 text-sm">
                  <li>• Los fines de semana suele haber más demanda</li>
                  <li>• Algunos moteles permiten reservaciones entre semana</li>
                  <li>• Verifica las amenidades antes de llegar</li>
                  <li>• Los precios pueden variar según la temporada</li>
                  <li>• Lleva efectivo, no todos aceptan tarjeta</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- FAQ Section para SEO -->
          <div class="mt-16 bg-[#1E1E1E] rounded-xl p-8 shadow-md border border-pink-500/20">
            <h2 class="text-3xl font-serif font-bold text-pink-400 mb-8 text-center">Preguntas Frecuentes sobre Moteles en Monterrey</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-[#2A2A2A] rounded-lg p-6 shadow-sm">
                <h3 class="text-xl font-serif font-bold text-pink-300 mb-3">¿Cuáles son los mejores moteles en Monterrey?</h3>
                <p class="text-gray-300">Los mejores moteles incluyen Motel Love (cerca de Universidad), Kyoto Suites Monterrey con cocheras privadas, y Motel Marbella por sus amenidades de lujo. También destacan ATM Motel y Motel Señorial.</p>
              </div>

              <div class="bg-[#2A2A2A] rounded-lg p-6 shadow-sm">
                <h3 class="text-xl font-serif font-bold text-pink-300 mb-3">¿Dónde encontrar moteles baratos en Monterrey?</h3>
                <p class="text-gray-300">Para moteles económicos recomendamos Hotel White (desde $300 por 12 horas), Grand Motel en zona Treviño, y Super Motel en Rangel Frías. Todos ofrecen excelente relación calidad-precio.</p>
              </div>

              <div class="bg-[#2A2A2A] rounded-lg p-6 shadow-sm">
                <h3 class="text-xl font-serif font-bold text-pink-300 mb-3">¿Qué moteles tienen jacuzzi en Monterrey?</h3>
                <p class="text-gray-300">Motel Marbella, Motel Canarias y varios moteles premium ofrecen jacuzzi privado. Los precios van desde $600-800 por sesión, perfectos para una experiencia romántica especial.</p>
              </div>

              <div class="bg-[#2A2A2A] rounded-lg p-6 shadow-sm">
                <h3 class="text-xl font-serif font-bold text-pink-300 mb-3">¿Cuáles son los moteles en el centro de Monterrey?</h3>
