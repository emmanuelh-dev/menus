// Configuración para SEO
const seoData = {
  title: "Mejores Moteles en Monterrey 2025 | Guía Completa",
  description: "Descubre los mejores moteles en Monterrey. Encuentra el lugar perfecto para una escapada romántica con información detallada sobre precios, ubicación, horarios y servicios.",
  keywords: ["moteles monterrey", "moteles baratos monterrey", "love hotel monterrey", "moteles con jacuzzi", "moteles privados monterrey"],
};

// Configuración para Schema.org
const schemaEnrichment = {
  address: {
    addressLocality: "Monterrey",
    addressRegion: "Nuevo León", 
    addressCountry: "MX",
  },
};
---

<RestaurantLayout 
  title={seoData.title}
  description={seoData.description}
  schemaEnrichment={schemaEnrichment}
  backgroundColor="bg-black"
  textWhite={true}
>
<main>
    <section class="relative overflow-hidden">
        <!-- Background Image with Overlay -->
        <div class="absolute inset-0 bg-cover bg-center" style="background-image: linear-gradient(135deg, #667eea 0%, #764ba2 100%); filter: brightness(0.3);"></div>
        
        <!-- Content -->
        <div class="relative z-10 max-w-6xl mx-auto px-4 py-24 md:py-32 text-center">
            <span class="inline-block bg-pink-500 text-white px-4 py-1 rounded-full text-sm font-medium mb-6 animate-pulse">💕 Romance & Privacidad</span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-pink-300 font-serif tracking-tight">{seoData.title}</h1>
            <p class="text-xl md:text-2xl text-white/90 max-w-3xl mx-auto mb-8">{seoData.description}</p>
        </div>

    </section>

    <section class="min-h-screen bg-black text-white py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
          <!-- Filtros interactivos -->
          <div class="mb-12 flex flex-wrap justify-center gap-4">
            <button id="filter-all" class="filter-btn px-6 py-2 bg-pink-500 text-white rounded-full font-serif hover:bg-pink-400 transition-colors" data-filter="all">Todos</button>
            <button id="filter-premium" class="filter-btn px-6 py-2 bg-[#1E1E1E] text-gray-300 rounded-full font-serif hover:bg-pink-500 hover:text-white transition-colors" data-filter="premium">Premium</button>
            <button id="filter-rated" class="filter-btn px-6 py-2 bg-[#1E1E1E] text-gray-300 rounded-full font-serif hover:bg-pink-500 hover:text-white transition-colors" data-filter="rated">Mejor calificados</button>
            <button id="filter-amenities" class="filter-btn px-6 py-2 bg-[#1E1E1E] text-gray-300 rounded-full font-serif hover:bg-pink-500 hover:text-white transition-colors" data-filter="amenities">Con amenidades</button>
          </div>

          <!-- Recomendación personal del autor -->
          <div class="mb-12 bg-gradient-to-r from-pink-900/50 to-purple-900/50 rounded-xl p-6 border border-pink-500/20">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-pink-500 rounded-full flex items-center justify-center">
                  <span class="text-white font-bold text-lg">👤</span>
                </div>
              </div>
              <div>
                <h3 class="text-xl font-bold text-pink-300 mb-2">Recomendación Personal del Autor</h3>
                <p class="text-gray-300 mb-3">
                  Mi favorito personal es el <strong class="text-pink-300">Motel Love</strong>, que está cerca de Universidad. 
                  Es tan bueno que a veces hay mucha fila, así que hay que llegar con tiempo. 
                  La experiencia vale totalmente la pena: excelentes instalaciones, privacidad garantizada y un servicio de primera.
                </p>
                <div class="flex items-center gap-2 text-sm text-pink-400">
                  <Star className="w-4 h-4 fill-current" />
                  <span>Recomendación especial del equipo</span>
                </div>
              </div>
            </div>
          </div>
    
          <!-- Grid de moteles con diseño creativo -->
          <div id="moteles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {motelesList.map((motel) => (
              <div 
                class={`motel-card group relative overflow-hidden rounded-xl bg-[#1E1E1E] shadow-md hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border ${motel.highlight ? 'border-pink-500/50 bg-gradient-to-br from-pink-900/20 to-purple-900/20' : 'border-pink-500/20'} hover:border-pink-500/50`}
                data-rating={motel.rating}
                data-price-range={motel.priceRange}
                data-has-amenities={motel.amenities.length > 3 ? "true" : "false"}
              >
                <!-- Imagen con overlay -->
                <div class="relative h-48 overflow-hidden">
                  <img
                    src={motel.image.src || placeholder.src} 
                    alt={motel.name}
                    width={500}
                    height={300}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-70"></div>
                  
                  <!-- Calificación y precio -->
                  <div class="absolute bottom-3 left-3 flex items-center space-x-2">
                    <div class="flex items-center bg-black/90 px-2 py-1 rounded-full">
                      <Star className="w-4 h-4 text-pink-400 mr-1" />
                      <span class="text-sm font-medium text-white">{motel.rating}</span>
                      <span class="text-xs text-gray-400 ml-1">({motel.reviewCount})</span>
                    </div>
                    <div class="bg-black/90 px-2 py-1 rounded-full">
                      <span class="text-sm font-medium text-white">{motel.priceRange}</span>
                    </div>
                  </div>
    
                  <!-- Destacado -->
                  {motel.highlight && (
                    <div class="absolute top-3 left-3 bg-pink-500 text-white px-2 py-1 rounded-full text-xs font-semibold animate-pulse">
                      ⭐ Recomendado
                    </div>
                  )}
                </div>
    
                <!-- Contenido de la tarjeta -->
                <div class="p-5">
                  <h3 class="font-serif text-xl font-bold text-pink-400 mb-2 group-hover:text-pink-300 transition-colors">
                    {motel.name}
                  </h3>
    
                  <!-- Estado (24 horas) -->
                  <div class="flex items-center mb-3">
                    <Clock className="w-4 h-4 text-gray-400 mr-2" />
                    <span class="text-sm text-green-400">Abierto 24 horas</span>
                  </div>                  <!-- Dirección -->
                  <div class="flex items-start mb-3">
                    <MapPin className="w-4 h-4 text-gray-400 mr-2 mt-0.5" />
                    <div class="flex flex-col">
                      <span class="text-sm text-gray-300">{motel.address}</span>
                    </div>
                  </div>

                  <!-- Teléfono -->
                  {motel.phone && (
                    <div class="flex items-center mb-3">
                      <Phone className="w-4 h-4 text-gray-400 mr-2" />
                      <a href={`tel:${motel.phone}`} class="text-sm text-pink-400 hover:text-pink-300 transition-colors">
                        {motel.phone}
                      </a>
                    </div>
                  )}
    
                  <!-- Especialidades -->
                  <div class="flex flex-wrap gap-2 mt-3 mb-3">
                    {motel.specialties && motel.specialties.map((specialty) => (
                      <span class="text-xs bg-[#2A2A2A] text-pink-400 px-2 py-1 rounded-full">{specialty}</span>
                    ))}
                  </div>
    
                  <!-- Amenidades disponibles con iconos -->
                  <div class="grid grid-cols-2 gap-2 mt-4">
                    {motel.amenities && motel.amenities.slice(0, 6).map((amenity) => (
                      <div class="flex items-center text-xs text-gray-300">
                        {amenity.toLowerCase().includes('wifi') && <Wifi className="w-3 h-3 mr-1 text-blue-400" />}
                        {amenity.toLowerCase().includes('estacionamiento') && <Car className="w-3 h-3 mr-1 text-green-400" />}
                        {amenity.toLowerCase().includes('aire') && <Snowflake className="w-3 h-3 mr-1 text-cyan-400" />}
                        {amenity.toLowerCase().includes('alberca') && <Waves className="w-3 h-3 mr-1 text-blue-400" />}
                        {amenity.toLowerCase().includes('restaurante') && <Utensils className="w-3 h-3 mr-1 text-orange-400" />}
                        {amenity.toLowerCase().includes('bar') && <Martini className="w-3 h-3 mr-1 text-purple-400" />}
                        <span class="truncate">{amenity}</span>
                      </div>
                    ))}
                  </div>
    
                  <!-- Información adicional -->
                  {motel.distance && (
                    <div class="mt-3 p-2 bg-[#2A2A2A] rounded-lg">
                      <p class="text-xs text-yellow-400">ℹ️ {motel.distance}</p>
                    </div>
                  )}
    
                  <!-- Botón de acción -->
                  <div class="mt-5">
                    {motel.menu ? (
                      <a 
                        href={motel.menu} 
                        class="inline-block w-full text-center py-2 bg-pink-500 text-white rounded-lg font-serif hover:bg-pink-400 transition-colors"
                      >
                        Ver Información
                      </a>
                    ) : (
                      <button 
                        class="w-full py-2 bg-[#2A2A2A] text-pink-400 rounded-lg font-serif hover:bg-[#3A3A3A] transition-colors"
                      >
                        Más Información
                      </button>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
    
          <!-- Sección de destacados -->
          <div class="mt-20 mb-16">
            <h2 class="text-3xl md:text-4xl font-serif font-bold text-pink-400 mb-8 text-center">Moteles Destacados</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <!-- Motel destacado 1 -->
              <div class="bg-[#1E1E1E] rounded-xl overflow-hidden shadow-lg flex flex-col md:flex-row border border-pink-500/20">
                <div class="md:w-2/5 relative">
                  <img
                    src={placeholder.src} 
                    alt="Motel Love"
                    width={400}
                    height={500}
                    class="w-full h-full object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-r from-black/50 to-transparent md:bg-gradient-to-t"></div>
                  <div class="absolute bottom-4 left-4 md:bottom-auto md:top-4">
                    <div class="bg-black/90 px-2 py-1 rounded-full inline-block">
                      <Star className="w-4 h-4 text-pink-400 inline mr-1" />
                      <span class="text-sm font-medium text-white">4.6 (1.1K)</span>
                    </div>
                  </div>
                </div>
                <div class="md:w-3/5 p-6">
                  <h3 class="font-serif text-2xl font-bold text-pink-400 mb-2">Motel Love</h3>
                  <p class="text-gray-300 mb-4">El favorito personal del autor. Ubicado cerca de Universidad, este motel ofrece una experiencia premium con instalaciones de primera clase y un ambiente romántico inigualable.</p>
                  <div class="flex items-center mb-2">
                    <MapPin className="w-4 h-4 text-gray-400 mr-2" />
                    <span class="text-sm text-gray-300">Cerca de Universidad, Monterrey</span>
                  </div>
                  <div class="flex items-center mb-4">
                    <DollarSign className="w-4 h-4 text-gray-400 mr-2" />
                    <span class="text-sm text-gray-300">$600–800 por sesión</span>
                  </div>
                  <div class="bg-pink-900/30 border border-pink-500/30 rounded-lg p-3 mb-4">
                    <p class="text-pink-300 text-sm">💡 <strong>Tip:</strong> Llega con tiempo, especialmente los fines de semana, ya que suele haber fila por su alta demanda.</p>
                  </div>
                </div>
              </div>
              
              <!-- Motel destacado 2 -->
              <div class="bg-[#1E1E1E] rounded-xl overflow-hidden shadow-lg flex flex-col md:flex-row border border-pink-500/20">
                <div class="md:w-2/5 relative">
                  <img
                    src={placeholder.src} 
                    alt="Kyoto Suites"
                    width={400}
                    height={500}
                    class="w-full h-full object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-r from-black/50 to-transparent md:bg-gradient-to-t"></div>
                  <div class="absolute bottom-4 left-4 md:bottom-auto md:top-4">
                    <div class="bg-black/90 px-2 py-1 rounded-full inline-block">
                      <Star className="w-4 h-4 text-pink-400 inline mr-1" />
                      <span class="text-sm font-medium text-white">4.5 (951)</span>
                    </div>
                  </div>
                </div>
                <div class="md:w-3/5 p-6">
                  <h3 class="font-serif text-2xl font-bold text-pink-400 mb-2">Kyoto Suites Motel</h3>
                  <p class="text-gray-300 mb-4">Conocido por su privacidad total con cocheras cerradas. Perfecto para quienes buscan discreción absoluta con un ambiente inspirado en el diseño japonés.</p>
                  <div class="flex items-center mb-2">
                    <MapPin className="w-4 h-4 text-gray-400 mr-2" />
                    <span class="text-sm text-gray-300">Monterrey, Nuevo León</span>
                  </div>
                  <div class="flex items-center mb-4">
                    <DollarSign className="w-4 h-4 text-gray-400 mr-2" />
                    <span class="text-sm text-gray-300">$600–800 por 8h fin de semana</span>
                  </div>
                  <div class="bg-yellow-900/30 border border-yellow-500/30 rounded-lg p-3 mb-4">
                    <p class="text-yellow-300 text-sm">⏰ <strong>Horarios:</strong> 8-12h entre semana, puede haber fila de 30-40 min los fines de semana.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Guía de precios y consejos -->
          <div class="bg-[#1E1E1E] rounded-xl p-8 shadow-md mt-16 border border-pink-500/20">
            <h2 class="text-2xl md:text-3xl font-serif font-bold text-pink-400 mb-6 text-center">Guía de Precios y Consejos</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div>
                <h3 class="text-xl font-semibold text-pink-300 mb-4">💰 Rangos de Precios</h3>
                <ul class="space-y-2 text-gray-300">
                  <li><span class="text-green-400">$</span> - $300-450 por 4 horas</li>
                  <li><span class="text-yellow-400">$$</span> - $450-600 por 4 horas</li>
                  <li><span class="text-orange-400">$$$</span> - $600-800 por sesión</li>
                  <li><span class="text-red-400">$$$$</span> - $800+ por sesión premium</li>
                </ul>
              </div>
              
              <div>
                <h3 class="text-xl font-semibold text-pink-300 mb-4">💡 Consejos Útiles</h3>
                <ul class="space-y-2 text-gray-300 text-sm">
                  <li>• Los fines de semana suele haber más demanda</li>
                  <li>• Algunos moteles permiten reservaciones entre semana</li>
                  <li>• Verifica las amenidades antes de llegar</li>
                  <li>• Los precios pueden variar según la temporada</li>
                  <li>• Lleva efectivo, no todos aceptan tarjeta</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Sección de registro de motel -->
          <div class="bg-[#1E1E1E] rounded-xl p-8 shadow-md mt-16 border border-pink-500/20">
            <h2 class="text-2xl md:text-3xl font-serif font-bold text-pink-400 mb-4 text-center">¿Tienes un motel?</h2>
            <p class="text-center text-gray-300 max-w-2xl mx-auto mb-6">Registra tu motel en nuestra plataforma y muestra tus servicios a miles de personas que buscan el lugar perfecto para su escapada romántica.</p>
            <div class="text-center">
              <a 
                href="/contact" 
                class="inline-block px-8 py-3 bg-pink-500 text-white rounded-lg font-serif hover:bg-pink-400 transition-colors"
              >
                Registrar mi Motel
              </a>
            </div>
          </div>
        </div>
      </section>
</main>
</RestaurantLayout>

<script>
// Funcionalidad de filtros
document.addEventListener('DOMContentLoaded', function() {
  const filterButtons = document.querySelectorAll('.filter-btn');
  const motelCards = document.querySelectorAll('.motel-card');

  filterButtons.forEach(button => {
    button.addEventListener('click', function() {
      const filter = this.getAttribute('data-filter');
      
      // Actualizar botones activos
      filterButtons.forEach(btn => {
        btn.classList.remove('bg-pink-500', 'text-white');
        btn.classList.add('bg-[#1E1E1E]', 'text-gray-300');
      });
      
      this.classList.remove('bg-[#1E1E1E]', 'text-gray-300');
      this.classList.add('bg-pink-500', 'text-white');

      // Filtrar tarjetas
      motelCards.forEach(card => {
        let shouldShow = true;

        if (filter === 'premium') {
          const priceRange = card.getAttribute('data-price-range');
          shouldShow = priceRange === '$$$$' || priceRange === '$$$';
        } else if (filter === 'rated') {
          const ratingAttr = card.getAttribute('data-rating');
          const rating = ratingAttr ? parseFloat(ratingAttr) : 0;
          shouldShow = rating >= 4.3;
        } else if (filter === 'amenities') {
          const hasAmenities = card.getAttribute('data-has-amenities') === 'true';
          shouldShow = hasAmenities;
        }

        if (shouldShow) {
          (card as HTMLElement).style.display = 'block';
          (card as HTMLElement).style.opacity = '1';
        } else {
          (card as HTMLElement).style.display = 'none';
          (card as HTMLElement).style.opacity = '0';
        }
      });
    });
  });
});
</script>

<style>
  .motel-card {
    transition: all 0.3s ease;
  }
  
  .motel-card:hover {
    transform: translateY(-5px);
  }
  
  .filter-btn {
    transition: all 0.3s ease;
  }

  .font-serif {
    font-family: "Playfair Display", serif;
  }
</style>
