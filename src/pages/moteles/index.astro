---
import MotelLayout from "../../layouts/MotelLayout.astro";
import MotelBusinessSchema from "../../components/MotelBusinessSchema.astro";
import MotelBreadcrumbSchema from "../../components/MotelBreadcrumbSchema.astro";
import MotelCard from "../../components/MotelCard.astro";
import Card from "../../components/Card.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getRestaurants, getStates } from "../../lib/api";
import { Star, DollarSign } from "lucide-react";


const [motelesList, states] = await Promise.all([
  getRestaurants({ type: 'motel' }),
  getStates()
]);

const url = new URL(Astro.request.url);
const zona = url.searchParams.get('zona') || undefined;
const tipo = url.searchParams.get('tipo') || undefined;

const getDynamicSEO = () => {
  const baseTitle = "Mejores Moteles en Monterrey 2026";
  const baseDescription = "Guía completa de moteles en Monterrey";
  const baseKeywords = ["moteles monterrey", "motel monterrey"];
  const baseUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();

  // SEO por zona específica
  if (zona) {
    switch (zona.toLowerCase()) {
      case 'centro':
        return {
          title: `Moteles en Centro de Monterrey 2026 | Hotel Los Angeles y Más`,
          description: `Mejores moteles en el centro de Monterrey. Hotel Los Angeles, opciones económicas y ubicación céntrica. Guía completa con precios.`,
          keywords: [...baseKeywords, "moteles en el centro de monterrey", "motel en monterrey centro", "moteles centro monterrey", "hotel los angeles monterrey"],
          heading: "Moteles en Centro de Monterrey",
          subheading: "Los mejores moteles en el corazón de la ciudad",
          canonical: `${baseUrl}?zona=centro`,
          ogUrl: `${baseUrl}?zona=centro`
        };
      
      case 'universidad':
        return {
          title: `Moteles cerca de Universidad Monterrey 2026 | Motel Love Recomendado`,
          description: `Moteles cerca de Universidad en Monterrey. Motel Love (favorito del autor), opciones premium y ubicación conveniente. Precios y horarios.`,
          keywords: [...baseKeywords, "motel cerca universidad monterrey", "motel love monterrey", "moteles universidad"],
          heading: "Moteles cerca de Universidad",
          subheading: "Opciones premium cerca de la zona universitaria",
          canonical: `${baseUrl}?zona=universidad`,
          ogUrl: `${baseUrl}?zona=universidad`
        };
        
      case 'cumbres':
        return {
          title: `Moteles en Cumbres Monterrey 2026 | Hacienda Cumbres y Más`,
          description: `Moteles en zona Cumbres, Monterrey. Motel Hacienda Cumbres, opciones de lujo y privacidad. Guía con precios actualizados.`,
          keywords: [...baseKeywords, "moteles cumbres monterrey", "motel hacienda cumbres", "moteles zona cumbres"],
          heading: "Moteles en Cumbres",
          subheading: "Opciones premium en la zona más exclusiva",
          canonical: `${baseUrl}?zona=cumbres`,
          ogUrl: `${baseUrl}?zona=cumbres`
        };
    }
  }

  // SEO por tipo de motel
  if (tipo) {
    switch (tipo.toLowerCase()) {
      case 'baratos':
        return {
          title: `Moteles Baratos en Monterrey 2026 | Desde $300 por 4 Horas`,
          description: `Moteles baratos en Monterrey con los mejores precios. Hotel White, Grand Motel y más opciones económicas. Guía de precios 2026.`,
          keywords: [...baseKeywords, "moteles baratos en monterrey", "motel barato monterrey", "moteles economicos monterrey", "moteles precio bajo"],
          heading: "Moteles Baratos en Monterrey",
          subheading: "Las mejores opciones económicas sin sacrificar calidad",
          canonical: `${baseUrl}?tipo=baratos`,
          ogUrl: `${baseUrl}?tipo=baratos`
        };
      
      case 'jacuzzi':
        return {
          title: `Moteles con Jacuzzi en Monterrey 2026 | Marbella, Canarias y Más`,
          description: `Moteles con jacuzzi en Monterrey. Motel Marbella, Canarias y opciones de lujo con jacuzzi privado. Precios y ubicaciones.`,
          keywords: [...baseKeywords, "motel con jacuzzi monterrey", "moteles con jacuzzi en monterrey", "motel jacuzzi privado", "moteles lujo jacuzzi"],
          heading: "Moteles con Jacuzzi en Monterrey",
          subheading: "Experiencia de lujo con jacuzzi privado",
          canonical: `${baseUrl}?tipo=jacuzzi`,
          ogUrl: `${baseUrl}?tipo=jacuzzi`
        };
        
      case '12-horas':
        return {
          title: `Moteles de 12 Horas en Monterrey 2026 | Hotel White y Más`,
          description: `Moteles con estancia de 12 horas en Monterrey. Hotel White y opciones para escapadas largas. Precios especiales para 12 horas.`,
          keywords: [...baseKeywords, "motel 12 horas monterrey", "motel de 12 horas en monterrey", "estancia larga motel"],
          heading: "Moteles de 12 Horas",
          subheading: "Escapadas largas con los mejores precios",
          canonical: `${baseUrl}?tipo=12-horas`,
          ogUrl: `${baseUrl}?tipo=12-horas`
        };
    }
  }

  // SEO por defecto optimizado
  return {
    title: baseTitle + " | Motel Love, Kyoto y Más",
    description: baseDescription + ". Encuentra moteles baratos, con jacuzzi y los mejores de la ciudad. Motel Love (recomendado), Kyoto Suites, Marbella y más. Precios, ubicaciones y recomendaciones actualizadas.",
    keywords: [
      ...baseKeywords,
      "moteles baratos en monterrey",
      "motel con jacuzzi monterrey", 
      "mejores moteles en monterrey",
      "moteles con jacuzzi en monterrey",
      "motel en monterrey centro",
      "moteles en el centro de monterrey",
      "moteles mty",
      "moteles en mty",
      "mejores moteles monterrey",
      "motel barato monterrey",
      "motel de 12 horas en monterrey",
      "kyoto motel mty",
      "kyoto suites monterrey",
      "grand motel monterrey",
      "marbella motel monterrey",
      "motel love monterrey"
    ],
    heading: "Mejores Moteles en Monterrey 2026",
    subheading: "Encuentra el lugar perfecto para tu escapada romántica en la ciudad",
    canonical: baseUrl,
    ogUrl: baseUrl
  };
};

const seoData = getDynamicSEO();

// Generar breadcrumbs dinámicos
const getBreadcrumbs = () => {
  const breadcrumbs = [
    { label: 'Inicio', href: '/' },
    { label: 'Moteles', href: '/moteles' }
  ];

  if (zona) {
    const zonaLabels = {
      'centro': 'Centro',
      'universidad': 'Universidad',
      'cumbres': 'Cumbres'
    };
    breadcrumbs.push({ label: zonaLabels[zona.toLowerCase()] || zona } as any);
  } else if (tipo) {
    const tipoLabels = {
      'baratos': 'Moteles Baratos',
      'jacuzzi': 'Con Jacuzzi',
      '12-horas': '12 Horas'
    };
    breadcrumbs.push({ label: tipoLabels[tipo.toLowerCase()] || tipo } as any);
  }

  return breadcrumbs;
};

const breadcrumbItems = getBreadcrumbs();

// Configuración para Schema.org
const schemaEnrichment = {
  address: {
    addressLocality: "Monterrey",
    addressRegion: "Nuevo León", 
    addressCountry: "MX",
  },
};

---

<MotelLayout 
  title={seoData.title}
  description={seoData.description}
  schemaEnrichment={schemaEnrichment}
  backgroundColor="bg-gradient-to-r from-[#4a5568] to-[#553c7b]"
  textWhite={true}
  canonical={seoData.canonical}
  ogUrl={seoData.ogUrl}
><!-- Motel Business Structured Data -->
  <MotelBusinessSchema moteles={motelesList} />
  
  <!-- Breadcrumb Structured Data -->
  <MotelBreadcrumbSchema zona={zona} tipo={tipo} />

<main>
    <section class="min-h-screen bg-black text-white pt-6 pb-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          
          <Breadcrumbs items={breadcrumbItems} />
          
          <!-- Cabecera Minimalista -->
          <div class="mt-6 mb-10">
            <h1 class="text-3xl md:text-5xl font-bold text-neutral-400 font-serif tracking-tight mb-3">{seoData.heading}</h1>
            <p class="text-base md:text-lg text-neutral-300 max-w-3xl">{seoData.subheading}. Guía con precios actualizados, fotos de habitaciones y ubicaciones en mapa.</p>
          </div>
          
          <!-- Banner: Califica y ayuda a otros -->
          <div class="mb-8 bg-[#1a0a1a] border border-neutral-500/20 rounded-xl px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class="p-2 bg-neutral-500/10 rounded-full">
                <Star className="w-5 h-5 text-neutral-400" fill="currentColor" />
              </div>
              <div>
                <p class="text-white font-bold text-sm">¿Ya fuiste a un motel? Deja tu calificación</p>
                <p class="text-neutral-400 text-xs mt-0.5">Tus reseñas ayudan a otros usuarios a elegir mejor</p>
              </div>
            </div>
            <p class="text-neutral-400 text-xs font-semibold tracking-wide text-center sm:text-right shrink-0">
              Entra al motel y<br class="hidden sm:block" /> califica dentro de la página
            </p>
          </div>

          <!-- Grid de moteles -->
          <div id="moteles-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-6">
            {motelesList
              .sort((a, b) => {
                if (a.featured !== b.featured) {
                  return a.featured ? -1 : 1;
                }
                return b.rating - a.rating;
              })
              .map((motel) => <MotelCard motel={motel} />)}
          </div>
    
          <div class="mt-20 mb-16">
            <h2 class="text-3xl md:text-4xl font-serif font-bold text-neutral-400 mb-8 text-center">Moteles por Estado</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              <Card 
                  href={`/moteles/estados/nuevo-leon`}
                  title={'Nuevo León'}
                  bgColor="bg-[#2A2A2A]"
                  textColor="text-neutral-300"
                  borderColor="border-neutral-500/20"
                  hoverBgColor="hover:bg-neutral-900/30"
                  className="text-center font-serif"
                />
              {states.slice(0, 6).map(state =>(
                <Card 
                  href={`/moteles/estados/${state.slug}`}
                  title={state.name}
                  bgColor="bg-[#2A2A2A]"
                  textColor="text-neutral-300"
                  borderColor="border-neutral-500/20"
                  hoverBgColor="hover:bg-neutral-900/30"
                  className="text-center font-serif"
                />
              ))}
            </div>
            
            {states.length > 6 && (
              <div class="text-center mt-8">
                <a
                  href="/moteles/estados"
                  class="inline-block px-8 py-3 bg-neutral-500 text-white rounded-lg font-serif hover:bg-neutral-400 transition-colors"
                >
                  Ver todos los estados
                </a>
              </div>
            )}
          </div>

          <!-- Guías: Mejores Moteles por Estado (blog) -->
          <div class="mt-16">
            <h2 class="text-3xl md:text-4xl font-serif font-bold text-neutral-400 mb-8 text-center">Guías: Mejores Moteles por Estado</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              {[
                { href: '/blog/mejores-moteles-en-monterrey', label: 'Mejores Moteles de Monterrey' },
                { href: '/blog/mejores-moteles-de-jalisco', label: 'Mejores Moteles de Jalisco' },
                { href: '/blog/mejores-moteles-de-hidalgo', label: 'Mejores Moteles de Hidalgo' },
                { href: '/blog/mejores-moteles-de-guanajuato', label: 'Mejores Moteles de Guanajuato' },
                { href: '/blog/mejores-moteles-de-chiapas', label: 'Mejores Moteles de Chiapas' },
                { href: '/blog/mejores-moteles-de-coahuila', label: 'Mejores Moteles de Coahuila' },
                { href: '/blog/mejores-moteles-de-guerrero', label: 'Mejores Moteles de Guerrero' },
              ].map(guide => (
                <a
                  href={guide.href}
                  class="bg-[#1E1E1E] border border-neutral-500/20 hover:border-neutral-500/50 rounded-xl p-4 text-center font-serif text-neutral-300 hover:text-neutral-200 transition-colors"
                >
                  {guide.label}
                </a>
              ))}
            </div>
          </div>

          <!-- Guía de precios y consejos -->
          <div class="bg-[#1E1E1E] rounded-xl p-8 shadow-md mt-16 border border-neutral-500/20">
            <h2 class="text-2xl md:text-3xl font-serif font-bold text-neutral-400 mb-6 text-center">Guía de Precios y Consejos</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div>
                <h3 class="text-xl font-semibold text-neutral-300 mb-4 flex items-center gap-2">
                  <DollarSign className="w-5 h-5 text-neutral-400" />
                  Rangos de Precios
                </h3>
                <ul class="space-y-2 text-neutral-300">
                  <li><span class="text-marca-400">$</span> - $300-450 por 4 horas</li>
                  <li><span class="text-neutral-400">$$</span> - $450-600 por 4 horas</li>
                  <li><span class="text-neutral-400">$$$</span> - $600-800 por sesión</li>
                  <li><span class="text-red-400">$$$$</span> - $800+ por sesión premium</li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-neutral-300 mb-4">Consejos Útiles</h3>
                <ul class="space-y-2 text-neutral-300 text-sm">
                  <li>• Los fines de semana suele haber más demanda</li>
                  <li>• Algunos moteles permiten reservaciones entre semana</li>
                  <li>• Verifica las amenidades antes de llegar</li>
                  <li>• Los precios pueden variar según la temporada</li>
                  <li>• Lleva efectivo, no todos aceptan tarjeta</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- FAQ Section para SEO -->
          <div class="mt-16 bg-[#1E1E1E] rounded-xl p-8 shadow-md border border-neutral-500/20">
            <h2 class="text-3xl font-serif font-bold text-neutral-400 mb-8 text-center">Preguntas Frecuentes sobre Moteles en Monterrey</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-[#2A2A2A] rounded-lg p-6 shadow-sm">
                <h3 class="text-xl font-serif font-bold text-neutral-300 mb-3">¿Cuáles son los mejores moteles en Monterrey?</h3>
                <p class="text-neutral-300">Los mejores moteles incluyen Motel Love (cerca de Universidad), Kyoto Suites Monterrey con cocheras privadas, y Motel Marbella por sus amenidades de lujo. También destacan ATM Motel y Motel Señorial.</p>
              </div>

              <div class="bg-[#2A2A2A] rounded-lg p-6 shadow-sm">
                <h3 class="text-xl font-serif font-bold text-neutral-300 mb-3">¿Dónde encontrar moteles baratos en Monterrey?</h3>
                <p class="text-neutral-300">Para moteles económicos recomendamos Hotel White (desde $300 por 12 horas), Grand Motel en zona Treviño, y Super Motel en Rangel Frías. Todos ofrecen excelente relación calidad-precio.</p>
              </div>

              <div class="bg-[#2A2A2A] rounded-lg p-6 shadow-sm">
                <h3 class="text-xl font-serif font-bold text-neutral-300 mb-3">¿Qué moteles tienen jacuzzi en Monterrey?</h3>
                <p class="text-neutral-300">Motel Marbella, Motel Canarias y varios moteles premium ofrecen jacuzzi privado. Los precios van desde $600-800 por sesión, perfectos para una experiencia romántica especial.</p>
              </div>

              <div class="bg-[#2A2A2A] rounded-lg p-6 shadow-sm">
                <h3 class="text-xl font-serif font-bold text-neutral-300 mb-3">¿Cuáles son los moteles en el centro de Monterrey?</h3>
                <p class="text-neutral-300">En el centro destacan Hotel Los Angeles (Centro Histórico) y opciones cerca de la zona céntrica. También hay buenas opciones en Barrio Antiguo y zonas aledañas al centro.</p>
              </div>

              <div class="bg-[#2A2A2A] rounded-lg p-6 shadow-sm">
                <h3 class="text-xl font-serif font-bold text-neutral-300 mb-3">¿Cómo son los precios de moteles en Monterrey?</h3>
                <p class="text-neutral-300">Los precios van desde $300-450 por 4 horas (económicos), $450-600 (estándar), $600-800 (premium) hasta $800+ para opciones de lujo. Los fines de semana pueden tener ligeros incrementos.</p>
              </div>

              <div class="bg-[#2A2A2A] rounded-lg p-6 shadow-sm">
                <h3 class="text-xl font-serif font-bold text-neutral-300 mb-3">¿Qué motel recomienda el autor?</h3>
                <p class="text-neutral-300">El favorito personal es Motel Love cerca de Universidad. Aunque a veces hay fila por su popularidad, ofrece excelentes instalaciones, privacidad garantizada y un servicio de primera calidad.</p>
              </div>
            </div>
          </div>

          <!-- Sección de registro de motel -->
          <div class="bg-[#1E1E1E] rounded-xl p-8 shadow-md mt-16 border border-neutral-500/20">
            <h2 class="text-2xl md:text-3xl font-serif font-bold text-neutral-400 mb-4 text-center">¿Tienes un motel?</h2>
            <p class="text-center text-neutral-300 max-w-2xl mx-auto mb-6">Registra tu motel en nuestra plataforma y muestra tus servicios a miles de personas que buscan el lugar perfecto para su escapada romántica.</p>
            <div class="text-center">
              <a 
                href="/contact" 
                class="inline-block px-8 py-3 bg-neutral-500 text-white rounded-lg font-serif hover:bg-neutral-400 transition-colors"
              >
                Registrar mi Motel
              </a>
            </div>
          </div>
        </div>
      </section>
</main>
</MotelLayout>

<style>
  .font-serif {
    font-family: "Playfair Display", serif;
  }
</style>
