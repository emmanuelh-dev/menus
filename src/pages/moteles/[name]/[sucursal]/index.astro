---
const { name, sucursal } = Astro.params;

import RestaurantLayout from "../../../../layouts/RestaurantLayout.astro";
import CategoryNavigation from "../../../../components/CategoryNavigation";
import { getRestaurantByName, supabase } from "../../../../lib/supabase";

if (!name) {
  throw new Error("No se ha especificado el nombre del restaurante");
}
const menuData = await getRestaurantByName({ name });

const restaurant = menuData[0];

const { data: menu } = await supabase
  .from("menus")
  .select("*")
  .eq("restaurant_id", restaurant?.id)
  .eq("menu", sucursal)
  .eq("is_active", true)
  .single();


const { data: categoriesData } = await supabase
  .from("menu_categories")
  .select(
    `
    *,
    menu_items (
      *
    )
  `
  )
  .eq("restaurant_id", restaurant.id)
  .eq("is_active", true)
  .order("display_order");

// Crear lista de categorías para navegación
const navigationCategories = categoriesData?.map((category) => ({
  id: `category-${category.id}`,
  name: category.name,
  description: category.description
})) || [];

if (!menuData || menuData.length === 0) {
  throw new Error(`No se encontró el restaurante: ${name}`);
}

const schemaEnrichment = {
  address: menu?.address
    ? {
        streetAddress: menu.address || restaurant.address,
        addressLocality: "Ciudad",
        addressCountry: "MX",
      }
    : undefined,
  telephone: undefined,
  priceRange: restaurant.priceRange || "$$",
  servesCuisine: restaurant.type ? [restaurant.type] : ["Restaurant"],
  openingHours: restaurant.hours || undefined,
  acceptsReservations: true,
  paymentAccepted: ["Cash", "Credit Card"],
  currenciesAccepted: ["MXN"],
  aggregateRating: restaurant.rating
    ? {
        ratingValue: restaurant.rating,
        reviewCount: restaurant.reviewCount || 1,
      }
    : undefined,
};
---

<RestaurantLayout
  title={restaurant.name + (" - " + menu?.name || "") || name}
  description={`Menú de ${restaurant.name || name}`}
  image={restaurant.image}
  textWhite={false}
  backgroundColor="bg-white"
  schemaEnrichment={schemaEnrichment}
  type="Restaurant"
>
  <!-- Componentes de navegación -->
  <CategoryNavigation 
    client:load 
    categories={navigationCategories} 
    backgroundColor="bg-white" 
    textColor="text-gray-700" 
  /><style>
    .hover-lift {
      transition: all 0.3s ease;
    }

    .hover-lift:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }
    .star-rating {
      filter: drop-shadow(0 2px 4px rgba(255, 215, 0, 0.3));
    }

    .review-form-section {
      scroll-margin-top: 100px;
    }

    /* Line clamp utility for description text */
    .line-clamp-3 {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }    /* Mobile-first menu images */

    @media (min-width: 769px) {
      .menu-image-mobile {
        object-fit: cover;
        max-height: 600px;
      }
    }

    /* Smooth animations for menu items */
    .menu-item-card {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .menu-item-card:hover {
      transform: translateY(-4px) scale(1.02);
    }

    /* Price styling */
    .price-highlight {
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }    /* Modal styles */
    .modal {
      display: none;
      position: fixed;
      z-index: 9999;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.9);
      animation: fadeIn 0.3s ease-in-out;
    }

    .modal.show {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-content {
      max-width: 90%;
      max-height: 90%;
      position: relative;
      animation: zoomIn 0.3s ease-in-out;
    }

    .modal-image {
      width: 100%;
      height: auto;
      border-radius: 8px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    .modal-close {
      position: absolute;
      top: -40px;
      right: 0;
      color: white;
      font-size: 28px;
      font-weight: bold;
      cursor: pointer;
      background: rgba(0, 0, 0, 0.5);
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background-color 0.3s ease;
    }

    .modal-close:hover {
      background: rgba(0, 0, 0, 0.8);
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes zoomIn {
      from { transform: scale(0.8); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .clickable-image {
      cursor: pointer;
      transition: transform 0.2s ease;
    }

    .clickable-image:hover {
      transform: scale(1.02);
    }
  </style>

  <!-- Image Modal -->
  <div id="imageModal" class="modal">
    <div class="modal-content">
      <span class="modal-close">&times;</span>
      <img id="modalImage" src="" alt="" class="modal-image" />
    </div>
  </div>
  <script>
    // Modal functionality
    document.addEventListener('DOMContentLoaded', function() {
      const modal = document.getElementById('imageModal') as HTMLElement;
      const modalImage = document.getElementById('modalImage') as HTMLImageElement;
      const closeBtn = document.querySelector('.modal-close') as HTMLElement;

      if (!modal || !modalImage || !closeBtn) return;

      // Function to open modal
      function openModal(imageSrc: string, imageAlt: string) {
        modalImage.src = imageSrc;
        modalImage.alt = imageAlt;
        modal.classList.add('show');
        document.body.style.overflow = 'hidden';
      }

      // Function to close modal
      function closeModal() {
        modal.classList.remove('show');
        document.body.style.overflow = 'auto';
      }

      // Add click listeners to all clickable images
      const clickableImages = document.querySelectorAll('.clickable-image');
      clickableImages.forEach(function(img) {
        const imageElement = img as HTMLImageElement;
        imageElement.addEventListener('click', function() {
          if (this.src && this.alt !== undefined) {
            openModal(this.src, this.alt);
          }
        });
      });

      // Close modal events
      closeBtn.addEventListener('click', closeModal);
      
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          closeModal();
        }
      });

      // Close with Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.classList.contains('show')) {
          closeModal();
        }
      });
    });
  </script>

  <div class="min-h-screen bg-gradient-to-br from-orange-50 to-red-50">
    <!-- Hero Section - Focused on Review Invitation -->
    <div class="bg-white shadow-lg">
      <div class="mx-auto px-4 py-12">
        <div class="text-center">
          {
            restaurant.image && (
              <div class="mb-8">
                <img
                  src={restaurant.image}
                  alt={restaurant.name}
                  class="w-48 h-48  mx-auto rounded-full shadow-xl border-4 border-orange-200 object-cover"
                />
              </div>
            )
          }
          <h1 class="text-5xl font-bold text-gray-900 mb-4">
            {restaurant.name}
            {menu ? ` - ${menu.name}` : sucursal?.toUpperCase()}
          </h1>

          <!-- Rating Display -->
          {
            restaurant.rating && (
              <div class="flex items-center justify-center mb-8">
                <div class="flex items-center space-x-1">
                  {Array.from({ length: 5 }, (_, i) => (
                    <svg
                      class={`w-8 h-8 ${i < Math.floor(restaurant.rating) ? "text-yellow-400" : "text-gray-300"}`}
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                  ))}
                </div>
                {/* <span class="ml-3 text-2xl font-semibold text-gray-700">
                  {restaurant.rating}/5
                </span> */}
              </div>
            )
          }

          <!-- Main CTA for Reviews -->
          <div
            class="max-w-4xl mx-auto bg-gradient-to-r from-orange-500 to-red-500 p-8 rounded-2xl shadow-2xl"
          >
            <h2 class="text-3xl font-bold text-white mb-4">
              🍴 ¡Comparte tu Experiencia!
            </h2>
            <p class="text-orange-100 text-lg mb-6 max-w-xl mx-auto">
              ¿Has visitado {restaurant.name}? Tu opinión es valiosa para otros
              comensales. ¡Cuéntanos qué tal estuvo tu experiencia!
            </p>
            <div
              class="flex flex-col sm:flex-row gap-4 justify-center items-center"
            >
              <button
                onclick="document.querySelector('.review-form-section')?.scrollIntoView({behavior: 'smooth'})"
                class="bg-white text-orange-600 px-8 py-4 rounded-xl font-bold text-lg hover:bg-orange-50 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:scale-105"
              >
                ⭐ Escribir Reseña
              </button>
              <span class="text-orange-200 text-sm"> Solo toma 2 minutos </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Menu Section -->
    {
      !menu && (
        <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-lg p-8 text-center mb-8">
          <div class="text-6xl mb-4">🚀</div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">
            ¡Menú Digital en Construcción!
          </h3>
          <p class="text-gray-600 mb-6 max-w-2xl mx-auto">
            Estamos trabajando para traerte el menú completo de
            {restaurant.name} muy pronto. Mientras tanto, ¡tu reseña nos ayuda a
            mejorar!
          </p>
          <div class="bg-orange-50 border border-orange-200 rounded-lg p-4 max-w-md mx-auto">
            <p class="text-orange-800 font-semibold">
              🎯 ¡Sé de los primeros en calificar!
            </p>
          </div>
        </div>
      )
    }    <!-- Menu Categories Section -->
    {
      categoriesData && categoriesData.length > 0 && (
        <div class="bg-white space-y-8 py-8">
          {categoriesData.map((category) => (
            <div id={`category-${category.id}`} class="max-w-6xl mx-auto lg:px-4">
              {/* Category with Image Only - Simple Layout */}
              {category.image && (!category.menu_items || category.menu_items.length === 0) && (
                <div class="mb-8">
                  <h3 class="text-3xl font-bold mb-4 text-center text-gray-900">
                    {category.name}
                  </h3>
                  <div class="w-full">
                    <img
                      src={category.image}
                      alt={`Menú ${category.name}`}
                      class="w-full h-auto md:rounded-lg shadow-lg clickable-image"
                    />
                  </div>
                </div>
              )}

              {/* Category with Items - Rich Layout */}
              {category.menu_items && category.menu_items.length > 0 && (
                <div class="mb-12 px-4">
                  <div class="text-center mb-8">
                    <h3 class="text-4xl font-bold text-gray-900 mb-2">
                      {category.name}
                    </h3>
                    {category.description && (
                      <p class="text-gray-600 text-lg max-w-2xl mx-auto">
                        {category.description}
                      </p>
                    )}
                  </div>{/* Category Image if exists */}
                  {category.image && (
                    <div class="mb-8">
                      <img
                        src={category.image}
                        alt={`Categoría ${category.name}`}
                        class="w-full h-64 object-cover rounded-lg shadow-lg clickable-image"
                      />
                    </div>
                  )}                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {category.menu_items
                      .filter(item => item.is_active)
                      .sort((a, b) => a.display_order - b.display_order)
                      .map((item) => (
                      <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden menu-item-card">
                        {/* Item Image */}
                        {item.image && (
                          <div class="h-64 overflow-hidden relative">
                            <img
                              src={item.image}
                              alt={item.name}
                              class="w-full h-full object-cover transition-transform duration-300 hover:scale-105 clickable-image"
                            />
                            {/* Featured badge overlay */}
                            {item.is_featured && (
                              <div class="absolute top-3 right-3 bg-yellow-400 text-yellow-900 px-2 py-1 rounded-full text-xs font-bold shadow-lg">
                                ⭐ Destacado
                              </div>
                            )}
                          </div>
                        )}
                        
                        {/* Item Content */}
                        <div class="p-2">
                          <div class="flex justify-between items-start mb-2">
                            <h4 class="text-xl font-bold text-gray-900 flex-1 pr-2">
                              {item.name}
                            </h4>
                            <div class="text-right">
                              <span class="text-2xl font-bold price-highlight">
                                ${item.base_price}
                              </span>
                            </div>
                          </div>

                          {/* Description */}
                          {item.description && (
                            <p class="text-gray-600 text-sm line-clamp-3">
                              {item.description}
                            </p>
                          )}

                          {/* Tags and Features */}
                          <div class="flex flex-wrap gap-2 mb-4">
                            {item.is_spicy && (
                              <span class="bg-red-100 text-red-800 text-xs px-2 py-1 rounded-full font-semibold flex items-center">
                                🌶️ Picante
                              </span>
                            )}
                            {item.is_vegan && (
                              <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full font-semibold flex items-center">
                                🌱 Vegano
                              </span>
                            )}
                            {item.is_vegetarian && !item.is_vegan && (
                              <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full font-semibold flex items-center">
                                🥬 Vegetariano
                              </span>
                            )}
                            {item.is_gluten_free && (
                              <span class="bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded-full font-semibold flex items-center">
                                🌾 Sin Gluten
                              </span>
                            )}
                          </div>

                          {/* Additional Info */}
                          {(item.calories || item.preparation_time) && (
                            <div class="flex justify-between items-center text-sm text-gray-500 mb-3">
                              {item.calories && (
                                <span class="flex items-center">
                                  🔥 {item.calories} cal
                                </span>
                              )}
                              {item.preparation_time && (
                                <span class="flex items-center">
                                  ⏱️ {item.preparation_time} min
                                </span>
                              )}
                            </div>
                          )}

                          {/* Ingredients */}
                          {item.ingredients && (
                            <div class="mt-3 pt-3 border-t border-gray-100">
                              <p class="text-xs text-gray-500">
                                <strong>Ingredientes:</strong> {item.ingredients}
                              </p>
                            </div>
                          )}

                          {/* Allergens Warning */}
                          {item.allergens && (
                            <div class="mt-2 p-2 bg-yellow-50 border border-yellow-200 rounded text-xs">
                              <p class="text-yellow-800">
                                <strong>⚠️ Alérgenos:</strong> {item.allergens}
                              </p>
                            </div>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      )
    }
    <div class="max-w-4xl mx-auto px-4 py-8">
      <div class="bg-white rounded-2xl shadow-lg p-6 mb-8">
        <h3 class="text-2xl font-semibold text-gray-900 mb-6 text-center">
          📍 Información del Restaurante
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {
            restaurant.address && (
              <div class="flex items-center p-3 bg-gray-50 rounded-lg">
                <svg
                  class="w-5 h-5 mr-3 text-orange-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
                <div>
                  <div class="text-xs text-gray-500 uppercase font-semibold">
                    Dirección
                  </div>
                  <div class="text-sm text-gray-900">{restaurant.address}</div>
                </div>
              </div>
            )
          }

          {
            restaurant.hours && (
              <div class="flex items-center p-3 bg-gray-50 rounded-lg">
                <svg
                  class="w-5 h-5 mr-3 text-green-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                <div>
                  <div class="text-xs text-gray-500 uppercase font-semibold">
                    Horarios
                  </div>
                  <div class="text-sm text-gray-900">{restaurant.hours}</div>
                </div>
              </div>
            )
          }

          {
            restaurant.priceRange && (
              <div class="flex items-center p-3 bg-gray-50 rounded-lg">
                <svg
                  class="w-5 h-5 mr-3 text-blue-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"
                  />
                </svg>
                <div>
                  <div class="text-xs text-gray-500 uppercase font-semibold">
                    Precios
                  </div>
                  <div class="text-sm text-gray-900">
                    {restaurant.priceRange}
                  </div>
                </div>
              </div>
            )
          }

          {
            restaurant.type && (
              <div class="flex items-center p-3 bg-gray-50 rounded-lg">
                <svg
                  class="w-5 h-5 mr-3 text-purple-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
                  />
                </svg>
                <div>
                  <div class="text-xs text-gray-500 uppercase font-semibold">
                    Tipo
                  </div>
                  <div class="text-sm text-gray-900">{restaurant.type}</div>
                </div>
              </div>
            )
          }
        </div>
      </div>

      <!-- Secondary CTA Section -->
      <div
        class="max-w-4xl mx-auto bg-gradient-to-r from-blue-600 to-purple-600 rounded-2xl p-8 text-center text-white mb-8"
      >
        <h3 class="text-2xl font-bold mb-4">💬 ¿Ya visitaste este lugar?</h3>
        <p class="text-blue-100 mb-6">
          Ayuda a otros visitantes compartiendo tu experiencia. Tu opinión
          cuenta mucho para la comunidad.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <button
            onclick="document.querySelector('.review-form-section')?.scrollIntoView({behavior: 'smooth'})"
            class="bg-white text-blue-600 px-6 py-3 rounded-lg font-semibold hover:bg-blue-50 transition-colors"
          >
            📝 Calificar ahora
          </button>
          <a
            href="/contact"
            class="border-2 border-white text-white px-6 py-3 rounded-lg font-semibold hover:bg-white hover:text-blue-600 transition-colors"
          >
            📞 Contactar restaurante
          </a>
        </div>
      </div>
    </div>
  </div>
</RestaurantLayout>
