---
export const prerender = false;

Astro.response.headers.set(
  'Cache-Control', 
  'public, s-maxage=3600, stale-while-revalidate=3600'
);

const { name, state } = Astro.params;

import RestaurantLayout from "../../../layouts/RestaurantLayout.astro";
import Gallery from "../../../components/Gallery.astro";
import WhatsappButton from "../../../components/WhatsappButton";
import CopyClabe from "../../../components/CopyClabe";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { getRestaurantByName, supabase, getStates } from "../../../lib/supabase";
import MotelLayout from "../../../layouts/MotelLayout.astro";
import QuickFeed from "../../../components/QuickFeed";
import MotelPageRenderer from "../../../components/MotelPageRenderer";

if (!name) {
	throw new Error("No se ha especificado el nombre del restaurante");
}
const { data: place } = await supabase
	.from("places")
	.select("*")
	.eq("short_name", name)
	.single();

const states = await getStates();
const currentState = states.find(s => s.slug === state);
---

<MotelLayout
  place={place}
	image={place.image ? place.image : "/placeholder.svg"}
	backgroundColor="bg-[#0A0A0A]"
>
	<div
		class="min-h-screen bg-[#0A0A0A] text-stone-300 selection:bg-red-900 selection:text-white"
	>
     <div class="max-w-3xl mx-auto p-4">
			
			<Breadcrumbs 
				items={[
					{ label: 'Inicio', href: '/' },
					{ label: 'Moteles', href: '/moteles' },
					{ label: 'Estados', href: '/moteles/estados' },
					...(currentState ? [{ label: currentState.name, href: `/moteles/estados/${state}` }] : []),
					{ label: place.name }
				]}
				theme="dark"
			/>
		</div>

		<MotelPageRenderer place={place} />
	</div>

	<!-- <QuickFeed placeId={place.id} client:load /> -->
</MotelLayout>

