---
export const prerender = false;

const { name } = Astro.params;
import { getRestaurantByName } from "../../../lib/supabase";

if (!name) {
	return Astro.redirect("/moteles");
}

const restaurantData = await getRestaurantByName({ name });
const place = restaurantData[0];

if (!place) {
	return Astro.redirect("/moteles");
}

// Redirigir siempre a la nueva estructura con estados
const stateSlug = place.state_slug || "nuevo-leon";
return Astro.redirect(`/moteles/estados/${stateSlug}/${name}`, 301);
---
