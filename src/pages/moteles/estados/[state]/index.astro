---
export const prerender = false;

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=31536000, stale-while-revalidate=86400",
);
Astro.response.headers.set("Vercel-Cache-Tag", "places-all");

import MotelLayout from "../../../../layouts/MotelLayout.astro";
import MotelBusinessSchema from "../../../../components/MotelBusinessSchema.astro";
import MotelCard from "../../../../components/MotelCard.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import { getRestaurants, getStates } from "../../../../lib/api";
import { Waves, DollarSign, Clock, Car, BedDouble, MapPin } from "lucide-react";
import type { SupabasePlace } from "../../../../types/app";

// Guías del blog por estado (doc: se agregan a medida que se escriben, no
// todos los estados tienen una todavía).
const BLOG_GUIDE_BY_STATE: Record<string, string> = {
	"nuevo-leon": "/blog/mejores-moteles-en-monterrey",
	jalisco: "/blog/mejores-moteles-de-jalisco",
	hidalgo: "/blog/mejores-moteles-de-hidalgo",
	guanajuato: "/blog/mejores-moteles-de-guanajuato",
	chiapas: "/blog/mejores-moteles-de-chiapas",
	coahuila: "/blog/mejores-moteles-de-coahuila",
	guerrero: "/blog/mejores-moteles-de-guerrero",
};

const { state } = Astro.params;
const states = await getStates();

const currentState = states.find((s) => s.slug === state);

if (!currentState) {
	return Astro.redirect("/moteles/estados");
}

// getRestaurants ya trae rating/reviewCount/priceRange/address/hours/etc.
// enriquecidos (internal/api/public.go los calcula server-side) — no hace
// falta una segunda consulta de ratings ni el .map() manual que había antes.
const motelesList: SupabasePlace[] = await getRestaurants({
	type: "motel",
	state_id: currentState.id,
});

const seoData = {
	title: `Moteles en ${currentState.name} 2026 | Con Jacuzzi, Precios y Ubicaciones Exactas`,
	description: `Encuentra ${motelesList.length} moteles en ${currentState.name} con jacuzzi, precios verificados, ubicaciones exactas y amenidades. Opciones desde económicas hasta premium. Abiertos 24 horas.`,
	keywords: [
		`moteles ${currentState.name.toLowerCase()}`,
		`motel ${currentState.name.toLowerCase()}`,
		`moteles con jacuzzi ${currentState.name.toLowerCase()}`,
		`moteles baratos ${currentState.name.toLowerCase()}`,
		`mejores moteles ${currentState.name.toLowerCase()}`,
		`motel ${currentState.name.toLowerCase()} precios`,
		`moteles ${currentState.name.toLowerCase()} 24 horas`,
	],
	heading: `Moteles en ${currentState.name}`,
	subheading: `Encuentra el lugar perfecto en ${currentState.name}`,
};

const schemaEnrichment = {
	address: {
		addressRegion: currentState.name,
		addressCountry: "MX",
	},
};
---

<MotelLayout
	title={seoData.title}
	description={seoData.description}
	schemaEnrichment={schemaEnrichment}
	backgroundColor="bg-gradient-to-r from-[#4a5568] to-[#553c7b]"
	textWhite={true}
>
	<MotelBusinessSchema moteles={motelesList} />

	<main>
		<section class="relative overflow-hidden">
			<div
				class="absolute inset-0 bg-cover bg-center bg-gradient-to-r from-[#4a5568] to-[#553c7b]"
			>
			</div>

			<div
				class="relative z-10 max-w-6xl mx-auto px-4 py-24 md:py-32 text-center"
			>
				<div class="mb-6">
					<a
						href="/moteles"
						class="inline-flex items-center text-neutral-300 hover:text-neutral-200 transition-colors text-sm"
					>
						← Volver a Directorio
					</a>
				</div>
				<span
					class="inline-flex items-center gap-1.5 bg-neutral-500 text-white px-4 py-1 rounded-full text-sm font-medium mb-6"
				>
					<MapPin className="w-3.5 h-3.5" />
					{currentState.name}
				</span>
				<h1
					class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-neutral-300 font-serif tracking-tight"
				>
					{seoData.heading}
				</h1>
				<p class="text-xl md:text-2xl text-white/90 max-w-3xl mx-auto mb-8">
					{seoData.subheading}
				</p>
				<p class="text-lg text-white/80 max-w-2xl mx-auto">
					Explora {motelesList.length}
					{motelesList.length === 1 ? "motel" : "moteles"} con información verificada,
					precios actualizados y recomendaciones locales.
				</p>
			</div>
		</section>

		<section class="min-h-screen bg-black text-white py-12">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				{
					BLOG_GUIDE_BY_STATE[currentState.slug] && (
						<a
							href={BLOG_GUIDE_BY_STATE[currentState.slug]}
							class="flex items-center justify-between gap-3 bg-neutral-500/10 border border-neutral-500/30 hover:border-neutral-500/60 rounded-xl px-5 py-3 mb-6 transition-colors group"
						>
							<span class="text-neutral-300 group-hover:text-neutral-200 font-serif text-sm sm:text-base">
								📖 Lee nuestra guía: <strong>Mejores Moteles de {currentState.name}</strong>
							</span>
							<span class="text-neutral-400 group-hover:translate-x-1 transition-transform shrink-0">→</span>
						</a>
					)
				}
				<Breadcrumbs
					items={[
						{ label: "Inicio", href: "/" },
						{ label: "Moteles", href: "/moteles" },
						{ label: "Estados", href: "/moteles/estados" },
						{ label: currentState.name },
					]}
				/>

				{
					motelesList.length > 0 ? (
						<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-6">
							{motelesList
								.sort((a, b) => {
									if (a.featured !== b.featured) {
										return a.featured ? -1 : 1;
									}
									return b.rating - a.rating;
								})
								.map((motel) => (
									<MotelCard motel={motel} stateSlug={currentState.slug} />
								))}
						</div>
					) : (
						<div class="text-center py-16">
							<div class="mb-8 flex justify-center">
								<BedDouble className="w-16 h-16 text-neutral-500/40" />
							</div>
							<h2 class="text-2xl font-serif font-bold text-neutral-400 mb-4">
								No hay moteles disponibles en {currentState.name}
							</h2>
							<p class="text-neutral-400 mb-6">
								Estamos trabajando para agregar más ubicaciones en este estado.
							</p>
							<a
								href="/moteles/estados"
								class="inline-block px-8 py-3 bg-neutral-500 text-white rounded-lg font-serif hover:bg-neutral-400 transition-colors"
							>
								Ver otros estados
							</a>
						</div>
					)
				}

				{
					motelesList.length > 0 && (
						<div class="bg-[#1E1E1E] rounded-xl p-8 shadow-md mt-16 border border-neutral-500/20">
							<h2 class="text-2xl md:text-3xl font-serif font-bold text-neutral-400 mb-6 text-center">
								Búsquedas Populares en {currentState.name}
							</h2>

							<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
								<div class="text-center">
									<div class="w-16 h-16 bg-neutral-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
										<Waves className="w-7 h-7 text-neutral-400" />
									</div>
									<h3 class="text-lg font-semibold text-neutral-300 mb-2">
										Con Jacuzzi
									</h3>
									<p class="text-neutral-400 text-sm">
										Habitaciones con jacuzzi privado
									</p>
								</div>

								<div class="text-center">
									<div class="w-16 h-16 bg-neutral-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
										<DollarSign className="w-7 h-7 text-neutral-400" />
									</div>
									<h3 class="text-lg font-semibold text-neutral-300 mb-2">
										Precios por Hora
									</h3>
									<p class="text-neutral-400 text-sm">Desde $200 por hora</p>
								</div>

								<div class="text-center">
									<div class="w-16 h-16 bg-neutral-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
										<Clock className="w-7 h-7 text-neutral-400" />
									</div>
									<h3 class="text-lg font-semibold text-neutral-300 mb-2">
										12 Horas
									</h3>
									<p class="text-neutral-400 text-sm">
										Paquetes especiales fin de semana
									</p>
								</div>

								<div class="text-center">
									<div class="w-16 h-16 bg-neutral-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
										<Car className="w-7 h-7 text-neutral-400" />
									</div>
									<h3 class="text-lg font-semibold text-neutral-300 mb-2">
										Cochera Cerrada
									</h3>
									<p class="text-neutral-400 text-sm">
										Privacidad y seguridad garantizada
									</p>
								</div>
							</div>

							<div class="bg-black/30 rounded-lg p-6 border border-neutral-500/10">
								<h3 class="text-xl font-serif font-bold text-neutral-300 mb-4 text-center">
									Términos Populares
								</h3>
								<div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-neutral-300">
									<ul class="space-y-2">
										<li>✓ Moteles con jacuzzi en {currentState.name}</li>
										<li>✓ Moteles baratos {currentState.name}</li>
										<li>✓ Motel {currentState.name} precios 2026</li>
										<li>✓ Moteles 24 horas {currentState.name}</li>
									</ul>
									<ul class="space-y-2">
										<li>✓ Mejores moteles {currentState.name}</li>
										<li>✓ Motel 12 horas {currentState.name}</li>
										<li>✓ Moteles con cochera {currentState.name}</li>
										<li>✓ Motel centro {currentState.name}</li>
									</ul>
								</div>
							</div>
						</div>
					)
				}

				<div
					class="bg-[#1E1E1E] rounded-xl p-8 shadow-md mt-16 border border-neutral-500/20"
				>
					<h2
						class="text-2xl md:text-3xl font-serif font-bold text-neutral-400 mb-4 text-center"
					>
						¿Tienes un motel en {currentState.name}?
					</h2>
					<p class="text-center text-neutral-300 max-w-2xl mx-auto mb-6">
						Registra tu motel en nuestra plataforma y llega a miles de personas
						que buscan opciones en {currentState.name}.
					</p>
					<div class="text-center">
						<a
							href="/contact"
							class="inline-block px-8 py-3 bg-neutral-500 text-white rounded-lg font-serif hover:bg-neutral-400 transition-colors"
						>
							Registrar mi Motel
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</MotelLayout>

<style>
	.font-serif {
		font-family: "Playfair Display", serif;
	}
</style>
