---
export const prerender = false;

Astro.response.headers.set(
  'Cache-Control', 
  'public, s-maxage=300, stale-while-revalidate=60'
);

import MotelLayout from "../../../../layouts/MotelLayout.astro";
import MotelBusinessSchema from "../../../../components/MotelBusinessSchema.astro";
import Card from "../../../../components/Card.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import { getRestaurants, getStates, getAllPlaceRatings } from "../../../../lib/supabase";
import { Bed, MapPin, Clock, Star, DollarSign, Phone, ArrowRight, Wifi, Car, Snowflake, Waves, Utensils, Martini } from "lucide-react";
import type { SupabasePlace } from "../../../../types/app";

const { state } = Astro.params;

const [states, allRatings] = await Promise.all([
  getStates(),
  getAllPlaceRatings()
]);

const currentState = states.find(s => s.slug === state);

if (!currentState) {
  return Astro.redirect('/moteles/estados');
}

const motelesData: SupabasePlace[] = await getRestaurants({ 
  type: 'motel',
  state_id: currentState.id 
});

const motelesList: SupabasePlace[] = motelesData.map((motel) => {
  const stats = allRatings[motel.id];
  
  return {
    ...motel,
    rating: stats?.rating || motel.rating || 4.0,
    reviewCount: stats?.count || motel.reviewCount || 0,
    priceRange: motel.priceRange || "$$",
    address: motel.address || "",
    hours: motel.hours || "24 horas",
    amenities: motel.amenities || [],
    specialties: [],
    destacado: motel.featured
  };
});

const seoData = {
  title: `Moteles en ${currentState.name} 2026 | Con Jacuzzi, Precios y Ubicaciones Exactas`,
  description: `Encuentra ${motelesList.length} moteles en ${currentState.name} con jacuzzi, precios verificados, ubicaciones exactas y amenidades. Opciones desde económicas hasta premium. Abiertos 24 horas.`,
  keywords: [
    `moteles ${currentState.name.toLowerCase()}`,
    `motel ${currentState.name.toLowerCase()}`,
    `moteles con jacuzzi ${currentState.name.toLowerCase()}`,
    `moteles baratos ${currentState.name.toLowerCase()}`,
    `mejores moteles ${currentState.name.toLowerCase()}`,
    `motel ${currentState.name.toLowerCase()} precios`,
    `moteles ${currentState.name.toLowerCase()} 24 horas`
  ],
  heading: `Moteles en ${currentState.name}`,
  subheading: `Encuentra el lugar perfecto en ${currentState.name}`
};

const schemaEnrichment = {
  address: {
    addressRegion: currentState.name,
    addressCountry: "MX",
  },
};
---

<MotelLayout 
  title={seoData.title}
  description={seoData.description}
  schemaEnrichment={schemaEnrichment}
  backgroundColor="bg-gradient-to-r from-[#4a5568] to-[#553c7b]"
  textWhite={true}
>
  <MotelBusinessSchema moteles={motelesList} />

  <main>
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-cover bg-center bg-gradient-to-r from-[#4a5568] to-[#553c7b]"></div>
      
      <div class="relative z-10 max-w-6xl mx-auto px-4 py-24 md:py-32 text-center">
        <div class="mb-6">
          <a href="/moteles/estados" class="inline-flex items-center text-pink-300 hover:text-pink-200 transition-colors text-sm">
            ← Volver a Estados
          </a>
        </div>
        <span class="inline-block bg-pink-500 text-white px-4 py-1 rounded-full text-sm font-medium mb-6 animate-pulse">📍 {currentState.name}</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-pink-300 font-serif tracking-tight">{seoData.heading}</h1>
        <p class="text-xl md:text-2xl text-white/90 max-w-3xl mx-auto mb-8">{seoData.subheading}</p>
        <p class="text-lg text-white/80 max-w-2xl mx-auto">Explora {motelesList.length} {motelesList.length === 1 ? 'motel' : 'moteles'} con información verificada, precios actualizados y recomendaciones locales.</p>
      </div>
    </section>

    <section class="min-h-screen bg-black text-white py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <Breadcrumbs 
          items={[
            { label: 'Inicio', href: '/' },
            { label: 'Moteles', href: '/moteles' },
            { label: 'Estados', href: '/moteles/estados' },
            { label: currentState.name }
          ]}
        />
        
        {motelesList.length > 0 ? (
          <>
            <div class="mb-12 space-y-4">
              <div class="flex flex-wrap justify-center gap-4">
                <button id="filter-all" class="filter-btn px-6 py-2 bg-pink-500 text-white rounded-full font-serif hover:bg-pink-400 transition-colors" data-filter="all">Todos</button>
                <button id="filter-premium" class="filter-btn px-6 py-2 bg-[#1E1E1E] text-gray-300 rounded-full font-serif hover:bg-pink-500 hover:text-white transition-colors" data-filter="premium">Premium</button>
                <button id="filter-rated" class="filter-btn px-6 py-2 bg-[#1E1E1E] text-gray-300 rounded-full font-serif hover:bg-pink-500 hover:text-white transition-colors" data-filter="rated">Mejor calificados</button>
              </div>
            </div>

            {motelesList.filter(motel => motel.featured === true).length > 0 && (
              <div class="mt-12 mb-16">
                <h2 class="text-3xl md:text-4xl font-serif font-bold text-pink-400 mb-8 text-center">Moteles Destacados</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  {motelesList.filter(motel => motel.featured === true).map(motel => (
                    <div class="bg-[#1E1E1E] rounded-xl overflow-hidden shadow-lg flex flex-col md:flex-row">
                      <div class="md:w-2/5 relative">
                        <img
                          src={motel.image || '/motel.png'} 
                          alt={motel.name}
                          width={400}
                          height={500}
                          class="w-full h-full object-cover"
                        />
                        <div class="absolute inset-0 bg-gradient-to-r from-black/50 to-transparent md:bg-gradient-to-t"></div>
                        <div class="absolute bottom-4 left-4 md:bottom-auto md:top-4">
                          <div class="bg-black/90 px-2 py-1 rounded-full inline-block">
                            <Star className="w-4 h-4 text-pink-400 inline mr-1" />
                            <span class="text-sm font-medium text-white">{motel.rating} ({motel.reviewCount})</span>
                          </div>
                        </div>
                      </div>
                      <div class="md:w-3/5 p-6">
                        <h3 class="font-serif text-2xl font-bold text-pink-400 mb-2">{motel.name}</h3>
                        <div class="flex items-center mb-2">
                          <MapPin className="w-4 h-4 text-gray-400 mr-2" />
                          <span class="text-sm text-gray-300">{motel.address}</span>
                        </div>
                        <div class="flex items-center mb-4">
                          <DollarSign className="w-4 h-4 text-gray-400 mr-2" />
                          <span class="text-sm text-gray-300">{motel.priceRange}</span>
                        </div>
                        
                        {motel.phone && (
                          <div class="flex items-center mt-3">
                            <Phone className="w-4 h-4 text-gray-400 mr-2" />
                            <a href={`tel:${motel.phone}`} class="text-sm text-pink-400 hover:text-pink-300 transition-colors">
                              {motel.phone}
                            </a>
                          </div>
                        )}
                                     {motel.short_name && (
                      <a 
                        data-astro-prefetch="hover"
                        href={`/moteles/estados/${state}/${motel.short_name}`}
                        data-umami-event={'/moteles/' + motel.short_name + ' button'}
                        class="w-full bg-pink-500 text-white px-4 py-2 rounded-lg font-serif font-bold hover:bg-pink-400 transition-colors flex items-center justify-center group"
                      >
                        Ver Habitaciones
                        <ArrowRight className="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform" />
                      </a>
                    )}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <div id="moteles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {motelesList.sort((a, b) => {
                if (a.featured !== b.featured) {
                    return a.featured ? -1 : 1; 
                }
                return b.rating - a.rating;
              }).map((motel) => (
                <div 
                  class={`motel-card group relative overflow-hidden rounded-xl bg-[#1E1E1E] shadow-md hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border-pink-500/20 hover:border-pink-500/50`}
                  data-rating={motel.rating}
                  data-price-range={motel.priceRange}
                >
                  <div class="relative h-48 overflow-hidden">
                    <img
                      src={motel.image || '/motel.png'} 
                      alt={motel.name}
                      width={500}
                      height={300}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-70"></div>
                    
                    <div class="absolute bottom-3 left-3 flex items-center space-x-2">
                      <div class="flex items-center bg-black/90 px-2 py-1 rounded-full">
                        <Star className="w-4 h-4 text-pink-400 mr-1" />
                        <span class="text-sm font-medium text-white">{motel.rating}</span>
                        <span class="text-xs text-gray-400 ml-1">({motel.reviewCount})</span>
                      </div>
                      <div class="bg-black/90 px-2 py-1 rounded-full">
                        <span class="text-sm font-medium text-white">{motel.priceRange}</span>
                      </div>
                    </div>
      
                    {motel.featured && (
                      <div class="absolute top-3 left-3 bg-pink-500 text-white px-2 py-1 rounded-full text-xs font-semibold animate-pulse">
                        ⭐ Recomendado
                      </div>
                    )}
                  </div>
      
                  <div class="p-5">
                    <h3 class="font-serif text-xl font-bold text-pink-400 mb-2 group-hover:text-pink-300 transition-colors">
                      {motel.name}
                    </h3>
      
                    <div class="flex items-center mb-3">
                      <Clock className="w-4 h-4 text-gray-400 mr-2" />
                      <span class="text-sm text-green-400">Abierto 24 horas</span>
                    </div>
                    
                    <div class="flex items-start mb-3">
                      <MapPin className="w-4 h-4 text-gray-400 mr-2 mt-0.5" />
                      <div class="flex flex-col">
                        <span class="text-sm text-gray-300">{motel.address}</span>
                      </div>
                    </div>

                    {motel.phone && (
                      <div class="flex items-center mb-3">
                        <Phone className="w-4 h-4 text-gray-400 mr-2" />
                        <a href={`tel:${motel.phone}`} class="text-sm text-pink-400 hover:text-pink-300 transition-colors">
                          {motel.phone}
                        </a>
                      </div>
                    )}
      
                    <div class="flex flex-wrap gap-2 mt-3 mb-3">
                      {motel.specialties && motel.specialties.map((specialty) => (
                        <span class="text-xs bg-[#2A2A2A] text-pink-400 px-2 py-1 rounded-full">{specialty}</span>
                      ))}
                    </div>
      
                    <div class="grid grid-cols-2 gap-2 mt-4">
                      {motel.amenities && motel.amenities.slice(0, 6).map((amenity) => (
                        <div class="flex items-center text-xs text-gray-300">
                          {amenity.toLowerCase().includes('wifi') && <Wifi className="w-3 h-3 mr-1 text-blue-400" />}
                          {amenity.toLowerCase().includes('estacionamiento') && <Car className="w-3 h-3 mr-1 text-green-400" />}
                          {amenity.toLowerCase().includes('aire') && <Snowflake className="w-3 h-3 mr-1 text-cyan-400" />}
                          {amenity.toLowerCase().includes('alberca') && <Waves className="w-3 h-3 mr-1 text-blue-400" />}
                          {amenity.toLowerCase().includes('restaurante') && <Utensils className="w-3 h-3 mr-1 text-orange-400" />}
                          {amenity.toLowerCase().includes('bar') && <Martini className="w-3 h-3 mr-1 text-purple-400" />}
                          <span class="truncate">{amenity}</span>
                        </div>
                      ))}
                    </div>
      
                    <div class="mt-5">
                      {motel.short_name ? (
                        <a 
                          data-astro-prefetch="hover"
                          href={`/moteles/estados/${currentState.slug}/${motel.short_name}`}
                          class="w-full bg-pink-500 text-white px-4 py-2 rounded-lg font-serif font-bold hover:bg-pink-400 transition-colors flex items-center justify-center group"
                        >
                          Ver Habitaciones
                          <ArrowRight className="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform" />
                        </a>
                      ) : motel.menu ? (
                        <a 
                          href={motel.menu} 
                          class="inline-block w-full text-center py-2 bg-pink-500 text-white rounded-lg font-serif hover:bg-pink-400 transition-colors"
                        >
                          Ver Información
                        </a>
                      ) : motel.phone ? (
                        <a 
                          href={`tel:${motel.phone}`}
                          class="w-full bg-pink-500 text-white px-4 py-2 rounded-lg font-serif font-bold hover:bg-pink-400 transition-colors flex items-center justify-center group"
                        >
                          <Phone className="mr-2 w-4 h-4" />
                          Llamar ahora
                        </a>
                      ) : (
                        <button 
                          class="w-full py-2 bg-[#2A2A2A] text-pink-400 rounded-lg font-serif hover:bg-[#3A3A3A] transition-colors"
                        >
                          Más Información
                        </button>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="text-center py-16">
            <div class="mb-8">
              <span class="text-6xl">🏨</span>
            </div>
            <h2 class="text-2xl font-serif font-bold text-pink-400 mb-4">No hay moteles disponibles en {currentState.name}</h2>
            <p class="text-gray-400 mb-6">Estamos trabajando para agregar más ubicaciones en este estado.</p>
            <a 
              href="/moteles/estados"
              class="inline-block px-8 py-3 bg-pink-500 text-white rounded-lg font-serif hover:bg-pink-400 transition-colors"
            >
              Ver otros estados
            </a>
          </div>
        )}

        {motelesList.length > 0 && (
          <div class="bg-[#1E1E1E] rounded-xl p-8 shadow-md mt-16 border border-pink-500/20">
            <h2 class="text-2xl md:text-3xl font-serif font-bold text-pink-400 mb-6 text-center">Búsquedas Populares en {currentState.name}</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
              <div class="text-center">
                <div class="w-16 h-16 bg-pink-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                  <span class="text-3xl">🛁</span>
                </div>
                <h3 class="text-lg font-semibold text-pink-300 mb-2">Con Jacuzzi</h3>
                <p class="text-gray-400 text-sm">Habitaciones con jacuzzi privado</p>
              </div>
              
              <div class="text-center">
                <div class="w-16 h-16 bg-pink-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                  <span class="text-3xl">💰</span>
                </div>
                <h3 class="text-lg font-semibold text-pink-300 mb-2">Precios por Hora</h3>
                <p class="text-gray-400 text-sm">Desde $200 por hora</p>
              </div>
              
              <div class="text-center">
                <div class="w-16 h-16 bg-pink-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                  <span class="text-3xl">🕐</span>
                </div>
                <h3 class="text-lg font-semibold text-pink-300 mb-2">12 Horas</h3>
                <p class="text-gray-400 text-sm">Paquetes especiales fin de semana</p>
              </div>

              <div class="text-center">
                <div class="w-16 h-16 bg-pink-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                  <span class="text-3xl">🚗</span>
                </div>
                <h3 class="text-lg font-semibold text-pink-300 mb-2">Cochera Cerrada</h3>
                <p class="text-gray-400 text-sm">Privacidad y seguridad garantizada</p>
              </div>
            </div>

            <div class="bg-black/30 rounded-lg p-6 border border-pink-500/10">
              <h3 class="text-xl font-serif font-bold text-pink-300 mb-4 text-center">Términos Populares</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-300">
                <ul class="space-y-2">
                  <li>✓ Moteles con jacuzzi en {currentState.name}</li>
                  <li>✓ Moteles baratos {currentState.name}</li>
                  <li>✓ Motel {currentState.name} precios 2026</li>
                  <li>✓ Moteles 24 horas {currentState.name}</li>
                </ul>
                <ul class="space-y-2">
                  <li>✓ Mejores moteles {currentState.name}</li>
                  <li>✓ Motel 12 horas {currentState.name}</li>
                  <li>✓ Moteles con cochera {currentState.name}</li>
                  <li>✓ Motel centro {currentState.name}</li>
                </ul>
              </div>
            </div>
          </div>
        )}

        <div class="bg-[#1E1E1E] rounded-xl p-8 shadow-md mt-16 border border-pink-500/20">
          <h2 class="text-2xl md:text-3xl font-serif font-bold text-pink-400 mb-4 text-center">¿Tienes un motel en {currentState.name}?</h2>
          <p class="text-center text-gray-300 max-w-2xl mx-auto mb-6">Registra tu motel en nuestra plataforma y llega a miles de personas que buscan opciones en {currentState.name}.</p>
          <div class="text-center">
            <a 
              href="/contact" 
              class="inline-block px-8 py-3 bg-pink-500 text-white rounded-lg font-serif hover:bg-pink-400 transition-colors"
            >
              Registrar mi Motel
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</MotelLayout>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const filterButtons = document.querySelectorAll('.filter-btn');
  const motelCards = document.querySelectorAll('.motel-card');

  filterButtons.forEach(button => {
    button.addEventListener('click', function() {
      const filter = this.getAttribute('data-filter');
      
      filterButtons.forEach(btn => {
        btn.classList.remove('bg-pink-500', 'text-white');
        btn.classList.add('bg-[#1E1E1E]', 'text-gray-300');
      });
      
      this.classList.remove('bg-[#1E1E1E]', 'text-gray-300');
      this.classList.add('bg-pink-500', 'text-white');

      motelCards.forEach(card => {
        let shouldShow = true;

        if (filter === 'premium') {
          const priceRange = card.getAttribute('data-price-range');
          shouldShow = priceRange === '$$$$' || priceRange === '$$$';
        } else if (filter === 'rated') {
          const ratingAttr = card.getAttribute('data-rating');
          const rating = ratingAttr ? parseFloat(ratingAttr) : 0;
          shouldShow = rating >= 4.3;
        }

        if (shouldShow) {
          (card as HTMLElement).style.display = 'block';
          (card as HTMLElement).style.opacity = '1';
        } else {
          (card as HTMLElement).style.display = 'none';
          (card as HTMLElement).style.opacity = '0';
        }
      });
    });
  });
});
</script>

<style>
  .motel-card {
    transition: all 0.3s ease;
  }
  
  .motel-card:hover {
    transform: translateY(-5px);
  }
  
  .filter-btn {
    transition: all 0.3s ease;
  }

  .font-serif {
    font-family: "Playfair Display", serif;
  }
</style>
