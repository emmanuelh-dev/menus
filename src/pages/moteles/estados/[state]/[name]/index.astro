---
export const prerender = false;

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=31536000, stale-while-revalidate=86400",
);

const { name, state } = Astro.params;

if (!name) {
	throw new Error("No se ha especificado el nombre del restaurante");
}

const placeTag = `place-${name}`;
Astro.response.headers.set("Vercel-Cache-Tag", placeTag);

import Breadcrumbs from "../../../../../components/Breadcrumbs.astro";
import { getStates, getRestaurantByName, getReviews } from "../../../../../lib/api";
import MotelLayout from "../../../../../layouts/MotelLayout.astro";
import MotelPageRenderer from "../../../../../components/MotelPageRenderer";
import { isAuthenticated } from "../../../../../middleware/auth";

const isAdmin = await isAuthenticated(Astro.request, Astro.cookies);

const places = await getRestaurantByName({ name });
const place = places[0];

if (!place) {
	return Astro.redirect("/404");
}

// Validar que el slug del estado coincida con el del lugar encontrado
// Si no coincide (ej: intentan entrar con /moteles/incorrecto/nombre-correcto), redirigimos al correcto
if (place.states?.slug && place.states.slug !== state) {
	return Astro.redirect(`/moteles/estados/${place.states.slug}/${name}`);
}

// getRestaurantByName ya trae rating/reviewCount (+ alias .count) calculados
// server-side — no hace falta una consulta de stats aparte.
const initialReviews = await getReviews(place.id, 10);

const placeWithStats = place;

const states = await getStates();
const currentState = states.find((s) => s.slug === state);
---

<MotelLayout
	place={placeWithStats}
	image={place.image ? place.image : "/placeholder.svg"}
	backgroundColor="bg-[#0A0A0A]"
>
	<div
		class="min-h-screen bg-[#0A0A0A] text-stone-300 selection:bg-pink-900 selection:text-white"
	>
		<div class="max-w-3xl mx-auto p-4">
			<Breadcrumbs
				items={[
					{ label: "Inicio", href: "/" },
					{ label: "Moteles", href: "/moteles" },
					{ label: "Estados", href: "/moteles/estados" },
					...(currentState
						? [
								{
									label: currentState.name,
									href: `/moteles/estados/${currentState.slug}`,
								},
							]
						: []),
					{ label: place.name },
				]}
				theme="dark"
			/>
		</div>

		<MotelPageRenderer
			place={placeWithStats}
			isAdmin={isAdmin}
			initialReviews={initialReviews || []}
			client:load
		/>
	</div>

	<!-- <QuickFeed placeId={place.id} client:load /> -->
</MotelLayout>
