---
export const prerender = false;
const { name } = Astro.params;

import RestaurantLayout from "../../../../../layouts/RestaurantLayout.astro";
import Gallery from "../../../../../components/Gallery.astro";
import WhatsappButton from "../../../../../components/WhatsappButton";
import CopyClabe from "../../../../../components/CopyClabe";
import { getRestaurantByName, supabase } from "../../../../../lib/supabase";
import MotelLayout from "../../../../../layouts/MotelLayout.astro";

if (!name) {
	throw new Error("No se ha especificado el nombre del restaurante");
}
const { data: place } = await supabase
	.from("places")
	.select("*")
	.eq("short_name", name)
	.single();

const { blocks = [], view_settings = {} } = place.content || {};

const address = place.content?.semantic_data?.address || place.address || "";
const mapsSearchQuery = encodeURIComponent(`${place.name} ${address || ""}`);
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsSearchQuery}`;
---

<MotelLayout
  place={place}
	image={place.image ? place.image : "/placeholder.svg"}
	backgroundColor="bg-[#0A0A0A]"
>
	<div
		class="min-h-screen bg-[#0A0A0A] text-stone-300 selection:bg-red-900 selection:text-white"
	>
		<div class="max-w-3xl mx-auto px-6 py-24">
			{/* Header Sensual y Nocturno */}
			<header class="mb-24 flex flex-col items-center">
				<div class="relative mb-8">
					<img
						src={place.image}
						alt={place.name}
						class="size-48 rounded-full transition-all duration-700 object-cover ring-1 ring-stone-200 ring-offset-4"
					/>
				</div>
				<h1
					class="text-5xl text-center font-light tracking-tighter serif italic mb-2 text-balance"
				>
					{place.name}
				</h1>
				<p
					class="text-[10px] uppercase tracking-[0.4em] text-stone-400 font-semibold mb-8 text-balance text-center"
				>
					{
						place?.content?.semantic_data?.description ||
							place?.description ||
							place.name
					}
				</p>
				{
					address && (
						<div class="space-y-1">
							<p class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold text-center">
								Ubicación
							</p>
							<a
								href={googleMapsUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="text-center text-lg text-stone-600 hover:text-red-700 transition-colors inline-flex items-center gap-2 group"
                >
								{address}
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="size-3 opacity-50 group-hover:opacity-100 transition-opacity"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
									/>
								</svg>
							</a>
						</div>
					)
				}
				{
					place.content?.semantic_data && (
						<div class="w-full mx-auto max-w-lg space-y-4 text-center mb-8">
							{place.content.semantic_data.price_range && (
								<div class="space-y-1">
									<p class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold">
										Precios
									</p>
									<p class="text-sm text-stone-600">
										{place.content.semantic_data.price_range}
									</p>
								</div>
							)}

							{place.content.semantic_data.parking && (
								<div class="space-y-1">
									<p class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold">
										Estacionamiento
									</p>
									<p class="text-sm text-stone-600">
										{place.content.semantic_data.parking}
									</p>
								</div>
							)}

							{place.content.semantic_data.hours && (
								<div class="space-y-1">
									<p class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold">
										Horarios
									</p>
									<p class="text-sm text-stone-600 whitespace-pre-line">
										{place.content.semantic_data.hours}
									</p>
								</div>
							)}

							{place.content.semantic_data.phone && (
								<div class="space-y-1">
									<p class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold">
										Teléfono
									</p>
									<p class="text-sm text-stone-600">
										{place.content.semantic_data.phone}
									</p>
								</div>
							)}

							{place.content.semantic_data.payment_options &&
								place.content.semantic_data.payment_options.length > 0 && (
									<div class="space-y-1">
										<p class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold">
											Métodos de Pago
										</p>
										<p class="text-sm text-stone-600">
											{place.content.semantic_data.payment_options.join(", ")}
										</p>
									</div>
								)}
						</div>
					)
				}

				<div class="h-[1px] w-12 bg-stone-200"></div>
			</header>

			{/* Suites y Servicios */}
			<div class="space-y-32">
				{
					blocks.map((block) => {
						if (block.type === "section") {
							return (
								<section class="relative">
									<div class="sticky top-0 bg-[#0A0A0A]/90 backdrop-blur-xl z-20 py-6 mb-16">
										<h2 class="text-3xl font-light serif italic text-white tracking-tight">
											{block.data.title}
										</h2>
									</div>

									<div class="space-y-20">
										{block.data.image && (
											<div class="overflow-hidden rounded-sm group">
												<img
													src={block.data.image}
													alt={block.data.title}
													class="w-full h-80 object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-1000"
												/>
											</div>
										)}

										<div class="grid gap-y-16">
											{block.data.items?.map((item) => (
												<div class="space-y-8">
													<div class="group flex flex-col md:flex-row gap-8 items-center md:items-start transition-colors duration-500">
														<div class="w-full">
															<div class="flex justify-between items-baseline mb-3">
																<h3 class="text-2xl font-light text-white group-hover:text-red-700 transition-colors">
																	{item.name}
																</h3>
																<div class="h-[1px] flex-1 mx-4 bg-white/5 hidden md:block" />
																<span class="text-xl font-light text-stone-500">
																	{view_settings.show_prices &&
																		`$${item.price}`}
																</span>
															</div>
															<p class="text-stone-500 text-sm font-light leading-relaxed mb-4 text-balance">
																{item.description}
															</p>
															{item.features && item.features.length > 0 && (
																<div class="flex flex-wrap gap-3 text-[9px] uppercase tracking-widest text-stone-600 font-bold">
																	{item.features.map((feature, idx) => (
																		<>
																			<span>{feature}</span>
																			{idx < item.features.length - 1 && (
																				<span>•</span>
																			)}
																		</>
																	))}
																</div>
															)}
														</div>

														{item.image && item.image.trim() !== "" && (
															<div class="w-full md:w-48 aspect-video md:aspect-square overflow-hidden rounded-sm order-1 md:order-2 shadow-2xl">
																<img
																	src={item.image}
																	alt={item.name}
																	class="w-full h-full object-cover brightness-75 group-hover:brightness-110 transition-all duration-700"
																/>
															</div>
														)}
													</div>

													{item.gallery && item.gallery.length > 0 && (
														<Gallery
															images={item.gallery}
															buttonClasses="bg-white/5 text-white border border-white/10 px-6 py-2 rounded-sm hover:bg-white/10 transition-all uppercase text-[9px] tracking-widest"
														/>
													)}
												</div>
											))}
										</div>
									</div>
								</section>
							);
						}

						if (block.type === "gallery") {
							return (
								<div class="py-20 border-y border-white/5">
									<p class="text-center text-[10px] uppercase tracking-[0.5em] text-stone-600 mb-12">
										Instalaciones
									</p>
									<Gallery
										images={block.data.images || []}
										buttonClasses="bg-white/5 text-white border border-white/10 px-8 py-3 rounded-sm hover:bg-white/10 transition-all uppercase text-[10px] tracking-widest"
									/>
								</div>
							);
						}
					})
				}
			</div>

			<footer class="mt-40 pb-20 text-center">
				<p class="text-[10px] text-stone-600 uppercase tracking-[0.5em]">
					Privacy Guaranteed • {place.name} • 2026
				</p>
			</footer>
		</div>
	</div>
</MotelLayout>
