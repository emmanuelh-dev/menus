---
export const prerender = false;

import MotelLayout from "../../../layouts/MotelLayout.astro";
import Card from "../../../components/Card.astro";
import { getStates } from "../../../lib/supabase";
import { MapPin } from "lucide-react";

const states = await getStates();

const seoData = {
  title: "Moteles por Estado en México 2026 | Encuentra Moteles en tu Estado",
  description: "Directorio completo de moteles organizados por estado en México. Encuentra los mejores moteles en Nuevo León, Ciudad de México, Jalisco, Estado de México y más. Guía actualizada 2026.",
  keywords: [
    "moteles por estado",
    "moteles méxico",
    "directorio moteles",
    "moteles nuevo león",
    "moteles cdmx",
    "moteles jalisco",
    "moteles estado de méxico",
    "guía moteles méxico"
  ],
  heading: "Moteles por Estado en México",
  subheading: "Explora opciones de moteles en todo el país"
};

const schemaEnrichment = {
  address: {
    addressCountry: "MX",
  },
};
---

<MotelLayout 
  title={seoData.title}
  description={seoData.description}
  schemaEnrichment={schemaEnrichment}
  backgroundColor="bg-gradient-to-r from-[#4a5568] to-[#553c7b]"
  textWhite={true}
>
  <main>
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-cover bg-center bg-gradient-to-r from-[#4a5568] to-[#553c7b]"></div>
      
      <div class="relative z-10 max-w-6xl mx-auto px-4 py-24 md:py-32 text-center">
        <span class="inline-block bg-pink-500 text-white px-4 py-1 rounded-full text-sm font-medium mb-6 animate-pulse">📍 Explora por Ubicación</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-pink-300 font-serif tracking-tight">{seoData.heading}</h1>
        <p class="text-xl md:text-2xl text-white/90 max-w-3xl mx-auto mb-8">{seoData.subheading}</p>
        <p class="text-lg text-white/80 max-w-2xl mx-auto">Selecciona tu estado para descubrir los mejores moteles con información verificada, precios actualizados y recomendaciones locales.</p>
      </div>
    </section>

    <section class="min-h-screen bg-black text-white py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="mb-12 text-center">
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-pink-400 mb-4">Selecciona tu Estado</h2>
          <p class="text-gray-300 max-w-2xl mx-auto">Encuentra moteles en tu estado con información detallada sobre ubicación, precios, amenidades y recomendaciones.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {states.map(state => (
            <a 
              href={`/moteles/estados/${state.slug}`}
              class="group bg-[#1E1E1E] rounded-xl p-6 border border-pink-500/20 hover:border-pink-500/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
            >
              <div class="flex items-start justify-between mb-4">
                <div class="flex items-center">
                  <MapPin className="w-6 h-6 text-pink-400 mr-3" />
                  <h3 class="text-xl font-serif font-bold text-pink-300 group-hover:text-pink-200 transition-colors">
                    {state.name}
                  </h3>
                </div>
                <span class="text-pink-400 transform group-hover:translate-x-1 transition-transform">→</span>
              </div>
              
              {state.description && (
                <p class="text-sm text-gray-400 mb-3">{state.description}</p>
              )}
              
              <div class="flex items-center text-sm text-gray-500">
                <span>Ver moteles disponibles</span>
              </div>
            </a>
          ))}
        </div>

        {states.length === 0 && (
          <div class="text-center py-16">
            <p class="text-gray-400 text-lg">Próximamente agregaremos más estados.</p>
            <p class="text-gray-500 mt-2">Estamos trabajando para expandir nuestra cobertura nacional.</p>
          </div>
        )}

        <div class="mt-16 bg-[#1E1E1E] rounded-xl p-8 shadow-md border border-pink-500/20">
          <h2 class="text-2xl md:text-3xl font-serif font-bold text-pink-400 mb-6 text-center">¿Por qué buscar por estado?</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="w-16 h-16 bg-pink-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-3xl">🎯</span>
              </div>
              <h3 class="text-lg font-semibold text-pink-300 mb-2">Información Local</h3>
              <p class="text-gray-400 text-sm">Descubre moteles con detalles específicos de tu región y recomendaciones locales.</p>
            </div>
            
            <div class="text-center">
              <div class="w-16 h-16 bg-pink-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-3xl">💰</span>
              </div>
              <h3 class="text-lg font-semibold text-pink-300 mb-2">Precios Regionales</h3>
              <p class="text-gray-400 text-sm">Compara precios adaptados al mercado local de cada estado.</p>
            </div>
            
            <div class="text-center">
              <div class="w-16 h-16 bg-pink-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-3xl">⭐</span>
              </div>
              <h3 class="text-lg font-semibold text-pink-300 mb-2">Recomendaciones</h3>
              <p class="text-gray-400 text-sm">Accede a reseñas y recomendaciones de usuarios locales.</p>
            </div>
          </div>
        </div>

        <div class="bg-[#1E1E1E] rounded-xl p-8 shadow-md mt-16 border border-pink-500/20">
          <h2 class="text-2xl md:text-3xl font-serif font-bold text-pink-400 mb-4 text-center">¿Tienes un motel?</h2>
          <p class="text-center text-gray-300 max-w-2xl mx-auto mb-6">Registra tu motel en nuestra plataforma y llega a miles de personas que buscan opciones en su estado.</p>
          <div class="text-center">
            <a 
              href="/contact" 
              class="inline-block px-8 py-3 bg-pink-500 text-white rounded-lg font-serif hover:bg-pink-400 transition-colors"
            >
              Registrar mi Motel
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</MotelLayout>

<style>
  .font-serif {
    font-family: "Playfair Display", serif;
  }
</style>