---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import main_menu from "./phone_with_menu.png";
import {
	QrCode,
	Zap,
	ArrowRight,
	Check,
	Layout,
	Image as ImageIcon,
	Smartphone,
} from "lucide-react";

import { Image } from "astro:assets";
import DefaultLayout from "../layouts/DefaultLayout.astro";

const seoData = {
	title: "Cómo Crear un Menú Digital con Código QR para Restaurante | BySMax",
	description:
		"Tutorial paso a paso para crear el menú digital y la carta QR de tu restaurante. Digitaliza tu carta en 10 minutos y recibe pedidos sin comisión.",
	keywords:
		"crear menú digital, creador de menú digital, hacer carta digital, cómo hacer una carta digital con código qr, sistema de menú digital para restaurantes",
};

const guideSchema = {
	"@context": "https://schema.org",
	"@type": "HowTo",
	name: "Cómo crear un menú digital para tu restaurante",
	description:
		"Guía paso a paso para digitalizar tu carta y generar tu código QR.",
	step: [
		{
			"@type": "HowToStep",
			name: "Sube tu carta actual",
			text: "Importa tus fotos o PDF de tu menú actual.",
			url: "https://menusdigitalesmonterrey.com/crear-menu-digital",
		},
		{
			"@type": "HowToStep",
			name: "Personaliza el diseño",
			text: "Elige colores, logos y categorías para tu menú digital.",
			url: "https://menusdigitalesmonterrey.com/crear-menu-digital",
		},
		{
			"@type": "HowToStep",
			name: "Genera y publica tu QR",
			text: "Genera tu código QR y compártelo con tus clientes.",
			url: "https://menusdigitalesmonterrey.com/crear-menu-digital",
		},
	],
};
---

<DefaultLayout
	title={seoData.title}
	description={seoData.description}
	keywords={seoData.keywords}
	showAds={false}
	schema={guideSchema}
>
	<div>
		<main class="flex-1">
			<!-- New Landing Redirect Banner -->
			<div class="bg-marca-500 py-3 text-center px-4">
				<p class="text-white text-xs font-bold uppercase tracking-widest">
					🚀 ¿Quieres ver el creador de menús?
					<a
						href="/menu-digital-gratis"
						class="underline ml-2 hover:text-marca-100 transition-colors"
						>Ver Nueva Plataforma Aquí</a
					>
				</p>
			</div>
			<!-- Hero Section Minimalist -->
			<section class="py-20 md:py-32 bg-white relative overflow-hidden">
				<div
					class="max-w-5xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12 items-center"
				>
					<div class="text-left">
						<div
							class="inline-block px-3 py-1 mb-6 text-xs font-semibold tracking-wider text-marca-800 uppercase bg-marca-100 rounded-full"
						>
							Sin Comisiones
						</div>
						<h1
							class="text-4xl md:text-6xl font-black text-neutral-900 mb-6 tracking-tighter tight-leading leading-[0.9]"
						>
							Crea tu <span class="text-marca-500">Menú Digital</span>
							<br />
							en solo 10 minutos.
						</h1>
						<p
							class="text-xl text-neutral-600 mb-8 max-w-lg leading-relaxed font-medium"
						>
							Olvida los PDFs estáticos. Utiliza nuestro <strong
								>creador de menús digitales</strong
							> para tener una carta QR profesional, actualizable y optimizada para
							Google.
						</p>

						<div class="flex flex-col sm:flex-row gap-4 mb-8">
							<a
								href="https://admin-menus.bysmax.com/login"
								class="inline-flex justify-center items-center px-6 py-3 bg-neutral-900 text-white font-semibold rounded-xl hover:bg-neutral-800 transition-all duration-200 shadow-neutral-900/10"
							>
								Empezar ahora
								<ArrowRight className="ml-2 h-4 w-4" />
							</a>
							<a
								href="#como-funciona"
								class="inline-flex justify-center items-center px-6 py-3 border border-neutral-200 text-neutral-600 font-medium rounded-xl hover:bg-neutral-50 transition-all duration-200"
							>
								Cómo funciona
							</a>
						</div>

						<div class="flex items-center gap-6 text-sm text-neutral-500">
							<div class="flex items-center">
								<Check className="h-4 w-4 text-marca-500 mr-2" />
								Código QR incluido
							</div>
							<div class="flex items-center">
								<Check className="h-4 w-4 text-marca-500 mr-2" />
								Carga rápida
							</div>
						</div>
					</div>

					<div class="relative">
						<div
							class="absolute inset-0 bg-gradient-to-tr from-marca-100 to-marca-50 rounded-3xl transform rotate-3 scale-95 opacity-50 -z-10"
						>
						</div>
						<Image
							src={main_menu}
							alt="Vista previa de menú digital en celular"
							class="relative w-full max-w-md mx-auto rounded-2xl shadow-2xl border-4 border-white"
						/>
					</div>
				</div>
			</section>

			<!-- Simple Steps -->
			<section id="como-funciona" class="py-20 bg-neutral-50">
				<div class="max-w-5xl mx-auto px-6">
					<div class="text-center mb-16">
						<h2
							class="text-3xl md:text-4xl font-black text-neutral-900 mb-4 tracking-tighter"
						>
							Cómo hacer una carta digital con código QR
						</h2>
						<p class="text-neutral-500">
							Sin diseñadores, sin complicaciones técnicas.
						</p>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
						<div class="relative group text-center md:text-left">
							<div
								class="mb-6 text-5xl opacity-40 group-hover:opacity-100 transition-opacity"
							>
								📄
							</div>
							<h3 class="font-bold text-xl mb-3">1. Sube tu carta actual</h3>
							<p class="text-neutral-600 leading-relaxed">
								Importamos tus fotos o PDF. Nuestra tecnología organiza tus
								platillos automáticamente.
							</p>
						</div>

						<div class="relative group text-center md:text-left">
							<div
								class="mb-6 text-5xl opacity-40 group-hover:opacity-100 transition-opacity"
							>
								🎨
							</div>
							<h3 class="font-bold text-xl mb-3">2. Elige tu Estilo</h3>
							<p class="text-neutral-600 leading-relaxed">
								Selecciona entre cientos de diseños profesionales. Personaliza
								colores, logos y categorías.
							</p>
						</div>

						<div class="relative group text-center md:text-left">
							<div
								class="mb-6 text-5xl opacity-40 group-hover:opacity-100 transition-opacity"
							>
								🚀
							</div>
							<h3 class="font-bold text-xl mb-3">3. Publica en segundos</h3>
							<p class="text-neutral-600 leading-relaxed">
								Genera tu QR y compártelo. Tu menú estará en Google, Instagram y
								en tus mesas al instante.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Features Highlights (Refined) -->
			<section class="py-24 bg-white">
				<div class="max-w-6xl mx-auto px-6">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
						<div>
							<h2
								class="text-3xl md:text-5xl font-black text-neutral-900 mb-8 tracking-tighter leading-tight"
							>
								Un sistema, <br />
								<span class="text-marca-500">todos los formatos.</span>
							</h2>
							<div class="space-y-8">
								<div class="flex gap-4">
									<div
										class="w-12 h-12 rounded-2xl bg-neutral-100 flex items-center justify-center shrink-0"
									>
										<QrCode className="w-6 h-6" />
									</div>
									<div>
										<h4 class="font-bold text-lg">Menú QR Digital</h4>
										<p class="text-neutral-500">
											Acceso instantáneo para tus clientes desde cualquier
											celular. Sin descargar apps.
										</p>
									</div>
								</div>
								<div class="flex gap-4">
									<div
										class="w-12 h-12 rounded-2xl bg-neutral-100 flex items-center justify-center shrink-0"
									>
										<Check className="w-6 h-6 text-marca-500" />
									</div>
									<div>
										<h4 class="font-bold text-lg">Multiidioma</h4>
										<p class="text-neutral-500">
											Atiende a clientes internacionales. Traducimos tu menú
											automáticamente (Próximamente).
										</p>
									</div>
								</div>
								<div class="flex gap-4">
									<div
										class="w-12 h-12 rounded-2xl bg-neutral-100 flex items-center justify-center shrink-0"
									>
										<Zap className="w-6 h-6 text-neutral-500" />
									</div>
									<div>
										<h4 class="font-bold text-lg">
											Actualización en Tiempo Real
										</h4>
										<p class="text-neutral-500">
											Cambia un precio o agota un platillo y se reflejará en
											todos lados al segundo.
										</p>
									</div>
								</div>
							</div>
						</div>
						<div
							class="bg-neutral-900 rounded-[40px] p-12 text-white relative overflow-hidden"
						>
							<div
								class="absolute top-0 right-0 w-64 h-64 bg-marca-500/20 blur-[100px]"
							>
							</div>
							<h3 class="text-2xl font-bold mb-6">Aumenta tus ventas un 30%</h3>
							<p class="text-neutral-400 mb-8 leading-relaxed">
								Psicología de precios aplicada al diseño. Destacamos tus platos
								más rentables y guiamos al cliente para que gaste más.
							</p>
							<a
								href="https://admin-menus.bysmax.com/login"
								class="inline-flex items-center text-marca-400 font-bold hover:gap-3 transition-all duration-300"
							>
								Empieza a ahorrar tiempo <ArrowRight className="ml-2 w-5 h-5" />
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Comparison Clean -->
			<section class="py-20 bg-white">
				<div class="max-w-3xl mx-auto px-6">
					<h2 class="text-3xl font-bold text-neutral-900 mb-12 text-center">
						Mejor que un PDF
					</h2>

					<div class="space-y-4">
						<div
							class="flex items-center justify-between p-4 bg-neutral-50 rounded-xl"
						>
							<div class="flex items-center gap-4">
								<div class="bg-white p-2 rounded-lg shadow-sm text-marca-600">
									<Smartphone className="w-5 h-5" />
								</div>
								<span class="font-medium text-neutral-700"
									>Se adapta al celular</span
								>
							</div>
							<Check className="text-marca-500 w-5 h-5" />
						</div>
						<div
							class="flex items-center justify-between p-4 bg-neutral-50 rounded-xl"
						>
							<div class="flex items-center gap-4">
								<div class="bg-white p-2 rounded-lg shadow-sm text-neutral-600">
									<ImageIcon className="w-5 h-5" />
								</div>
								<span class="font-medium text-neutral-700"
									>Fotos en alta calidad</span
								>
							</div>
							<Check className="text-marca-500 w-5 h-5" />
						</div>
						<div
							class="flex items-center justify-between p-4 bg-neutral-50 rounded-xl"
						>
							<div class="flex items-center gap-4">
								<div class="bg-white p-2 rounded-lg shadow-sm text-neutral-600">
									<Zap className="w-5 h-5" />
								</div>
								<span class="font-medium text-neutral-700">Carga inmediata</span>
							</div>
							<Check className="text-marca-500 w-5 h-5" />
						</div>
						<div
							class="flex items-center justify-between p-4 bg-neutral-50 rounded-xl"
						>
							<div class="flex items-center gap-4">
								<div class="bg-white p-2 rounded-lg shadow-sm text-neutral-600">
									<Layout className="w-5 h-5" />
								</div>
								<span class="font-medium text-neutral-700"
									>Fácil de actualizar</span
								>
							</div>
							<Check className="text-marca-500 w-5 h-5" />
						</div>
					</div>
				</div>
			</section>

			<!-- CTA Simple -->
			<section class="py-20 bg-neutral-900 text-white text-center">
				<div class="max-w-2xl mx-auto px-6">
					<h2 class="text-3xl font-bold mb-6">
						Únete a más de 10,000 restaurantes
					</h2>
					<p class="text-lg text-neutral-400 mb-8">
						Crea tu cuenta en segundos y empieza a digitalizar tu menú
						hoy mismo.
					</p>

					<a
						href="https://admin-menus.bysmax.com/login"
						class="inline-flex items-center px-8 py-4 bg-marca-500 text-white font-bold rounded-xl hover:bg-marca-600 transition-all transform hover:scale-105 shadow-xl shadow-marca-500/20"
					>
						Crear mi menú
					</a>
				</div>
			</section>
		</main>
	</div>
</DefaultLayout>
