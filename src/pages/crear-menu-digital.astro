---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import main_menu from "./phone_with_menu.png";
import {
	QrCode,
	Zap,
	ArrowRight,
	Check,
	Layout,
	Image as ImageIcon,
	Smartphone,
} from "lucide-react";

import { Image } from "astro:assets";
import DefaultLayout from "../layouts/DefaultLayout.astro";

const seoData = {
	title: "Crear Menú Digital GRATIS con Código QR - BySMax",
	description:
		"La forma más simple de tener tu menú en internet. Crea tu carta con código QR en minutos. Gratis y sin complicaciones.",
	keywords:
		"crear menú digital, carta digital qr, menú código qr gratis, sistema para restaurantes, menú digital whatsapp",
};
---

<DefaultLayout
	title={seoData.title}
	description={seoData.description}
	keywords={seoData.keywords}
	showAds={false}
>
	<div>
		<main class="flex-1">
			<!-- Hero Section Minimalist -->
			<section class="py-20 md:py-32 bg-white relative overflow-hidden">
				<div
					class="max-w-5xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12 items-center"
				>
					<div class="text-left">
						<div
							class="inline-block px-3 py-1 mb-6 text-xs font-semibold tracking-wider text-emerald-800 uppercase bg-emerald-100 rounded-full"
						>
							Sin Comisiones
						</div>
						<h1
							class="text-4xl md:text-5xl font-bold text-slate-900 mb-6 tracking-tight tight-leading"
						>
							Tu Menú Digital <br />
							<span class="text-emerald-600">Listo en Minutos</span>
						</h1>
						<p class="text-lg text-slate-600 mb-8 max-w-lg leading-relaxed">
							Olvídate de los PDFs difíciles de leer. Crea una experiencia móvil
							increíble para tus clientes. Gratis y fácil.
						</p>

						<div class="flex flex-col sm:flex-row gap-4 mb-8">
							<a
								href="/admin/login"
								class="inline-flex justify-center items-center px-6 py-3 bg-slate-900 text-white font-semibold rounded-xl hover:bg-slate-800 transition-all duration-200 shadow-lg shadow-slate-900/10"
							>
								Empezar Gratis
								<ArrowRight className="ml-2 h-4 w-4" />
							</a>
							<a
								href="#como-funciona"
								class="inline-flex justify-center items-center px-6 py-3 border border-slate-200 text-slate-600 font-medium rounded-xl hover:bg-slate-50 transition-all duration-200"
							>
								Cómo funciona
							</a>
						</div>

						<div class="flex items-center gap-6 text-sm text-slate-500">
							<div class="flex items-center">
								<Check className="h-4 w-4 text-emerald-500 mr-2" />
								Código QR gratis
							</div>
							<div class="flex items-center">
								<Check className="h-4 w-4 text-emerald-500 mr-2" />
								Carga rápida
							</div>
						</div>
					</div>

					<div class="relative">
						<div
							class="absolute inset-0 bg-gradient-to-tr from-emerald-100 to-teal-50 rounded-3xl transform rotate-3 scale-95 opacity-50 -z-10"
						>
						</div>
						<Image
							src={main_menu}
							alt="Vista previa de menú digital en celular"
							class="relative w-full max-w-md mx-auto rounded-2xl shadow-2xl border-4 border-white"
						/>
					</div>
				</div>
			</section>

			<!-- Simple Steps -->
			<section id="como-funciona" class="py-20 bg-slate-50">
				<div class="max-w-4xl mx-auto px-6 text-center">
					<h2 class="text-3xl font-bold text-slate-900 mb-16">
						Solo necesitas 3 pasos
					</h2>

					<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
						<div
							class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow"
						>
							<div
								class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center mx-auto mb-6"
							>
								<span class="font-bold text-xl">1</span>
							</div>
							<h3 class="font-semibold text-lg mb-2">Sube tus productos</h3>
							<p class="text-slate-500 text-sm">
								Agrega fotos y precios desde tu celular o computadora.
							</p>
						</div>

						<div
							class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow"
						>
							<div
								class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center mx-auto mb-6"
							>
								<span class="font-bold text-xl">2</span>
							</div>
							<h3 class="font-semibold text-lg mb-2">Personaliza</h3>
							<p class="text-slate-500 text-sm">
								Elige colores y logo para que coincida con tu marca.
							</p>
						</div>

						<div
							class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow"
						>
							<div
								class="w-12 h-12 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center mx-auto mb-6"
							>
								<span class="font-bold text-xl">3</span>
							</div>
							<h3 class="font-semibold text-lg mb-2">Descarga el QR</h3>
							<p class="text-slate-500 text-sm">
								Imprímelo y pégalo en tus mesas. ¡Listo!
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Comparison Clean -->
			<section class="py-20 bg-white">
				<div class="max-w-3xl mx-auto px-6">
					<h2 class="text-3xl font-bold text-slate-900 mb-12 text-center">
						Mejor que un PDF
					</h2>

					<div class="space-y-4">
						<div
							class="flex items-center justify-between p-4 bg-slate-50 rounded-xl"
						>
							<div class="flex items-center gap-4">
								<div class="bg-white p-2 rounded-lg shadow-sm text-emerald-600">
									<Smartphone className="w-5 h-5" />
								</div>
								<span class="font-medium text-slate-700"
									>Se adapta al celular</span
								>
							</div>
							<Check className="text-emerald-500 w-5 h-5" />
						</div>
						<div
							class="flex items-center justify-between p-4 bg-slate-50 rounded-xl"
						>
							<div class="flex items-center gap-4">
								<div class="bg-white p-2 rounded-lg shadow-sm text-blue-600">
									<ImageIcon className="w-5 h-5" />
								</div>
								<span class="font-medium text-slate-700"
									>Fotos en alta calidad</span
								>
							</div>
							<Check className="text-emerald-500 w-5 h-5" />
						</div>
						<div
							class="flex items-center justify-between p-4 bg-slate-50 rounded-xl"
						>
							<div class="flex items-center gap-4">
								<div class="bg-white p-2 rounded-lg shadow-sm text-orange-600">
									<Zap className="w-5 h-5" />
								</div>
								<span class="font-medium text-slate-700">Carga inmediata</span>
							</div>
							<Check className="text-emerald-500 w-5 h-5" />
						</div>
						<div
							class="flex items-center justify-between p-4 bg-slate-50 rounded-xl"
						>
							<div class="flex items-center gap-4">
								<div class="bg-white p-2 rounded-lg shadow-sm text-purple-600">
									<Layout className="w-5 h-5" />
								</div>
								<span class="font-medium text-slate-700"
									>Fácil de actualizar</span
								>
							</div>
							<Check className="text-emerald-500 w-5 h-5" />
						</div>
					</div>
				</div>
			</section>

			<!-- CTA Simple -->
			<section class="py-20 bg-slate-900 text-white text-center">
				<div class="max-w-2xl mx-auto px-6">
					<h2 class="text-3xl font-bold mb-6">
						Únete a más de 10,000 restaurantes
					</h2>
					<p class="text-lg text-slate-400 mb-8">
						Crea tu cuenta gratis en segundos y empieza a digitalizar tu menú
						hoy mismo.
					</p>

					<a
						href="/admin/login"
						class="inline-flex items-center px-8 py-4 bg-emerald-500 text-white font-bold rounded-xl hover:bg-emerald-600 transition-all transform hover:scale-105 shadow-xl shadow-emerald-500/20"
					>
						Crear Menú Gratis
					</a>
				</div>
			</section>
		</main>
	</div>
</DefaultLayout>
