---
export const prerender = false;

import PlaceAdminLayout from "../../../../layouts/PlaceAdminLayout.astro";
import { isAuthenticated } from "../../../../middleware/auth";
import PlaceInsightsContainer from "../../../../components/admin/PlaceInsightsContainer";

const { id } = Astro.params;
const isAuth = await isAuthenticated(Astro.request, Astro.cookies);

if (!isAuth) return Astro.redirect("/admin/login");
---

<PlaceAdminLayout title={`Analíticas | BysMax`} placeId={id!}>
	<PlaceInsightsContainer client:only="react" placeId={id!} />
</PlaceAdminLayout>
