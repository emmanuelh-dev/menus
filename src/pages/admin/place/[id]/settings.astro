---
export const prerender = false;

import PlaceAdminLayout from "../../../../layouts/PlaceAdminLayout.astro";
import { isAuthenticated } from "../../../../middleware/auth";
import PlaceEditContainer from "../../../../components/admin/PlaceEditContainer";

const { id } = Astro.params;
const isAuth = await isAuthenticated(Astro.request, Astro.cookies);

if (!isAuth) return Astro.redirect("/admin/login");
---

<PlaceAdminLayout title={`Configuración | BysMax`} placeId={id!}>
	<PlaceEditContainer client:only="react" placeId={id!} initialTab="info" />
</PlaceAdminLayout>
