---
export const prerender = false;
import PlaceAdminLayout from "../../../../layouts/PlaceAdminLayout.astro";
import WaiterMode from "../../../../components/admin/WaiterMode";
import { supabase } from "../../../../lib/supabase";

const { id } = Astro.params;

const { data: place, error } = await supabase
	.from("places")
	.select("name")
	.eq("id", id)
	.single();

if (error || !place) {
	return Astro.redirect("/admin");
}
---

<PlaceAdminLayout title={`Nueva Comanda - ${place.name}`} placeId={id!}>
	<div class="h-[calc(100vh-140px)] min-h-[600px]">
		<div class="flex items-center gap-4 mb-6 xl:px-4">
			<h1 class="text-xl font-bold">Nueva Comanda</h1>
		</div>

		<WaiterMode placeId={Number(id)} client:load isPage={true} />
	</div>
</PlaceAdminLayout>
