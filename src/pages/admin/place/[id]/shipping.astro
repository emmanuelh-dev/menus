---
export const prerender = false;

import PlaceAdminLayout from "../../../../layouts/PlaceAdminLayout.astro";
import ShippingZonesManager from "../../../../components/admin/ShippingZonesManager.tsx";
import { supabase } from "../../../../lib/supabase";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const { data: place } = await supabase
	.from("places")
	.select("*")
	.eq("id", id)
	.single();

if (!place) {
	return Astro.redirect("/admin/dashboard");
}
---

<PlaceAdminLayout title={`Zonas de Envío - ${place.name}`} placeId={id!}>
	<ShippingZonesManager client:load placeId={parseInt(id)} />
</PlaceAdminLayout>
