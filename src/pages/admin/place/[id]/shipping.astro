---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import ShippingZonesManager from '../../../../components/admin/ShippingZonesManager.tsx';
import { supabase } from '../../../../lib/supabase';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin');
}

const { data: place } = await supabase
  .from('places')
  .select('*')
  .eq('id', id)
  .single();

if (!place) {
  return Astro.redirect('/admin/dashboard');
}
---

<AdminLayout title={`Zonas de Envío - ${place.name}`}>
  <div class="p-6">
    <div class="mb-6">
      <div class="flex items-center gap-4 mb-2">
        <a
          href="/admin/dashboard"
          class="text-slate-400 hover:text-slate-600 transition-colors"
        >
          ← Volver
        </a>
      </div>
      <h1 class="text-2xl font-bold text-slate-900">
        Configurar Zonas de Envío
      </h1>
      <p class="text-slate-600 mt-1">{place.name}</p>
    </div>

    <ShippingZonesManager client:load placeId={parseInt(id)} />
  </div>
</AdminLayout>
