---
export const prerender = false;
import PlaceAdminLayout from "../../../../layouts/PlaceAdminLayout.astro";
import CashControl from "../../../../components/admin/CashControl";
import { supabase } from "../../../../lib/supabase";

const { id } = Astro.params;

const { data: place, error } = await supabase
	.from("places")
	.select("*")
	.eq("id", id)
	.single();

if (error || !place) {
	return Astro.redirect("/admin");
}
---

<PlaceAdminLayout title={`Arqueo - ${place.name}`} placeId={id!}>
	<CashControl
		placeId={Number(id)}
		initialContent={place.content}
		client:load
	/>
</PlaceAdminLayout>
