---
// filepath: c:\Users\Emmanuel\Documents\GitHub\menus\src\pages\admin\categories\[id]\edit.astro
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { isAuthenticated } from '../../../../middleware/auth';
import { createSupabaseClient } from '../../../../lib/supabase';

const isAuth = await isAuthenticated(Astro.request, Astro.cookies);

if (!isAuth) {
  return Astro.redirect("/admin/login");
}

const accessTokenCookie = Astro.cookies.get("sb-access-token");
const refreshTokenCookie = Astro.cookies.get("sb-refresh-token");

if (!accessTokenCookie || !refreshTokenCookie) {
  return Astro.redirect("/admin/login");
}

const supabase = createSupabaseClient(
  accessTokenCookie.value,
  refreshTokenCookie.value
);

const { id } = Astro.params;

// Definir tipos
interface Category {
  id: number;
  name: string;
  description?: string;
  restaurant_id: number;
  parent_id?: number;
  is_active: boolean;
  restaurant_name?: string;
  image?: string;
  display_order?: number;
}

interface ParentCategory {
  id: number;
  name: string;
}

// Obtener datos de la categoría existente
let category: Category | null = null;
let parentCategories: ParentCategory[] = [];
let error: string | null = null;

try {
    // Obtener datos de la categoría con información del restaurante
    const { data: categoryData, error: categoryError } = await supabase
        .from('menu_categories')
        .select(`
            *,
            restaurants (
                id,
                name
            )
        `)
        .eq('id', id)
        .single();
    
    if (categoryError || !categoryData) {
        throw new Error('Categoría no encontrada');
    }
    
    // Formatear los datos
    category = {
        ...categoryData,
        restaurant_name: categoryData.restaurants?.name
    } as Category;

    // Obtener categorías padre posibles (del mismo restaurante, excluyendo la actual y sus hijos)
    const { data: parentData, error: parentError } = await supabase
        .from('menu_categories')
        .select('id, name')
        .eq('restaurant_id', category.restaurant_id)
        .neq('id', id)
        .is('parent_id', null)
        .order('name');
    
    if (!parentError && parentData) {
        parentCategories = parentData;
    }

} catch (err: any) {
    console.error('Error:', err);
    error = err.message;
}

// Manejar el envío del formulario
if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();

        const name = formData.get('name') as string;
        const description = formData.get('description') as string;
        const image = formData.get('image') as string;
        const parent_id = formData.get('parent_id') as string || null;
        const display_order = parseInt(formData.get('display_order') as string) || 0;
        const is_active = formData.get('is_active') === 'on';

        const { error: updateError } = await supabase
            .from('menu_categories')
            .update({
                name,
                description,
                image,
                parent_id: parent_id ? parseInt(parent_id) : null,
                display_order,
                is_active,
                updated_at: new Date().toISOString()
            })
            .eq('id', id);

        if (updateError) {
            throw new Error(updateError.message);
        }

        return Astro.redirect(`/admin/menus/${category?.restaurant_id}/categories?success=category_updated`);
    } catch (err: any) {
        console.error('Error updating category:', err);
        error = 'Error al actualizar la categoría: ' + err.message;
    }
}
---

<AdminLayout title="Editar Categoría">
    <div class="container mx-auto px-4 py-8">
        <div class="max-w-2xl mx-auto">
            <div class="flex justify-between items-center mb-8">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">Editar Categoría</h1>
                    <p class="text-gray-600 mt-2">Modifica la información de la categoría</p>
                </div>
                <a href={`/admin/menus/${category?.restaurant_id}/categories`} class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors">
                    Volver a Categorías
                </a>
            </div>

            {error && (
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                    {error}
                </div>
            )}

            {category && (
                <form method="POST" class="bg-white shadow-lg rounded-lg p-8">
                    <div class="space-y-6">
                        <div>
                            <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                                Nombre de la Categoría *
                            </label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                value={category.name}
                                required
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                placeholder="Ej: Entradas, Platos Principales, Bebidas"
                            />
                        </div>

                        <div>
                            <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
                                Descripción
                            </label>
                            <textarea
                                id="description"
                                name="description"
                                rows="3"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                placeholder="Descripción de la categoría..."
                            >{category.description}</textarea>
                        </div>

                        <div>
                            <label for="image" class="block text-sm font-medium text-gray-700 mb-2">
                                URL de la Imagen
                            </label>
                            <input
                                type="url"
                                id="image"
                                name="image"
                                value={category.image}
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                placeholder="https://ejemplo.com/imagen.jpg"
                            />
                            <p class="text-sm text-gray-500 mt-1">
                                Imagen de fondo para la categoría (opcional)
                            </p>
                        </div>

                        <div>
                            <label for="parent_id" class="block text-sm font-medium text-gray-700 mb-2">
                                Categoría Padre (Subcategoría)
                            </label>
                            <select
                                id="parent_id"
                                name="parent_id"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            >
                                <option value="">Sin categoría padre</option>
                                {parentCategories.map(parent => (
                                    <option 
                                        value={parent.id}
                                        selected={parent.id === category.parent_id}
                                    >
                                        {parent.name}
                                    </option>
                                ))}
                            </select>
                            <p class="text-sm text-gray-500 mt-1">
                                Selecciona una categoría padre para crear una subcategoría
                            </p>
                        </div>

                        <div>
                            <label for="display_order" class="block text-sm font-medium text-gray-700 mb-2">
                                Orden de Visualización
                            </label>
                            <input
                                type="number"
                                id="display_order"
                                name="display_order"
                                value={category.display_order}
                                min="0"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                placeholder="0"
                            />
                            <p class="text-sm text-gray-500 mt-1">
                                Orden en que aparecerá la categoría (menor número = primero)
                            </p>
                        </div>

                        <div>
                            <label class="flex items-center space-x-3">
                                <input
                                    type="checkbox"
                                    name="is_active"
                                    checked={category.is_active}
                                    class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                                />
                                <span class="text-sm font-medium text-gray-700">Categoría activa</span>
                            </label>
                            <p class="text-sm text-gray-500 mt-1">
                                Las categorías inactivas no se mostrarán en el menú público
                            </p>
                        </div>
                    </div>

                    <div class="flex justify-end space-x-4 mt-8 pt-6 border-t border-gray-200">
                        <a href={`/admin/menus/${category.restaurant_id}/categories`} class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                            Cancelar
                        </a>
                        <button
                            type="submit"
                            class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                        >
                            Actualizar Categoría
                        </button>
                    </div>
                </form>
            )}
        </div>
    </div>
</AdminLayout>
