      initializeFilters();
      initializeSearch();
      initializeBulkActions();
      initializeDeleteButtons();
      initializeRestaurantModal();
      updateStats();
    });function initializeRestaurantsData() {
      const rows = document.querySelectorAll('#restaurants-table tbody tr') as NodeListOf<HTMLTableRowElement>;
      allRestaurants = Array.from(rows).map(row => {
        const id = (row as HTMLElement).dataset.restaurantId || '';
        const cells = row.querySelectorAll('td');
        return {
          id,
          element: row,
          name: cells[3]?.textContent?.trim() || '',
          shortName: cells[2]?.textContent?.trim() || '',
          type: cells[4]?.textContent?.trim() || '',
          address: cells[5]?.textContent?.trim() || '',
          featured: cells[8]?.textContent?.includes('Destacado') || false
        } as RestaurantData;
      });
      filteredRestaurants = [...allRestaurants];
    }function initializeFilters() {
      // Poblar filtro de tipos
      const typeFilter = document.getElementById('type-filter') as HTMLSelectElement;
      if (!typeFilter) return;
      
      const types = [...new Set(allRestaurants.map(r => r.type))].filter(Boolean);
      types.forEach(type => {
        const option = document.createElement('option');
        option.value = type;
        option.textContent = type;
        typeFilter.appendChild(option);
      });

      // Event listeners para filtros
      typeFilter.addEventListener('change', applyFilters);
      
      const featuredFilter = document.getElementById('featured-filter') as HTMLSelectElement;
      if (featuredFilter) {
        featuredFilter.addEventListener('change', applyFilters);
      }
      
      const clearFiltersBtn = document.getElementById('clear-filters');
      if (clearFiltersBtn) {
        clearFiltersBtn.addEventListener('click', clearFilters);
      }
    }    function initializeSearch() {
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      if (!searchInput) return;
      
      let searchTimeout: NodeJS.Timeout;
      
      searchInput.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          applyFilters();
        }, 300);
      });
    }function initializeBulkActions() {
      const selectAllCheckbox = document.getElementById('select-all') as HTMLInputElement;
      const bulkActionsPanel = document.getElementById('bulk-actions');
      
      if (!selectAllCheckbox || !bulkActionsPanel) return;
      
      selectAllCheckbox.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (!target) return;
        
        const checkboxes = document.querySelectorAll('.restaurant-checkbox') as NodeListOf<HTMLInputElement>;
        checkboxes.forEach(checkbox => {
          const row = checkbox.closest('tr');
          if (row && row.style.display !== 'none') {
            checkbox.checked = target.checked;
            const dataId = checkbox.dataset.id;
            if (dataId) {
              if (target.checked) {
                selectedRestaurants.add(dataId);
              } else {
                selectedRestaurants.delete(dataId);
              }
            }
          }
        });
        updateBulkActions();
      });

      // Event listeners para checkboxes individuales
      document.addEventListener('change', (e) => {
        const target = e.target as HTMLElement;
        if (!target) return;
        
        if (target.classList.contains('restaurant-checkbox')) {
          const checkbox = target as HTMLInputElement;
          const dataId = checkbox.dataset.id;
          if (dataId) {
            if (checkbox.checked) {
              selectedRestaurants.add(dataId);
            } else {
              selectedRestaurants.delete(dataId);
            }
          }
          updateBulkActions();
        }
      });

      // Bulk actions
      const bulkDeleteBtn = document.getElementById('bulk-delete');
      const bulkFeatureBtn = document.getElementById('bulk-feature');
      const bulkUnfeatureBtn = document.getElementById('bulk-unfeature');
      
      if (bulkDeleteBtn) {
        bulkDeleteBtn.addEventListener('click', bulkDelete);
      }
      if (bulkFeatureBtn) {
        bulkFeatureBtn.addEventListener('click', () => bulkToggleFeature(true));
      }
      if (bulkUnfeatureBtn) {
        bulkUnfeatureBtn.addEventListener('click', () => bulkToggleFeature(false));
      }
    }    function initializeDeleteButtons() {
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target) return;
        
        if (target.classList.contains('delete-btn') || target.closest('.delete-btn')) {
          const button = target.classList.contains('delete-btn') ? target : target.closest('.delete-btn') as HTMLElement;
          if (!button) return;
          
          const id = button.getAttribute('data-id');
          if (!id) return;
          
          if (confirm('¿Estás seguro de que deseas eliminar este restaurante?')) {
            deleteRestaurant(id);
          }
        }
      });
    }    function applyFilters() {
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const typeFilterElement = document.getElementById('type-filter') as HTMLSelectElement;
      const featuredFilterElement = document.getElementById('featured-filter') as HTMLSelectElement;
      
      if (!searchInput || !typeFilterElement || !featuredFilterElement) return;
      
      const searchTerm = searchInput.value.toLowerCase();
      const typeFilter = typeFilterElement.value;
      const featuredFilter = featuredFilterElement.value;

      allRestaurants.forEach(restaurant => {
        let visible = true;

        // Filtro de búsqueda
        if (searchTerm) {
          const searchableText = `${restaurant.name} ${restaurant.shortName} ${restaurant.type} ${restaurant.address}`.toLowerCase();
          visible = visible && searchableText.includes(searchTerm);
        }

        // Filtro de tipo
        if (typeFilter) {
          visible = visible && restaurant.type === typeFilter;
        }

        // Filtro de destacado
        if (featuredFilter) {
          const isFeatured = featuredFilter === 'true';
          visible = visible && restaurant.featured === isFeatured;
        }

        restaurant.element.style.display = visible ? '' : 'none';
      });

      updateStats();
      updateSelectAllState();
    }    function clearFilters() {
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const typeFilter = document.getElementById('type-filter') as HTMLSelectElement;
      const featuredFilter = document.getElementById('featured-filter') as HTMLSelectElement;
      
      if (searchInput) searchInput.value = '';
      if (typeFilter) typeFilter.value = '';
      if (featuredFilter) featuredFilter.value = '';
      
      applyFilters();
    }    function updateStats() {
      const visibleRestaurants = allRestaurants.filter(r => r.element.style.display !== 'none');
      
      const totalCountElement = document.getElementById('total-count');
      if (totalCountElement) {
        totalCountElement.textContent = visibleRestaurants.length.toString();
      }
      
      const featuredCount = visibleRestaurants.filter(r => r.featured).length;
      const featuredCountElement = document.getElementById('featured-count');
      if (featuredCountElement) {
        featuredCountElement.textContent = featuredCount.toString();
      }
    }    function updateBulkActions() {
      const bulkActionsPanel = document.getElementById('bulk-actions');
      const selectionCount = document.getElementById('selection-count');
      const selectedCount = document.getElementById('selected-count');
      
      if (!bulkActionsPanel || !selectionCount || !selectedCount) return;
      
      if (selectedRestaurants.size > 0) {
        bulkActionsPanel.classList.remove('hidden');
        selectionCount.textContent = `${selectedRestaurants.size} elemento${selectedRestaurants.size !== 1 ? 's' : ''} seleccionado${selectedRestaurants.size !== 1 ? 's' : ''}`;
        selectedCount.textContent = selectedRestaurants.size.toString();
      } else {
        bulkActionsPanel.classList.add('hidden');
        selectedCount.textContent = '0';
      }
      
      updateSelectAllState();
    }    function updateSelectAllState() {
      const selectAllCheckbox = document.getElementById('select-all') as HTMLInputElement;
      if (!selectAllCheckbox) return;
      
      const visibleCheckboxes = Array.from(document.querySelectorAll('.restaurant-checkbox') as NodeListOf<HTMLInputElement>).filter(
        cb => {
          const row = cb.closest('tr');
          return row && row.style.display !== 'none';
        }
      );
      
      if (visibleCheckboxes.length === 0) {
        selectAllCheckbox.indeterminate = false;
        selectAllCheckbox.checked = false;
        return;
      }
      
      const checkedVisible = visibleCheckboxes.filter(cb => cb.checked);
      
      if (checkedVisible.length === 0) {
        selectAllCheckbox.indeterminate = false;
        selectAllCheckbox.checked = false;
      } else if (checkedVisible.length === visibleCheckboxes.length) {
        selectAllCheckbox.indeterminate = false;
        selectAllCheckbox.checked = true;
      } else {
        selectAllCheckbox.indeterminate = true;
        selectAllCheckbox.checked = false;
      }
    }    async function deleteRestaurant(id) {
      try {
        // Usar Supabase directamente para eliminar
        const { createSupabaseClient } = await import('../../../lib/supabase.js');
        const supabase = createSupabaseClient();
        
        const { error } = await supabase
          .from('restaurants')
          .delete()
          .eq('id', id);
        
        if (error) throw error;
        
        window.location.reload();
      } catch (error) {
        console.error('Error:', error);
        alert('Error al eliminar el restaurante');
      }
    }    async function bulkDelete() {
      if (selectedRestaurants.size === 0) return;
      
      const count = selectedRestaurants.size;
      if (!confirm(`¿Estás seguro de que deseas eliminar ${count} restaurante${count !== 1 ? 's' : ''}?`)) {
        return;
      }

      try {
        // Usar Supabase directamente para eliminación masiva
        const { createSupabaseClient } = await import('../../../lib/supabase.js');
        const supabase = createSupabaseClient();
        
        const idsArray = Array.from(selectedRestaurants);
        const { error } = await supabase
          .from('restaurants')
          .delete()
          .in('id', idsArray);
        
        if (error) throw error;
        
        window.location.reload();
      } catch (error) {
        console.error('Error:', error);
        alert('Error al eliminar los restaurantes');
      }
    }    async function bulkToggleFeature(featured) {
      if (selectedRestaurants.size === 0) return;
      
      const count = selectedRestaurants.size;
      const action = featured ? 'destacar' : 'quitar como destacados';
      
      if (!confirm(`¿Estás seguro de que deseas ${action} ${count} restaurante${count !== 1 ? 's' : ''}?`)) {
        return;
      }

      try {
        const restaurantIds = Array.from(selectedRestaurants);
        
        // Usar Supabase directamente para actualizar restaurantes
        const { createSupabaseClient } = await import('../../../lib/supabase.js');
        const supabase = createSupabaseClient();
        
        const { error } = await supabase
          .from('restaurants')
          .update({ featured })
          .in('id', restaurantIds);
        
        if (error) {
          console.error('Error al actualizar restaurantes:', error);
          alert('Error al actualizar los restaurantes');
          return;
        }
        
        // Actualizar la UI localmente
        restaurantIds.forEach(id => {
          const row = document.querySelector(`tr[data-restaurant-id="${id}"]`);
          if (row) {
            const nameCell = row.querySelector('.restaurant-name');
            if (nameCell) {
              const badge = nameCell.querySelector('.featured-badge');
              if (featured) {
                if (!badge) {
                  const newBadge = document.createElement('span');
                  newBadge.className = 'featured-badge inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 ml-2';
                  newBadge.textContent = 'Destacado';
                  nameCell.appendChild(newBadge);
                }
              } else {
                if (badge) {
                  badge.remove();
                }
              }
            }
          }
        });
        
        // Limpiar selección
        selectedRestaurants.clear();
        updateBulkActions();
        updateSelectAllState();
        
        alert(`Se ${featured ? 'destacaron' : 'quitaron como destacados'} ${count} restaurante${count !== 1 ? 's' : ''} exitosamente.`);
        
      } catch (error) {
        console.error('Error:', error);
        alert('Error al actualizar los restaurantes');
      }
    }

    // Gestión del modal para crear/editar restaurantes
    function initializeRestaurantModal() {
      const newRestaurantBtn = document.getElementById('new-restaurant-btn');
      const editButtons = document.querySelectorAll('.edit-btn');
      
      if (newRestaurantBtn) {
        newRestaurantBtn.addEventListener('click', () => {
          openRestaurantModal();
        });
      }      editButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          const target = e.target;
          if (!target || !(target instanceof Element)) return;
          
          const editBtn = target.closest('.edit-btn');
          const restaurantData = editBtn?.getAttribute('data-restaurant');
          if (restaurantData) {
            const restaurant = JSON.parse(restaurantData);
            openRestaurantModal(restaurant);
          }
        });
      });
    }    function openRestaurantModal(restaurant = null) {
      // Eliminar modal existente si hay uno
      const existingModal = document.getElementById('restaurant-modal');
      if (existingModal) {
        existingModal.remove();
      }
      
      // Crear elemento del modal dinámicamente
      const modalHTML = `
        <div id="restaurant-modal" class="fixed inset-0 z-50 overflow-y-auto">
          <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" onclick="closeRestaurantModal()"></div>
            <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-4xl sm:w-full">
              <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                <div class="flex justify-between items-center mb-6">
                  <h3 class="text-lg leading-6 font-medium text-gray-900">
                    ${restaurant ? 'Editar Restaurante' : 'Nuevo Restaurante'}
                  </h3>
                  <button type="button" class="bg-white rounded-md text-gray-400 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" onclick="closeRestaurantModal()">
                    <span class="sr-only">Cerrar</span>
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                </div>
                <div id="restaurant-form-container"></div>
              </div>
            </div>
          </div>
        </div>
      `;
      
      document.body.insertAdjacentHTML('beforeend', modalHTML);
      
      // Renderizar el formulario React
      renderRestaurantForm(restaurant);
    }    function closeRestaurantModal() {
      const modal = document.getElementById('restaurant-modal');
      if (modal) {
        modal.remove();
      }
    }

    // Hacer las funciones globalmente accesibles
    (window as any).closeRestaurantModal = closeRestaurantModal;
    (window as any).openRestaurantModal = openRestaurantModal;

    async function renderRestaurantForm(restaurant) {
      // Esta función se implementará cuando se integre React
      // Por ahora, mostramos un formulario HTML estático
      const container = document.getElementById('restaurant-form-container');
      if (!container) return;

      const formHTML = `
        <form id="restaurant-form" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700">Nombre *</label>
              <input type="text" name="name" id="name" required value="${restaurant?.name || ''}" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>
            <div>
              <label for="type" class="block text-sm font-medium text-gray-700">Tipo</label>
              <input type="text" name="type" id="type" value="${restaurant?.type || ''}" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>
          </div>
          
          <div>
            <label for="address" class="block text-sm font-medium text-gray-700">Dirección *</label>
            <input type="text" name="address" id="address" required value="${restaurant?.address || ''}" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
              <label for="rating" class="block text-sm font-medium text-gray-700">Calificación *</label>
              <input type="number" name="rating" id="rating" min="1" max="5" step="0.1" required value="${restaurant?.rating || 4.0}" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>
            <div>
              <label for="priceRange" class="block text-sm font-medium text-gray-700">Precio</label>
              <select name="priceRange" id="priceRange" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                <option value="$" ${restaurant?.priceRange === '$' ? 'selected' : ''}>$ - Económico</option>
                <option value="$$" ${restaurant?.priceRange === '$$' ? 'selected' : ''}>$$ - Moderado</option>
                <option value="$$$" ${restaurant?.priceRange === '$$$' ? 'selected' : ''}>$$$ - Caro</option>
                <option value="$$$$" ${restaurant?.priceRange === '$$$$' ? 'selected' : ''}>$$$$ - Muy Caro</option>
              </select>
            </div>
            <div>
              <label for="menu" class="block text-sm font-medium text-gray-700">Slug del Menú</label>
              <input type="text" name="menu" id="menu" value="${restaurant?.menu || ''}" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            </div>
          </div>

          <div>
            <label for="hours" class="block text-sm font-medium text-gray-700">Horario</label>
            <input type="text" name="hours" id="hours" value="${restaurant?.hours || ''}" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
          </div>

          <div>
            <label for="image" class="block text-sm font-medium text-gray-700">Imagen</label>
            ${restaurant?.image ? `<img src="${restaurant.image}" alt="Imagen actual" class="w-32 h-32 object-cover rounded-lg mb-2">` : ''}
            <input type="file" name="image" id="image" accept="image/*" class="mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
          </div>

          <div>
            <div class="flex items-center">
              <input id="featured" name="featured" type="checkbox" ${restaurant?.featured ? 'checked' : ''} class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded">
              <label for="featured" class="ml-2 block text-sm text-gray-900">Marcar como destacado</label>
            </div>
          </div>

          <div class="flex justify-end space-x-3">
            <button type="button" onclick="closeRestaurantModal()" class="inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
              Cancelar
            </button>
            <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
              ${restaurant ? 'Actualizar' : 'Crear'} Restaurante
            </button>
          </div>
        </form>
      `;

      container.innerHTML = formHTML;

      // Agregar event listener al formulario
      const form = document.getElementById('restaurant-form');
      if (form) {
        form.addEventListener('submit', (e) => handleRestaurantSubmit(e, restaurant));
      }
    }

    async function handleRestaurantSubmit(e, restaurant) {
      e.preventDefault();
      
      const form = e.target;
      const formData = new FormData(form);
      const imageFile = formData.get('image');
      
      try {
        let imageUrl = restaurant?.image;
          // Subir nueva imagen si se seleccionó una
        if (imageFile && imageFile instanceof File && imageFile.size > 0) {
          const uploadFormData = new FormData();
          uploadFormData.append('image', imageFile);
          
          const uploadResponse = await fetch('/api/upload', {
            method: 'POST',
            body: uploadFormData
          });
          
          if (!uploadResponse.ok) {
            const errorData = await uploadResponse.json();
            throw new Error(errorData.error || 'Error al subir la imagen');
          }
          
          const uploadResult = await uploadResponse.json();
          imageUrl = uploadResult.url;
        }
          // Preparar datos del restaurante
        const restaurantData = {
          name: formData.get('name')?.toString() || '',
          type: formData.get('type')?.toString() || '',
          address: formData.get('address')?.toString() || '',
          rating: parseFloat(formData.get('rating')?.toString() || '4.0'),
          priceRange: formData.get('priceRange')?.toString() || '$$',
          menu: formData.get('menu')?.toString() || '',
          hours: formData.get('hours')?.toString() || '',
          featured: formData.get('featured') === 'on',
          image: imageUrl
        };
        
        if (restaurant?.id) {
          // Actualizar restaurante existente con Supabase directamente
          const { createSupabaseClient } = await import('../../../lib/supabase.js');
          const supabase = createSupabaseClient();
          
          const { error } = await supabase
            .from('restaurants')
            .update(restaurantData)
            .eq('id', restaurant.id);
            
          if (error) throw error;
        } else {
          // Crear nuevo restaurante usando la API
          const response = await fetch('/api/restaurants', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              ...restaurantData,
              created_at: new Date().toISOString()
            })
          });
          
          if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.error || 'Error al crear el restaurante');
          }
        }
        
        closeRestaurantModal();
        window.location.reload(); // Recargar la página para mostrar cambios
        
      } catch (error) {
        console.error('Error:', error);
        alert(error.message || 'Error al procesar el restaurante');
      }
    }

    // Inicializar modal cuando se carga la página
    document.addEventListener('DOMContentLoaded', () => {
      initializeRestaurantModal();
    });
  </script>
</AdminLayout>