    let filteredRestaurants: RestaurantData[] = [];
    let selectedRestaurants = new Set<string>();    // Inicializar cuando el DOM esté listo
    document.addEventListener('DOMContentLoaded', () => {
      // Obtener datos de los restaurantes del DOM
