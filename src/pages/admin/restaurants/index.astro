  </div>  <script>
    // Types
    interface RestaurantData {
      id: string;
      element: HTMLTableRowElement;
      name: string;
      shortName: string;
      type: string;
      address: string;
      featured: boolean;
    }

    // Variables globales
    let allRestaurants: RestaurantData[] = [];
    let filteredRestaurants: RestaurantData[] = [];
    let selectedRestaurants = new Set<string>();

    // Inicializar cuando el DOM esté listo
    document.addEventListener('DOMContentLoaded', () => {
      // Obtener datos de los restaurantes del DOM
      initializeRestaurantsData();
      initializeFilters();
      initializeSearch();
      initializeBulkActions();
      initializeDeleteButtons();
      updateStats();
    });    function initializeRestaurantsData() {
      const rows = document.querySelectorAll('#restaurants-table tbody tr') as NodeListOf<HTMLTableRowElement>;
      allRestaurants = Array.from(rows).map(row => {
        const id = (row as HTMLElement).dataset.restaurantId || '';
        const cells = row.querySelectorAll('td');
        return {
          id,
          element: row,
          name: cells[3]?.textContent?.trim() || '',
          shortName: cells[2]?.textContent?.trim() || '',
          type: cells[4]?.textContent?.trim() || '',
          address: cells[5]?.textContent?.trim() || '',
          featured: cells[8]?.textContent?.includes('Destacado') || false
        } as RestaurantData;
      });
      filteredRestaurants = [...allRestaurants];
    }function initializeFilters() {
      // Poblar filtro de tipos
      const typeFilter = document.getElementById('type-filter') as HTMLSelectElement;
      if (!typeFilter) return;
      
      const types = [...new Set(allRestaurants.map(r => r.type))].filter(Boolean);
      types.forEach(type => {
        const option = document.createElement('option');
        option.value = type;
        option.textContent = type;
        typeFilter.appendChild(option);
      });

      // Event listeners para filtros
      typeFilter.addEventListener('change', applyFilters);
      
      const featuredFilter = document.getElementById('featured-filter') as HTMLSelectElement;
      if (featuredFilter) {
        featuredFilter.addEventListener('change', applyFilters);
      }
      
      const clearFiltersBtn = document.getElementById('clear-filters');
      if (clearFiltersBtn) {
        clearFiltersBtn.addEventListener('click', clearFilters);
      }
    }    function initializeSearch() {
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      if (!searchInput) return;
      
      let searchTimeout: NodeJS.Timeout;
      
      searchInput.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          applyFilters();
        }, 300);
      });
    }function initializeBulkActions() {
      const selectAllCheckbox = document.getElementById('select-all') as HTMLInputElement;
      const bulkActionsPanel = document.getElementById('bulk-actions');
      
      if (!selectAllCheckbox || !bulkActionsPanel) return;
      
      selectAllCheckbox.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (!target) return;
        
        const checkboxes = document.querySelectorAll('.restaurant-checkbox') as NodeListOf<HTMLInputElement>;
        checkboxes.forEach(checkbox => {
          const row = checkbox.closest('tr');
          if (row && row.style.display !== 'none') {
            checkbox.checked = target.checked;
            const dataId = checkbox.dataset.id;
            if (dataId) {
              if (target.checked) {
                selectedRestaurants.add(dataId);
              } else {
                selectedRestaurants.delete(dataId);
              }
            }
          }
        });
        updateBulkActions();
      });

      // Event listeners para checkboxes individuales
      document.addEventListener('change', (e) => {
        const target = e.target as HTMLElement;
        if (!target) return;
        
        if (target.classList.contains('restaurant-checkbox')) {
          const checkbox = target as HTMLInputElement;
          const dataId = checkbox.dataset.id;
          if (dataId) {
            if (checkbox.checked) {
              selectedRestaurants.add(dataId);
            } else {
              selectedRestaurants.delete(dataId);
            }
          }
          updateBulkActions();
        }
      });

      // Bulk actions
      const bulkDeleteBtn = document.getElementById('bulk-delete');
      const bulkFeatureBtn = document.getElementById('bulk-feature');
      const bulkUnfeatureBtn = document.getElementById('bulk-unfeature');
      
      if (bulkDeleteBtn) {
        bulkDeleteBtn.addEventListener('click', bulkDelete);
      }
      if (bulkFeatureBtn) {
        bulkFeatureBtn.addEventListener('click', () => bulkToggleFeature(true));
      }
      if (bulkUnfeatureBtn) {
        bulkUnfeatureBtn.addEventListener('click', () => bulkToggleFeature(false));
      }
    }    function initializeDeleteButtons() {
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target) return;
        
        if (target.classList.contains('delete-btn') || target.closest('.delete-btn')) {
          const button = target.classList.contains('delete-btn') ? target : target.closest('.delete-btn') as HTMLElement;
          if (!button) return;
          
          const id = button.getAttribute('data-id');
          if (!id) return;
          
          if (confirm('¿Estás seguro de que deseas eliminar este restaurante?')) {
            deleteRestaurant(id);
          }
        }
      });
    }    function applyFilters() {
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const typeFilterElement = document.getElementById('type-filter') as HTMLSelectElement;
      const featuredFilterElement = document.getElementById('featured-filter') as HTMLSelectElement;
      
      if (!searchInput || !typeFilterElement || !featuredFilterElement) return;
      
      const searchTerm = searchInput.value.toLowerCase();
      const typeFilter = typeFilterElement.value;
      const featuredFilter = featuredFilterElement.value;

      allRestaurants.forEach(restaurant => {
        let visible = true;

        // Filtro de búsqueda
        if (searchTerm) {
          const searchableText = `${restaurant.name} ${restaurant.shortName} ${restaurant.type} ${restaurant.address}`.toLowerCase();
          visible = visible && searchableText.includes(searchTerm);
        }

        // Filtro de tipo
        if (typeFilter) {
          visible = visible && restaurant.type === typeFilter;
        }

        // Filtro de destacado
        if (featuredFilter) {
          const isFeatured = featuredFilter === 'true';
          visible = visible && restaurant.featured === isFeatured;
        }

        restaurant.element.style.display = visible ? '' : 'none';
      });

      updateStats();
      updateSelectAllState();
    }    function clearFilters() {
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const typeFilter = document.getElementById('type-filter') as HTMLSelectElement;
      const featuredFilter = document.getElementById('featured-filter') as HTMLSelectElement;
      
      if (searchInput) searchInput.value = '';
      if (typeFilter) typeFilter.value = '';
      if (featuredFilter) featuredFilter.value = '';
      
      applyFilters();
    }    function updateStats() {
      const visibleRestaurants = allRestaurants.filter(r => r.element.style.display !== 'none');
      
      const totalCountElement = document.getElementById('total-count');
      if (totalCountElement) {
        totalCountElement.textContent = visibleRestaurants.length.toString();
      }
      
      const featuredCount = visibleRestaurants.filter(r => r.featured).length;
      const featuredCountElement = document.getElementById('featured-count');
      if (featuredCountElement) {
        featuredCountElement.textContent = featuredCount.toString();
      }
    }    function updateBulkActions() {
      const bulkActionsPanel = document.getElementById('bulk-actions');
      const selectionCount = document.getElementById('selection-count');
      const selectedCount = document.getElementById('selected-count');
      
      if (!bulkActionsPanel || !selectionCount || !selectedCount) return;
      
      if (selectedRestaurants.size > 0) {
        bulkActionsPanel.classList.remove('hidden');
        selectionCount.textContent = `${selectedRestaurants.size} elemento${selectedRestaurants.size !== 1 ? 's' : ''} seleccionado${selectedRestaurants.size !== 1 ? 's' : ''}`;
        selectedCount.textContent = selectedRestaurants.size.toString();
      } else {
        bulkActionsPanel.classList.add('hidden');
        selectedCount.textContent = '0';
      }
      
      updateSelectAllState();
    }    function updateSelectAllState() {
      const selectAllCheckbox = document.getElementById('select-all') as HTMLInputElement;
      if (!selectAllCheckbox) return;
      
      const visibleCheckboxes = Array.from(document.querySelectorAll('.restaurant-checkbox') as NodeListOf<HTMLInputElement>).filter(
        cb => {
          const row = cb.closest('tr');
          return row && row.style.display !== 'none';
        }
      );
      
      if (visibleCheckboxes.length === 0) {
        selectAllCheckbox.indeterminate = false;
        selectAllCheckbox.checked = false;
        return;
      }
      
      const checkedVisible = visibleCheckboxes.filter(cb => cb.checked);
      
      if (checkedVisible.length === 0) {
        selectAllCheckbox.indeterminate = false;
        selectAllCheckbox.checked = false;
      } else if (checkedVisible.length === visibleCheckboxes.length) {
        selectAllCheckbox.indeterminate = false;
        selectAllCheckbox.checked = true;
      } else {
        selectAllCheckbox.indeterminate = true;
        selectAllCheckbox.checked = false;
      }
    }

    async function deleteRestaurant(id) {
      try {
        const response = await fetch(`/api/restaurants/${id}`, {
          method: 'DELETE',
        });
        
        if (response.ok) {
          window.location.reload();
        } else {
          const data = await response.json();
          alert(data.error || 'Error al eliminar el restaurante');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error al eliminar el restaurante');
      }
    }

    async function bulkDelete() {
      if (selectedRestaurants.size === 0) return;
      
      const count = selectedRestaurants.size;
      if (!confirm(`¿Estás seguro de que deseas eliminar ${count} restaurante${count !== 1 ? 's' : ''}?`)) {
        return;
      }

      try {
        const promises = Array.from(selectedRestaurants).map(id => 
          fetch(`/api/restaurants/${id}`, { method: 'DELETE' })
        );
        
        const results = await Promise.all(promises);
        const failed = results.filter(r => !r.ok);
        
        if (failed.length === 0) {
          window.location.reload();
        } else {
          alert(`Se eliminaron ${results.length - failed.length} restaurantes. ${failed.length} fallaron.`);
          window.location.reload();
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error al eliminar los restaurantes');
      }
    }

    async function bulkToggleFeature(featured) {
      if (selectedRestaurants.size === 0) return;
      
      const count = selectedRestaurants.size;
      const action = featured ? 'destacar' : 'quitar como destacados';
      
      if (!confirm(`¿Estás seguro de que deseas ${action} ${count} restaurante${count !== 1 ? 's' : ''}?`)) {
        return;
      }

      try {
        const promises = Array.from(selectedRestaurants).map(id => 
          fetch(`/api/restaurants/${id}`, { 
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ featured })
          })
        );
        
        const results = await Promise.all(promises);
        const failed = results.filter(r => !r.ok);
        
        if (failed.length === 0) {
          window.location.reload();
        } else {
          alert(`Se actualizaron ${results.length - failed.length} restaurantes. ${failed.length} fallaron.`);
          window.location.reload();
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error al actualizar los restaurantes');
      }
    }
  </script>
</AdminLayout>