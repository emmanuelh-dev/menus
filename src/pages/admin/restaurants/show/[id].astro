---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { isAuthenticated } from '../../../../middleware/auth';
import { createAuthenticatedClient, createSupabaseClient } from '../../../../lib/supabase';

const isAuth = await isAuthenticated(Astro.request, Astro.cookies);

if (!isAuth) {
  return Astro.redirect("/admin/login");
}

const accessTokenCookie = Astro.cookies.get("sb-access-token");
const refreshTokenCookie = Astro.cookies.get("sb-refresh-token");

if (!accessTokenCookie || !refreshTokenCookie) {
  return Astro.redirect("/admin/login");
}

const supabase = await createAuthenticatedClient(
  accessTokenCookie.value,
  refreshTokenCookie.value
);

const { id } = Astro.params;

// Obtener información del restaurante
const { data: restaurant, error: restaurantError } = await supabase
  .from("restaurants")
  .select("*")
  .eq("id", id)
  .single();

if (restaurantError || !restaurant) {
  return Astro.redirect("/admin/restaurants");
}

// Obtener menús del restaurante
const { data: menus } = await supabase
  .from("menus")
  .select(`
    *,
    menu_categories (
      id,
      name,
      is_active,
      menu_items (
        id,
        name,
        is_active
      )
    )
  `)
  .eq("restaurant_id", id)
  .order("created_at", { ascending: false });

// Obtener comentarios/reviews del restaurante
const { data: reviews } = await supabase
  .from("review")
  .select("*")
  .eq("restaurant_id", id)
  .order("created_at", { ascending: false });

// Calcular estadísticas de reviews
const totalReviews = reviews?.length || 0;
const averageRating = totalReviews > 0 && reviews
  ? (reviews.reduce((sum, review) => sum + review.rate, 0) / totalReviews).toFixed(1)
  : "0";

// Calcular estadísticas de menús
const totalMenus = menus?.length || 0;
const activeMenus = menus?.filter(menu => menu.is_active).length || 0;
const totalCategories = menus?.reduce((sum, menu) => sum + (menu.menu_categories?.length || 0), 0) || 0;
const totalItems = menus?.reduce((sum, menu) => 
  sum + (menu.menu_categories?.reduce((catSum, category) => 
    catSum + (category.menu_items?.length || 0), 0) || 0), 0) || 0;
---

<AdminLayout title={`${restaurant.name} - Detalles del Restaurante`}>
  <!-- Header con información del restaurante -->
  <div class="mb-8">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center">
        <a 
          href="/admin/restaurants" 
          class="mr-4 text-black -600 hover:text-black -800 flex items-center"
        >
          <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Volver a Restaurantes
        </a>
        <div>
          <h1 class="text-3xl font-bold text-gray-900">{restaurant.name}</h1>
          <p class="text-gray-600">{restaurant.address}</p>
        </div>
      </div>
      <div class="flex space-x-3">
        <a
          href={`/admin/restaurants/edit/${restaurant.id}`}
          class="bg-black -600 hover:bg-black -700 text-white px-4 py-2 rounded-md text-sm font-medium flex items-center"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Editar Restaurante
        </a>
        {restaurant.menu && (
          <a
            href={`/menus/${restaurant.menu}`}
            target="_blank"
            class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md text-sm font-medium flex items-center"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
            Ver Menú Público
          </a>
        )}
      </div>
    </div>

    <!-- Información general del restaurante -->
    <div class="bg-white rounded-lg shadow-sm border p-6 mb-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {restaurant.image && (
          <div class="lg:col-span-1">
            <img 
              src={restaurant.image} 
              alt={restaurant.name}
              class="w-full h-48 object-cover rounded-lg"
            />
          </div>
        )}
        <div class={restaurant.image ? "lg:col-span-3" : "lg:col-span-4"}>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div>
              <h3 class="text-sm font-medium text-gray-500 uppercase">Tipo</h3>
              <p class="text-lg font-semibold text-gray-900">{restaurant.type || 'No especificado'}</p>
            </div>
            <div>
              <h3 class="text-sm font-medium text-gray-500 uppercase">Calificación</h3>
              <div class="flex items-center">
                <span class="text-lg font-semibold text-gray-900">{restaurant.rating || 'N/A'}</span>
                {restaurant.rating && (
                  <div class="ml-2 flex items-center">
                    <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                    </svg>
                  </div>
                )}
              </div>
            </div>
            <div>
              <h3 class="text-sm font-medium text-gray-500 uppercase">Rango de Precio</h3>
              <p class="text-lg font-semibold text-gray-900">{restaurant.priceRange || 'No especificado'}</p>
            </div>
            <div>
              <h3 class="text-sm font-medium text-gray-500 uppercase">Horarios</h3>
              <p class="text-sm text-gray-900">{restaurant.hours || 'No especificado'}</p>
            </div>
            <div>
              <h3 class="text-sm font-medium text-gray-500 uppercase">Estado</h3>
              <span class={`px-2 py-1 text-xs font-medium rounded-full ${
                restaurant.featured 
                  ? 'bg-yellow-100 text-yellow-800' 
                  : 'bg-gray-100 text-gray-800'
              }`}>
                {restaurant.featured ? 'Destacado' : 'Normal'}
              </span>
            </div>
            <div>
              <h3 class="text-sm font-medium text-gray-500 uppercase">URL del Menú</h3>
              <p class="text-sm text-gray-900 truncate">{restaurant.menu || 'No configurado'}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Estadísticas rápidas -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow-sm border p-6">
      <div class="flex items-center">
        <div class="p-2 bg-blue-100 rounded-lg mr-3">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-500">Menús Totales</p>
          <p class="text-2xl font-bold text-gray-900">{totalMenus}</p>
          <p class="text-xs text-gray-600">{activeMenus} activos</p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border p-6">
      <div class="flex items-center">
        <div class="p-2 bg-green-100 rounded-lg mr-3">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14-7H5a2 2 0 00-2 2v12a2 2 0 002 2h14a2 2 0 002-2V6a2 2 0 00-2-2z"></path>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-500">Categorías</p>
          <p class="text-2xl font-bold text-gray-900">{totalCategories}</p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border p-6">
      <div class="flex items-center">
        <div class="p-2 bg-purple-100 rounded-lg mr-3">
          <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4"></path>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-500">Platillos</p>
          <p class="text-2xl font-bold text-gray-900">{totalItems}</p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border p-6">
      <div class="flex items-center">
        <div class="p-2 bg-yellow-100 rounded-lg mr-3">
          <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-500">Reseñas</p>
          <p class="text-2xl font-bold text-gray-900">{totalReviews}</p>
          {totalReviews > 0 && (
            <p class="text-xs text-gray-600">Promedio: {averageRating}/5</p>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Contenido principal en pestañas -->
  <div class="bg-white rounded-lg shadow-sm border">
    <!-- Pestañas -->
    <div class="border-b border-gray-200">
      <nav class="-mb-px flex space-x-8 px-6">
        <button
          id="tab-menus"
          class="tab-button active border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"
          onclick="switchTab('menus')"
        >
          <svg class="w-5 h-5 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Menús ({totalMenus})
        </button>
        <button
          id="tab-reviews"
          class="tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"
          onclick="switchTab('reviews')"
        >
          <svg class="w-5 h-5 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
          </svg>
          Reseñas ({totalReviews})
        </button>
      </nav>
    </div>

    <!-- Contenido de las pestañas -->
    <div class="p-6">
      <!-- Pestaña de Menús -->


      <!-- Pestaña de Reseñas -->

        <div id="content-menus" class="tab-content ">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-xl font-semibold">Menús del Restaurante</h2>
          <a
            href="/admin/menus/create"
            class="bg-black -600 hover:bg-black -700 text-white px-4 py-2 rounded-md text-sm font-medium flex items-center"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Crear Nuevo Menú
          </a>
        </div>

        {menus && menus.length > 0 ? (
          <div class="space-y-4">
            {menus.map((menu) => (
              <div class="border border-gray-200 rounded-lg p-4 hover:border-gray-300 transition-colors">
                <div class="flex justify-between items-start">
                  <div class="flex-1">
                    <div class="flex items-center space-x-3 mb-2">
                      <h3 class="text-lg font-medium text-gray-900">{menu.name}</h3>
                      <span class={`px-2 py-1 text-xs font-medium rounded-full ${
                        menu.is_active 
                          ? 'bg-green-100 text-green-800' 
                          : 'bg-red-100 text-red-800'
                      }`}>
                        {menu.is_active ? 'Activo' : 'Inactivo'}
                      </span>
                      <span class="px-2 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800">
                        {menu.menu_type || 'principal'}
                      </span>
                    </div>
                    {menu.description && (
                      <p class="text-gray-600 mb-3">{menu.description}</p>
                    )}
                    <div class="flex items-center space-x-4 text-sm text-gray-500">
                      <span>{menu.menu_categories?.length || 0} categorías</span>
                      <span>
                        {menu.menu_categories?.reduce((sum, cat) => sum + (cat.menu_items?.length || 0), 0) || 0} platillos
                      </span>
                      <span>Creado: {new Date(menu.created_at).toLocaleDateString()}</span>
                    </div>
                  </div>
                  <div class="flex space-x-2">
                    <a
                      href={`/admin/menus/${menu.id}/categories`}
                      class="text-black -600 hover:text-black -800 text-sm font-medium"
                    >
                      Gestionar
                    </a>
                    <a
                      href={`/admin/menus/${menu.id}/edit`}
                      class="text-blue-600 hover:text-blue-800 text-sm font-medium"
                    >
                      Editar
                    </a>
                  </div>
                </div>

                <!-- Categorías del menú -->
                {menu.menu_categories && menu.menu_categories.length > 0 && (
                  <div class="mt-4 pt-4 border-t border-gray-100">
                    <h4 class="text-sm font-medium text-gray-900 mb-2">Categorías:</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2">
                      {menu.menu_categories.map((category) => (
                        <div class="flex justify-between items-center p-2 bg-gray-50 rounded">
                          <span class="text-sm text-gray-700">{category.name}</span>
                          <div class="flex items-center space-x-2">
                            <span class="text-xs text-gray-500">
                              {category.menu_items?.length || 0} items
                            </span>
                            <span class={`w-2 h-2 rounded-full ${
                              category.is_active ? 'bg-green-400' : 'bg-red-400'
                            }`}></span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No hay menús creados</h3>
            <p class="text-gray-600 mb-4">Crea el primer menú para este restaurante</p>
            <a
              href="/admin/menus/create"
              class="bg-black -600 hover:bg-black -700 text-white px-4 py-2 rounded-md text-sm font-medium"
            >
              Crear Primer Menú
            </a>
          </div>
        )}
      </div>
            <div id="content-reviews" class="tab-content ">
        <div class="mb-6">
          <h2 class="text-xl font-semibold mb-4">Reseñas de Clientes</h2>
          
          {totalReviews > 0 && (
            <div class="bg-gray-50 rounded-lg p-4 mb-6">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="text-center">
                  <div class="text-3xl font-bold text-gray-900">{averageRating}</div>
                  <div class="text-sm text-gray-600">Calificación Promedio</div>                  <div class="flex justify-center mt-1">
                    {Array.from({length: 5}, (_, i) => (
                      <svg 
                        class={`w-4 h-4 ${i < Math.floor(parseFloat(averageRating)) ? 'text-yellow-400' : 'text-gray-300'}`} 
                        fill="currentColor" 
                        viewBox="0 0 24 24"
                      >
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                      </svg>
                    ))}
                  </div>
                </div>
                <div class="text-center">
                  <div class="text-3xl font-bold text-gray-900">{totalReviews}</div>
                  <div class="text-sm text-gray-600">Total de Reseñas</div>
                </div>                <div class="text-center">
                  <div class="text-lg font-semibold text-gray-900">
                    {reviews ? reviews.filter(r => r.rate >= 4).length : 0}
                  </div>
                  <div class="text-sm text-gray-600">Reseñas Positivas (4+ estrellas)</div>
                </div>
              </div>
            </div>
          )}
        </div>

        {reviews && reviews.length > 0 ? (
          <div class="space-y-4">
            {reviews.map((review) => (
              <div class="border border-gray-200 rounded-lg p-4">
                <div class="flex justify-between items-start mb-3">
                  <div class="flex items-center space-x-3">
                    <div class="flex items-center">
                      {Array.from({length: 5}, (_, i) => (
                        <svg 
                          class={`w-4 h-4 ${i < review.rate ? 'text-yellow-400' : 'text-gray-300'}`} 
                          fill="currentColor" 
                          viewBox="0 0 24 24"
                        >
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                        </svg>
                      ))}
                    </div>
                    <span class="text-sm font-medium text-gray-900">{review.rate}/5 estrellas</span>
                  </div>
                  <span class="text-sm text-gray-500">
                    {new Date(review.created_at).toLocaleDateString('es-ES', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                      hour: '2-digit',
                      minute: '2-digit'
                    })}
                  </span>
                </div>
                <p class="text-gray-700">{review.comment}</p>
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
            </svg>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No hay reseñas</h3>
            <p class="text-gray-600">Este restaurante aún no tiene reseñas de clientes</p>
          </div>
        )}
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .tab-button.active {
    border-color: #4f46e5 !important;
    color: #4f46e5 !important;
  }
</style>
