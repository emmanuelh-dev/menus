---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createSupabaseClient } from "../../../lib/supabase";
import { isAuthenticated } from "../../../middleware/auth";

const isAuth = await isAuthenticated(Astro.request, Astro.cookies);

if (!isAuth) {
  return Astro.redirect("/admin/login");
}

const accessTokenCookie = Astro.cookies.get("sb-access-token");
const refreshTokenCookie = Astro.cookies.get("sb-refresh-token");

if (!accessTokenCookie || !refreshTokenCookie) {
  return Astro.redirect("/admin/login");
}

const supabase = createSupabaseClient(
  accessTokenCookie.value,
  refreshTokenCookie.value
);

// Obtener menús con información del restaurante
const { data: menus, error } = await supabase
  .from("menus")
  .select(`
    *,
    restaurants (
      id,
      name
    )
  `)
  .order("created_at", { ascending: false });

// Obtener restaurantes para el selector
const { data: restaurants } = await supabase
  .from("restaurants")
  .select("id, name")
  .order("name");

if (error) {
  console.error("Error fetching menus:", error);
}
---

<AdminLayout title="Gestión de Menús">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Gestión de Menús</h1>
    <a
      href="/admin/menus/create"
      class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium"
    >
      Crear Nuevo Menú
    </a>
  </div>

  <!-- Filtros -->
  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label for="restaurant-filter" class="block text-sm font-medium text-gray-700 mb-2">
          Filtrar por Restaurante
        </label>
        <select
          id="restaurant-filter"
          class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500"
        >
          <option value="">Todos los restaurantes</option>
          {restaurants?.map((restaurant) => (
            <option value={restaurant.id}>{restaurant.name}</option>
          ))}
        </select>
      </div>
      <div>
        <label for="status-filter" class="block text-sm font-medium text-gray-700 mb-2">
          Estado
        </label>
        <select
          id="status-filter"
          class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500"
        >
          <option value="">Todos</option>
          <option value="active">Activo</option>
          <option value="inactive">Inactivo</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Lista de menús -->
  <div class="bg-white shadow rounded-lg overflow-hidden">
    {menus && menus.length > 0 ? (
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Menú
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Restaurante
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Tipo
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Estado
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Fecha de creación
              </th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                Acciones
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            {menus.map((menu) => (
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div>
                    <div class="text-sm font-medium text-gray-900">
                      {menu.name}
                    </div>
                    {menu.description && (
                      <div class="text-sm text-gray-500">
                        {menu.description.substring(0, 100)}...
                      </div>
                    )}
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {menu.restaurants?.name || 'Restaurante no encontrado'}
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="px-2 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800">
                    {menu.menu_type || 'principal'}
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class={`px-2 py-1 text-xs font-medium rounded-full ${
                    menu.is_active 
                      ? 'bg-green-100 text-green-800' 
                      : 'bg-red-100 text-red-800'
                  }`}>
                    {menu.is_active ? 'Activo' : 'Inactivo'}
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  {new Date(menu.created_at).toLocaleDateString()}
                </td>                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex justify-end space-x-3">
                    <a
                      href={`/admin/menus/${menu.id}/categories`}
                      class="inline-flex items-center px-2 py-1 text-xs font-medium text-indigo-600 bg-indigo-100 rounded hover:bg-indigo-200 transition-colors"
                      title="Gestionar categorías"
                    >
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14-7H5a2 2 0 00-2 2v12a2 2 0 002 2h14a2 2 0 002-2V6a2 2 0 00-2-2z"></path>
                      </svg>
                      Categorías
                    </a>
                    <a
                      href={`/admin/menus/${menu.id}/edit`}
                      class="inline-flex items-center px-2 py-1 text-xs font-medium text-blue-600 bg-blue-100 rounded hover:bg-blue-200 transition-colors"
                      title="Editar menú"
                    >
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                      Editar
                    </a>
                    <a
                      href={`/admin/menus/${menu.id}/delete`}
                      class="inline-flex items-center px-2 py-1 text-xs font-medium text-red-600 bg-red-100 rounded hover:bg-red-200 transition-colors"
                      title="Eliminar menú"
                      onclick="return confirm('¿Estás seguro de que quieres eliminar este menú? Esta acción no se puede deshacer.')"
                    >
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                      Eliminar
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-gray-500 text-lg mb-4">No hay menús creados</p>
        <a
          href="/admin/menus/create"
          class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium"
        >
          Crear Primer Menú
        </a>
      </div>
    )}
  </div>
</AdminLayout>

<script>
  // Filtros en tiempo real
  document.getElementById('restaurant-filter')?.addEventListener('change', filterMenus);
  document.getElementById('status-filter')?.addEventListener('change', filterMenus);

  function filterMenus() {
    const restaurantFilter = (document.getElementById('restaurant-filter') as HTMLSelectElement)?.value || '';
    const statusFilter = (document.getElementById('status-filter') as HTMLSelectElement)?.value || '';
    const rows = document.querySelectorAll('tbody tr') as NodeListOf<HTMLTableRowElement>;

    rows.forEach(row => {
      const restaurantCell = row.cells[1]?.textContent || '';
      const statusCell = row.cells[3]?.textContent?.toLowerCase() || '';
      
      let showRow = true;

      if (restaurantFilter && !restaurantCell.includes(restaurantFilter)) {
        showRow = false;
      }

      if (statusFilter === 'active' && !statusCell.includes('activo')) {
        showRow = false;
      } else if (statusFilter === 'inactive' && !statusCell.includes('inactivo')) {
        showRow = false;
      }

      row.style.display = showRow ? '' : 'none';
    });
  }
</script>
