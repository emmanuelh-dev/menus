---
import AdminLayout from "../../../../../../layouts/AdminLayout.astro";
import { isAuthenticated } from "../../../../../../middleware/auth";
import { createSupabaseClient } from "../../../../../../lib/supabase";

const isAuth = await isAuthenticated(Astro.request, Astro.cookies);

if (!isAuth) {
  return Astro.redirect("/admin/login");
}

const accessTokenCookie = Astro.cookies.get("sb-access-token");
const refreshTokenCookie = Astro.cookies.get("sb-refresh-token");

if (!accessTokenCookie || !refreshTokenCookie) {
  return Astro.redirect("/admin/login");
}

const supabase = createSupabaseClient(
  accessTokenCookie.value,
  refreshTokenCookie.value
);

const menuId = Astro.params.id;
const categoryId = Astro.params.categoryId;
let error: string | null = null;
let success = false;

// Verificar si viene un mensaje de éxito
const url = new URL(Astro.request.url);
const successParam = url.searchParams.get('success');
if (successParam === 'item_created') {
  success = true;
} else if (successParam === 'item_updated') {
  success = true;
} else if (successParam === 'item_deleted') {
  success = true;
}

// Obtener información del menú y categoría
const { data: menu } = await supabase
  .from("menus")
  .select(`
    *,
    restaurants (
      id,
      name
    )
  `)
  .eq("id", menuId)
  .single();

const { data: category } = await supabase
  .from("menu_categories")
  .select("*")
  .eq("id", categoryId)
  .single();

if (!menu || !category) {
  return Astro.redirect("/admin/menus");
}

// Obtener platillos de esta categoría
const { data: menuItems } = await supabase
  .from("menu_items")
  .select("*")
  .eq("category_id", categoryId)
  .order("display_order");

// Procesar formulario para crear nuevo platillo
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    
    // Procesar ingredientes y alérgenos como arrays
    const ingredientsText = formData.get("ingredients") as string;
    const allergensText = formData.get("allergens") as string;
    
    const ingredients = ingredientsText ? ingredientsText.split(',').map(i => i.trim()).filter(i => i) : [];
    const allergens = allergensText ? allergensText.split(',').map(a => a.trim()).filter(a => a) : [];

    const itemData = {
      category_id: parseInt(categoryId as any),
      restaurant_id: menu.restaurant_id,
      name: formData.get("name") as string,
      description: formData.get("description") as string,
      base_price: parseFloat(formData.get("base_price") as string),
      image: formData.get("image") as string || null,
      ingredients: ingredients.length > 0 ? ingredients : null,
      allergens: allergens.length > 0 ? allergens : null,
      calories: formData.get("calories") ? parseInt(formData.get("calories") as string) : null,
      preparation_time: formData.get("preparation_time") ? parseInt(formData.get("preparation_time") as string) : null,
      display_order: parseInt(formData.get("display_order") as string) || 0,
      is_active: formData.get("is_active") === "on",
      is_featured: formData.get("is_featured") === "on",
      is_vegetarian: formData.get("is_vegetarian") === "on",
      is_vegan: formData.get("is_vegan") === "on",
      is_gluten_free: formData.get("is_gluten_free") === "on",
      is_spicy: formData.get("is_spicy") === "on",
      spicy_level: formData.get("spicy_level") ? parseInt(formData.get("spicy_level") as string) : 0,
      stock_quantity: formData.get("stock_quantity") ? parseInt(formData.get("stock_quantity") as string) : null,
    };    const { error: insertError } = await supabase
      .from("menu_items")
      .insert([itemData]);

    if (insertError) {
      error = insertError.message;
    } else {
      // Redirección del servidor después de crear el item exitosamente
      return Astro.redirect(`/admin/menus/${menuId}/categories/${categoryId}/items?success=item_created`);
    }
  } catch (e) {
    error = "Error al procesar el formulario";
  }
}
---

<AdminLayout title={`Platillos - ${category.name}`}>
  <div class="max-w-7xl mx-auto">
    <div class="flex items-center mb-6">
      <a href={`/admin/menus/${menuId}/categories`} class="text-indigo-600 hover:text-indigo-800 mr-4">
        ← Volver a Categorías
      </a>
      <div>
        <h1 class="text-2xl font-bold">Platillos de {category.name}</h1>
        <p class="text-gray-600">{menu.name} - {menu.restaurants?.name}</p>
      </div>
    </div>    {success && (
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
        {successParam === 'item_created' && '¡Platillo creado exitosamente!'}
        {successParam === 'item_updated' && '¡Platillo actualizado exitosamente!'}
        {successParam === 'item_deleted' && '¡Platillo eliminado exitosamente!'}
      </div>
    )}

    {error && (
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
        Error: {error}
      </div>
    )}

    <div class="grid grid-cols-1 xl:grid-cols-4 gap-6">
      <!-- Formulario para crear nuevo platillo -->
      <div class="xl:col-span-1">
        <div class="bg-white shadow rounded-lg p-6 sticky top-6">

          <form method="POST" class="space-y-4">
                      <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-medium text-gray-900 mb-4">Nuevo Platillo</h2>
            <div>
              <button
                type="submit"
                class="w-full bg-indigo-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-indigo-700"
              >
                +
              </button>
            </div>
          </div>
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                Nombre *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Nombre del platillo"
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
              />
            </div>

            <div>
              <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
                Descripción
              </label>
              <textarea
                id="description"
                name="description"
                rows="3"
                placeholder="Descripción del platillo..."
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
              ></textarea>
            </div>

            <div>
              <label for="base_price" class="block text-sm font-medium text-gray-700 mb-2">
                Precio Base *
              </label>
              <input
                type="number"
                id="base_price"
                name="base_price"
                step="0.01"
                min="0"
                required
                placeholder="0.00"
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
              />
            </div>

            <div>
              <label for="image" class="block text-sm font-medium text-gray-700 mb-2">
                URL de Imagen
              </label>
              <input
                type="url"
                id="image"
                name="image"
                placeholder="https://ejemplo.com/platillo.jpg"
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
              />
            </div>

            <div>
              <label for="ingredients" class="block text-sm font-medium text-gray-700 mb-2">
                Ingredientes
              </label>
              <textarea
                id="ingredients"
                name="ingredients"
                rows="2"
                placeholder="Ingrediente 1, Ingrediente 2, ..."
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
              ></textarea>
              <p class="text-xs text-gray-500 mt-1">Separar con comas</p>
            </div>

            <div>
              <label for="allergens" class="block text-sm font-medium text-gray-700 mb-2">
                Alérgenos
              </label>
              <input
                type="text"
                id="allergens"
                name="allergens"
                placeholder="Gluten, Lácteos, Frutos secos..."
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
              />
              <p class="text-xs text-gray-500 mt-1">Separar con comas</p>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label for="calories" class="block text-sm font-medium text-gray-700 mb-2">
                  Calorías
                </label>
                <input
                  type="number"
                  id="calories"
                  name="calories"
                  min="0"
                  class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
                />
              </div>

              <div>
                <label for="preparation_time" class="block text-sm font-medium text-gray-700 mb-2">
                  Tiempo (min)
                </label>
                <input
                  type="number"
                  id="preparation_time"
                  name="preparation_time"
                  min="0"
                  class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
                />
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label for="display_order" class="block text-sm font-medium text-gray-700 mb-2">
                  Orden
                </label>
                <input
                  type="number"
                  id="display_order"
                  name="display_order"
                  min="0"
                  value="0"
                  class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
                />
              </div>

              <div>
                <label for="stock_quantity" class="block text-sm font-medium text-gray-700 mb-2">
                  Stock
                </label>
                <input
                  type="number"
                  id="stock_quantity"
                  name="stock_quantity"
                  min="0"
                  class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
                />
              </div>
            </div>

            <!-- Checkboxes para características -->
            <div class="space-y-2">
              <label class="flex items-center">
                <input type="checkbox" name="is_active" checked class="rounded border-gray-300 focus:ring-indigo-500 mr-2" />
                <span class="text-sm">Activo</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" name="is_featured" class="rounded border-gray-300 focus:ring-indigo-500 mr-2" />
                <span class="text-sm">Destacado</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" name="is_vegetarian" class="rounded border-gray-300 focus:ring-indigo-500 mr-2" />
                <span class="text-sm">Vegetariano</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" name="is_vegan" class="rounded border-gray-300 focus:ring-indigo-500 mr-2" />
                <span class="text-sm">Vegano</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" name="is_gluten_free" class="rounded border-gray-300 focus:ring-indigo-500 mr-2" />
                <span class="text-sm">Sin gluten</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" name="is_spicy" class="rounded border-gray-300 focus:ring-indigo-500 mr-2" />
                <span class="text-sm">Picante</span>
              </label>
            </div>

            <div>
              <label for="spicy_level" class="block text-sm font-medium text-gray-700 mb-2">
                Nivel de Picante (0-5)
              </label>
              <input
                type="range"
                id="spicy_level"
                name="spicy_level"
                min="0"
                max="5"
                value="0"
                class="w-full"
                oninput="document.getElementById('spicy-value').textContent = this.value"
              />
              <div class="text-center text-sm text-gray-600">
                Nivel: <span id="spicy-value">0</span>
              </div>
            </div>

            <button
              type="submit"
              class="w-full bg-indigo-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-indigo-700"
            >
              Crear Platillo
            </button>
          </form>
        </div>
      </div>

      <!-- Lista de platillos existentes -->
      <div class="xl:col-span-3">
        <div class="bg-white shadow rounded-lg overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Platillos Existentes</h2>
          </div>

          {menuItems && menuItems.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-6">
              {menuItems.map((item) => (
                <div class="border border-gray-200 rounded-lg overflow-hidden hover:shadow-md transition-shadow">
                  {item.image && (
                    <img
                      src={item.image}
                      alt={item.name}
                      class="w-full h-48 object-cover"
                    />
                  )}
                  
                  <div class="p-4">
                    <div class="flex justify-between items-start mb-2">
                      <h3 class="text-lg font-medium text-gray-900">{item.name}</h3>
                      <span class="text-lg font-bold text-green-600">${item.base_price}</span>
                    </div>
                    
                    {item.description && (
                      <p class="text-sm text-gray-600 mb-3 line-clamp-2">
                        {item.description}
                      </p>
                    )}

                    <!-- Características del platillo -->
                    <div class="flex flex-wrap gap-1 mb-3">
                      {item.is_featured && (
                        <span class="px-2 py-1 text-xs bg-yellow-100 text-yellow-800 rounded-full">
                          Destacado
                        </span>
                      )}
                      {item.is_vegetarian && (
                        <span class="px-2 py-1 text-xs bg-green-100 text-green-800 rounded-full">
                          Vegetariano
                        </span>
                      )}
                      {item.is_vegan && (
                        <span class="px-2 py-1 text-xs bg-green-100 text-green-800 rounded-full">
                          Vegano
                        </span>
                      )}
                      {item.is_gluten_free && (
                        <span class="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded-full">
                          Sin gluten
                        </span>
                      )}
                      {item.is_spicy && (
                        <span class="px-2 py-1 text-xs bg-red-100 text-red-800 rounded-full">
                          Picante {item.spicy_level > 0 ? `(${item.spicy_level})` : ''}
                        </span>
                      )}
                    </div>

                    <!-- Información adicional -->
                    <div class="text-xs text-gray-500 space-y-1 mb-3">
                      {item.calories && (
                        <div>Calorías: {item.calories}</div>
                      )}
                      {item.preparation_time && (
                        <div>Tiempo de preparación: {item.preparation_time} min</div>
                      )}
                      {item.stock_quantity && (
                        <div>Stock: {item.stock_quantity}</div>
                      )}
                    </div>

                    <!-- Estado y acciones -->
                    <div class="flex justify-between items-center">
                      <span class={`px-2 py-1 text-xs font-medium rounded-full ${
                        item.is_active 
                          ? 'bg-green-100 text-green-800' 
                          : 'bg-red-100 text-red-800'
                      }`}>
                        {item.is_active ? 'Activo' : 'Inactivo'}
                      </span>
                      
                      <div class="flex space-x-2">
                        <a
                          href={`/admin/menu-items/${item.id}/options`}
                          class="text-blue-600 hover:text-blue-900 text-xs"
                        >
                          Opciones
                        </a>
                        <a
                          href={`/admin/menu-items/edit/${item.id}`}
                          class="text-indigo-600 hover:text-indigo-900 text-xs"
                        >
                          Editar
                        </a>
                        <button
                          class="text-red-600 hover:text-red-900 text-xs"
                          onclick={`deleteItem(${item.id})`}
                        >
                          Eliminar
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="text-center py-12">
              <p class="text-gray-500 text-lg mb-4">No hay platillos en esta categoría</p>
              <p class="text-gray-400 text-sm">Usa el formulario de la izquierda para crear el primer platillo</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  function deleteItem(itemId) {
    if (confirm('¿Estás seguro de que quieres eliminar este platillo?')) {
      window.location.href = `/admin/menu-items/delete/${itemId}`;
    }
  }
</script>
