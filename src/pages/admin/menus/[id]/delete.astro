---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { isAuthenticated } from '../../../../middleware/auth';
import { createAuthenticatedClient, createSupabaseClient } from '../../../../lib/supabase';

const isAuth = await isAuthenticated(Astro.request, Astro.cookies);

if (!isAuth) {
  return Astro.redirect("/admin/login");
}

const accessTokenCookie = Astro.cookies.get("sb-access-token");
const refreshTokenCookie = Astro.cookies.get("sb-refresh-token");

if (!accessTokenCookie || !refreshTokenCookie) {
  return Astro.redirect("/admin/login");
}

const supabase = await createAuthenticatedClient(
  accessTokenCookie.value,
  refreshTokenCookie.value
);

const { id } = Astro.params;

// Definir tipos
interface Menu {
  id: number;
  name: string;
  description?: string;
  restaurant_id: number;
  menu_type: string;
  is_active: boolean;
  restaurants?: {
    id: number;
    name: string;
  };
}

let menu: Menu | null = null;
let error: string | null = null;
let categoryCount = 0;
let itemCount = 0;

try {
    // Obtener datos del menú
    const { data: menuData, error: menuError } = await supabase
        .from('menus')
        .select(`
            *,
            restaurants (
                id,
                name
            )
        `)
        .eq('id', id)
        .single();
    
    if (menuError || !menuData) {
        throw new Error('Menú no encontrado');
    }
    
    menu = menuData;

    // Contar categorías asociadas
    const { data: categoryData, error: categoryError } = await supabase
        .from('menu_categories')
        .select('id', { count: 'exact' })
        .eq('menu_id', id);
    
    if (!categoryError && categoryData) {
        categoryCount = categoryData.length;
    }

    // Contar items del menú
    const { data: itemData, error: itemError } = await supabase
        .from('menu_items')
        .select('id', { count: 'exact' })
        .eq('menu_id', id);
    
    if (!itemError && itemData) {
        itemCount = itemData.length;
    }

} catch (err: any) {
    console.error('Error:', err);
    error = err.message;
}

// Manejar la eliminación
if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const confirmDelete = formData.get('confirm_delete') === 'true';
        
        if (!confirmDelete) {
            error = 'Debe confirmar la eliminación';
        } else {
            // Eliminar el menú (las relaciones se eliminan por CASCADE)
            const { error: deleteError } = await supabase
                .from('menus')
                .delete()
                .eq('id', id);

            if (deleteError) {
                throw new Error(deleteError.message);
            }

            return Astro.redirect('/admin/menus?success=deleted');
        }
    } catch (err: any) {
        console.error('Error deleting menu:', err);
        error = 'Error al eliminar el menú: ' + err.message;
    }
}
---

<AdminLayout title="Eliminar Menú">
    <div class="container mx-auto px-4 py-8">
        <div class="max-w-2xl mx-auto">
            <div class="flex justify-between items-center mb-8">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">Eliminar Menú</h1>
                    <p class="text-gray-600 mt-2">Esta acción no se puede deshacer</p>
                </div>
                <a href="/admin/menus" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors">
                    Cancelar
                </a>
            </div>

            {error && (
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                    {error}
                </div>
            )}

            {menu && (
                <div class="bg-white shadow-lg rounded-lg p-8">
                    <div class="flex items-center mb-6">
                        <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mr-4">
                            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">¿Confirmar eliminación?</h3>
                            <p class="text-gray-600">Esta acción eliminará permanentemente el menú y toda su información asociada.</p>
                        </div>
                    </div>

                    <!-- Información del menú -->
                    <div class="border border-gray-200 rounded-lg p-4 mb-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">                            <div>
                                <span class="text-sm font-medium text-gray-500">Nombre:</span>
                                <p class="text-gray-900">{menu.name}</p>
                            </div>
                            <div>
                                <span class="text-sm font-medium text-gray-500">Restaurante:</span>
                                <p class="text-gray-900">{menu.restaurants?.name}</p>
                            </div>
                            <div>
                                <span class="text-sm font-medium text-gray-500">Tipo:</span>
                                <p class="text-gray-900 capitalize">{menu.menu_type}</p>
                            </div>
                            <div>
                                <span class="text-sm font-medium text-gray-500">Estado:</span>
                                <span class={`inline-flex px-2 py-1 text-xs font-medium rounded-full ${
                                    menu.is_active 
                                        ? 'bg-green-100 text-green-800' 
                                        : 'bg-red-100 text-red-800'
                                }`}>
                                    {menu.is_active ? 'Activo' : 'Inactivo'}
                                </span>
                            </div>
                        </div>
                        
                        {menu.description && (
                            <div class="mt-4">
                                <span class="text-sm font-medium text-gray-500">Descripción:</span>
                                <p class="text-gray-900">{menu.description}</p>
                            </div>
                        )}
                    </div>

                    <!-- Advertencias sobre datos relacionados -->
                    {(categoryCount > 0 || itemCount > 0) && (
                        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
                            <div class="flex items-center mb-2">
                                <svg class="w-5 h-5 text-yellow-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                                </svg>
                                <h4 class="text-sm font-medium text-yellow-800">Datos que se eliminarán</h4>
                            </div>
                            <ul class="text-sm text-yellow-700 space-y-1">
                                {categoryCount > 0 && (
                                    <li>• {categoryCount} categoría{categoryCount !== 1 ? 's' : ''} asociada{categoryCount !== 1 ? 's' : ''}</li>
                                )}
                                {itemCount > 0 && (
                                    <li>• {itemCount} producto{itemCount !== 1 ? 's' : ''} del menú</li>
                                )}
                                <li>• Todas las opciones de personalización de los productos</li>
                                <li>• Historial y configuraciones del menú</li>
                            </ul>
                        </div>
                    )}

                    <!-- Formulario de confirmación -->
                    <form method="POST">
                        <div class="mb-6">
                            <label class="flex items-center space-x-3">
                                <input
                                    type="checkbox"
                                    name="confirm_delete"
                                    value="true"
                                    required
                                    class="w-4 h-4 text-red-600 border-gray-300 rounded focus:ring-red-500"
                                />
                                <span class="text-sm text-gray-700">
                                    Entiendo que esta acción no se puede deshacer y eliminará permanentemente 
                                    el menú "{menu.name}" y todos sus datos asociados.
                                </span>
                            </label>
                        </div>

                        <div class="flex justify-end space-x-4">
                            <a href="/admin/menus" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                                Cancelar
                            </a>
                            <button
                                type="submit"
                                class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors"
                            >
                                Eliminar Menú
                            </button>
                        </div>
                    </form>
                </div>
            )}
        </div>
    </div>
</AdminLayout>
