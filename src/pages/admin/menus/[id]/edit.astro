---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { isAuthenticated } from '../../../../middleware/auth';
import { createAuthenticatedClient, createSupabaseClient } from '../../../../lib/supabase';

// Verificar autenticación
const isAuth = await isAuthenticated(Astro.request, Astro.cookies);
if (!isAuth) {
  return Astro.redirect("/admin/login");
}

const accessTokenCookie = Astro.cookies.get("sb-access-token");
const refreshTokenCookie = Astro.cookies.get("sb-refresh-token");

if (!accessTokenCookie || !refreshTokenCookie) {
  return Astro.redirect("/admin/login");
}

const supabase = await createAuthenticatedClient(
  accessTokenCookie.value,
  refreshTokenCookie.value
);

const { id } = Astro.params;

// Definir tipos para los objetos
interface Menu {
  id: number;
  name: string;
  menu?: string;
  description: string;
  address?: string;
  restaurant_id: number;
  menu_type: string;
  image?: string;
  is_active: boolean;
  start_date?: string;
  end_date?: string;
  availability_days?: number[];
  availability_start?: string;
  availability_end?: string;
  display_order: number;
}

interface Restaurant {
  id: number;
  name: string;
}

// Obtener datos del menú existente
let menu: Menu | null = null;
let restaurants: Restaurant[] = [];
let error: string | null = null;

try {
    // Obtener datos del menú
    const { data: menuData, error: menuError } = await supabase
        .from('menus')
        .select('*')
        .eq('id', id)
        .single();
    
    if (menuError || !menuData) {
        throw new Error('Menú no encontrado');
    }
    
    menu = menuData as Menu;

    // VERIFICAR PROPIEDAD O ADMIN
    const { data: { user } } = await supabase.auth.getUser();
    const isAdmin = [
        "emmanuelh.dev@gmail.com",
        "admin@bysmax.com",
        "e805177@gmail.com",
    ].includes(user?.email || "");

    // @ts-ignore
    if (menu.user_id !== user?.id && !isAdmin) {
        return Astro.redirect("/admin/dashboard");
    }

    // Obtener lista de restaurantes para el select (filtrar por usuario si no es admin)
    const restaurantQuery = supabase
        .from('places') // Usamos 'places' que es la tabla principal
        .select('id, name')
        .order('name');
    
    if (!isAdmin) {
        restaurantQuery.eq('user_id', user?.id);
    }

    const { data: restaurantsData, error: restaurantsError } = await restaurantQuery;
    
    if (restaurantsError) {
        throw restaurantsError;
    }
    
    restaurants = restaurantsData as Restaurant[];

} catch (err: any) {
    console.error('Error:', err);
    error = err.message;
}

// Manejar el envío del formulario
if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();

        // Manejar subida de imagen
        let imageUrl: string | undefined = menu?.image;
        const imageFile = formData.get('image') as File;
          if (imageFile && imageFile.size > 0) {
            // Crear FormData para la imagen
            const uploadFormData = new FormData();
            uploadFormData.append('image', imageFile);
            
            // Construir URL absoluta para la API
            const uploadUrl = new URL('/api/upload', Astro.url.origin);
            
            // Subir imagen usando la API existente
            const uploadResponse = await fetch(uploadUrl, {
                method: 'POST',
                body: uploadFormData,
                headers: {
                    'Cookie': Astro.request.headers.get('cookie') || ''
                }
            });
            
            if (uploadResponse.ok) {
                const uploadResult = await uploadResponse.json();
                imageUrl = uploadResult.url;
            } else {
                const errorData = await uploadResponse.json();
                throw new Error(errorData.error || 'Error al subir la imagen');
            }
        }        const name = formData.get('name') as string;
        const menuShort = formData.get('menu') as string;
        const description = formData.get('description') as string;
        const address = formData.get('address') as string || null;
        const restaurant_id = parseInt(formData.get('restaurant_id') as string);
        const menu_type = formData.get('menu_type') as string;
        const is_active = formData.get('is_active') === 'on';
        const start_date = formData.get('start_date') as string || null;
        const end_date = formData.get('end_date') as string || null;
        const availability_start = formData.get('availability_start') as string || null;
        const availability_end = formData.get('availability_end') as string || null;
        const display_order = parseInt(formData.get('display_order') as string) || 0;

        // Manejar días de disponibilidad
        const availability_days: number[] = [];
        for (let i = 0; i <= 6; i++) {
            if (formData.get(`day_${i}`)) {
                availability_days.push(i);
            }
        }        const { error: updateError } = await supabase
            .from('menus')
            .update({
                name, 
                menu: menuShort,
                description, 
                address,
                restaurant_id, 
                menu_type,
                image: imageUrl,
                is_active,
                start_date, 
                end_date, 
                availability_days, 
                availability_start,
                availability_end, 
                display_order,
                updated_at: new Date().toISOString()
            })
            .eq('id', id);

        if (updateError) {
            throw updateError;
        }

        return Astro.redirect('/admin/menus?success=updated');
    } catch (err: any) {
        console.error('Error updating menu:', err);
        error = 'Error al actualizar el menú: ' + err.message;
    }
}

const dayNames = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
---

<AdminLayout title="Editar Menú">
    <div class="container mx-auto px-4 py-8">
        <div class="max-w-4xl mx-auto">
            <div class="flex justify-between items-center mb-8">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">Editar Menú</h1>
                    <p class="text-gray-600 mt-2">Modifica la información del menú</p>
                </div>
                <a href="/admin/menus" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors">
                    Volver a Menús
                </a>
            </div>

            {error && (
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                    {error}
                </div>
            )}            {menu && (
                <form method="POST" enctype="multipart/form-data" class="bg-white  rounded-lg p-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Información básica -->
                        <div class="md:col-span-2">
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Información Básica</h3>
                        </div>                        <div>
                            <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                                Nombre del Menú *
                            </label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                value={menu.name}
                                required
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                placeholder="Ej: Menú Principal"
                            />
                        </div>

                        <div>
                            <label for="menu" class="block text-sm font-medium text-gray-700 mb-2">
                                Nombre Corto
                            </label>
                            <input
                                type="text"
                                id="menu"
                                name="menu"
                                value={menu.menu || ''}
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                placeholder="Ej: principal, infantil"
                            />
                        </div>                        <div>
                            <label for="restaurant_id" class="block text-sm font-medium text-gray-700 mb-2">
                                Restaurante *
                            </label>
                            <select
                                id="restaurant_id"
                                name="restaurant_id"
                                required
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            >
                                <option value="">Seleccionar restaurante</option>
                                {restaurants.map(restaurant => (
                                    <option 
                                        value={restaurant.id} 
                                        selected={restaurant.id === menu.restaurant_id}
                                    >
                                        {restaurant.name}
                                    </option>
                                ))}
                            </select>
                        </div>                        <div class="md:col-span-2">
                            <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
                                Descripción
                            </label>
                            <textarea
                                id="description"
                                name="description"
                                rows="3"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                placeholder="Descripción del menú..."
                            >{menu.description}</textarea>
                        </div>

                        <div class="md:col-span-2">
                            <label for="address" class="block text-sm font-medium text-gray-700 mb-2">
                                Dirección
                            </label>
                            <input
                                type="text"
                                id="address"
                                name="address"
                                value={menu.address || ''}
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                placeholder="Ej: Calle Principal 123, Colonia Centro"
                            />
                        </div>                        <div class="md:col-span-2">
                            <label for="image" class="block text-sm font-medium text-gray-700 mb-2">
                                Imagen del Menú
                            </label>
                            
                            {menu.image && (
                                <div class="mb-4">
                                    <img 
                                        src={menu.image} 
                                        alt="Imagen actual del menú" 
                                        class="w-32 h-32 object-cover rounded-lg shadow-sm"
                                    />
                                    <p class="text-sm text-gray-500 mt-1">Imagen actual</p>
                                </div>
                            )}
                            
                            <div id="imagePreview" class="hidden mb-4">
                                <img 
                                    id="previewImg" 
                                    alt="Vista previa" 
                                    class="w-32 h-32 object-cover rounded-lg shadow-sm"
                                />
                                <p class="text-sm text-gray-500 mt-1">Nueva imagen (vista previa)</p>
                            </div>
                            
                            <input
                                type="file"
                                id="image"
                                name="image"
                                accept="image/*"
                                class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"
                            />
                            <p class="mt-1 text-sm text-gray-500">PNG, JPG o WEBP (máx. 2MB). Dejar vacío para mantener la imagen actual.</p>
                        </div>

                        <!-- Configuración -->
                        <div class="md:col-span-2 mt-6">
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Configuración</h3>
                        </div>

                        <div>
                            <label for="menu_type" class="block text-sm font-medium text-gray-700 mb-2">
                                Tipo de Menú
                            </label>
                            <select
                                id="menu_type"
                                name="menu_type"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            >
                                <option value="main" selected={menu.menu_type === 'main'}>Principal</option>
                                <option value="kids" selected={menu.menu_type === 'kids'}>Infantil</option>
                                <option value="daily" selected={menu.menu_type === 'daily'}>Del Día</option>
                                <option value="drinks" selected={menu.menu_type === 'drinks'}>Bebidas</option>
                                <option value="desserts" selected={menu.menu_type === 'desserts'}>Postres</option>
                                <option value="breakfast" selected={menu.menu_type === 'breakfast'}>Desayuno</option>
                                <option value="lunch" selected={menu.menu_type === 'lunch'}>Almuerzo</option>
                                <option value="dinner" selected={menu.menu_type === 'dinner'}>Cena</option>
                            </select>
                        </div>

                        <div>
                            <label for="display_order" class="block text-sm font-medium text-gray-700 mb-2">
                                Orden de Visualización
                            </label>
                            <input
                                type="number"
                                id="display_order"
                                name="display_order"
                                value={menu.display_order}
                                min="0"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            />
                        </div>

                        <!-- Vigencia -->
                        <div class="md:col-span-2 mt-6">
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Vigencia</h3>
                        </div>

                        <div>
                            <label for="start_date" class="block text-sm font-medium text-gray-700 mb-2">
                                Fecha de Inicio
                            </label>
                            <input
                                type="date"
                                id="start_date"
                                name="start_date"
                                value={menu.start_date}
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            />
                        </div>

                        <div>
                            <label for="end_date" class="block text-sm font-medium text-gray-700 mb-2">
                                Fecha de Fin
                            </label>
                            <input
                                type="date"
                                id="end_date"
                                name="end_date"
                                value={menu.end_date}
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            />
                        </div>

                        <!-- Horarios -->
                        <div class="md:col-span-2 mt-6">
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Horarios de Disponibilidad</h3>
                        </div>

                        <div>
                            <label for="availability_start" class="block text-sm font-medium text-gray-700 mb-2">
                                Hora de Inicio
                            </label>
                            <input
                                type="time"
                                id="availability_start"
                                name="availability_start"
                                value={menu.availability_start}
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            />
                        </div>

                        <div>
                            <label for="availability_end" class="block text-sm font-medium text-gray-700 mb-2">
                                Hora de Fin
                            </label>
                            <input
                                type="time"
                                id="availability_end"
                                name="availability_end"
                                value={menu.availability_end}
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            />
                        </div>

                        <!-- Días de la semana -->
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Días de Disponibilidad
                            </label>
                            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-2">
                                {dayNames.map((day, index) => (
                                    <label class="flex items-center space-x-2 cursor-pointer">
                                        <input
                                            type="checkbox"
                                            name={`day_${index}`}
                                            checked={menu.availability_days?.includes(index)}
                                            class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                                        />
                                        <span class="text-sm text-gray-700">{day}</span>
                                    </label>
                                ))}
                            </div>
                        </div>

                        <!-- Estado -->
                        <div class="md:col-span-2 mt-6">
                            <label class="flex items-center space-x-3">
                                <input
                                    type="checkbox"
                                    name="is_active"
                                    checked={menu.is_active}
                                    class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                                />
                                <span class="text-sm font-medium text-gray-700">Menú activo</span>
                            </label>
                        </div>
                    </div>

                    <div class="flex justify-end space-x-4 mt-8 pt-6 border-t border-gray-200">
                        <a href="/admin/menus" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                            Cancelar
                        </a>
                        <button
                            type="submit"
                            class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                        >
                            Actualizar Menú
                        </button>
                    </div>
                </form>
            )}        </div>
    </div>    <script>
        // Image preview functionality
        document.addEventListener('DOMContentLoaded', function() {
            const imageInput = document.getElementById('image') as HTMLInputElement;
            const imagePreview = document.getElementById('imagePreview') as HTMLElement;
            const previewImg = document.getElementById('previewImg') as HTMLImageElement;

            imageInput?.addEventListener('change', function(e) {
                const target = e.target as HTMLInputElement;
                const file = target.files?.[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        if (e.target?.result && previewImg) {
                            previewImg.src = e.target.result as string;
                            imagePreview?.classList.remove('hidden');
                        }
                    };
                    reader.readAsDataURL(file);
                } else {
                    imagePreview?.classList.add('hidden');
                }
            });
        });
    </script>
</AdminLayout>
