---
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import { isAuthenticated } from "../../middleware/auth";
import { createAuthenticatedClient } from "../../lib/supabase";
import MenuManager from "../../components/admin/MenuManager";
import PlaceManager from "../../components/admin/PlaceManager";
import HistoryManager from "../../components/admin/HistoryManager";

const isAuth = await isAuthenticated(Astro.request, Astro.cookies);

if (!isAuth) {
	return Astro.redirect("/admin/login");
}

const accessTokenCookie = Astro.cookies.get("sb-access-token");
const refreshTokenCookie = Astro.cookies.get("sb-refresh-token");

if (!accessTokenCookie || !refreshTokenCookie) {
	return Astro.redirect("/admin/login");
}

const supabase = await createAuthenticatedClient(
	accessTokenCookie.value,
	refreshTokenCookie.value,
);

const {
	data: { user },
	error: userError,
} = await supabase.auth.getUser();

if (userError || !user) {
	console.error("Error al obtener usuario:", userError);
	return Astro.redirect("/admin/login");
}

const isAdmin = [
	"emmanuelh.dev@gmail.com",
	"admin@bysmax.com",
	"e805177@gmail.com",
].includes(user.email || "");

const { data: places, error: placesError } = await supabase
	.from("places")
	.select(
		`
		*,
		states (
			id,
			name,
			slug
		)
	`,
	)
	.eq("user_id", user?.id)
	.order("created_at", { ascending: false });

const { data: recentComments } = await supabase
	.from("reviews")
	.select(
		`
		*,
		places (
			name
		)
	`,
	)
	.in(
		"place_id",
		(places || []).map((p) => p.id),
	)
	.order("created_at", { ascending: false })
	.limit(20);

// Only fetch history if admin
let history: any[] = [];
if (isAdmin) {
	const { data: historyData } = await supabase
		.from("place_content_history")
		.select(
			`
			*,
			places (
				name
			)
		`,
		)
		.order("created_at", { ascending: false })
		.limit(10);
	history = historyData || [];
}
---

<AdminLayout title="Dashboard | Panel de Administrador">
	<div class="flex flex-col gap-6 pb-20">
		<header
			class="flex flex-col md:flex-row md:items-end justify-between gap-4"
		>
			<div class="flex flex-col gap-1">
				<h1
					class="text-3xl font-black uppercase tracking-tighter text-slate-900"
				>
					Panel
				</h1>
				<p class="text-slate-500 font-medium text-sm">
					Bienvenido, {user.user_metadata?.name || "Administrador"}.
				</p>
			</div>
			<div id="place-manager-trigger">
				<PlaceManager initialRestaurants={places || []} client:load />
			</div>
		</header>

		{
			places && places.length === 0 ? (
				<div class="bg-slate-50 border-2 border-dashed border-slate-200 rounded-3xl p-12 text-center">
					<div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-sm">
						<span class="text-2xl">✨</span>
					</div>
					<h2 class="text-2xl font-black uppercase tracking-tighter text-slate-900 mb-2">
						Comienza creando tu primer lugar
					</h2>
					<p class="text-slate-500 font-medium max-w-sm mx-auto mb-8">
						Registra tu establecimiento y sube tu menú para empezar a recibir
						pedidos por WhatsApp.
					</p>
					{/* The PlaceManager above already provides the button, but we can add a visual hint here if needed */}
				</div>
			) : (
				<div class="space-y-12">
					{isAdmin && (
						<div>
							<HistoryManager client:load initialHistory={history || []} />
						</div>
					)}

					{recentComments && recentComments.length > 0 && (
						<div class="bg-white rounded-3xl border border-slate-100 p-8 shadow-sm max-w-2xl">
							<h2 class="text-xs font-black uppercase tracking-widest text-slate-400 mb-6 flex items-center gap-2">
								<span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse" />
								Actividad Reciente
							</h2>
							<ul class="space-y-4">
								{recentComments.slice(0, 5).map((comment) => (
									<li class="flex flex-col gap-1">
										<div class="flex items-center justify-between text-[10px] font-black uppercase tracking-tight">
											<span class="text-emerald-600">
												{comment.places?.name}
											</span>
											<span class="text-slate-300">
												{new Date(comment.created_at).toLocaleDateString()}
											</span>
										</div>
										<p class="text-sm font-medium text-slate-700 leading-snug">
											"{comment.comment}"
										</p>
									</li>
								))}
							</ul>
						</div>
					)}
				</div>
			)
		}
	</div>
</AdminLayout>
