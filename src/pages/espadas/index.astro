    image: '/espadas.webp',
    closed: true,
    openingTime: "mañana a las 13:00",
    specialties: ["Picaña", "Costilla", "Filete"]
  },
  {
    name: "Brasa & Leña",
    rating: 4.5,
    reviewCount: 620,
    priceRange: "$$$",
    address: "Calzada San Pedro 290, San Pedro Garza García",
    hours: "14:00 - 23:00",
    services: ["Rodizio", "Barra de ensaladas", "Vinos", "Postres"],
    image: '/espadas.webp',
    distance: "7.2 km",
    specialties: ["Picaña", "Costilla", "Filete"]
  },
  {
    name: "Churrascaría Gaucho",
    rating: 4.4,
    reviewCount: 580,
    priceRange: "$$$",
    address: "Av. Fundidora 501, Monterrey",
    hours: "13:00 - 22:00",
    services: ["Rodizio", "Barra de ensaladas", "Vinos"],
    image: '/espadas.webp',
    distance: "5.1 km",
    specialties: ["Picaña", "Costilla", "Chorizo"]
  },
  {
    name: "Fogón do Brasil",
    rating: 4.7,
    reviewCount: 890,
    priceRange: "$$$$",
    address: "Av. Gómez Morín 908, San Pedro Garza García",
    hours: "13:30 - 23:00",
    services: ["Rodizio", "Barra de ensaladas", "Vinos", "Postres"],
    image: '/espadas.webp',
    menu: "/menus/fogondobrasil",
    specialties: ["Picaña", "Costilla", "Filete", "Cordero"]
  }
];

// Configuración para SEO
const seoData = {
  title: "🔥 Restaurantes de Espadas Brasileñas en Monterrey 2025 | Mejores Churrascarías",
  description: "🥩 Descubre los mejores restaurantes de espadas brasileñas en Monterrey. Rodizio, carnes premium, buffet brasileño y más. ⭐ Reseñas, precios, ubicaciones y menús digitales. ¡Reserva ya!",
  keywords: [
    "restaurante de espadas en monterrey", 
    "restaurantes brasileños en monterrey", 
    "espadas brasileñas", 
    "restaurantes de espadas brasileñas en monterrey",
    "restaurante brasileño monterrey",
    "restaurante de espadas",
    "restaurantes de espadas en monterrey",
    "restaurante las espadas",
    "espadas brasileñas monterrey",
    "las espadas - brazilian steakhouse",
    "rodizio monterrey",
    "churrascarías monterrey",
    "buffet brasileño monterrey",
    "carnes espadas brasileñas",
    "espadas de carne",
    "comida brasileña en monterrey",
    "restaurante de espadas cerca de mi",
    "cortes de carne espadas"
  ],
};

// Configuración para Schema.org
const schemaEnrichment = {
  address: {
    addressLocality: "Monterrey",
    addressRegion: "Nuevo León",
    addressCountry: "MX",
  },
};
---

<RestaurantLayout 
  title={seoData.title}
  description={seoData.description}
  schemaEnrichment={schemaEnrichment}
  backgroundColor="bg-black"
  textWhite={true}
>
<!-- Schema.org markup para SEO -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Restaurantes de Espadas Brasileñas en Monterrey",
