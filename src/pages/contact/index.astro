---
import DefaultLayout from "../../layouts/DefaultLayout.astro";
---

<DefaultLayout
  title="Contactanos"
  description="Deja tu mensaje y nos pondremos en contacto contigo lo antes posible."
>
  <div class="max-w-2xl mx-auto p-4">
    <h1 class="text-4xl py-8 font-bold mb-4 text-center">Contáctanos</h1>
    <div class="text-balance">
      <p>¿Tienes alguna pregunta o comentario? No dudes en enviarnos un mensaje.</p>
      <p>Usa este formulario para solicitar un registro o nuevas características.</p>
    </div>

    <p id="contact-status" class="px-4 py-3 rounded mb-4 hidden"></p>

    <form id="contact-form" class="space-y-4 mt-4">
      <div>
        <label for="name" class="block mb-1">Nombre</label>
        <input
          type="text"
          id="name"
          name="name"
          minlength="2"
          required
          class="w-full px-3 py-2 border rounded"
        />
      </div>

      <div>
        <label for="email" class="block mb-1">Correo electrónico</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-3 py-2 border rounded"
        />
      </div>

      <div>
        <label for="message" class="block mb-1">Mensaje</label>
        <textarea
          id="message"
          name="message"
          minlength="10"
          rows="4"
          required
          class="w-full px-3 py-2 border rounded"
        ></textarea>
      </div>

      <button
        type="submit"
        id="contact-submit"
        class="bg-black text-white px-4 font-semibold rounded hover:bg-black/80 w-full py-3 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Enviar mensaje
      </button>
    </form>
  </div>
</DefaultLayout>

<script>
  // Igual que anaconda-tracking y bysmax: postea directo al backend
  // compartido (bysmax-backend), sin pasar por Supabase ni por un route
  // propio de Astro — el backend ya guarda el mensaje y manda el correo
  // (Resend) del lado del servidor.
  const CONTACT_ENDPOINT = "https://admin.bysmax.com/api/contact";

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement;
  const status = document.getElementById("contact-status") as HTMLParagraphElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    submitBtn.disabled = true;
    submitBtn.textContent = "ENVIANDO...";
    status.classList.add("hidden");

    try {
      const res = await fetch(CONTACT_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: formData.get("name"),
          email: formData.get("email"),
          message: formData.get("message"),
          source: "menus",
        }),
      });

      if (!res.ok) throw new Error("request failed");

      form.reset();
      status.textContent = "¡Mensaje enviado con éxito! Te contactaremos pronto.";
      status.className = "px-4 py-3 rounded mb-4 bg-green-100 border border-green-400 text-green-700";

      if ((window as any).umami) {
        (window as any).umami.track("contact_form_submit", { source: "menus" });
      }
    } catch (err) {
      status.textContent = "No se pudo enviar el mensaje. Intenta de nuevo.";
      status.className = "px-4 py-3 rounded mb-4 bg-red-100 border border-red-400 text-red-700";
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Enviar mensaje";
      status.classList.remove("hidden");
    }
  });
</script>
