---
import { ArrowRight, X } from "lucide-react";
import RestaurantLayout from "../../layouts/RestaurantLayout.astro";
import { comparativeFeatures } from "../../data/pricing";
const seoData = {
	title: "Precios y Planes para Menú Digital y Carta QR | BySMax",
	description:
		"Consulta nuestros planes para digitalizar tu restaurante. Desde un plan gratuito para siempre hasta opciones Pro con pedidos por WhatsApp. Sin comisiones.",
	keywords:
		"menu digital precio, planes carta qr, costo menu digital restaurantes, sistema qr restaurante precio",
};
---

<RestaurantLayout
	title={seoData.title}
	description={seoData.description}
	keywords={seoData.keywords}
	textWhite={false}
>
	<div class="mt-24 max-w-[85%] mx-auto">
		<h2 class="text-2xl font-bold text-neutral-900 mb-8 text-center">
			Comparativa de planes
		</h2>
		<div class="overflow-x-auto">
			<table class="w-full">
				<thead>
					<tr>
						<th class="w-[200px] p-4 text-left">Característica</th>
						<th class="p-4 text-center">Gratis</th>
						<th class="p-4 text-center">Pro</th>
						<th class="p-4 text-center">Empresarial</th>
					</tr>
				</thead>
				<tbody>
					{
						comparativeFeatures.map((feature) => (
							<tr class="border-b border-neutral-200 hover:bg-neutral-100 last:border-b-0">
								<td class="font-medium p-4">{feature.name}</td>
								<td class="p-4 text-center">
									{feature.free === "No" ? (
										<X className="text-red-500 mx-auto" />
									) : (
										feature.free
									)}
								</td>
								<td class="p-4 text-center">
									{feature.pro === "No" ? (
										<X className="text-red-500 mx-auto" />
									) : (
										feature.pro
									)}
								</td>
								<td class="p-4 text-center">
									{feature.enterprise === "No" ? (
										<X className="text-red-500 mx-auto" />
									) : (
										feature.enterprise
									)}
								</td>
							</tr>
						))
					}
					<tr>
						<td></td>
						<td class="p-4 text-center justify-center">
							<a href="/admin/dashboard">
								<span class="flex items-center justify-center">
									Comenzar Ahora
									<ArrowRight className="ml-2" />
								</span>
							</a>
						</td>
						<td class="p-4 text-center">
							<a href="/admin/dashboard">
								<span class="flex items-center justify-center">
									Comenzar Ahora
									<ArrowRight className="ml-2" />
								</span>
							</a>
						</td>
						<td class="p-4 text-center">
							<a href="/admin/dashboard">
								<span class="flex items-center justify-center">
									Comenzar Ahora
									<ArrowRight className="ml-2" />
								</span>
							</a>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</RestaurantLayout>
