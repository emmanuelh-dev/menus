---
import {
	Tv,
	Monitor,
	Layout,
	Zap,
	RefreshCcw,
	Maximize,
	ArrowRight,
	Smartphone,
	Check,
} from "lucide-react";
import DefaultLayout from "../layouts/DefaultLayout.astro";

const seoData = {
	title: "Menú Digital para Pantallas y TV | Digital Signage Gratis | BySMax",
	description:
		"Convierte cualquier TV en un menú digital profesional. La mejor solución de digital signage para restaurantes en México. ¡Configura tu pantalla en minutos!",
	keywords:
		"pantalla para menu digital, reproductor de menu digital, menu digital para tv, tableros de menu digitales",
};
---

<DefaultLayout
	title={seoData.title}
	description={seoData.description}
	keywords={seoData.keywords}
	showAds={false}
>
	<main class="flex-1 bg-white">
		<!-- Hero Section -->
		<section class="py-20 md:py-32 bg-slate-50 relative overflow-hidden">
			<div
				class="absolute top-0 right-0 w-1/3 h-full bg-emerald-500/5 blur-3xl -z-10"
			>
			</div>
			<div
				class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
			>
				<div>
					<div
						class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold uppercase tracking-wider mb-6"
					>
						<Tv className="w-3 h-3" />
						Digital Signage para Restaurantes
					</div>
					<h1
						class="text-4xl md:text-6xl font-black text-slate-900 mb-6 tracking-tighter leading-tight"
					>
						Tu Menú Digital en <br />
						<span class="text-emerald-600">Cualquier Pantalla.</span>
					</h1>
					<p class="text-xl text-slate-600 mb-8 leading-relaxed">
						No solo somos códigos QR. Con BySMax puedes proyectar tu <strong
							>carta digital</strong
						> en Smart TVs, monitores o tablets. Actualiza precios desde tu celular
						y mira el cambio al instante en tu local.
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<a
							href="/admin/register"
							class="inline-flex items-center justify-center px-8 py-4 bg-slate-900 text-white font-bold rounded-2xl hover:bg-slate-800 transition-all shadow-xl shadow-slate-900/10"
						>
							Empezar Ahora Gratis
							<ArrowRight className="ml-2 h-5 w-5" />
						</a>
						<a
							href="#como-funciona"
							class="inline-flex items-center justify-center px-8 py-4 border border-slate-200 text-slate-600 font-semibold rounded-2xl hover:bg-white transition-all"
						>
							¿Cómo se conecta?
						</a>
					</div>
				</div>
				<div class="relative">
					<div
						class="aspect-video bg-slate-900 rounded-[32px] p-4 border-[12px] border-slate-800 shadow-2xl relative overflow-hidden group"
					>
						<!-- Mockup of a TV menu -->
						<div class="w-full h-full bg-white rounded-xl p-6 overflow-hidden">
							<div class="flex justify-between items-center mb-6">
								<h3 class="font-black text-xl text-slate-900 uppercase">
									Menú del Día
								</h3>
								<div
									class="bg-emerald-500 text-white px-3 py-1 rounded text-[10px] font-bold"
								>
									BY SMAX
								</div>
							</div>
							<div class="grid grid-cols-2 gap-4">
								<div class="space-y-3">
									<div
										class="flex justify-between border-b border-dotted border-slate-300 pb-1"
									>
										<span class="font-bold text-sm">Hamburguesa Especial</span>
										<span class="text-emerald-600 font-bold">$120</span>
									</div>
									<div
										class="flex justify-between border-b border-dotted border-slate-300 pb-1"
									>
										<span class="font-bold text-sm">Pizza Pepperoni</span>
										<span class="text-emerald-600 font-bold">$180</span>
									</div>
									<div
										class="flex justify-between border-b border-dotted border-slate-300 pb-1"
									>
										<span class="font-bold text-sm">Tacos Mix (3)</span>
										<span class="text-emerald-600 font-bold">$95</span>
									</div>
								</div>
								<div class="rounded-lg bg-slate-100 animate-pulse h-full"></div>
							</div>
						</div>
						<div
							class="absolute inset-0 bg-gradient-to-t from-slate-900/40 to-transparent pointer-events-none text-white p-8 flex flex-col justify-end"
						>
							<div class="flex items-center gap-2">
								<div class="w-2 h-2 bg-emerald-500 rounded-full animate-ping">
								</div>
								<span class="text-xs font-bold uppercase tracking-widest"
									>En Vivo</span
								>
							</div>
						</div>
					</div>
					<!-- Device floating icons -->
					<div
						class="absolute -bottom-6 -left-6 bg-white p-4 rounded-2xl shadow-xl border border-slate-100"
					>
						<Monitor className="w-8 h-8 text-blue-500" />
					</div>
					<div
						class="absolute -top-6 -right-6 bg-white p-4 rounded-2xl shadow-xl border border-slate-100"
					>
						<Zap className="w-8 h-8 text-orange-500" />
					</div>
				</div>
			</div>
		</section>

		<!-- Solutions -->
		<section id="como-funciona" class="py-24">
			<div class="max-w-6xl mx-auto px-6">
				<div class="text-center mb-16">
					<h2
						class="text-3xl md:text-5xl font-black text-slate-900 mb-4 tracking-tighter"
					>
						La solución perfecta para tu mostrador.
					</h2>
					<p class="text-slate-500 text-lg">
						Digital Signage simplificado: sin cables complicados ni software
						caro.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
					<div class="space-y-4">
						<div
							class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center mb-6"
						>
							<Maximize className="w-6 h-6" />
						</div>
						<h4 class="text-xl font-bold">Cualquier Dispositivo</h4>
						<p class="text-slate-600 leading-relaxed text-sm">
							Funciona en Smart TV, Android TV Box, Fire Stick, tablets o
							incluso computadoras conectadas por HDMI.
						</p>
					</div>
					<div class="space-y-4">
						<div
							class="w-12 h-12 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center mb-6"
						>
							<RefreshCcw className="w-6 h-6" />
						</div>
						<h4 class="text-xl font-bold">Sincronización Total</h4>
						<p class="text-slate-600 leading-relaxed text-sm">
							¿Se terminó un ingrediente? Quita el plato desde tu celular y se
							actualizará automáticamente en la pantalla del local.
						</p>
					</div>
					<div class="space-y-4">
						<div
							class="w-12 h-12 bg-purple-100 text-purple-600 rounded-xl flex items-center justify-center mb-6"
						>
							<Layout className="w-6 h-6" />
						</div>
						<h4 class="text-xl font-bold">Tableros de Menú</h4>
						<p class="text-slate-600 leading-relaxed text-sm">
							Diseña tableros de menú (Menu Boards) visuales que atraen más
							ventas y agilizan la fila en el mostrador.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Step by step -->
		<section class="py-24 bg-slate-50">
			<div class="max-w-4xl mx-auto px-6">
				<h2 class="text-3xl font-bold text-center mb-16">
					3 pasos para tener tu Menú en TV
				</h2>
				<div class="space-y-12">
					<div class="flex gap-8 items-start">
						<div
							class="w-10 h-10 shrink-0 bg-slate-900 text-white rounded-full flex items-center justify-center font-bold"
						>
							1
						</div>
						<div>
							<h4 class="text-xl font-bold mb-2">Crea tu Menú en BySMax</h4>
							<p class="text-slate-600">
								Sube tus platillos, fotos y precios. El sistema generará una
								versión optimizada para visualización horizontal.
							</p>
						</div>
					</div>
					<div class="flex gap-8 items-start">
						<div
							class="w-10 h-10 shrink-0 bg-slate-900 text-white rounded-full flex items-center justify-center font-bold"
						>
							2
						</div>
						<div>
							<h4 class="text-xl font-bold mb-2">Abre el enlace en tu TV</h4>
							<p class="text-slate-600">
								Usa el navegador integrado de tu Smart TV o conecta un
								dispositivo económico (como Fire Stick o Chromecast) y abre tu
								URL personalizada.
							</p>
						</div>
					</div>
					<div class="flex gap-8 items-start">
						<div
							class="w-10 h-10 shrink-0 bg-slate-900 text-white rounded-full flex items-center justify-center font-bold"
						>
							3
						</div>
						<div>
							<h4 class="text-xl font-bold mb-2">
								¡Listo! Ventas en automático
							</h4>
							<p class="text-slate-600">
								Pon la pantalla en pantalla completa. Tu menú luce profesional,
								moderno y siempre actualizado.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Benefits -->
		<section class="py-24 bg-white">
			<div class="max-w-6xl mx-auto px-6 text-center">
				<h2 class="text-3xl font-bold mb-16">
					¿Por qué usar pantallas digitales?
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
					<div class="p-6">
						<div class="text-3xl mb-4">🚀</div>
						<p class="font-bold">Aumenta ventas +20%</p>
						<p class="text-xs text-slate-500 mt-2">
							Los clientes compran más cuando ven fotos atractivas en grande.
						</p>
					</div>
					<div class="p-6">
						<div class="text-3xl mb-4">💰</div>
						<p class="font-bold">Cero Costos de Impresión</p>
						<p class="text-xs text-slate-500 mt-2">
							Ahorra miles de pesos en lonas y vinilos que quedan obsoletos.
						</p>
					</div>
					<div class="p-6">
						<div class="text-3xl mb-4">⏱️</div>
						<p class="font-bold">Menos tiempo de espera</p>
						<p class="text-xs text-slate-500 mt-2">
							Los clientes eligen mientras están en la fila.
						</p>
					</div>
					<div class="p-6">
						<div class="text-3xl mb-4">✨</div>
						<p class="font-bold">Imagen Profesional</p>
						<p class="text-xs text-slate-500 mt-2">
							Diferénciate de la competencia con tecnología de punta.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Final CTA -->
		<section class="py-20 bg-emerald-600 text-white text-center">
			<div class="max-w-2xl mx-auto px-6">
				<h2 class="text-3xl font-bold mb-6">Convierte tu TV en un vendedor</h2>
				<p class="text-lg opacity-90 mb-8">
					Empieza hoy mismo. No necesitas comprar hardware costoso ni pagar
					mensualidades excesivas.
				</p>
				<a
					href="/admin/login"
					class="inline-flex items-center px-8 py-4 bg-white text-emerald-600 font-bold rounded-xl hover:bg-emerald-50 transition-all shadow-xl"
				>
					Crear mi Menú Digital Gratuitamente
				</a>
			</div>
		</section>
	</main>
</DefaultLayout>
