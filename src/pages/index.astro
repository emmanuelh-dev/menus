---
export const prerender = true;

import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import menu from "./menu.jpg";
import main_menu from "./phone_with_menu.png";
import {
	Utensils,
	QrCode,
	Smartphone,
	Clock,
	Zap,
	ArrowRight,
	Check,
	X,
	Search,
	Star,
	Globe,
	Settings,
	ChevronDown,
	Users,
	Trophy,
} from "lucide-react";

import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { Image } from "astro:assets";
import RestaurantLayout from "../layouts/RestaurantLayout.astro";

const restaurantData = {
	name: "BySMax Menús - Crea tu menú digital con código QR",
	description: "Crea tu menú digital profesional con código QR en minutos. Sin anuncios, visible en Google, totalmente personalizable. Planes gratis y premium disponibles.",
};

---

<RestaurantLayout
title={restaurantData.name}
description={restaurantData.description}
>
	<div>
		<main class="flex-1">
			<!-- Hero Section -->
			<section class="mx-auto py-16 md:py-24 bg-gradient-to-br from-blue-50 to-indigo-100">
				<div class="container px-4 md:px-6 mx-auto text-center">
					<div class="max-w-4xl mx-auto">
						<h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6 leading-tight">
							Crea tu <span class="text-blue-600">menú digital</span> con código QR en minutos
						</h1>
						<p class="text-xl md:text-2xl text-gray-600 mb-8 max-w-3xl mx-auto">
							Sin anuncios, fácil de usar, personalizable y visible desde Google. 
							La forma más profesional de mostrar tu menú.
						</p>
						<div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
							<a
								href="/contact"
								class="inline-flex items-center px-8 py-4 bg-blue-600 text-white text-lg font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-lg"
							>
								Empieza gratis
								<ArrowRight className="ml-2 h-5 w-5" />
							</a>
							<a
								href="/menus"
								class="inline-flex items-center px-8 py-4 border-2 border-blue-600 text-blue-600 text-lg font-semibold rounded-lg hover:bg-blue-50 transition-colors"
							>
								Ver casos de éxito
							</a>
						</div>
						<Image 
							src={main_menu} 
							alt="Menú digital con código QR en smartphone" 
							class="mx-auto max-w-md md:max-w-lg rounded-2xl shadow-2xl"
						/>
					</div>
				</div>
			</section>

			<!-- Quick Benefits Section -->
			<section class="py-16 bg-white">
				<div class="container mx-auto px-4">
					<h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 mb-12">
						¿Por qué elegir BySMax Menús?
					</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
						<div class="text-center">
							<div class="bg-green-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
								<Search className="h-8 w-8 text-green-600" />
							</div>
							<h3 class="text-xl font-semibold mb-2">Visible en Google</h3>
							<p class="text-gray-600">Tu menú aparece en resultados de búsqueda y aumenta tu visibilidad online</p>
						</div>
						<div class="text-center">
							<div class="bg-blue-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
								<X className="h-8 w-8 text-blue-600" />
							</div>
							<h3 class="text-xl font-semibold mb-2">Sin publicidad</h3>
							<p class="text-gray-600">Experiencia limpia y profesional para tus clientes sin anuncios molestos</p>
						</div>
						<div class="text-center">
							<div class="bg-purple-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
								<Settings className="h-8 w-8 text-purple-600" />
							</div>
							<h3 class="text-xl font-semibold mb-2">Totalmente personalizable</h3>
							<p class="text-gray-600">Adapta colores, logos y diseño a la identidad de tu restaurante</p>
						</div>
						<div class="text-center">
							<div class="bg-orange-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
								<Clock className="h-8 w-8 text-orange-600" />
							</div>
							<h3 class="text-xl font-semibold mb-2">Listo en 5 minutos</h3>
							<p class="text-gray-600">Crea y publica tu menú digital de forma rápida y sencilla</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Demo Video Section -->
			<section class="py-16 bg-gray-50">
				<div class="container mx-auto px-4 text-center">
					<h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-8">
						Mira cómo crear tu menú en menos de 5 minutos
					</h2>
					<div class="max-w-4xl mx-auto">
						<div class="bg-white rounded-2xl shadow-xl p-8">								<div class="aspect-video bg-gray-200 rounded-lg flex items-center justify-center mb-6">
									<div class="text-center">
										<div class="bg-blue-600 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
											<svg class="h-8 w-8 text-white" fill="currentColor" viewBox="0 0 20 20">
												<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
											</svg>
										</div>
										<p class="text-gray-600">Video demo: "Cómo crear tu menú digital en 5 minutos"</p>
									</div>
								</div>
							<p class="text-gray-600">
								Descubre lo fácil que es crear un menú profesional, subirlo y generar tu código QR
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Comparison Table -->
			<section class="py-16 bg-white">
				<div class="container mx-auto px-4">
					<h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 mb-4">
						BySMax Menús vs Competencia
					</h2>
					<p class="text-xl text-gray-600 text-center mb-12">
						Conoce las diferencias que nos hacen únicos
					</p>
					<div class="max-w-4xl mx-auto">
						<div class="bg-white rounded-2xl shadow-xl overflow-hidden">
							<table class="w-full">
								<thead class="bg-gray-50">
									<tr>
										<th class="px-6 py-4 text-left text-lg font-semibold text-gray-900">Funcionalidad</th>
										<th class="px-6 py-4 text-center text-lg font-semibold text-blue-600">BySMax Menús</th>
										<th class="px-6 py-4 text-center text-lg font-semibold text-gray-600">Otros</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-200">
									<tr>
										<td class="px-6 py-4 font-medium text-gray-900">Sin anuncios</td>
										<td class="px-6 py-4 text-center">
											<Check className="h-6 w-6 text-green-600 mx-auto" />
										</td>
										<td class="px-6 py-4 text-center">
											<X className="h-6 w-6 text-red-500 mx-auto" />
										</td>
									</tr>
									<tr class="bg-gray-50">
										<td class="px-6 py-4 font-medium text-gray-900">Visible en Google</td>
										<td class="px-6 py-4 text-center">
											<Check className="h-6 w-6 text-green-600 mx-auto" />
										</td>
										<td class="px-6 py-4 text-center">
											<X className="h-6 w-6 text-red-500 mx-auto" />
										</td>
									</tr>
									<tr>
										<td class="px-6 py-4 font-medium text-gray-900">Diseño optimizado</td>
										<td class="px-6 py-4 text-center">
											<Check className="h-6 w-6 text-green-600 mx-auto" />
										</td>
										<td class="px-6 py-4 text-center">
											<X className="h-6 w-6 text-red-500 mx-auto" />
										</td>
									</tr>
									<tr class="bg-gray-50">
										<td class="px-6 py-4 font-medium text-gray-900">IA para recomendar</td>
										<td class="px-6 py-4 text-center">
											<Check className="h-6 w-6 text-green-600 mx-auto" />
										</td>
										<td class="px-6 py-4 text-center">
											<X className="h-6 w-6 text-red-500 mx-auto" />
										</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</section>

			<!-- Pricing Plans -->
			<section class="py-16 bg-gradient-to-br from-gray-50 to-blue-50">
				<div class="container mx-auto px-4">
					<h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 mb-4">
						Planes y precios
					</h2>
					<p class="text-xl text-gray-600 text-center mb-12">
						Empieza gratis y actualiza cuando necesites más funciones
					</p>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
						<!-- Plan Gratis -->
						<div class="bg-white rounded-2xl shadow-lg p-8 border-2 border-gray-200">
							<h3 class="text-2xl font-bold text-gray-900 mb-4">Gratis</h3>
							<div class="text-4xl font-bold text-gray-900 mb-6">$0<span class="text-lg text-gray-600">/mes</span></div>
							<ul class="space-y-3 mb-8">
								<li class="flex items-center">
									<Check className="h-5 w-5 text-green-500 mr-3" />
									<span>Menú básico con código QR</span>
								</li>
								<li class="flex items-center">
									<Check className="h-5 w-5 text-green-500 mr-3" />
									<span>Visible en Google</span>
								</li>
								<li class="flex items-center">
									<Check className="h-5 w-5 text-green-500 mr-3" />
									<span>Enlaces externos</span>
								</li>
								<li class="flex items-center text-gray-500">
									<X className="h-5 w-5 text-red-500 mr-3" />
									<span>Incluye marca BySMax</span>
								</li>
							</ul>
							<a
								href="/contact"
								class="w-full bg-gray-600 text-white py-3 px-6 rounded-lg font-semibold hover:bg-gray-700 transition-colors block text-center"
							>
								Empezar gratis
							</a>
						</div>

						<!-- Plan Pro -->
						<div class="bg-white rounded-2xl shadow-lg p-8 border-2 border-blue-500 relative">
							<div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
								<span class="bg-blue-500 text-white px-4 py-2 rounded-full text-sm font-semibold">Más Popular</span>
							</div>
							<h3 class="text-2xl font-bold text-gray-900 mb-4">Pro</h3>
							<div class="text-4xl font-bold text-blue-600 mb-6">$29<span class="text-lg text-gray-600">/mes</span></div>
							<ul class="space-y-3 mb-8">
								<li class="flex items-center">
									<Check className="h-5 w-5 text-green-500 mr-3" />
									<span>Todo del plan Gratis</span>
								</li>
								<li class="flex items-center">
									<Check className="h-5 w-5 text-green-500 mr-3" />
									<span>Sin marca BySMax</span>
								</li>
								<li class="flex items-center">
									<Check className="h-5 w-5 text-green-500 mr-3" />
									<span>Sin anuncios</span>
								</li>
								<li class="flex items-center">
									<Check className="h-5 w-5 text-green-500 mr-3" />
									<span>Botones WhatsApp y delivery</span>
								</li>
								<li class="flex items-center">
									<Check className="h-5 w-5 text-green-500 mr-3" />
									<span>Analytics básicos</span>
								</li>
							</ul>
							<a
								href="/contact"
								class="w-full bg-blue-600 text-white py-3 px-6 rounded-lg font-semibold hover:bg-blue-700 transition-colors block text-center"
							>
								Empezar Pro
							</a>
						</div>

						<!-- Plan Plus -->
						<div class="bg-white rounded-2xl shadow-lg p-8 border-2 border-purple-500">
							<h3 class="text-2xl font-bold text-gray-900 mb-4">Plus</h3>
							<div class="text-4xl font-bold text-purple-600 mb-6">$49<span class="text-lg text-gray-600">/mes</span></div>
							<ul class="space-y-3 mb-8">
								<li class="flex items-center">
									<Check className="h-5 w-5 text-green-500 mr-3" />
									<span>Todo del plan Pro</span>
								</li>
								<li class="flex items-center">
									<Check className="h-5 w-5 text-green-500 mr-3" />
									<span>IA recomendadora</span>
								</li>
								<li class="flex items-center">
									<Check className="h-5 w-5 text-green-500 mr-3" />
									<span>Integración delivery</span>
								</li>
								<li class="flex items-center">
									<Check className="h-5 w-5 text-green-500 mr-3" />
									<span>Sistema de reservaciones</span>
								</li>
								<li class="flex items-center">
									<Check className="h-5 w-5 text-green-500 mr-3" />
									<span>Soporte prioritario</span>
								</li>
							</ul>
							<a
								href="/contact"
								class="w-full bg-purple-600 text-white py-3 px-6 rounded-lg font-semibold hover:bg-purple-700 transition-colors block text-center"
							>
								Empezar Plus
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Testimonials Section -->
			<section class="py-16 bg-white">
				<div class="container mx-auto px-4">
					<h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 mb-12">
						Casos de éxito
					</h2>
					<div class="max-w-4xl mx-auto">
						<div class="bg-gradient-to-br from-blue-50 to-indigo-100 rounded-2xl p-8 text-center">
							<div class="flex justify-center mb-6">
								<Star className="h-6 w-6 text-yellow-400 fill-current" />
								<Star className="h-6 w-6 text-yellow-400 fill-current" />
								<Star className="h-6 w-6 text-yellow-400 fill-current" />
								<Star className="h-6 w-6 text-yellow-400 fill-current" />
								<Star className="h-6 w-6 text-yellow-400 fill-current" />
							</div>
							<blockquote class="text-xl md:text-2xl text-gray-700 mb-6 italic">
								"Mi menú ahora aparece en Google y mis clientes piden más rápido. 
								El sistema de IA recomienda platillos y hemos aumentado las ventas un 30%."
							</blockquote>
							<cite class="text-lg font-semibold text-gray-900">— Dueño de Campomar</cite>
							<div class="mt-6">
								<a 
									href="/menus/campomar" 
									class="inline-flex items-center text-blue-600 font-medium hover:text-blue-700"
								>
									Ver su menú
									<ArrowRight className="ml-2 h-4 w-4" />
								</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- FAQ Section -->
			<section class="py-16 bg-gray-50">
				<div class="container mx-auto px-4">
					<h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 mb-12">
						Preguntas frecuentes
					</h2>
					<div class="max-w-3xl mx-auto space-y-6">
						<div class="bg-white rounded-lg shadow-md p-6">
							<h3 class="text-xl font-semibold text-gray-900 mb-3 flex items-center">
								¿Por qué mi menú se ve en Google?
								<ChevronDown className="ml-2 h-5 w-5" />
							</h3>
							<p class="text-gray-600">
								A diferencia de los PDFs o imágenes, nuestros menús son páginas web reales indexadas por Google. 
								Esto significa que aparecen en resultados de búsqueda cuando la gente busca tu restaurante.
							</p>
						</div>
						<div class="bg-white rounded-lg shadow-md p-6">
							<h3 class="text-xl font-semibold text-gray-900 mb-3 flex items-center">
								¿Cómo funciona la IA recomendadora?
								<ChevronDown className="ml-2 h-5 w-5" />
							</h3>
							<p class="text-gray-600">
								Nuestra IA analiza las preferencias del cliente y sugiere platillos personalizados, 
								aumentando la satisfacción y las ventas promedio por mesa.
							</p>
						</div>
						<div class="bg-white rounded-lg shadow-md p-6">
							<h3 class="text-xl font-semibold text-gray-900 mb-3 flex items-center">
								¿Puedo integrar delivery o reservaciones?
								<ChevronDown className="ml-2 h-5 w-5" />
							</h3>
							<p class="text-gray-600">
								Sí, con nuestro plan Plus puedes integrar sistemas de delivery como Uber Eats, 
								y un sistema de reservaciones directo desde tu menú.
							</p>
						</div>
						<div class="bg-white rounded-lg shadow-md p-6">
							<h3 class="text-xl font-semibold text-gray-900 mb-3 flex items-center">
								¿Cómo cambio precios o fotos?
								<ChevronDown className="ml-2 h-5 w-5" />
							</h3>
							<p class="text-gray-600">
								Desde tu panel de administración puedes actualizar precios, fotos y descripciones en tiempo real. 
								Los cambios se reflejan inmediatamente sin necesidad de reimprimir códigos QR.
							</p>
						</div>
						<div class="bg-white rounded-lg shadow-md p-6">
							<h3 class="text-xl font-semibold text-gray-900 mb-3 flex items-center">
								¿Puedo subir mi menú sin publicidad?
								<ChevronDown className="ml-2 h-5 w-5" />
							</h3>
							<p class="text-gray-600">
								Con nuestro plan Pro eliminas completamente la publicidad y la marca BySMax, 
								ofreciendo una experiencia 100% profesional a tus clientes.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Final CTA -->
			<section class="py-20 bg-gradient-to-br from-blue-600 to-indigo-700 text-white">
				<div class="container mx-auto px-4 text-center">
					<h2 class="text-3xl md:text-5xl font-bold mb-6">
						¿Listo para modernizar tu menú?
					</h2>
					<p class="text-xl md:text-2xl mb-10 max-w-3xl mx-auto opacity-90">
						Únete a cientos de restaurantes que ya transformaron su experiencia digital. 
						Crea tu menú ahora, gratis y sin complicaciones.
					</p>
					<div class="flex flex-col sm:flex-row gap-4 justify-center">
						<a
							href="/contact"
							class="inline-flex items-center px-8 py-4 bg-white text-blue-600 text-lg font-semibold rounded-lg hover:bg-gray-100 transition-colors shadow-lg"
						>
							Crear menú gratis
							<ArrowRight className="ml-2 h-5 w-5" />
						</a>
						<a
							href="/menus"
							class="inline-flex items-center px-8 py-4 border-2 border-white text-white text-lg font-semibold rounded-lg hover:bg-white hover:text-blue-600 transition-colors"
						>
							Ver ejemplos
						</a>
					</div>
				</div>
			</section>
		</main>
	</div>
</RestaurantLayout>