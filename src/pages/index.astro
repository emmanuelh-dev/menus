---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import menu from "./menu.jpg";
import main_menu from "./phone_with_menu.png";
import {
	Utensils,
	QrCode,
	Smartphone,
	Clock,
	Zap,
	ArrowRight,
	Check,
	X,
	Search,
	Star,
	Globe,
	Settings,
	ChevronDown,
	Users,
	Trophy,
} from "lucide-react";

import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { Image } from "astro:assets";
import DefaultLayout from "../layouts/DefaultLayout.astro";

const restaurantData = {
	name: "Menús Digitales para Restaurantes | Crea tu Menú QR Gratis",
	description:
		"Crea tu menú digital GRATIS con código QR en 5 minutos. La mejor plataforma de menús digitales en Monterrey y todo México. Sin comisiones, sin anuncios. Visible en Google.",
	keywords:
		"menús digitales, menú digital para restaurantes, crear menú digital, menú qr gratis, carta digital qr méxico, menús digitales monterrey",
};

const mainSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "BySMax Menús Digitales",
	operatingSystem: "Web",
	applicationCategory: "BusinessApplication",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "MXN",
	},
	description: restaurantData.description,
	aggregateRating: {
		"@type": "AggregateRating",
		ratingValue: "4.9",
		reviewCount: "10000",
	},
};
---

<DefaultLayout
	title={restaurantData.name}
	description={restaurantData.description}
	keywords={restaurantData.keywords}
	showAds={false}
	schema={mainSchema}
>
	<div>
		<main class="flex-1">
			<!-- Hero Section -->
			<section class="py-24 md:py-32 bg-white relative overflow-hidden">
				<div
					class="absolute inset-0 bg-gradient-to-br from-slate-50/50 via-white to-emerald-50/30"
				>
				</div>
				<div class="max-w-4xl mx-auto px-6 text-center relative">
					<div
						class="bg-gradient-to-r from-emerald-50 to-slate-50 border border-emerald-200/60 rounded-2xl px-6 py-3 inline-block mb-8 backdrop-blur-sm shadow-sm"
					>
						<p class="text-sm font-medium text-emerald-800">
							GRATIS Y SIN COMISIÓN - Con la confianza de +10,000 restaurantes
						</p>
					</div>
					<h1
						class="text-4xl md:text-6xl font-semibold text-slate-900 mb-6 tracking-tight leading-[1.1]"
					>
						Los Mejores <span
							class="bg-gradient-to-r from-emerald-600 via-emerald-500 to-teal-600 bg-clip-text text-transparent font-bold"
							>Menús Digitales</span
						> con Código QR para Restaurantes
					</h1>
					<p
						class="text-xl text-slate-600 mb-10 max-w-2xl mx-auto leading-relaxed font-medium"
					>
						Crea tu <strong>menú digital</strong> profesional en 5 minutos. La solución
						líder en <strong>Monterrey</strong> y todo <strong>México</strong> para
						digitalizar tu carta GRATIS.
					</p><div class="flex flex-col sm:flex-row gap-4 justify-center mb-10">
						<a
							href="/admin/register"
							class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-slate-900 to-slate-800 text-white font-semibold rounded-2xl hover:from-slate-800 hover:to-slate-700 transition-all duration-300 shadow-xl shadow-slate-900/25 text-lg border border-slate-800"
						>
							🚀 ¡Crea tu Menú GRATIS!
							<ArrowRight className="ml-2 h-5 w-5" />
						</a>
						<a
							href="/menus"
							class="inline-flex items-center px-8 py-4 border border-slate-200 text-slate-700 font-medium rounded-2xl hover:border-slate-300 hover:bg-slate-50 transition-all duration-300 bg-white text-lg shadow-sm"
						>
							Ver Casos de Éxito
						</a>
					</div>
					<div
						class="flex justify-center items-center gap-8 mb-16 text-sm text-slate-600"
					>
						<div class="flex items-center">
							<div class="w-2 h-2 bg-emerald-500 rounded-full mr-2 shadow-sm">
							</div>
							Sin comisiones
						</div>
						<div class="flex items-center">
							<div class="w-2 h-2 bg-slate-500 rounded-full mr-2 shadow-sm">
							</div>
							Sin anuncios
						</div>
						<div class="flex items-center">
							<div class="w-2 h-2 bg-emerald-400 rounded-full mr-2 shadow-sm">
							</div>
							Listo en 5 minutos
						</div>
					</div>
					<div class="max-w-md mx-auto">
						<div class="relative">
							<div
								class="absolute inset-0 bg-gradient-to-r from-emerald-500/20 to-slate-500/20 rounded-2xl blur-2xl"
							>
							</div>
							<Image
								src={main_menu}
								alt="Menú digital con código QR gratis para restaurantes - BySMax"
								class="relative w-full rounded-2xl border border-slate-200 shadow-2xl"
							/>
						</div>
					</div>
				</div>
			</section><!-- Benefits Section -->
			<section class="py-24 bg-slate-50/50">
				<div class="max-w-6xl mx-auto px-6">
					<h2
						class="text-3xl font-semibold text-slate-900 text-center mb-4 tracking-tight"
					>
						¿Por qué más de 10,000 restaurantes eligen BySMax?
					</h2>
					<p class="text-slate-600 text-center mb-16 font-medium">
						Aprovecha la última generación de menús digitales para recibir
						pedidos sin intermediarios
					</p>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
						<div class="text-center group">
							<div
								class="w-14 h-14 rounded-2xl bg-emerald-50 border border-emerald-200/60 flex items-center justify-center mx-auto mb-6 group-hover:bg-emerald-100 transition-colors duration-300 shadow-sm"
							>
								<span class="text-2xl">💰</span>
							</div>
							<h3 class="text-lg font-semibold text-slate-900 mb-3">
								Maximiza tus márgenes
							</h3>
							<p class="text-sm text-slate-600 leading-relaxed">
								¡Ahorra las comisiones de los aplicativos de delivery abriendo
								tu propio canal de entrega!
							</p>
						</div>
						<div class="text-center group">
							<div
								class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-200/60 flex items-center justify-center mx-auto mb-6 group-hover:bg-slate-100 transition-colors duration-300 shadow-sm"
							>
								<span class="text-2xl">🚀</span>
							</div>
							<h3 class="text-lg font-semibold text-slate-900 mb-3">
								Gana tiempo con cada pedido
							</h3>
							<p class="text-sm text-slate-600 leading-relaxed">
								Recibe tus pedidos sin tardar en largas llamadas telefónicas
							</p>
						</div>
						<div class="text-center group">
							<div
								class="w-14 h-14 rounded-2xl bg-emerald-50 border border-emerald-200/60 flex items-center justify-center mx-auto mb-6 group-hover:bg-emerald-100 transition-colors duration-300 shadow-sm"
							>
								<span class="text-2xl">❤️</span>
							</div>
							<h3 class="text-lg font-semibold text-slate-900 mb-3">
								Incrementa la fidelidad
							</h3>
							<p class="text-sm text-slate-600 leading-relaxed">
								Usa tus descuentos y programa de fidelidad para fidelizar
								clientes
							</p>
						</div>
						<div class="text-center group">
							<div
								class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-200/60 flex items-center justify-center mx-auto mb-6 group-hover:bg-slate-100 transition-colors duration-300 shadow-sm"
							>
								<Search className="h-6 w-6 text-slate-700" />
							</div>
							<h3 class="text-lg font-semibold text-slate-900 mb-3">
								Visible en Google
							</h3>
							<p class="text-sm text-slate-600 leading-relaxed">
								Tu menú aparece en resultados de búsqueda y aumenta tu
								visibilidad online
							</p>
						</div>
					</div>
					<!-- CTA Banner -->
					<div
						class="mt-16 bg-gradient-to-r from-emerald-500/10 via-slate-50 to-emerald-500/10 border border-emerald-200/30 rounded-2xl p-8 text-center backdrop-blur-sm"
					>
						<h3 class="text-2xl font-semibold mb-4 text-slate-900">
							🎯 Permite a tus clientes usar tu menú digital para pedir
							directamente a ti
						</h3>
						<p class="text-lg mb-6 text-slate-600 font-medium">
							Sin intermediarios • Sin comisiones • Sin anuncios
						</p>
						<a
							href="/admin/dashboard"
							class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-slate-900 to-slate-800 text-white font-semibold rounded-2xl hover:from-slate-800 hover:to-slate-700 transition-all duration-300 shadow-lg text-lg border border-slate-800"
						>
							¡Empezar GRATIS Ahora!
							<ArrowRight className="ml-2 h-5 w-5" />
						</a>
					</div>
				</div>
			</section>
			<section class="py-24 bg-slate-50/50">
				<div class="max-w-4xl mx-auto px-6">
					<h2
						class="text-3xl font-semibold text-slate-900 text-center mb-4 tracking-tight"
					>
						BySMax Menús vs Competencia
					</h2>
					<p class="text-slate-600 text-center mb-16 font-medium">
						Conoce las diferencias que nos hacen únicos
					</p>
					<div
						class="bg-white rounded-2xl border border-slate-200/60 overflow-hidden shadow-sm"
					>
						<table class="w-full">
							<thead class="bg-slate-50/50 border-b border-slate-200/60">
								<tr>
									<th class="px-6 py-4 text-left font-semibold text-slate-900"
										>Funcionalidad</th
									>
									<th class="px-6 py-4 text-center font-semibold text-slate-900"
										>BySMax Menús</th
									>
									<th class="px-6 py-4 text-center font-semibold text-slate-600"
										>Otros</th
									>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-200/60">
								<tr>
									<td class="px-6 py-4 text-sm text-slate-900 font-medium"
										>Sin anuncios</td
									>
									<td class="px-6 py-4 text-center">
										<Check className="h-5 w-5 text-emerald-600 mx-auto" />
									</td>
									<td class="px-6 py-4 text-center">
										<X className="h-5 w-5 text-slate-400 mx-auto" />
									</td>
								</tr>
								<tr class="bg-slate-50/30">
									<td class="px-6 py-4 text-sm text-slate-900 font-medium"
										>Visible en Google</td
									>
									<td class="px-6 py-4 text-center">
										<Check className="h-5 w-5 text-emerald-600 mx-auto" />
									</td>
									<td class="px-6 py-4 text-center">
										<X className="h-5 w-5 text-slate-400 mx-auto" />
									</td>
								</tr>
								<tr>
									<td class="px-6 py-4 text-sm text-slate-900 font-medium"
										>Diseño optimizado</td
									>
									<td class="px-6 py-4 text-center">
										<Check className="h-5 w-5 text-emerald-600 mx-auto" />
									</td>
									<td class="px-6 py-4 text-center">
										<X className="h-5 w-5 text-slate-400 mx-auto" />
									</td>
								</tr>
								<tr class="bg-slate-50/30">
									<td class="px-6 py-4 text-sm text-slate-900 font-medium"
										>IA para recomendar</td
									>
									<td class="px-6 py-4 text-center">
										<Check className="h-5 w-5 text-emerald-600 mx-auto" />
									</td>
									<td class="px-6 py-4 text-center">
										<X className="h-5 w-5 text-slate-400 mx-auto" />
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</section>
			<!-- Pricing Plans -->
			<section class="py-24 bg-white">
				<div class="max-w-6xl mx-auto px-6">
					<h2
						class="text-3xl font-semibold text-slate-900 text-center mb-4 tracking-tight"
					>
						Planes para tu menú digital con código QR
					</h2>
					<p class="text-slate-600 text-center mb-12 font-medium">
						Precios claros, sin letras chiquitas ni comisiones ocultas
					</p>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
						<!-- Plan Gratis -->
						<div
							class="bg-white rounded-3xl border border-slate-200/60 p-8 shadow-sm hover:shadow-md transition-all duration-300"
						>
							<div class="mb-6 text-center">
								<h3
									class="text-lg font-bold text-slate-900 mb-1 uppercase tracking-tight"
								>
									Básico
								</h3>
								<div class="flex items-baseline justify-center gap-1">
									<span class="text-3xl font-bold text-slate-900">$0</span>
									<span class="text-slate-400 font-bold uppercase text-[9px]"
										>MXN / MES</span
									>
								</div>
							</div>
							<ul class="space-y-3 mb-8">
								<li
									class="flex items-center text-sm font-medium text-slate-600"
								>
									<Check className="h-4 w-4 text-emerald-500 mr-2" />
									Menú Digital Ilimitado
								</li>
								<li
									class="flex items-center text-sm font-medium text-slate-600"
								>
									<Check className="h-4 w-4 text-emerald-500 mr-2" />
									Código QR Personalizado
								</li>
								<li
									class="flex items-center text-sm font-medium text-slate-600"
								>
									<Check className="h-4 w-4 text-emerald-500 mr-2" />
									Fotos y Precios Editables
								</li>
								<li
									class="flex items-center text-sm font-medium text-slate-600"
								>
									<Check className="h-4 w-4 text-emerald-500 mr-2" />
									Sin Anuncios Externos
								</li>
								<li
									class="flex items-center text-sm font-medium text-slate-300 italic"
								>
									<X className="h-3 w-3 mr-2" />
									Sin Pedidos WhatsApp
								</li>
							</ul>
							<a
								href="/admin/register"
								class="w-full bg-slate-50 text-slate-900 py-3 rounded-xl font-bold uppercase text-[10px] tracking-wider hover:bg-slate-100 transition-all block text-center border border-slate-200"
							>
								¡Empezar!
							</a>
						</div>

						<!-- Plan WhatsApp -->
						<div
							class="bg-white rounded-3xl border-2 border-emerald-500 p-8 relative shadow-lg shadow-emerald-500/5"
						>
							<div
								class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-emerald-500 text-white px-4 py-1 rounded-full text-[9px] font-black uppercase tracking-wider"
							>
								Más Popular
							</div>
							<div class="mb-6 text-center">
								<h3
									class="text-lg font-bold text-slate-900 mb-1 uppercase tracking-tight"
								>
									WhatsApp Lite
								</h3>
								<div class="flex items-baseline justify-center gap-1">
									<span class="text-3xl font-bold text-slate-900">$99</span>
									<span class="text-slate-400 font-bold uppercase text-[9px]"
										>MXN / MES</span
									>
								</div>
							</div>
							<ul class="space-y-3 mb-8">
								<li class="flex items-center text-sm font-bold text-slate-800">
									<Check className="h-4 w-4 text-emerald-500 mr-2" />
									Pedidos por WhatsApp
								</li>
								<li class="flex items-center text-sm font-bold text-slate-800">
									<Check className="h-4 w-4 text-emerald-500 mr-2" />
									Carrito de Compras
								</li>
								<li class="flex items-center text-sm font-bold text-slate-800">
									<Check className="h-4 w-4 text-emerald-500 mr-2" />
									Marca de BySMax
								</li>
								<li class="flex items-center text-sm font-bold text-slate-800">
									<Check className="h-4 w-4 text-emerald-500 mr-2" />
									Limitado a una sucursal
								</li>
							</ul>
							<a
								href="/admin/register"
								class="w-full bg-emerald-500 text-white py-3.5 rounded-xl font-bold uppercase text-[10px] tracking-wider hover:bg-emerald-600 transition-all block text-center shadow-md shadow-emerald-500/20"
							>
								🚀 ¡Vende por WhatsApp!
							</a>
						</div>

						<!-- Plan Pro -->
						<div class="bg-slate-900 rounded-3xl p-8 shadow-xl">
							<div class="mb-6 text-center">
								<h3
									class="text-lg font-bold text-white mb-1 uppercase tracking-tight"
								>
									WhatsApp Pro
								</h3>
								<div class="flex items-baseline justify-center gap-1">
									<span class="text-3xl font-bold text-white">$199</span>
									<span class="text-slate-400 font-bold uppercase text-[9px]"
										>MXN / MES</span
									>
								</div>
							</div>
							<ul class="space-y-3 mb-8">
								<li
									class="flex items-center text-sm font-medium text-slate-300"
								>
									<Check className="h-4 w-4 text-emerald-400 mr-2" />
									Sin marca de BySMax
								</li>
								<li
									class="flex items-center text-sm font-medium text-slate-300"
								>
									<Check className="h-4 w-4 text-emerald-400 mr-2" />
									Múltiples sucursales
								</li>
								<li
									class="flex items-center text-sm font-medium text-slate-300"
								>
									<Check className="h-4 w-4 text-emerald-400 mr-2" />
									Dominio personalizado
								</li>
							</ul>
							<a
								href="/admin/register"
								class="w-full bg-white/10 text-white py-3 rounded-xl font-bold uppercase text-[10px] tracking-wider hover:bg-white/20 transition-all block text-center border border-white/20"
							>
								🚀 ¡Plan Pro!
							</a>
						</div>

						<!-- Plan Asistido -->
						<div
							class="bg-white rounded-3xl border border-slate-200/60 p-8 shadow-sm hover:shadow-md transition-all duration-300"
						>
							<div class="mb-6 text-center">
								<h3
									class="text-lg font-bold text-slate-900 mb-1 uppercase tracking-tight"
								>
									Plan Asistido
								</h3>
								<div class="flex items-baseline justify-center gap-1">
									<span class="text-3xl font-bold text-slate-900">$299</span>
									<span class="text-slate-400 font-bold uppercase text-[9px]"
										>UN PAGO</span
									>
								</div>
							</div>
							<ul class="space-y-3 mb-8">
								<li
									class="flex items-center text-sm font-medium text-slate-600"
								>
									<Check className="h-4 w-4 text-emerald-500 mr-2" />
									Damos de alta tus platillos
								</li>
								<li
									class="flex items-center text-sm font-medium text-slate-600"
								>
									<Check className="h-4 w-4 text-emerald-500 mr-2" />
									Configuración completa
								</li>
								<li
									class="flex items-center text-sm font-medium text-slate-600"
								>
									<Check className="h-4 w-4 text-emerald-500 mr-2" />
									Asistencia Personalizada
								</li>
								<li
									class="flex items-center text-sm font-medium text-slate-600"
								>
									<Check className="h-4 w-4 text-emerald-500 mr-2" />
									Limitado a una sucursal
								</li>
							</ul>
							<a
								href="https://wa.me/528111913676"
								target="_blank"
								class="w-full bg-slate-900 text-white py-3 rounded-xl font-bold uppercase text-[10px] tracking-wider hover:bg-slate-800 transition-all block text-center"
							>
								🎯 ¡Lo hacemos por ti!
							</a>
						</div>
					</div>

					<!-- Trust indicators -->
					<div class="mt-12 text-center">
						<p class="text-sm text-slate-600 mb-4 font-medium">
							🔒 Aprobado por Google y Facebook • ✅ +10,000 restaurantes
							confían en nosotros
						</p>
						<div
							class="flex justify-center items-center gap-4 text-xs text-slate-500"
						>
							<span>Sin compromiso</span>
							<span>•</span>
							<span>Cancela cuando quieras</span>
							<span>•</span>
							<span>Soporte incluido</span>
						</div>
