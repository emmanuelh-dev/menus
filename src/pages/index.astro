---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import HeroSection from "../components/landing/HeroSection.astro";
import TrustShowcase from "../components/landing/TrustShowcase.astro";
import HowItWorks from "../components/landing/HowItWorks.astro";
import FeaturesGrid from "../components/landing/FeaturesGrid.astro";
import IndustriesSection from "../components/landing/IndustriesSection.astro";
import FAQSection from "../components/landing/FAQSection.astro";
import FinalCTA from "../components/landing/FinalCTA.astro";
import { Zap } from "lucide-react";

const pageData = {
	title: "Menú Digital QR y Pedidos por WhatsApp | Carta QR para Restaurantes",
	description:
		"Crea tu menú digital QR GRATIS. Recibe pedidos por WhatsApp, gestiona tu inventario y vende más sin pagar comisiones. La mejor carta digital en México.",
};
---

<DefaultLayout title={pageData.title} description={pageData.description}>
	<main class="overflow-x-hidden">
		<HeroSection />

		<TrustShowcase />

		<IndustriesSection />

		<HowItWorks />

		<FeaturesGrid />

		<FAQSection />

		<!-- Partners / Badges -->
		<section class="py-20 bg-slate-50 border-t border-slate-100">
			<div class="max-w-7xl mx-auto px-6 text-center">
				<p
					class="text-[10px] font-black uppercase tracking-[0.4em] text-slate-400 mb-10"
				>
					Respaldados por
				</p>
				<div
					class="flex flex-wrap justify-center items-center gap-12 opacity-50 contrast-125 grayscale"
				>
					<div
						class="flex items-center gap-2 font-black text-2xl tracking-tighter uppercase italic"
					>
						<Zap className="w-6 h-6 text-emerald-500" /> Cloud partner
					</div>
					<div class="font-black text-2xl tracking-tighter uppercase italic">
						Startup Grind
					</div>
					<div class="font-black text-2xl tracking-tighter uppercase italic">
						SMAX DIGITAL
					</div>
				</div>
			</div>
		</section>

		<FinalCTA />
	</main>
</DefaultLayout>
