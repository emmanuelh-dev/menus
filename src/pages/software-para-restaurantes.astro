---
import {
	Utensils,
	Smartphone,
	Monitor,
	LayoutDashboard,
	Globe,
	QrCode,
	Zap,
	Check,
	ArrowRight,
	Star,
	Users,
	ChefHat,
	Receipt,
	BarChart3,
	Package,
} from "lucide-react";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import { Image } from "astro:assets";
import main_menu from "./phone_with_menu.png";

const seoData = {
	title:
		"Software para Restaurantes, Bares y Cafés | Gestión Integral | BySMax",
	description:
		"La solución completa para tu negocio gastronómico. Punto de venta, pedidos en línea, monitor de cocina y control de inventarios. Sin comisión por pedido.",
	keywords:
		"software restaurantes, pos para bares, sistema para cafeterias, monitor de cocina kds, control de inventarios restaurantes",
};

const features = [
	{
		title: "Venta Online",
		description:
			"Impulsa tus domicilios y simplifica tus cobros con canales integrados.",
		items: [
			"Tienda Online",
			"Carta QR",
			"Integraciones con Delivery",
			"API para integraciones",
		],
		icon: Globe,
		color: "text-neutral-600",
		bgColor: "bg-neutral-50",
	},
	{
		title: "Servicio Eficiente",
		description:
			"Reduce tiempos de espera con nuestro Monitor de Cocina (KDS).",
		items: [
			"Carga de pedidos instantánea",
			"Visualización de comandas",
			"Gestión de tiempos",
			"Alertas de preparación",
		],
		icon: ChefHat,
		color: "text-marca-600",
		bgColor: "bg-marca-50",
	},
	{
		title: "Mejores Resultados",
		description:
			"Información clave para tomar decisiones acertadas en tu negocio.",
		items: [
			"Registro de ventas",
			"Control de gastos",
			"Gestión de stock",
			"Reportes detallados",
		],
		icon: BarChart3,
		color: "text-neutral-600",
		bgColor: "bg-neutral-50",
	},
];

const advantages = [
	{
		title: "Simple y moderno",
		desc: "Interfaz amigable y fácil de usar diseñada para el ritmo real de un restaurante.",
		icon: "✨",
	},
	{
		title: "Flexible",
		desc: "Funciona en cualquier dispositivo: Windows, MAC, Linux, iOS o Android.",
		icon: "📱",
	},
	{
		title: "On-line",
		desc: "Sin instalaciones complejas. Accede desde cualquier lugar en tiempo real.",
		icon: "☁️",
	},
];
---

<DefaultLayout
	title={seoData.title}
	description={seoData.description}
	keywords={seoData.keywords}
	showAds={false}
>
	<main class="flex-1">
		<!-- Hero Section -->
		<section class="relative py-20 lg:py-32 overflow-hidden bg-white">
			<div
				class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_70%,transparent_100%)]"
			>
			</div>

			<div class="max-w-7xl mx-auto px-6 relative">
				<div class="flex flex-col lg:flex-row items-center gap-16">
					<div class="flex-1 text-center lg:text-left">
						<div
							class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-marca-50 border border-marca-100 mb-6"
						>
							<span class="relative flex h-2 w-2">
								<span
									class="animate-ping absolute inline-flex h-full w-full rounded-full bg-marca-400 opacity-75"
								></span>
								<span
									class="relative inline-flex rounded-full h-2 w-2 bg-marca-500"
								></span>
							</span>
							<span
								class="text-xs font-bold text-marca-800 uppercase tracking-wider"
								>Nuevo: Monitor de Cocina Inteligente</span
							>
						</div>

						<h1
							class="text-5xl lg:text-7xl font-black text-neutral-900 mb-6 leading-[1.1] tracking-tight"
						>
							Software para <br />
							<span
								class="text-marca-600"
								>Restaurantes.</span
							>
						</h1>

						<p
							class="text-xl text-neutral-600 mb-10 leading-relaxed max-w-xl mx-auto lg:mx-0"
						>
							Encárgate de la comida. <strong class="text-neutral-900"
								>BySMax</strong
							> resuelve los pedidos y la administración de tu negocio.
						</p>

						<div
							class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
						>
							<a
								href="https://admin-menus.bysmax.com"
								class="inline-flex items-center justify-center px-8 py-4 bg-neutral-900 text-white font-bold rounded-2xl hover:bg-neutral-800 transition-all shadow-xl shadow-neutral-900/20 group"
							>
								Empezar ahora
								<ArrowRight
									className="ml-2 h-5 w-5 group-hover:translate-x-1 transition-transform"
								/>
							</a>
							<div
								class="flex flex-col items-center lg:items-start justify-center px-4"
							>
								<span class="text-sm font-bold text-neutral-900"
									>Desde USD $30/mes</span
								>
								<span class="text-xs text-neutral-500"
									>Sin contratos forzosos</span
								>
							</div>
						</div>
					</div>

					<div class="flex-1 relative w-full max-w-2xl">
						<div
							class="bg-marca-500/10 absolute -inset-4 blur-3xl rounded-full"
						>
						</div>
						<div
							class="relative bg-white rounded-3xl border border-neutral-200 shadow-2xl overflow-hidden"
						>
							<div
								class="flex items-center gap-2 px-4 py-3 border-b border-neutral-100 bg-neutral-50/50"
							>
								<div class="flex gap-1.5">
									<div class="w-3 h-3 rounded-full bg-neutral-200"></div>
									<div class="w-3 h-3 rounded-full bg-neutral-200"></div>
									<div class="w-3 h-3 rounded-full bg-neutral-200"></div>
								</div>
								<div class="mx-auto text-[10px] font-medium text-neutral-400">
									app.bysmax.com
								</div>
							</div>
							<Image
								src={main_menu}
								alt="Software Dashboard"
								class="w-full h-auto"
							/>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Solutions Grid -->
		<section class="py-24 bg-neutral-50">
			<div class="max-w-7xl mx-auto px-6">
				<div class="text-center max-w-3xl mx-auto mb-20">
					<h2 class="text-3xl lg:text-5xl font-black text-neutral-900 mb-6">
						Una única solución para cualquier negocio.
					</h2>
					<p class="text-lg text-neutral-600">
						¿Tienes un restaurante, pizzería, bar, café, foodtruck o dark
						kitchen? BySMax se hace cargo.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{
						features.map((f) => (
							<div class="bg-white p-8 rounded-[32px] border border-neutral-200 shadow-sm hover:shadow-xl transition-all duration-300 group">
								<div
									class={`w-14 h-14 ${f.bgColor} ${f.color} rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform`}
								>
									<f.icon className="w-7 h-7" />
								</div>
								<h3 class="text-2xl font-bold text-neutral-900 mb-4">
									{f.title}
								</h3>
								<p class="text-neutral-600 mb-8">{f.description}</p>
								<ul class="space-y-3">
									{f.items.map((item) => (
										<li class="flex items-center gap-3 text-sm font-medium text-neutral-700">
											<Check className="w-4 h-4 text-marca-500" />
											{item}
										</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Mobile Management -->
		<section class="py-24 overflow-hidden">
			<div class="max-w-7xl mx-auto px-6">
				<div class="flex flex-col lg:flex-row items-center gap-20">
					<div class="flex-1 order-2 lg:order-1">
						<div class="relative">
							<div
								class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-marca-500/5 blur-[120px] rounded-full"
							>
							</div>
							<Image
								src={main_menu}
								alt="Mobile App"
								class="relative mx-auto max-w-[300px] shadow-2xl rounded-[40px] border-[8px] border-neutral-900"
							/>
						</div>
					</div>

					<div class="flex-1 order-1 lg:order-2">
						<h2
							class="text-4xl lg:text-5xl font-black text-neutral-900 mb-8 leading-tight"
						>
							Gestiona tus pedidos desde tablets o smartphones.
						</h2>
						<p class="text-xl text-neutral-600 mb-10 leading-relaxed">
							Toma órdenes, emite comandas y cierra ventas, evitando los errores
							del lápiz y el papel también con nuestra aplicación móvil
							integrada.
						</p>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
							<div class="p-6 rounded-2xl bg-neutral-50 border border-neutral-100">
								<h4 class="font-bold text-neutral-900 mb-2">
									App para camareros
								</h4>
								<p class="text-sm text-neutral-500">
									Optimiza el flujo de servicio en mesa y reduce errores.
								</p>
							</div>
							<div class="p-6 rounded-2xl bg-neutral-50 border border-neutral-100">
								<h4 class="font-bold text-neutral-900 mb-2">
									App para comensales
								</h4>
								<p class="text-sm text-neutral-500">
									Permite que tus clientes pidan y paguen desde su mesa.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Advantages -->
		<section class="py-24 bg-neutral-900 text-white">
			<div class="max-w-7xl mx-auto px-6">
				<div class="text-center mb-20">
					<h2 class="text-3xl lg:text-5xl font-black mb-6">
						Un sistema de vanguardia
					</h2>
					<p class="text-neutral-400 text-lg">
						Diseñado para ser la pieza central de tu operación.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
					{
						advantages.map((adj) => (
							<div class="text-center">
								<div class="text-5xl mb-6">{adj.icon}</div>
								<h3 class="text-2xl font-bold mb-4">{adj.title}</h3>
								<p class="text-neutral-400 leading-relaxed">{adj.desc}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Testimonials -->
		<section class="py-24 bg-white">
			<div class="max-w-7xl mx-auto px-6">
				<div
					class="flex flex-col lg:flex-row items-end justify-between mb-16 gap-8"
				>
					<div class="max-w-2xl">
						<h2 class="text-3xl lg:text-5xl font-black text-neutral-900 mb-6">
							Más de 25.000 negocios nos eligen
						</h2>
						<p class="text-lg text-neutral-600 font-medium italic">
							"BySMax es el colaborador virtual perfecto para mi negocio"
						</p>
					</div>
					<div class="flex gap-4">
						<div
							class="px-6 py-4 bg-neutral-50 rounded-2xl border border-neutral-100"
						>
							<div class="text-2xl font-black text-neutral-900">4.9/5</div>
							<div
								class="text-xs font-bold text-neutral-400 uppercase tracking-widest"
							>
								Google Rating
							</div>
						</div>
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					<div
						class="p-10 rounded-[40px] bg-marca-50 border border-marca-100 relative"
					>
						<div class="text-neutral-400 flex gap-1 mb-6">
							{
								[...Array(5)].map(() => (
									<Star className="w-5 h-5 fill-current" />
								))
							}
						</div>
						<p
							class="text-xl text-marca-900 font-medium mb-8 leading-relaxed"
						>
							"BySMax es una plataforma completa para cualquier modelo de
							restaurante. Es fácil adaptarse. Siempre están agregando y
							actualizando herramientas. Simplemente nos encanta trabajar con
							ellos."
						</p>
						<div class="flex items-center gap-4">
							<div class="w-12 h-12 rounded-full bg-marca-200"></div>
							<div>
								<div class="font-bold text-marca-900">Jorge, Tin Tom</div>
								<div class="text-sm text-marca-700/60">
									Restaurante Gourmet
								</div>
							</div>
						</div>
					</div>

					<div
						class="p-10 rounded-[40px] bg-neutral-900 text-white relative overflow-hidden"
					>
						<div class="absolute top-0 right-0 p-8 opacity-10">
							<Zap className="w-32 h-32" />
						</div>
						<div class="text-marca-400 flex gap-1 mb-6">
							{
								[...Array(5)].map(() => (
									<Star className="w-5 h-5 fill-current" />
								))
							}
						</div>
						<p
							class="text-xl text-neutral-300 font-medium mb-8 leading-relaxed italic"
						>
							"Hemos reducido los tiempos de espera un 40% gracias al Monitor de
							Cocina. El control de stock automático nos ha ahorrado miles de
							pesos en mermas."
						</p>
						<div class="flex items-center gap-4 mt-auto">
							<div class="w-12 h-12 rounded-full bg-neutral-800"></div>
							<div>
								<div class="font-bold">Ana Valeria, La Central</div>
								<div class="text-sm text-neutral-500">Cadena de Cafeterías</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Final CTA -->
		<section class="py-24">
			<div class="max-w-5xl mx-auto px-6">
				<div
					class="bg-gradient-to-br from-neutral-900 to-neutral-800 rounded-[48px] p-12 lg:p-20 text-center relative overflow-hidden shadow-2xl"
				>
					<div
						class="absolute inset-0 bg-[radial-gradient(circle_at_50%_-20%,rgba(16,185,129,0.15),transparent)]"
					>
					</div>
					<h2 class="text-3xl lg:text-6xl font-black text-white mb-8 relative">
						Potencia tu negocio hoy mismo
					</h2>
					<p
						class="text-xl text-neutral-400 mb-12 max-w-2xl mx-auto relative leading-relaxed"
					>
						Únete a la nueva generación de restaurantes que ya están
						transformando su operación con tecnología de punta.
					</p>
					<div
						class="flex flex-col sm:flex-row items-center justify-center gap-6 relative"
					>
						<a
							href="https://admin-menus.bysmax.com"
							class="inline-flex items-center px-10 py-5 bg-marca-500 text-white font-black rounded-2xl hover:bg-marca-400 transition-all text-lg shadow-xl shadow-marca-500/20"
						>
							Empezar ahora
						</a>
						<a
							href="/precios"
							class="text-white font-bold hover:text-marca-400 transition-colors"
						>
							Ver planes y precios →
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</DefaultLayout>
