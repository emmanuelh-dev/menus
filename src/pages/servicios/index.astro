---
export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=31536000, stale-while-revalidate=86400'
);
Astro.response.headers.set('Vercel-Cache-Tag', 'places-all');

import ServiciosLayout from "../../layouts/ServiciosLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getAvailableServices } from "../../lib/services";

// Lista de servicios disponibles
const servicios = getAvailableServices();

const seoData = {
  title: 'Directorio de Servicios Locales en México 2026 | BySMax',
  description: 'Encuentra servicios locales de confianza cerca de ti: vulcanizadoras, plomeros, electricistas y más. Teléfonos verificados, servicio 24 horas y emergencias.',
  h1: 'Servicios Locales de Emergencia y Confianza',
};

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios' },
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoData.h1,
  "description": seoData.description,
  "url": Astro.url.toString(),
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": b.label,
      "item": b.href ? `https://menus.bysmax.com${b.href}` : undefined
    }))
  }
};
---

<ServiciosLayout
  title={seoData.title}
  description={seoData.description}
  canonical={Astro.url.toString()}
  schemaData={schemaData}
>
  <main class="bg-neutral-950 min-h-screen text-neutral-200">
    <!-- Hero -->
    <section class="bg-gradient-to-br from-orange-950/25 via-neutral-950 to-neutral-950 py-16 px-4 text-center">
      <div class="max-w-3xl mx-auto">
        <div class="inline-block bg-orange-500/10 text-orange-400 px-4 py-1.5 rounded-full text-xs font-bold tracking-wider mb-5">
          🛠️ Red de Profesionales
        </div>
        <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">{seoData.h1}</h1>
        <p class="text-neutral-400 text-base md:text-lg mb-8 max-w-2xl leading-relaxed mx-auto">
          Directorio verificado de técnicos y servicios de emergencia en México. 
          Encuentra profesionales disponibles las 24 horas cerca de ti con teléfono y ubicación en mapa.
        </p>

        <!-- Stats rápidas -->
        <div class="flex justify-center gap-8 md:gap-12">
          <div class="text-center">
            <span class="block text-xl md:text-2xl font-black text-orange-500 mb-0.5">24h</span>
            <span class="text-[10px] md:text-xs text-neutral-400 uppercase tracking-widest font-medium">Emergencias</span>
          </div>
          <div class="text-center">
            <span class="block text-xl md:text-2xl font-black text-orange-500 mb-0.5">100%</span>
            <span class="text-[10px] md:text-xs text-neutral-400 uppercase tracking-widest font-medium">Verificados</span>
          </div>
          <div class="text-center">
            <span class="block text-xl md:text-2xl font-black text-orange-500 mb-0.5">Gratuito</span>
            <span class="text-[10px] md:text-xs text-neutral-400 uppercase tracking-widest font-medium">Sin intermediarios</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumbs -->
    <div class="max-w-5xl mx-auto px-4 pt-6">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Servicios Grid -->
    <section class="max-w-5xl mx-auto px-4 py-12">
      <h2 class="text-2xl font-bold text-white mb-2">Nuestros Servicios Activos</h2>
      <p class="text-sm text-neutral-400 leading-relaxed mb-8">Selecciona la categoría de servicio que necesitas para encontrar profesionales locales.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {servicios.map(serv => (
          <a href={`/servicios/${serv.slug}`} class="flex items-start gap-4 p-5 bg-neutral-900/60 rounded-2xl hover:shadow-lg hover:shadow-orange-950/5 hover:-translate-y-0.5 transition duration-200 group">
            <div class="text-3xl shrink-0 p-3 bg-orange-500/5 rounded-xl group-hover:bg-orange-500/10 transition duration-200">{serv.emoji}</div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-bold text-white mb-1">{serv.title}</h3>
              <p class="text-xs text-neutral-400 leading-normal mb-3">
                Técnicos a domicilio, servicio de emergencia y presupuestos en tu localidad.
              </p>
              <span class="text-xs font-semibold text-orange-400 group-hover:text-white transition duration-200">Ver directorio →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ¿Cómo funciona? -->
    <section class="bg-neutral-900/30 py-12 px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-8 text-center">¿Por qué buscar en BySMax?</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center p-4">
            <div class="text-4xl mb-4">📞</div>
            <h3 class="text-base font-bold text-white mb-2">Contacto Directo</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">Llama directamente al profesional sin intermediarios ni comisiones de por medio. Trato 100% directo.</p>
          </div>
          <div class="text-center p-4">
            <div class="text-4xl mb-4">🔍</div>
            <h3 class="text-base font-bold text-white mb-2">Filtro por Localidad</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">Busca por tu estado y municipio para encontrar al técnico o taller más cercano a tu ubicación.</p>
          </div>
          <div class="text-center p-4">
            <div class="text-4xl mb-4">🕐</div>
            <h3 class="text-base font-bold text-white mb-2">Servicio 24 Horas</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">Identifica rápidamente cuáles negocios ofrecen servicio nocturno y de emergencias de madrugada.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Registrar Negocio CTA -->
    <section class="py-16 px-4 text-center">
      <div class="max-w-xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-extrabold text-white mb-3">¿Ofreces algún servicio local?</h2>
        <p class="text-sm text-neutral-400 leading-relaxed mb-6">Agrégate a nuestro directorio de forma 100% gratuita y empieza a recibir llamadas de clientes locales hoy mismo.</p>
        <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-orange-600 to-orange-500 text-white text-sm font-bold rounded-xl shadow-lg shadow-orange-500/20 hover:opacity-95 hover:-translate-y-0.5 transition duration-150">Registrar mi servicio gratis</a>
      </div>
    </section>
  </main>
</ServiciosLayout>
