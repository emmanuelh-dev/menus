---
export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=31536000, stale-while-revalidate=86400'
);
Astro.response.headers.set('Vercel-Cache-Tag', 'places-all');

import ServiciosLayout from "../../../layouts/ServiciosLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { getServiceTypeFromSlug, getServiceTitlePlural, getServiceEmoji, getServiceSeoPhrase } from "../../../lib/services";
import { getRestaurants } from "../../../lib/api";

const { servicio } = Astro.params;

if (!servicio) {
  return Astro.redirect('/servicios');
}

const serviceType = getServiceTypeFromSlug(servicio);

// Si no es un servicio mapeado en nuestro helper, redirigimos al hub principal
if (!serviceType) {
  return Astro.redirect('/servicios');
}

const serviceTitle = getServiceTitlePlural(serviceType);
const serviceEmoji = getServiceEmoji(serviceType);
const serviceSeoPhrase = getServiceSeoPhrase(serviceType);

// getRestaurants ya aplica el mapeo vulka_movil→vulcanizadora y el filtro por
// areas internamente (doc11) — mismo comportamiento que antes, menos código.
const places = await getRestaurants({ type: serviceType });

// Agrupar estados y obtener municipios con negocios registrados de este tipo
const estadosMap = new Map();
(places as any[] | null)?.forEach((place: any) => {
  if (place.states) {
    const state = place.states;
    if (!estadosMap.has(state.id)) {
      estadosMap.set(state.id, {
        id: state.id,
        name: state.name,
        slug: state.slug,
        emoji: '🏙️',
        total: 0,
        municipios: new Set()
      });
    }
    const stateData = estadosMap.get(state.id);
    stateData.total += 1;
    if (place.municipalities) {
      stateData.municipios.add(place.municipalities.name);
    }
  }
});

const estadosActivos = Array.from(estadosMap.values()).map(e => ({
  ...e,
  municipios: Array.from(e.municipios).slice(0, 4) // Mostrar primeros 4 municipios
}));

const seoData = {
  title: `${serviceSeoPhrase} en México 2026 | Teléfonos y Precios`,
  description: `Encuentra ${serviceSeoPhrase.toLowerCase()} en México por estado. Teléfonos verificados, precios, atención a domicilio y servicios de emergencia las 24 horas cerca de ti.`,
  h1: `Directorio de ${serviceTitle} en México`,
};

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios' },
  { label: serviceTitle },
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoData.h1,
  "description": seoData.description,
  "url": Astro.url.toString(),
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": b.label,
      "item": b.href ? `https://menus.bysmax.com${b.href}` : undefined
    }))
  }
};
---

<ServiciosLayout
  title={seoData.title}
  description={seoData.description}
  canonical={Astro.url.toString()}
  schemaData={schemaData}
  servicioActive={serviceType}
>
  <main class="bg-neutral-950 min-h-screen text-neutral-200">
    <!-- Hero -->
    <section class="bg-gradient-to-br from-neutral-950/25 via-neutral-950 to-neutral-950 py-16 px-4 text-center">
      <div class="max-w-3xl mx-auto">
        <div class="inline-block bg-neutral-500/10 text-neutral-400 px-4 py-1.5 rounded-full text-xs font-bold tracking-wider mb-5">
          {serviceEmoji} Emergencias y Servicio Local
        </div>
        <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">{seoData.h1}</h1>
        <p class="text-neutral-400 text-base md:text-lg mb-8 max-w-2xl leading-relaxed mx-auto">
          Localiza {serviceSeoPhrase.toLowerCase()} cerca de tu ubicación.
          Presupuestos directos, números de teléfono verificados y horarios de atención reales.
        </p>

        <!-- Stats rápidas -->
        <div class="flex justify-center gap-8 md:gap-12">
          <div class="text-center">
            <span class="block text-xl md:text-2xl font-black text-neutral-500 mb-0.5">24h</span>
            <span class="text-[10px] md:text-xs text-neutral-400 uppercase tracking-widest font-medium">Soporte y Emergencia</span>
          </div>
          <div class="text-center">
            <span class="block text-xl md:text-2xl font-black text-neutral-500 mb-0.5">{estadosActivos.length}</span>
            <span class="text-[10px] md:text-xs text-neutral-400 uppercase tracking-widest font-medium">Estados activos</span>
          </div>
          <div class="text-center">
            <span class="block text-xl md:text-2xl font-black text-neutral-500 mb-0.5">Gratis</span>
            <span class="text-[10px] md:text-xs text-neutral-400 uppercase tracking-widest font-medium">Presupuesto Directo</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumbs -->
    <div class="max-w-5xl mx-auto px-4 pt-6">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Selección de estado -->
    <section class="max-w-5xl mx-auto px-4 py-12 pb-16">
      <h2 class="text-2xl font-bold text-white mb-2">Selecciona tu estado</h2>
      
      {estadosActivos.length > 0 ? (
        <p class="text-sm text-neutral-400 leading-relaxed mb-8">
          Tenemos profesionales registrados en los siguientes estados. Selecciona uno para ver municipios y detalles.
        </p>
      ) : (
        <p class="text-sm text-neutral-400 leading-relaxed mb-8">
          Actualmente estamos registrando profesionales de este servicio. Pronto tendremos cobertura en tu región.
        </p>
      )}

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {estadosActivos.map(estado => (
          <a href={`/servicios/${servicio}/${estado.slug}`} class="flex items-center gap-4 p-5 bg-neutral-900/60 rounded-2xl hover:shadow-lg hover:shadow-neutral-950/5 hover:-translate-y-0.5 transition duration-200 group">
            <div class="text-3xl shrink-0">{estado.emoji}</div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-bold text-white mb-1">{estado.name}</h3>
              {estado.municipios.length > 0 ? (
                <p class="text-xs text-neutral-400 font-semibold mb-1 truncate">
                  {estado.municipios.join(' · ')}
                </p>
              ) : (
                <p class="text-xs text-neutral-400 font-semibold mb-1 truncate">Ver municipios disponibles</p>
              )}
              <p class="text-xs text-neutral-400 leading-normal">
                {estado.total} {estado.total === 1 ? 'establecimiento registrado' : 'establecimientos registrados'} en el estado.
              </p>
            </div>
            <svg class="text-neutral-500 shrink-0 group-hover:translate-x-1 group-hover:text-neutral-500 transition duration-200" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}

        {/* Fallback de estados populares */}
        {estadosActivos.length === 0 && ['Nuevo León', 'CDMX', 'Jalisco', 'Tamaulipas'].map(e => (
          <div class="flex items-center gap-4 p-5 bg-neutral-900/60 rounded-2xl opacity-55">
            <div class="text-3xl shrink-0">🗺️</div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-bold text-white mb-1">{e}</h3>
              <p class="text-xs text-neutral-400">Registro abierto para profesionales</p>
            </div>
            <span class="text-[9px] bg-neutral-850 text-neutral-400 px-2 py-0.5 rounded-md font-bold uppercase tracking-wider shrink-0 shadow-sm">Pronto</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Acceso rápido: filtros populares (si hay estados activos) -->
    {estadosActivos.length > 0 && (
      <section class="bg-neutral-900/30 py-10 px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-xs font-bold text-neutral-400 uppercase tracking-widest mb-4">Búsquedas populares</h2>
          <div class="flex flex-wrap gap-2">
            {estadosActivos.map(estado => (
              <a href={`/servicios/${servicio}/${estado.slug}?horario=24h`} class="px-4 py-1.5 bg-neutral-900 text-neutral-400 hover:text-neutral-400 rounded-full text-xs font-medium transition duration-150">
                🕐 {serviceTitle} 24h en {estado.name}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Texto SEO dinámico -->
    <section class="py-12 px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-xl font-bold text-neutral-500 mb-3 mt-8 first:mt-0">¿Necesitas {serviceTitle.toLowerCase()} de emergencia?</h2>
        <p class="text-sm text-neutral-400 leading-relaxed mb-4">
          Encontrar un profesional verificado y disponible a altas horas de la noche o en fin de semana puede ser sumamente complicado.
          Nuestro directorio recopila de forma detallada los números telefónicos, enlaces de WhatsApp directos y la ubicación
          geográfica de {serviceTitle.toLowerCase()} con servicio a domicilio y atención las 24 horas.
        </p>
        <p class="text-sm text-neutral-400 leading-relaxed mb-4">
          Todo esto de forma gratuita, sin comisiones ni intermediarios, para que puedas llamar directamente al técnico o taller
          y resolver tu inconveniente de la forma más rápida y económica posible.
        </p>
      </div>
    </section>
  </main>
</ServiciosLayout>
