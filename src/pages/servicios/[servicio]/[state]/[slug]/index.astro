---
export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=60'
);

import ServiciosLayout from "../../../../../layouts/ServiciosLayout.astro";
import Breadcrumbs from "../../../../../components/Breadcrumbs.astro";
import { getRestaurants, getRestaurantByName, supabase } from "../../../../../lib/supabase";
import { getServiceTypeFromSlug, getServiceTitlePlural } from "../../../../../lib/services";

const { servicio, state, slug } = Astro.params;

if (!servicio || !state || !slug) {
  return Astro.redirect('/servicios');
}

const serviceType = getServiceTypeFromSlug(servicio);
if (!serviceType) {
  return Astro.redirect('/servicios');
}

// 1. Obtener datos del estado
const { data: stateDb } = await supabase
  .from('states')
  .select('*')
  .eq('slug', state.toLowerCase())
  .single();

if (!stateDb) {
  return Astro.redirect(`/servicios/${servicio}`);
}

// 2. Verificar si el 'slug' corresponde a un municipio de este estado
const { data: municipalityDb } = await supabase
  .from('municipalities')
  .select('*')
  .eq('state_id', stateDb.id)
  .eq('slug', slug.toLowerCase())
  .maybeSingle();

let isMunicipality = !!municipalityDb;
let isPlaceRedirect = false;
let redirectUrl = '';
let place: any = null;
let lista: any[] = [];

// Variables para el caso de negocio
let placeSemantic: any = {};
let placeEs24h = false;
let placePhones: string[] = [];
let placeWhatsapps: string[] = [];
let placeAddress = '';
let placeDescription = '';
let placeMapsUrl = '';
let placeStateName = '';
let placeMunicipalityName = '';
let placeTitle = '';
let placeMetaDescription = '';
let placeSchemaData: any = null;
let placeBreadcrumbs: any[] = [];

if (isMunicipality && municipalityDb) {
  // Cargar todos los locales de este servicio en el estado
  const locales = await getRestaurants({ type: serviceType, state_id: stateDb.id });
  
  // Filtrar: coincidencia directa de municipio O negocios móviles con cobertura en el municipio
  lista = locales.filter(v => {
    const matchDirect = v.municipality_id === municipalityDb.id;
    
    const areas = v.content?.semantic_data?.areas || [];
    const matchMobile = areas.some((a: string) => 
      a.toLowerCase() === municipalityDb.slug || 
      a.toLowerCase() === municipalityDb.name.toLowerCase() ||
      a.toLowerCase() === 'all'
    );
    
    return matchDirect || matchMobile;
  });
} else {
  // No es un municipio. Podría ser un negocio individual
  const results = await getRestaurantByName({ name: slug });
  place = results[0];
  
  const dbType = serviceType === 'vulka_movil' ? 'vulcanizadora' : serviceType;
  if (place && place.type === dbType) {
    if (place.municipalities?.slug) {
      isPlaceRedirect = true;
      redirectUrl = `/servicios/${servicio}/${state}/${place.municipalities.slug}/${slug}`;
    } else {
      // Negocio sin municipio: configurar variables para renderizar directamente
      placeSemantic = place.content?.semantic_data || {};
      placeEs24h = (place.hours || placeSemantic.hours || '').toLowerCase().includes('24');
      const phone = placeSemantic.phone || place.phone || '';
      const whatsapp = placeSemantic.whatsapp || '';
      placeAddress = placeSemantic.address || place.address || '';
      placeDescription = placeSemantic.description || '';

      placePhones = phone.split(/[,\/|y]/).map((p: string) => p.trim()).filter(Boolean);
      placeWhatsapps = whatsapp.split(/[,\/|y]/).map((w: string) => w.trim()).filter(Boolean);

      placeMapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.name + ' ' + placeAddress)}`;

      placeStateName = place.states?.name || stateDb.name;
      placeMunicipalityName = 'General';

      placeTitle = `${place.name} en ${placeStateName} | Teléfono ${placeEs24h ? '· Servicio 24h' : ''}`;
      placeMetaDescription = `${placeDescription || `${place.name} en ${placeStateName}`}.${placeEs24h ? ' Servicio las 24 horas.' : ''} Teléfono${placePhones.length > 1 ? 's' : ''}: ${placePhones.slice(0, 2).join(', ')}. Dirección, opiniones y mapa interactivo.`;

      placeSchemaData = {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": place.name,
        "description": placeMetaDescription,
        "telephone": placePhones[0],
        "image": place.image,
        "address": {
          "@type": "PostalAddress",
          "streetAddress": placeAddress,
          "addressLocality": placeMunicipalityName,
          "addressRegion": placeStateName,
          "addressCountry": "MX"
        },
        "openingHours": placeEs24h ? ["Mo-Su 00:00-23:59"] : undefined,
        "priceRange": place.priceRange || "$$",
        "url": Astro.url.toString(),
        "aggregateRating": place.reviewCount > 0 ? {
          "@type": "AggregateRating",
          "ratingValue": place.rating,
          "reviewCount": place.reviewCount,
          "bestRating": 5,
          "worstRating": 1
        } : undefined
      };

      placeBreadcrumbs = [
        { label: 'Inicio', href: '/' },
        { label: 'Servicios', href: '/servicios' },
        { label: getServiceTitlePlural(serviceType), href: `/servicios/${servicio}` },
        { label: placeStateName, href: `/servicios/${servicio}/${state}` },
        { label: place.name },
      ];
    }
  }
}

// Si corresponde a redirección de negocio (301)
if (isPlaceRedirect && redirectUrl) {
  return Astro.redirect(redirectUrl, 301);
}

// Si no es municipio ni negocio válido, retornamos 404
if (!isMunicipality && !place) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}

const serviceTitle = getServiceTitlePlural(serviceType);
const serviceNameSingular = serviceType;

// SEO de la Landing de Municipio
const seoTitle = municipalityDb 
  ? `${serviceTitle} en ${municipalityDb.name}, ${stateDb.name} 2026 | Servicio Local`
  : 'Página no encontrada | BySMax';

const seoDescription = municipalityDb
  ? `Directorio verificado de ${serviceTitle.toLowerCase()} en ${municipalityDb.name}, ${stateDb.name}. Teléfonos directos, whatsapp y atención a domicilio las 24 horas.`
  : 'El servicio o localidad solicitada no se encuentra disponible.';

const breadcrumbs = municipalityDb ? [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios' },
  { label: serviceTitle, href: `/servicios/${servicio}` },
  { label: stateDb.name, href: `/servicios/${servicio}/${state}` },
  { label: municipalityDb.name },
] : [];

const schemaData = municipalityDb ? {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": seoTitle,
  "description": seoDescription,
  "numberOfItems": lista.length,
  "itemListElement": lista.map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": v.name,
      "telephone": v.phone || v.content?.semantic_data?.phone,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": v.address,
        "addressLocality": municipalityDb.name,
        "addressRegion": stateDb.name,
        "addressCountry": "MX"
      },
      "image": v.image
    }
  }))
} : null;
---

{municipalityDb ? (
  <ServiciosLayout
    title={seoTitle}
    description={seoDescription}
    canonical={Astro.url.toString()}
    schemaData={schemaData}
    servicioActive={serviceType}
  >
    <main class="bg-neutral-950 min-h-screen text-neutral-200">
      <!-- Hero -->
      <section class="bg-gradient-to-br from-orange-950/25 via-neutral-950 to-neutral-950 border-b border-orange-500/10 py-12 px-4">
        <div class="max-w-4xl mx-auto">
          <div class="inline-flex items-center gap-2 bg-orange-500/10 border border-orange-500/30 text-orange-400 px-3.5 py-1 rounded-full text-xs font-semibold tracking-wider mb-5">
            <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
            <span>Ubicación: {municipalityDb.name} · {stateDb.name}</span>
          </div>
          <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight leading-tight mb-3">{serviceTitle} en {municipalityDb.name}</h1>
          <p class="text-neutral-400 text-base md:text-lg mb-5 max-w-2xl leading-relaxed">
            Encuentra técnicos locales y negocios de {serviceTitle.toLowerCase()} en {municipalityDb.name} con servicio a domicilio y atención de emergencias.
          </p>

          <!-- Back button -->
          <div class="mt-4">
            <a href={`/servicios/${servicio}/${state}`} class="text-orange-500 hover:text-orange-400 text-sm font-semibold transition">
              ← Ver todo {stateDb.name}
            </a>
          </div>
        </div>
      </section>

      <!-- Breadcrumbs -->
      <div class="max-w-7xl mx-auto px-4 pt-6">
        <Breadcrumbs items={breadcrumbs} />
      </div>

      <!-- Resultados -->
      <section class="max-w-7xl mx-auto px-4 py-6 pb-12">
        <div class="mb-5">
          <p class="text-xs md:text-sm text-neutral-400 font-medium">
            {lista.length > 0
              ? `${lista.length} ${lista.length !== 1 ? serviceTitle.toLowerCase() : serviceNameSingular} registrada${lista.length !== 1 ? 's' : ''}`
              : `No se encontraron ${serviceTitle.toLowerCase()} en ${municipalityDb.name}`}
          </p>
        </div>

        {lista.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {lista.sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0)).map(loc => {
              const es24h = loc.hours?.toLowerCase().includes('24');
              const phones = (loc.content?.semantic_data?.phone || loc.phone || '')
                .split(/[,\/|y]/)
                .map((p: string) => p.trim())
                .filter(Boolean);
              const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(loc.name + ' ' + (loc.address || ''))}`;
              const detailUrl = `/servicios/${servicio}/${state}/${municipalityDb.slug}/${loc.short_name}`;
              const esMovil = loc.content?.semantic_data?.areas?.length > 0 && loc.municipality_id !== municipalityDb.id;

              return (
                <article class={`bg-neutral-900/60 border border-neutral-800/80 rounded-2xl overflow-hidden hover:border-orange-500/30 transition duration-300 flex flex-col hover:shadow-lg hover:shadow-orange-950/5 relative ${loc.featured ? 'border-orange-500/25 bg-gradient-to-b from-orange-950/10 to-neutral-900/60' : ''}`}>
                  <div class="relative h-40 overflow-hidden bg-neutral-950">
                    <img
                      src={loc.image || '/vulcanizadora-placeholder.jpg'}
                      alt={`${serviceTitle} ${loc.name} en ${municipalityDb.name}`}
                      loading="lazy"
                      class="w-full h-full object-cover transition duration-500 hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/75 to-transparent"></div>

                    {es24h && (
                      <div class="absolute top-3 left-3 flex items-center gap-1.5 bg-emerald-500/90 text-white text-[10px] font-extrabold tracking-wider px-2 py-1 rounded-full backdrop-blur-sm shadow-sm">
                        <span class="w-1.5 h-1.5 bg-white rounded-full animate-pulse"></span>
                        24 HORAS
                      </div>
                    )}

                    {esMovil && (
                      <div class="absolute bottom-3 left-3 bg-orange-500/90 text-white text-[10px] font-extrabold tracking-wider px-2 py-1 rounded-full backdrop-blur-sm shadow-sm">
                        🚚 Móvil / Domicilio
                      </div>
                    )}

                    {loc.featured && (
                      <div class="absolute top-3 right-3 bg-amber-500 text-neutral-950 text-[10px] font-black tracking-wider px-2.5 py-1 rounded-full shadow-sm">
                        ⭐ Destacado
                      </div>
                    )}
                  </div>

                  <div class="p-5 flex-1 flex flex-col justify-between">
                    <div>
                      <h2 class="text-lg font-bold text-white mb-2 leading-snug">
                        <a href={detailUrl} class="hover:text-orange-500 transition duration-150">{loc.name}</a>
                      </h2>

                      {loc.address && (
                        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="flex items-start gap-1.5 text-xs text-neutral-400 hover:text-white transition duration-150 mb-2 leading-relaxed">
                          <svg class="w-3.5 h-3.5 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                          </svg>
                          <span class="line-clamp-2">{loc.address}</span>
                        </a>
                      )}

                      <div class="flex items-center gap-1.5 text-xs text-neutral-400 mb-4">
                        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <circle cx="12" cy="12" r="10" />
                          <path stroke-linecap="round" d="M12 6v6l4 2" />
                        </svg>
                        <span class={es24h ? 'text-emerald-400 font-semibold' : ''}>{loc.hours || 'Consultar horario'}</span>
                      </div>

                      {phones.length > 0 && (
                        <div class="flex flex-col gap-1.5 mb-4 border-t border-neutral-800/60 pt-3">
                          {phones.map((phone: string, idx: number) => (
                            <a href={`tel:${phone.trim().replace(/\D/g, '')}`} class={`flex items-center gap-1.5 text-xs font-semibold hover:text-white transition duration-150 ${idx === 0 ? 'text-orange-500' : 'text-neutral-300'}`}>
                              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                              </svg>
                              {phone.trim()}
                            </a>
                          ))}
                        </div>
                      )}
                    </div>

                    <div class="flex gap-2.5 mt-auto pt-2">
                      {phones.length > 0 && (
                        <a
                          href={`tel:${phones[0].trim().replace(/\D/g, '')}`}
                          class="flex-1 inline-flex items-center justify-center gap-1.5 py-2 bg-gradient-to-r from-orange-600 to-orange-500 hover:from-orange-500 hover:to-orange-400 text-white font-bold text-xs rounded-lg transition duration-150 active:scale-[0.98]"
                        >
                          Llamar
                        </a>
                      )}
                      <a href={detailUrl} class="inline-flex items-center justify-center gap-1 py-2 px-3 bg-neutral-900 border border-neutral-800 hover:border-neutral-700 text-neutral-400 hover:text-white font-semibold text-xs rounded-lg transition duration-150">
                        Ver Ficha
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="text-center py-12 px-4 max-w-md mx-auto">
            <div class="text-5xl mb-4">📍</div>
            <h2 class="text-xl font-bold text-white mb-2">Sin resultados locales</h2>
            <p class="text-sm text-neutral-400 leading-relaxed mb-6">
              Aún no tenemos profesionales de este ramo registrados en {municipalityDb.name}.
            </p>
            <a href="/contact" class="inline-flex items-center justify-center gap-1.5 py-2 px-4 bg-gradient-to-r from-orange-600 to-orange-500 hover:from-orange-500 hover:to-orange-400 text-white font-bold text-xs rounded-lg transition duration-150 active:scale-[0.98]">
              Sugerir un negocio
            </a>
          </div>
        )}
      </section>
    </main>
  </ServiciosLayout>
) : place ? (
  <ServiciosLayout
    title={placeTitle}
    description={placeMetaDescription}
    ogImage={place.image}
    canonical={Astro.url.toString()}
    schemaData={placeSchemaData}
    servicioActive={serviceType}
  >
    <main class="bg-neutral-950 min-h-screen text-neutral-200">
      <div class="max-w-4xl mx-auto px-4 py-8">
        <Breadcrumbs items={placeBreadcrumbs} />

        <!-- Header del establecimiento -->
        <header class="mb-8 mt-4">
          <!-- Imagen principal -->
          {place.image && (
            <div class="relative h-64 md:h-96 rounded-2xl overflow-hidden mb-6 border border-neutral-800/80 shadow-inner">
              <img
                src={place.image}
                alt={`${place.name} en ${placeStateName}`}
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/65 to-transparent"></div>
              {placeEs24h && (
                <div class="absolute bottom-4 left-4 flex items-center gap-2 bg-emerald-500/90 text-white text-xs font-bold px-3 py-1.5 rounded-full backdrop-blur-sm">
                  <span class="w-2.5 h-2.5 bg-white rounded-full animate-pulse"></span>
                  Abierto 24 horas
                </div>
              )}
            </div>
          )}

          <!-- Info principal -->
          <div class="space-y-4">
            <div class="flex items-center gap-3 flex-wrap">
              <h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">{place.name}</h1>
              {placeEs24h && <span class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-extrabold px-2.5 py-1 rounded uppercase tracking-wider">24h</span>}
            </div>

            {place.rating > 0 && (
              <div class="flex items-center gap-2 text-sm">
                <span class="text-amber-400 font-bold">{'★'.repeat(Math.round(place.rating))}</span>
                <span class="text-white font-bold">{place.rating}</span>
                {place.reviewCount > 0 && <span class="text-neutral-400">({place.reviewCount} opiniones)</span>}
              </div>
            )}

            {placeDescription && <p class="text-neutral-400 text-sm leading-relaxed max-w-2xl">{placeDescription}</p>}

            <!-- Botones de Acción directos -->
            <div class="flex flex-wrap gap-3 mt-4">
              {placePhones.map((phoneNum: string) => (
                <a
                  href={`tel:${phoneNum.replace(/\D/g, '')}`}
                  class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-orange-600 to-orange-500 hover:from-orange-500 hover:to-orange-400 text-white font-bold text-sm rounded-xl transition duration-150 shadow-lg shadow-orange-950/20 active:scale-95"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  Llamar: {phoneNum}
                </a>
              ))}
              
              {placeWhatsapps.map((waNum: string) => (
                <a
                  href={`https://wa.me/${waNum.replace(/\D/g, '')}?text=${encodeURIComponent(`Hola, vi su información en BySMax. ¿Tienen servicio disponible?`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm rounded-xl transition duration-150 active:scale-95"
                >
                  <svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                  </svg>
                  WhatsApp: {waNum}
                </a>
              ))}

              <a
                href={placeMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-3 bg-neutral-900 border border-neutral-800 text-neutral-400 hover:text-white hover:border-neutral-700 font-semibold text-sm rounded-xl transition duration-150"
              >
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Google Maps
              </a>
            </div>
          </div>
        </header>

        <!-- Ficha de Datos -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Columna izquierda: información de contacto -->
          <div class="md:col-span-2 space-y-4">
            <!-- Teléfonos -->
            {placePhones.length > 0 && (
              <div class="bg-neutral-900/60 border border-neutral-800/80 rounded-xl p-5">
                <h2 class="flex items-center gap-2 text-xs font-bold text-neutral-400 uppercase tracking-wider mb-4 border-b border-neutral-800 pb-2">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  Números Telefónicos
                </h2>
                <div class="space-y-2">
                  {placePhones.map((p: string, i: number) => (
                    <a
                      href={`tel:${p.replace(/\D/g, '')}`}
                      class="flex items-center justify-between p-2.5 rounded-lg bg-neutral-950/40 hover:bg-neutral-950 border border-neutral-800/40 transition duration-150"
                    >
                      <span class={i === 0 ? "text-orange-500 font-bold" : "text-neutral-200 font-medium"}>{p}</span>
                      {i === 0 ? (
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-orange-500/10 text-orange-400 border border-orange-500/30 uppercase tracking-wider">Principal</span>
                      ) : (
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-850 text-neutral-400 border border-neutral-700/30 uppercase tracking-wider">Alternativo</span>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            )}

            <!-- Horario -->
            <div class="bg-neutral-900/60 border border-neutral-800/80 rounded-xl p-5">
              <h2 class="flex items-center gap-2 text-xs font-bold text-neutral-400 uppercase tracking-wider mb-4 border-b border-neutral-800 pb-2">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10" />
                  <path stroke-linecap="round" d="M12 6v6l4 2" />
                </svg>
                Horarios de Atención
              </h2>
              <div class="text-sm text-neutral-300 p-3 bg-neutral-950/40 border border-neutral-800/40 rounded-lg">
                {placeEs24h ? (
                  <div class="flex items-center gap-2 text-emerald-400 font-bold">
                    <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
                    <span>Abierto las 24 horas (Emergencias / A domicilio)</span>
                  </div>
                ) : (
                  <span>{place.hours || placeSemantic.hours || 'Consultar horarios directamente'}</span>
                )}
              </div>
            </div>

            <!-- Cobertura Geográfica -->
            {placeSemantic.areas && placeSemantic.areas.length > 0 && (
              <div class="bg-neutral-900/60 border border-neutral-800/80 rounded-xl p-5">
                <h2 class="flex items-center gap-2 text-xs font-bold text-neutral-400 uppercase tracking-wider mb-4 border-b border-neutral-800 pb-2">🚚 Zona de Cobertura</h2>
                <div class="space-y-3">
                  <p class="text-xs text-neutral-400">Este profesional ofrece servicio móvil a domicilio en las siguientes áreas:</p>
                  <div class="flex flex-wrap gap-2">
                    {placeSemantic.areas.map((area: string) => (
                      <span class="text-xs bg-neutral-950/80 border border-neutral-800 text-orange-300 px-3 py-1.5 rounded-md font-medium">📍 {area}</span>
                    ))}
                  </div>
                </div>
              </div>
            )}

            <!-- Dirección -->
            {placeAddress && (
              <div class="bg-neutral-900/60 border border-neutral-800/80 rounded-xl p-5">
                <h2 class="flex items-center gap-2 text-xs font-bold text-neutral-400 uppercase tracking-wider mb-4 border-b border-neutral-800 pb-2">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  Dirección Física
                </h2>
                <p class="text-neutral-300 text-sm leading-relaxed mb-3">{placeAddress}</p>
                <a href={placeMapsUrl} target="_blank" rel="noopener noreferrer" class="text-xs text-orange-400 hover:text-orange-300 font-semibold transition">
                  Ver ruta en Google Maps →
                </a>
              </div>
            )}

            <!-- Especialidades -->
            {place.specialties && place.specialties.length > 0 && (
              <div class="bg-neutral-900/60 border border-neutral-800/80 rounded-xl p-5">
                <h2 class="flex items-center gap-2 text-xs font-bold text-neutral-400 uppercase tracking-wider mb-4 border-b border-neutral-800 pb-2">🔧 Especialidades y Servicios</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {place.specialties.map((s: string) => (
                    <div class="flex items-start gap-2.5 text-sm text-neutral-300">
                      <span class="text-orange-500 font-bold">✓</span>
                      <span>{s}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Columna derecha: mapa embed + CTA de dueño -->
          <div class="space-y-4">
            {placeAddress && (
              <div class="border border-neutral-800/80 rounded-xl overflow-hidden bg-neutral-900/60 shadow-lg">
                <iframe
                  title={`Ubicación en Google Maps de ${place.name}`}
                  src={`https://maps.google.com/maps?q=${encodeURIComponent(place.name + ' ' + placeAddress)}&output=embed&z=15`}
                  width="100%"
                  height="280"
                  style="border:0;"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                ></iframe>
              </div>
            )}

            <a href={`/servicios/${servicio}/${state}`} class="block w-full py-3 bg-neutral-900 border border-neutral-800 text-neutral-400 hover:text-white hover:border-neutral-700 font-bold text-xs rounded-xl transition duration-150 text-center uppercase tracking-wider">
              ← Volver a {placeStateName}
            </a>

            <div class="bg-neutral-900/60 border border-neutral-800/80 rounded-xl p-5 border-dashed border-orange-500/20">
              <p class="text-sm font-bold text-white mb-1.5">¿Eres el dueño del negocio?</p>
              <p class="text-xs text-neutral-400 leading-relaxed mb-4">Reclama tu listado gratis para actualizar teléfonos, fotos de tus trabajos y horarios de atención.</p>
              <a href="/contact" class="inline-block px-4 py-2 bg-orange-500/10 border border-orange-500/30 text-orange-400 hover:bg-orange-500/20 hover:text-orange-300 font-bold text-xs rounded-lg transition duration-150">Reclamar este servicio</a>
            </div>
          </div>
        </div>
      </div>
    </main>
  </ServiciosLayout>
) : (
  <ServiciosLayout
    title="Página no encontrada"
    description="El servicio o localidad solicitada no se encuentra disponible."
  >
    <main class="flex items-center justify-center min-h-[70vh] bg-neutral-950 text-neutral-200">
      <div class="text-center py-12 px-4 max-w-md mx-auto">
        <div class="text-5xl mb-4">404</div>
        <h2 class="text-xl font-bold text-white mb-2">Localidad o servicio no encontrado</h2>
        <p class="text-sm text-neutral-400 leading-relaxed mb-6">El enlace que has seguido no existe o no tiene profesionales registrados.</p>
        <a href="/servicios" class="inline-flex items-center justify-center gap-1.5 py-2 px-4 bg-gradient-to-r from-orange-600 to-orange-500 hover:from-orange-500 hover:to-orange-400 text-white font-bold text-xs rounded-lg transition duration-150 active:scale-[0.98]">
          Ir al listado de servicios
        </a>
      </div>
    </main>
  </ServiciosLayout>
)}
