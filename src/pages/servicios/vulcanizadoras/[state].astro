---
// Redirigir /servicios/vulcanizadoras/nuevo-leon a la página detallada
// Esto permite escalar: /servicios/vulcanizadoras/[state]
export const prerender = false;

const { state } = Astro.params;

// Mapa de slugs de estado válidos
const validStates: Record<string, string> = {
  'nuevo-leon': 'nuevo-leon',
  'cdmx': 'cdmx',
  'jalisco': 'jalisco',
};

if (!state || !validStates[state]) {
  return Astro.redirect('/servicios/vulcanizadoras', 302);
}

// Por ahora solo nuevo-leon está activo
if (state !== 'nuevo-leon') {
  // Estado próximo — mostrar página de "coming soon" en lugar de redirigir
  // Futuro: return Astro.redirect(`/servicios/vulcanizadoras/${state}`, 302);
  return Astro.redirect('/servicios/vulcanizadoras', 302);
}

// Redirigir al estado activo
return Astro.redirect(`/servicios/vulcanizadoras/nuevo-leon`, 301);
---
