---
export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=600, stale-while-revalidate=120'
);

import ServiciosLayout from "../../../layouts/ServiciosLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";

// Datos estáticos de estados con vulcanizadoras (expandir conforme crezca)
const estados = [
  {
    name: 'Nuevo León',
    slug: 'nuevo-leon',
    emoji: '🏙️',
    municipios: ['Monterrey', 'San Nicolás', 'Guadalupe', 'Apodaca'],
    descripcion: 'Área metropolitana de Monterrey, zona más poblada del norte de México.'
  },
  // Futuras expansiones:
  // { name: 'CDMX', slug: 'cdmx', emoji: '🏛️', ... },
  // { name: 'Jalisco', slug: 'jalisco', emoji: '🌵', ... },
];

const seoData = {
  title: 'Vulcanizadoras en México 2026 | Servicio 24 Horas y Emergencias',
  description: 'Directorio de vulcanizadoras en México por estado. Encuentra la más cercana con servicio 24 horas, teléfonos verificados y horarios actualizados. Nuevo León, CDMX, Jalisco y más.',
  h1: 'Directorio de Vulcanizadoras en México',
};

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Vulcanizadoras' },
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoData.h1,
  "description": seoData.description,
  "url": Astro.url.toString(),
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": b.label,
      "item": b.href ? `https://menus.bysmax.com${b.href}` : undefined
    }))
  }
};
---

<ServiciosLayout
  title={seoData.title}
  description={seoData.description}
  canonical={Astro.url.toString()}
  schemaData={schemaData}
>
  <main>
    <!-- Hero -->
    <section class="hub-hero">
      <div class="hub-hero-inner">
        <div class="hero-badge">🔧 Servicios de Emergencia</div>
        <h1 class="hub-h1">{seoData.h1}</h1>
        <p class="hub-sub">
          Encuentra vulcanizadoras con servicio 24 horas cerca de ti.
          Teléfonos directos, horarios reales y ubicaciones en mapa.
        </p>

        <!-- Stats rápidas -->
        <div class="hub-stats">
          <div class="stat">
            <span class="stat-n">24h</span>
            <span class="stat-label">Servicio disponible</span>
          </div>
          <div class="stat">
            <span class="stat-n">NL</span>
            <span class="stat-label">Estado activo</span>
          </div>
          <div class="stat">
            <span class="stat-n">Gratis</span>
            <span class="stat-label">Registro de negocio</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Breadcrumbs -->
    <div class="breadcrumb-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Selección de estado -->
    <section class="estados-section">
      <div class="estados-inner">
        <h2 class="section-title">Selecciona tu estado</h2>
        <p class="section-sub">Tenemos cobertura en Nuevo León y pronto en más estados.</p>

        <div class="estados-grid">
          {estados.map(estado => (
            <a href={`/servicios/vulcanizadoras/${estado.slug}`} class="estado-card">
              <div class="estado-emoji">{estado.emoji}</div>
              <div class="estado-info">
                <h3 class="estado-name">{estado.name}</h3>
                <p class="estado-municipios">
                  {estado.municipios.join(' · ')}
                </p>
                {estado.descripcion && (
                  <p class="estado-desc">{estado.descripcion}</p>
                )}
              </div>
              <svg class="estado-arrow" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ))}

          <!-- Próximamente -->
          {['CDMX', 'Jalisco', 'Chihuahua', 'Tamaulipas'].map(e => (
            <div class="estado-card coming-soon">
              <div class="estado-emoji">🗺️</div>
              <div class="estado-info">
                <h3 class="estado-name">{e}</h3>
                <p class="estado-municipios">Próximamente</p>
              </div>
              <span class="soon-badge">Pronto</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Acceso rápido: filtros populares -->
    <section class="quick-access">
      <div class="quick-inner">
        <h2>Búsquedas populares</h2>
        <div class="quick-links">
          <a href="/servicios/vulcanizadoras/nuevo-leon?horario=24h" class="quick-link">
            🕐 Vulcanizadoras 24h en NL
          </a>
          <a href="/servicios/vulcanizadoras/nuevo-leon?municipio=Monterrey" class="quick-link">
            📍 Monterrey
          </a>
          <a href="/servicios/vulcanizadoras/nuevo-leon?municipio=San%20Nicolás" class="quick-link">
            📍 San Nicolás
          </a>
          <a href="/servicios/vulcanizadoras/nuevo-leon?municipio=Guadalupe" class="quick-link">
            📍 Guadalupe
          </a>
          <a href="/servicios/vulcanizadoras/nuevo-leon?municipio=Apodaca" class="quick-link">
            📍 Apodaca
          </a>
        </div>
      </div>
    </section>

    <!-- Texto SEO -->
    <section class="seo-text">
      <div class="seo-text-inner">
        <h2>¿Por qué es tan difícil encontrar una vulcanizadora de noche?</h2>
        <p>
          La mayoría de las vulcanizadoras en México no tienen página web propia.
          Cuando se poncha una llanta a las 2 de la mañana, dependes de que alguien en
          Google Maps haya registrado el negocio y que tenga el teléfono correcto.
        </p>
        <p>
          Este directorio nació de esa necesidad: reunir en un solo lugar las
          <strong>vulcanizadoras con servicio nocturno y 24 horas</strong> con sus
          teléfonos verificados, para que puedas llamar de inmediato sin perder tiempo buscando.
        </p>

        <h2>¿Cómo funciona este directorio?</h2>
        <p>
          Recopilamos información de vulcanizadoras locales a través de Google Maps, llamadas
          directas de verificación y sugerencias de la comunidad. Si conoces una vulcanizadora
          que debería aparecer aquí, <a href="/contact">contáctanos</a> y la agregamos gratis.
        </p>
      </div>
    </section>
  </main>
</ServiciosLayout>

<style>
  :root {
    --orange: #f97316;
    --orange-dark: #ea580c;
    --bg: #0a0a0a;
    --surface: #111111;
    --surface2: #1a1a1a;
    --border: rgba(249, 115, 22, 0.15);
    --text: #e5e7eb;
    --text-muted: #9ca3af;
  }

  /* ── Hero ── */
  .hub-hero {
    background: linear-gradient(160deg, #0f0500 0%, #1a0800 50%, #0a0a0a 100%);
    padding: 4rem 1.25rem 3rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .hub-hero-inner { max-width: 700px; margin: 0 auto; }

  .hero-badge {
    display: inline-block;
    background: rgba(249, 115, 22, 0.1);
    border: 1px solid rgba(249, 115, 22, 0.3);
    color: #f97316;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 1.25rem;
  }

  .hub-h1 {
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  .hub-sub {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .hub-stats {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
  }

  .stat { text-align: center; }

  .stat-n {
    display: block;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--orange);
  }

  .stat-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 500;
  }

  /* ── Breadcrumbs ── */
  .breadcrumb-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.75rem 1.25rem 0;
  }

  /* ── Estados ── */
  .estados-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.25rem;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.4rem;
  }

  .section-sub {
    color: var(--text-muted);
    margin-bottom: 1.75rem;
    font-size: 0.9rem;
  }

  .estados-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .estados-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .estado-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.25s;
  }

  a.estado-card:hover {
    border-color: rgba(249, 115, 22, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(249, 115, 22, 0.08);
  }

  .estado-card.coming-soon {
    opacity: 0.5;
    cursor: default;
  }

  .estado-emoji { font-size: 2rem; flex-shrink: 0; }

  .estado-info { flex: 1; }

  .estado-name {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.2rem;
  }

  .estado-municipios {
    font-size: 0.75rem;
    color: var(--orange);
    font-weight: 500;
    margin-bottom: 0.2rem;
  }

  .estado-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .estado-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  a.estado-card:hover .estado-arrow {
    transform: translateX(4px);
    color: var(--orange);
  }

  .soon-badge {
    font-size: 0.65rem;
    background: var(--surface2);
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    font-weight: 700;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  /* ── Quick Access ── */
  .quick-access {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 1.75rem 1.25rem;
  }

  .quick-inner { max-width: 1100px; margin: 0 auto; }

  .quick-access h2 {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.85rem;
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .quick-link {
    padding: 0.4rem 0.9rem;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
  }

  .quick-link:hover {
    border-color: var(--orange);
    color: var(--orange);
  }

  /* ── Texto SEO ── */
  .seo-text {
    padding: 3rem 1.25rem;
  }

  .seo-text-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .seo-text h2 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--orange);
    margin-top: 2rem;
    margin-bottom: 0.65rem;
  }

  .seo-text h2:first-child { margin-top: 0; }

  .seo-text p {
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
  }

  .seo-text strong { color: var(--text); }

  .seo-text a {
    color: var(--orange);
    text-decoration: none;
    font-weight: 600;
  }

  .seo-text a:hover { text-decoration: underline; }
</style>
