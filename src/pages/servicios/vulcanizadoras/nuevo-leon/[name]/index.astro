---
export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=60'
);

import ServiciosLayout from "../../../../../layouts/ServiciosLayout.astro";
import Breadcrumbs from "../../../../../components/Breadcrumbs.astro";
import { getRestaurantByName } from "../../../../../lib/supabase";

const { name } = Astro.params;

if (!name) {
  return Astro.redirect('/servicios/vulcanizadoras/nuevo-leon');
}

const results = await getRestaurantByName({ name });
const vulca = results[0];

if (!vulca || vulca.type !== 'vulcanizadora') {
  return Astro.redirect('/servicios/vulcanizadoras/nuevo-leon');
}

const semantic = vulca.content?.semantic_data || {};
const es24h = (vulca.hours || semantic.hours || '').toLowerCase().includes('24');
const phone = semantic.phone || vulca.phone || '';
const whatsapp = semantic.whatsapp || '';
const address = semantic.address || vulca.address || '';
const description = semantic.description || '';

// Parsear teléfonos múltiples
const phones = phone.split(/[,\/|y]/).map((p: string) => p.trim()).filter(Boolean);
const whatsapps = whatsapp.split(/[,\/|y]/).map((w: string) => w.trim()).filter(Boolean);

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(vulca.name + ' ' + address)}`;

// SEO
const stateName = vulca.states?.name || 'Nuevo León';
const title = `Vulcanizadora ${vulca.name} en ${stateName} | Teléfono${es24h ? ' · Abierto 24h' : ''} 2026`;
const metaDescription = `${description || `Vulcanizadora ${vulca.name}`} en ${stateName}.${es24h ? ' Servicio 24 horas.' : ''} Teléfono${phones.length > 1 ? 's' : ''}: ${phones.slice(0, 2).join(', ')}. Dirección y mapa.`;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  "name": vulca.name,
  "description": metaDescription,
  "telephone": phones[0],
  "image": vulca.image,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": address,
    "addressLocality": stateName,
    "addressRegion": stateName,
    "addressCountry": "MX"
  },
  "openingHours": es24h ? ["Mo-Su 00:00-23:59"] : undefined,
  "priceRange": vulca.priceRange || "$$",
  "url": Astro.url.toString(),
  "aggregateRating": vulca.reviewCount > 0 ? {
    "@type": "AggregateRating",
    "ratingValue": vulca.rating,
    "reviewCount": vulca.reviewCount,
    "bestRating": 5,
    "worstRating": 1
  } : undefined
};

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Vulcanizadoras', href: '/servicios/vulcanizadoras' },
  { label: stateName, href: `/servicios/vulcanizadoras/nuevo-leon` },
  { label: vulca.name },
];
---

<ServiciosLayout
  title={title}
  description={metaDescription}
  ogImage={vulca.image}
  canonical={Astro.url.toString()}
  schemaData={schemaData}
>
  <main class="detalle-main">
    <div class="detalle-inner">
      <Breadcrumbs items={breadcrumbs} />

      <!-- Header de la vulcanizadora -->
      <header class="detalle-header">
        <!-- Imagen -->
        {vulca.image && (
          <div class="detalle-img-wrap">
            <img
              src={vulca.image}
              alt={`Vulcanizadora ${vulca.name} en ${stateName}`}
              class="detalle-img"
            />
            <div class="detalle-img-overlay"></div>
            {es24h && (
              <div class="badge-24h-lg">
                <span class="pulse-dot"></span>
                Abierto 24 horas
              </div>
            )}
          </div>
        )}

        <!-- Info principal -->
        <div class="detalle-info">
          <div class="info-top">
            <h1 class="detalle-name">{vulca.name}</h1>
            {es24h && <span class="chip-24h">24h</span>}
          </div>

          {vulca.rating > 0 && (
            <div class="detalle-rating">
              <span class="stars">{'★'.repeat(Math.round(vulca.rating))}</span>
              <span class="rating-val">{vulca.rating}</span>
              {vulca.reviewCount > 0 && <span class="rating-count">({vulca.reviewCount} opiniones)</span>}
            </div>
          )}

          {description && <p class="detalle-desc">{description}</p>}

          <!-- CTAs principales — teléfono es el más importante -->
          <div class="detalle-ctas">
            {phones.length > 0 && (
              <a href={`tel:${phones[0].replace(/\D/g, '')}`} class="cta-call">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                Llamar ahora
              </a>
            )}
            {whatsapps.length > 0 && (
              <a
                href={`https://wa.me/${whatsapps[0].replace(/\D/g, '')}?text=${encodeURIComponent(`Hola, vi su información en el directorio. ¿Me pueden ayudar con una llanta?`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="cta-whatsapp"
              >
                <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                </svg>
                WhatsApp
              </a>
            )}
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="cta-maps">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Ver en mapa
            </a>
          </div>
        </div>
      </header>

      <!-- Grid de datos -->
      <div class="detalle-grid">
        <!-- Columna izquierda: datos de contacto -->
        <div class="data-col">
          <!-- Teléfonos -->
          {phones.length > 0 && (
            <div class="data-card">
              <h2 class="data-card-title">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                Teléfonos
              </h2>
              <div class="phones-detail">
                {phones.map((p: string, i: number) => (
                  <a href={`tel:${p.replace(/\D/g, '')}`} class={`phone-row ${i === 0 ? 'main-phone' : 'alt-phone'}`}>
                    <span class="phone-num">{p}</span>
                    {i === 0 ? <span class="phone-badge principal">Principal</span> : <span class="phone-badge alt">Alternativo</span>}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Horario -->
          <div class="data-card">
            <h2 class="data-card-title">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" />
                <path stroke-linecap="round" d="M12 6v6l4 2" />
              </svg>
              Horario
            </h2>
            <div class={`horario-display ${es24h ? 'open-24' : ''}`}>
              {es24h ? (
                <div class="horario-24h">
                  <span class="pulse-dot"></span>
                  <span>Abierto las 24 horas, los 7 días</span>
                </div>
              ) : (
                <span>{vulca.hours || semantic.hours || 'Consultar horario directamente'}</span>
              )}
            </div>
          </div>

          <!-- Dirección -->
          {address && (
            <div class="data-card">
              <h2 class="data-card-title">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Dirección
              </h2>
              <p class="address-text">{address}</p>
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="maps-link">
                Abrir en Google Maps →
              </a>
            </div>
          )}

          <!-- Servicios/especialidades -->
          {vulca.specialties && vulca.specialties.length > 0 && (
            <div class="data-card">
              <h2 class="data-card-title">🔧 Servicios</h2>
              <div class="servicios-list">
                {vulca.specialties.map((s: string) => (
                  <div class="servicio-item">
                    <span class="check">✓</span>
                    <span>{s}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Amenidades extra -->
          {vulca.amenities && vulca.amenities.length > 0 && (
            <div class="data-card">
              <h2 class="data-card-title">ℹ️ Información adicional</h2>
              <div class="servicios-list">
                {vulca.amenities.map((a: string) => (
                  <div class="servicio-item">
                    <span class="check">•</span>
                    <span>{a}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Columna derecha: mapa embed + volver -->
        <div class="map-col">
          <div class="map-embed-wrap">
            <iframe
              title={`Ubicación de ${vulca.name}`}
              src={`https://maps.google.com/maps?q=${encodeURIComponent(vulca.name + ' ' + address)}&output=embed&z=15`}
              width="100%"
              height="280"
              style="border:0;border-radius:12px;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>

          <!-- Volver al directorio -->
          <a href="/servicios/vulcanizadoras/nuevo-leon" class="back-link">
            ← Ver todas las vulcanizadoras en Nuevo León
          </a>

          <!-- ¿Es el dueño? -->
          <div class="owner-box">
            <p class="owner-title">¿Eres el dueño de {vulca.name}?</p>
            <p class="owner-desc">Reclama tu listado gratis para actualizar tu información, añadir fotos y más.</p>
            <a href="/contact" class="owner-cta">Reclamar negocio</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</ServiciosLayout>

<style>
  :root {
    --orange: #f97316;
    --orange-dark: #ea580c;
    --bg: #0a0a0a;
    --surface: #111111;
    --surface2: #1a1a1a;
    --border: rgba(249, 115, 22, 0.15);
    --text: #e5e7eb;
    --text-muted: #9ca3af;
  }

  .detalle-main { background: var(--bg); min-height: 100vh; }

  .detalle-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.75rem 1.25rem 4rem;
  }

  /* ── Header ── */
  .detalle-header {
    margin-top: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .detalle-img-wrap {
    position: relative;
    height: 260px;
    border-radius: 18px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .detalle-img-wrap { height: 340px; }
  }

  .detalle-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .detalle-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, transparent 50%);
  }

  .badge-24h-lg {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(34, 197, 94, 0.9);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    letter-spacing: 0.03em;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #fff;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .info-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .detalle-name {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.15;
  }

  .chip-24h {
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.4);
    color: #22c55e;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    letter-spacing: 0.06em;
  }

  .detalle-rating {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .stars { color: #fbbf24; font-size: 0.9rem; letter-spacing: -1px; }
  .rating-val { font-weight: 700; color: #fff; font-size: 0.9rem; }
  .rating-count { color: var(--text-muted); font-size: 0.8rem; }

  .detalle-desc {
    color: var(--text-muted);
    line-height: 1.65;
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
    max-width: 600px;
  }

  /* CTAs */
  .detalle-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .cta-call {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, var(--orange-dark), var(--orange));
    color: #fff;
    font-weight: 800;
    font-size: 0.9rem;
    border-radius: 12px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.15s;
    box-shadow: 0 4px 14px rgba(249, 115, 22, 0.3);
  }

  .cta-call:hover { opacity: 0.88; transform: scale(1.02); }

  .cta-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: #16a34a;
    color: #fff;
    font-weight: 700;
    font-size: 0.88rem;
    border-radius: 12px;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .cta-whatsapp:hover { opacity: 0.88; }

  .cta-maps {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.1rem;
    background: var(--surface2);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.85rem;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .cta-maps:hover { border-color: var(--orange); color: var(--orange); }

  /* ── Grid de datos ── */
  .detalle-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .detalle-grid { grid-template-columns: 1fr 340px; }
  }

  /* ── Data cards ── */
  .data-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.25rem;
    margin-bottom: 1rem;
  }

  .data-card-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.85rem;
  }

  /* Teléfonos */
  .phones-detail { display: flex; flex-direction: column; gap: 0.5rem; }

  .phone-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    transition: background 0.2s;
  }

  .phone-row:hover { background: var(--surface2); }

  .main-phone .phone-num { color: var(--orange); font-size: 1.05rem; font-weight: 700; }
  .alt-phone .phone-num { color: var(--text); font-size: 0.9rem; font-weight: 500; }

  .phone-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    letter-spacing: 0.04em;
  }

  .phone-badge.principal {
    background: rgba(249, 115, 22, 0.15);
    color: var(--orange);
    border: 1px solid rgba(249, 115, 22, 0.3);
  }

  .phone-badge.alt {
    background: var(--surface2);
    color: var(--text-muted);
    border: 1px solid rgba(255,255,255,0.06);
  }

  /* Horario */
  .horario-display {
    font-size: 0.9rem;
    color: var(--text);
    padding: 0.6rem 0.75rem;
    background: var(--surface2);
    border-radius: 10px;
  }

  .horario-24h {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #22c55e;
    font-weight: 700;
  }

  /* Dirección */
  .address-text {
    color: var(--text);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 0.6rem;
  }

  .maps-link {
    color: var(--orange);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    transition: opacity 0.2s;
  }

  .maps-link:hover { opacity: 0.75; }

  /* Servicios */
  .servicios-list { display: flex; flex-direction: column; gap: 0.4rem; }

  .servicio-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text);
  }

  .check { color: var(--orange); font-weight: 700; flex-shrink: 0; }

  /* ── Mapa ── */
  .map-col { position: sticky; top: 80px; height: fit-content; }

  .map-embed-wrap {
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 1rem;
    background: var(--surface2);
  }

  .back-link {
    display: block;
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: 1rem;
    transition: all 0.2s;
  }

  .back-link:hover { border-color: var(--orange); color: var(--orange); }

  /* Owner box */
  .owner-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.25rem;
  }

  .owner-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.4rem;
  }

  .owner-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 0.85rem;
  }

  .owner-cta {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.3);
    color: var(--orange);
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .owner-cta:hover { background: rgba(249, 115, 22, 0.2); }
</style>
