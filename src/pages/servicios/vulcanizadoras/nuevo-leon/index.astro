---
export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=60'
);

import ServiciosLayout from "../../../../layouts/ServiciosLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import { getRestaurants } from "../../../../lib/supabase";

const vulcanizadoras = await getRestaurants({ type: 'vulcanizadora' });

// Filtros desde URL
const url = new URL(Astro.request.url);
const horario = url.searchParams.get('horario') || '';
const municipio = url.searchParams.get('municipio') || '';

// Aplicar filtros
let lista = vulcanizadoras;
if (horario === '24h') {
  lista = lista.filter(v => v.hours?.toLowerCase().includes('24'));
}
if (municipio) {
  lista = lista.filter(v =>
    v.address?.toLowerCase().includes(municipio.toLowerCase()) ||
    v.specialties?.some((s: string) => s.toLowerCase().includes(municipio.toLowerCase()))
  );
}

const municipios = [
  'Monterrey', 'San Nicolás', 'Guadalupe', 'Apodaca',
  'San Pedro', 'Escobedo', 'Santa Catarina'
];

const seoData = (() => {
  if (horario === '24h') return {
    title: 'Vulcanizadoras 24 Horas en Nuevo León 2026 | Servicio de Emergencia',
    description: 'Vulcanizadoras abiertas las 24 horas en Nuevo León. Servicio de llanta ponchada a domicilio, parche y vulcanizado en frío. Teléfonos verificados.',
    h1: 'Vulcanizadoras 24 Horas en Nuevo León',
    sub: 'Servicio de emergencia disponible toda la noche'
  };
  if (municipio) return {
    title: `Vulcanizadoras en ${municipio}, Nuevo León 2026 | Teléfonos y Horarios`,
    description: `Directorio de vulcanizadoras en ${municipio}, Nuevo León. Teléfonos, horarios y servicios verificados. Parche de llanta rápido.`,
    h1: `Vulcanizadoras en ${municipio}`,
    sub: `Servicio local de llanta ponchada en ${municipio}`
  };
  return {
    title: 'Vulcanizadoras en Nuevo León 2026 | 24 Horas y Servicio a Domicilio',
    description: 'Directorio completo de vulcanizadoras en Nuevo León. Encuentra la más cercana con servicio 24 horas, parche de llanta, vulcanizado y más. Teléfonos verificados.',
    h1: 'Vulcanizadoras en Nuevo León',
    sub: 'Directorio de vulcanizadoras con teléfono, horario y ubicación'
  };
})();

const schemaData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": seoData.h1,
  "description": seoData.description,
  "numberOfItems": lista.length,
  "itemListElement": lista.map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@context": "https://schema.org",
      "@type": "AutoRepair",
      "name": v.name,
      "telephone": v.phone || v.content?.semantic_data?.phone,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": v.address,
        "addressLocality": "Nuevo León",
        "addressCountry": "MX"
      },
      "openingHours": v.hours?.toLowerCase().includes('24') ? ["Mo-Su 00:00-23:59"] : undefined,
      "image": v.image
    }
  }))
};

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Vulcanizadoras', href: '/servicios/vulcanizadoras' },
  { label: 'Nuevo León' },
];
---

<ServiciosLayout
  title={seoData.title}
  description={seoData.description}
  canonical={Astro.url.toString()}
  schemaData={schemaData}
>
  <main class="main-content">
    <!-- Hero -->
    <section class="hero-section">
      <div class="hero-inner">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span>Directorio verificado · Nuevo León</span>
        </div>
        <h1 class="hero-h1">{seoData.h1}</h1>
        <p class="hero-sub">{seoData.sub}</p>

        <!-- Filtros rápidos -->
        <div class="filtros">
          <a
            href="?horario=24h"
            class={`filtro-chip ${horario === '24h' ? 'active' : ''}`}
          >
            🕐 Solo 24 horas
          </a>
          {municipios.map(m => (
            <a
              href={`?municipio=${m}`}
              class={`filtro-chip ${municipio === m ? 'active' : ''}`}
            >
              📍 {m}
            </a>
          ))}
          {(horario || municipio) && (
            <a href="/servicios/vulcanizadoras/nuevo-leon" class="filtro-chip clear">
              ✕ Limpiar
            </a>
          )}
        </div>
      </div>
    </section>

    <!-- Breadcrumbs -->
    <div class="breadcrumb-wrap">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Grid de resultados -->
    <section class="grid-section">
      <div class="grid-header">
        <p class="results-count">
          {lista.length > 0
            ? `${lista.length} vulcanizadora${lista.length !== 1 ? 's' : ''} encontrada${lista.length !== 1 ? 's' : ''}`
            : 'Sin resultados para este filtro'}
        </p>
      </div>

      {lista.length > 0 ? (
        <div class="cards-grid">
          {lista.sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0)).map(vulca => {
            const es24h = vulca.hours?.toLowerCase().includes('24');
            const phones = (vulca.content?.semantic_data?.phone || vulca.phone || '').split(/[,\/|y]/).filter(Boolean);
            const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(vulca.name + ' ' + (vulca.address || ''))}`;
            return (
              <article class={`vulca-card ${vulca.featured ? 'featured' : ''}`}>
                {/* Imagen */}
                <div class="card-img-wrap">
                  <img
                    src={vulca.image || '/vulcanizadora-placeholder.jpg'}
                    alt={`Vulcanizadora ${vulca.name} en Nuevo León`}
                    loading="lazy"
                    class="card-img"
                  />
                  <div class="img-overlay"></div>

                  {es24h && (
                    <div class="badge-24h">
                      <span class="pulse-dot small"></span>
                      24 HORAS
                    </div>
                  )}

                  {vulca.featured && (
                    <div class="badge-top">⭐ Destacado</div>
                  )}
                </div>

                {/* Contenido */}
                <div class="card-body">
                  <h2 class="card-name">{vulca.name}</h2>

                  {vulca.address && (
                    <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="card-address">
                      <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      {vulca.address}
                    </a>
                  )}

                  {/* Horario */}
                  <div class="card-hours">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10" />
                      <path stroke-linecap="round" d="M12 6v6l4 2" />
                    </svg>
                    <span class={es24h ? 'text-green' : ''}>{vulca.hours || 'Consultar horario'}</span>
                  </div>

                  {/* Teléfonos */}
                  {phones.length > 0 && (
                    <div class="phones-list">
                      {phones.map((phone: string, idx: number) => (
                        <a href={`tel:${phone.trim().replace(/\D/g, '')}`} class={`phone-link ${idx === 0 ? 'primary' : 'alt'}`}>
                          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                          </svg>
                          {phone.trim()}
                          {idx > 0 && <span class="alt-label">Alt</span>}
                        </a>
                      ))}
                    </div>
                  )}

                  {/* Especialidades/servicios */}
                  {vulca.specialties && vulca.specialties.length > 0 && (
                    <div class="servicios-chips">
                      {vulca.specialties.slice(0, 4).map((s: string) => (
                        <span class="chip">{s}</span>
                      ))}
                    </div>
                  )}

                  {/* CTAs */}
                  <div class="card-ctas">
                    {phones.length > 0 && (
                      <a
                        href={`tel:${phones[0].trim().replace(/\D/g, '')}`}
                        class="cta-primary"
                      >
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        Llamar ahora
                      </a>
                    )}
                    <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="cta-secondary">
                      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      Ver en mapa
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        /* Estado vacío */
        <div class="empty-state">
          <div class="empty-icon">🔧</div>
          <h2 class="empty-title">Estamos construyendo este directorio</h2>
          <p class="empty-desc">
            Si conoces una vulcanizadora en Nuevo León que debería aparecer aquí,
            dinos y la agregamos gratis.
          </p>
          <a href="/contact" class="cta-primary" style="display:inline-flex;margin-top:1rem;">
            Sugerir una vulcanizadora
          </a>
        </div>
      )}
    </section>

    <!-- Sección de contenido SEO -->
    <section class="seo-content">
      <div class="seo-inner">
        <h2>¿Por qué usar este directorio de vulcanizadoras?</h2>
        <p>
          Cuando se te poncha una llanta, cada minuto cuenta. Este directorio reúne
          las vulcanizadoras de Nuevo León con <strong>teléfonos verificados, horarios reales
          y fotos del lugar</strong> para que puedas llamar de inmediato.
        </p>

        <div class="seo-grid">
          <div class="seo-card">
            <span class="seo-icon">🕐</span>
            <h3>Servicio 24 horas</h3>
            <p>Encuentra vulcanizadoras que atienden toda la noche y fines de semana.</p>
          </div>
          <div class="seo-card">
            <span class="seo-icon">📞</span>
            <h3>Teléfonos directos</h3>
            <p>Números verificados, incluyendo números alternativos si el principal no contesta.</p>
          </div>
          <div class="seo-card">
            <span class="seo-icon">📍</span>
            <h3>Ubicación exacta</h3>
            <p>Dirección y enlace directo a Google Maps para llegar fácilmente.</p>
          </div>
          <div class="seo-card">
            <span class="seo-icon">🏙️</span>
            <h3>Por municipio</h3>
            <p>Filtra por Monterrey, San Nicolás, Guadalupe, Apodaca y más municipios.</p>
          </div>
        </div>

        <!-- FAQ SEO -->
        <div class="faq-section">
          <h2>Preguntas frecuentes sobre vulcanizadoras en Nuevo León</h2>
          <div class="faq-list">
            <details class="faq-item">
              <summary>¿Qué vulcanizadoras abren las 24 horas en Nuevo León?</summary>
              <p>
                En Nuevo León existen algunas vulcanizadoras con servicio nocturno y de madrugada.
                Usa el filtro "Solo 24 horas" en esta página para ver solo las que tienen
                servicio disponible toda la noche.
              </p>
            </details>
            <details class="faq-item">
              <summary>¿Hay vulcanizadoras a domicilio en Monterrey?</summary>
              <p>
                Sí, algunas vulcanizadoras ofrecen servicio móvil o a domicilio en el área
                metropolitana de Monterrey. Busca en las especialidades de cada negocio
                si incluyen "servicio a domicilio" o "vulcanizadora móvil".
              </p>
            </details>
            <details class="faq-item">
              <summary>¿Cuánto cuesta un parche de llanta en Nuevo León?</summary>
              <p>
                El precio de un parche básico de llanta en Nuevo León varía entre $50 y $150 pesos
                dependiendo del tamaño de la llanta y el tipo de reparación. El vulcanizado en frío
                puede costar entre $80 y $200 pesos.
              </p>
            </details>
            <details class="faq-item">
              <summary>¿Cómo agrego mi vulcanizadora a este directorio?</summary>
              <p>
                Es completamente gratis. Contáctanos con el nombre del negocio, teléfono,
                dirección y horario y lo agregamos en menos de 24 horas.
              </p>
            </details>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA para negocios -->
    <section class="business-cta">
      <div class="business-cta-inner">
        <span class="cta-emoji">🔧</span>
        <h2>¿Tienes una vulcanizadora en Nuevo León?</h2>
        <p>Aparece gratis en este directorio y recibe llamadas de clientes que te buscan ahora mismo.</p>
        <a href="/contact" class="cta-primary large">Registrar mi negocio gratis</a>
      </div>
    </section>
  </main>
</ServiciosLayout>

<style>
  :root {
    --orange: #f97316;
    --orange-dark: #ea580c;
    --bg: #0a0a0a;
    --surface: #111111;
    --surface2: #1a1a1a;
    --border: rgba(249, 115, 22, 0.15);
    --text: #e5e7eb;
    --text-muted: #9ca3af;
  }

  .main-content { background: var(--bg); min-height: 100vh; }

  /* ── Hero ── */
  .hero-section {
    background: linear-gradient(160deg, #0f0500 0%, #1a0800 40%, #0a0a0a 100%);
    border-bottom: 1px solid var(--border);
    padding: 3rem 1.25rem 2.5rem;
  }

  .hero-inner { max-width: 1000px; margin: 0 auto; }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(249, 115, 22, 0.1);
    border: 1px solid rgba(249, 115, 22, 0.3);
    color: #f97316;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 1.25rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .pulse-dot.small { width: 6px; height: 6px; }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-h1 {
    font-size: clamp(1.8rem, 5vw, 3rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  .hero-sub {
    color: var(--text-muted);
    font-size: 1rem;
    margin-bottom: 1.75rem;
    max-width: 600px;
  }

  /* ── Filtros ── */
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filtro-chip {
    padding: 0.4rem 0.9rem;
    background: var(--surface2);
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
  }

  .filtro-chip:hover {
    border-color: var(--orange);
    color: var(--orange);
    background: rgba(249, 115, 22, 0.05);
  }

  .filtro-chip.active {
    background: rgba(249, 115, 22, 0.15);
    border-color: var(--orange);
    color: var(--orange);
    font-weight: 700;
  }

  .filtro-chip.clear {
    border-color: rgba(239, 68, 68, 0.4);
    color: #ef4444;
  }

  /* ── Breadcrumbs ── */
  .breadcrumb-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0.75rem 1.25rem 0;
  }

  /* ── Grid ── */
  .grid-section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }

  .grid-header { margin-bottom: 1.25rem; }

  .results-count {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .cards-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .cards-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── Card ── */
  .vulca-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }

  .vulca-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(249, 115, 22, 0.12);
    border-color: rgba(249, 115, 22, 0.4);
  }

  .vulca-card.featured {
    border-color: rgba(249, 115, 22, 0.35);
    background: linear-gradient(160deg, #120800, #111111);
  }

  .card-img-wrap {
    position: relative;
    height: 160px;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }

  .vulca-card:hover .card-img { transform: scale(1.07); }

  .img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);
  }

  .badge-24h {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    align-items: center;
    gap: 5px;
    background: rgba(34, 197, 94, 0.9);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }

  .badge-top {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(249, 115, 22, 0.9);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }

  .card-body { padding: 1rem 1rem 1.1rem; }

  .card-name {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .card-address {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    text-decoration: none;
    margin-bottom: 0.45rem;
    line-height: 1.4;
    transition: color 0.2s;
  }

  .card-address svg { flex-shrink: 0; margin-top: 1px; }
  .card-address:hover { color: var(--orange); }

  .card-hours {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }

  .card-hours .text-green { color: #22c55e; font-weight: 600; }

  /* Teléfonos */
  .phones-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 0.75rem;
  }

  .phone-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    transition: color 0.2s;
  }

  .phone-link.primary { color: var(--orange); }
  .phone-link.alt { color: var(--text-muted); font-weight: 500; }
  .phone-link:hover { color: #fff; }

  .alt-label {
    font-size: 0.6rem;
    background: var(--surface2);
    color: var(--text-muted);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  /* Chips servicios */
  .servicios-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-bottom: 0.85rem;
  }

  .chip {
    font-size: 0.68rem;
    background: rgba(249, 115, 22, 0.08);
    border: 1px solid rgba(249, 115, 22, 0.2);
    color: #fdba74;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    font-weight: 500;
  }

  /* CTAs */
  .card-ctas {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.1rem;
  }

  .cta-primary {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.55rem 0.75rem;
    background: linear-gradient(135deg, var(--orange-dark), var(--orange));
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    border-radius: 10px;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.15s;
  }

  .cta-primary:hover { opacity: 0.88; transform: scale(1.02); }
  .cta-primary.large { padding: 0.85rem 2rem; font-size: 0.95rem; }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.75rem;
    background: var(--surface2);
    border: 1px solid var(--border);
    color: var(--text-muted);
