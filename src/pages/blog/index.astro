---
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import RestaurantLayout from "../../layouts/RestaurantLayout.astro";
import { ArrowRight } from "lucide-react";
import { DIAS_DE_PRUEBA } from "../../data/pricing";

// La portada anterior se presentaba como blog gastronómico —"Experiencias
// Gastronómicas", "Recetas Compartidas"— y le hablaba al comensal. A quien le
// vendemos es a quien tiene el restaurante. Ahora los artículos se separan por
// audiencia: primero lo que le sirve al dueño, después las guías que traen
// tráfico.
//
// Se quitaron tres cosas que no resistían una revisión:
//   - Las métricas del pie: "120+ Recetas Compartidas", "15k Lectores
//     Mensuales", "4.9 de valoración". No hay recetas, hay 15 artículos y el
//     tráfico real es cercano a cero. Anunciar eso mientras se paga por
//     anuncios es regalar la primera objeción.
//   - Tres tarjetas de categoría con href="#" y fotos de relleno.
//   - Un formulario de newsletter sin `action` ni JS: no enviaba a ningún lado.
const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const paraNegocio = posts.filter((p) => p.data.audiencia === "negocio");
const directorios = posts.filter((p) => p.data.audiencia === "directorio");

const seo = {
	title: "Blog para dueños de restaurante | BySMax",
	description:
		"Cómo bajar comisiones, digitalizar tu carta y vender más por WhatsApp. Guías prácticas para quien opera un restaurante.",
};
---

<RestaurantLayout title={seo.title} description={seo.description}>
	<main>
		<section class="max-w-6xl mx-auto px-6 pt-16 pb-10">
			<div class="max-w-3xl">
				<p
					class="text-[11px] font-black uppercase tracking-[0.2em] text-marca-700"
				>
					Blog
				</p>
				<h1
					class="text-4xl md:text-6xl font-black text-neutral-900 tracking-tight mt-3 leading-[0.95]"
				>
					Para quien tiene el restaurante
				</h1>
				<p class="text-lg text-neutral-600 mt-6 font-medium">
					Comisiones, cartas digitales, pedidos por WhatsApp y sistemas de
					punto de venta. Lo que hemos aprendido montando menús para negocios
					reales.
				</p>
			</div>
		</section>

		{
			paraNegocio.length > 0 && (
				<section class="max-w-6xl mx-auto px-6 pb-16">
					<ul class="grid grid-cols-1 md:grid-cols-2 gap-8 list-none p-0 m-0">
						{paraNegocio.map((post, index) => (
							<li class={index === 0 ? "md:col-span-2" : ""}>
								<a
									href={`/blog/${post.slug}/`}
									class="group block h-full overflow-hidden rounded-2xl border border-neutral-200 bg-white no-underline transition-colors hover:border-neutral-300"
								>
									{post.data.heroImage && (
										<img
											width={720}
											height={360}
											src={post.data.heroImage}
											alt=""
											loading={index === 0 ? "eager" : "lazy"}
											class={`w-full object-cover ${index === 0 ? "h-64 md:h-80" : "h-48"}`}
										/>
									)}
									<div class="p-6">
										<p class="text-[11px] font-bold uppercase tracking-widest text-neutral-400">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h2
											class={`${index === 0 ? "text-2xl md:text-3xl" : "text-xl"} mt-2 font-black tracking-tight text-neutral-900`}
										>
											{post.data.title}
										</h2>
										<p class="mt-3 text-sm font-medium leading-relaxed text-neutral-600 line-clamp-3">
											{post.data.description}
										</p>
										<span class="mt-4 inline-flex items-center text-xs font-black uppercase tracking-widest text-marca-700">
											Leer
											<ArrowRight className="ml-2 h-3.5 w-3.5 transition-transform group-hover:translate-x-1" />
										</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<section class="border-y border-neutral-200 bg-neutral-50">
			<div
				class="max-w-6xl mx-auto px-6 py-14 flex flex-col gap-6 md:flex-row md:items-center md:justify-between"
			>
				<div class="max-w-xl">
					<h2 class="text-2xl font-black tracking-tight text-neutral-900">
						Deja de pagar un porcentaje por cada pedido
					</h2>
					<p class="mt-3 text-sm font-medium leading-relaxed text-neutral-600">
						Monta tu menú, publica tu QR y recibe los pedidos directo en tu
						WhatsApp. {DIAS_DE_PRUEBA} días de prueba, sin tarjeta para
						empezar.
					</p>
				</div>
				<a
					href="https://admin-menus.bysmax.com"
					class="group inline-flex shrink-0 items-center justify-center rounded-xl bg-neutral-900 px-6 py-4 text-[11px] font-black uppercase tracking-widest text-white transition-colors hover:bg-black"
				>
					Empieza ahora
					<ArrowRight
						className="ml-2 h-3.5 w-3.5 transition-transform group-hover:translate-x-1"
					/>
				</a>
			</div>
		</section>

		{
			directorios.length > 0 && (
				<section class="max-w-6xl mx-auto px-6 py-16">
					<h2 class="text-2xl font-black tracking-tight text-neutral-900">
						Guías y directorios
					</h2>
					<p class="mt-2 text-sm font-medium text-neutral-600">
						Listados de restaurantes, cafeterías y moteles hechos con fichas de
						nuestro propio directorio.
					</p>
					<ul class="mt-8 grid grid-cols-1 gap-4 list-none p-0 m-0 md:grid-cols-2 lg:grid-cols-3">
						{directorios.map((post) => (
							<li>
								<a
									href={`/blog/${post.slug}/`}
									class="group flex h-full flex-col rounded-2xl border border-neutral-200 bg-white p-5 no-underline transition-colors hover:border-neutral-300"
								>
									<p class="text-[11px] font-bold uppercase tracking-widest text-neutral-400">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h3 class="mt-2 text-base font-black leading-snug tracking-tight text-neutral-900">
										{post.data.title}
									</h3>
									<span class="mt-4 inline-flex items-center text-xs font-black uppercase tracking-widest text-marca-700">
										Leer
										<ArrowRight className="ml-2 h-3.5 w-3.5 transition-transform group-hover:translate-x-1" />
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</main>
</RestaurantLayout>
