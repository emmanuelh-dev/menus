<script>
  // Definir interfaces para elementos HTML con dataset específico para cafeterías
  interface CafeCardElement extends HTMLElement {
    dataset: {
      rating: string;
      distance: string;
      closed: string;
      hasMenu: string;
      zona: string;
      especialidad: string;
    };
    style: CSSStyleDeclaration;
  }

  interface FilterButtonElement extends HTMLElement {
    dataset: {
      filter?: string;
      location?: string;
    };
    style: CSSStyleDeclaration;
  }

  // Variables globales para filtros activos
  let activeQualityFilter = 'all';
  let activeLocationFilter = '';

  document.addEventListener('DOMContentLoaded', () => {
    // Obtener referencias a los elementos
    const filterButtons = document.querySelectorAll('.filter-btn');
    const locationFilterButtons = document.querySelectorAll('.location-filter-btn');
    const cafeCards = document.querySelectorAll('.cafe-card');
    const urlFilterIndicator = document.getElementById('url-filter-indicator');
    const filterMessage = document.getElementById('filter-message');
    const clearFiltersButton = document.getElementById('clear-filters');
    
    // Detectar parámetros URL y aplicar filtros automáticamente
    const urlParams = new URLSearchParams(window.location.search);
    const zonaParam = urlParams.get('zona');
    const tipoParam = urlParams.get('tipo');
    
    // Función para actualizar la clase activa en los botones de calidad
    function updateActiveQualityButton(activeButton: Element) {
      filterButtons.forEach(button => {
        if (button === activeButton) {
          button.classList.remove('bg-white/80');
          button.classList.add('bg-[#D4BEA3]');
        } else {
          button.classList.remove('bg-[#D4BEA3]');
          button.classList.add('bg-white/80');
        }
      });
    }
    
    // Función para actualizar la clase activa en los botones de ubicación
    function updateActiveLocationButton(activeButton: Element | null) {
      locationFilterButtons.forEach(button => {
        if (button === activeButton) {
          button.classList.remove('bg-white/80');
          button.classList.add('bg-[#D4BEA3]');
        } else {
          button.classList.remove('bg-[#D4BEA3]');
          button.classList.add('bg-white/80');
        }
      });
    }
    
    // Función principal para filtrar cafeterías
    function filterCafes() {
      cafeCards.forEach(card => {
        const cafeCard = card as CafeCardElement;
        const rating = parseFloat(cafeCard.dataset.rating);
        const distance = parseFloat(cafeCard.dataset.distance);
        const isClosed = cafeCard.dataset.closed === 'true';
        const hasMenu = cafeCard.dataset.hasMenu === 'true';
        const zona = cafeCard.dataset.zona;
        const esEspecialidad = cafeCard.dataset.especialidad === 'true';
        
        let shouldShow = true;
        
        // Filtros de calidad/estado
        switch(activeQualityFilter) {
          case 'all':
            shouldShow = true;
            break;
          case 'rated':
            shouldShow = rating >= 4.7;
            break;
          case 'open':
            shouldShow = !isClosed;
            break;
          case 'menu':
            shouldShow = hasMenu;
            break;
          case 'especialidad':
            shouldShow = esEspecialidad;
            break;
        }
        
        // Filtros de ubicación (aplicar además del filtro de calidad)
        if (shouldShow && activeLocationFilter) {
          shouldShow = zona === activeLocationFilter;
        }
        
        cafeCard.style.display = shouldShow ? 'block' : 'none';
      });
    }
      // Llamar a priorización después de cada filtrado
    const originalFilterCafes = filterCafes;
    const enhancedFilterCafes = function() {
      originalFilterCafes();
      prioritizeRelevantCafes();
    };
    
    // Reemplazar las llamadas a filterCafes con enhancedFilterCafes
    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const filterButton = button as FilterButtonElement;
        activeQualityFilter = filterButton.dataset.filter || 'all';
        updateActiveQualityButton(button);
        enhancedFilterCafes();
      });
    });
    
    locationFilterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const locationButton = button as FilterButtonElement;
        const location = locationButton.dataset.location || '';
        
        if (activeLocationFilter === location) {
          activeLocationFilter = '';
          updateActiveLocationButton(null);
        } else {
          activeLocationFilter = location;
          updateActiveLocationButton(button);
        }
        
        enhancedFilterCafes();
      });
    });
    
    // Aplicar filtros iniciales
    enhancedFilterCafes();
      // Función para mostrar/ocultar el indicador de filtros por URL
    function updateUrlFilterIndicator() {
      if (zonaParam || tipoParam) {
        if (urlFilterIndicator) {
          urlFilterIndicator.classList.remove('hidden');
        }
        
        let message = 'Filtros activos: ';
        
        if (zonaParam) {
          message += `Zona ${zonaParam.replace('-', ' ')} `;
        }
        
        if (tipoParam === 'especialidad') {
          message += `| Café de Especialidad`;
        }
        
        if (filterMessage) {
          filterMessage.innerHTML = message;
        }
      } else {
        if (urlFilterIndicator) {
          urlFilterIndicator.classList.add('hidden');
        }
      }
    }
    
    // Aplicar filtros automáticos basados en URL
    if (zonaParam) {
      activeLocationFilter = zonaParam;
      const locationButton = document.querySelector(`[data-location="${zonaParam}"]`) as HTMLElement;
      if (locationButton) {
        updateActiveLocationButton(locationButton);
      }
    }
    
    if (tipoParam === 'especialidad') {
      activeQualityFilter = 'especialidad';
      const especialidadButton = document.getElementById('filter-especialidad') as HTMLElement;
      if (especialidadButton) {
        updateActiveQualityButton(especialidadButton);
      }
    } else {
      // Si no hay filtros especiales, inicializar con "Mejor calificados"
      const ratedButton = document.getElementById('filter-rated') as HTMLElement;
      if (ratedButton) {
        activeQualityFilter = 'rated';
        updateActiveQualityButton(ratedButton);
      }
    }
      // Aplicar filtros iniciales
    enhancedFilterCafes();
    updateUrlFilterIndicator();
    
    // Función para mostrar cafeterías relevantes primero cuando hay intención de búsqueda
    function prioritizeRelevantCafes() {
      const grid = document.getElementById('cafeterias-grid');
      if (!grid) return;
      
      const cards = Array.from(grid.children) as HTMLElement[];
      
      // Si hay filtros activos de zona o especialidad, reordenar
      if (activeLocationFilter || activeQualityFilter === 'especialidad') {
        cards.sort((a, b) => {
          const aCard = a as CafeCardElement;
          const bCard = b as CafeCardElement;
          
          const aZonaMatch = activeLocationFilter ? aCard.dataset.zona === activeLocationFilter : false;
          const bZonaMatch = activeLocationFilter ? bCard.dataset.zona === activeLocationFilter : false;
          
          const aEspecialidadMatch = activeQualityFilter === 'especialidad' ? aCard.dataset.especialidad === 'true' : false;
          const bEspecialidadMatch = activeQualityFilter === 'especialidad' ? bCard.dataset.especialidad === 'true' : false;
          
          // Priorizar coincidencias exactas
          const aScore = (aZonaMatch ? 2 : 0) + (aEspecialidadMatch ? 1 : 0);
          const bScore = (bZonaMatch ? 2 : 0) + (bEspecialidadMatch ? 1 : 0);
          
          return bScore - aScore;
        });
        
        // Reordenar elementos en el DOM
        cards.forEach(card => grid.appendChild(card));
      }
    }
  });
</script>