---
import { Image } from "astro:assets";
import RestaurantLayout from "../../layouts/RestaurantLayout.astro";
import LocalBusinessSchema from "../../components/LocalBusinessSchema.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import { Coffee, MapPin, Clock, Star, DollarSign, Phone, ArrowRight } from "lucide-react";

// Importar imágenes para las cafeterías
import placeholder from "../menus/placeholder.svg";
import alchemyCoffee from "../menus/alchemycoffeelab/espuma.jpg";
import fosforoCafe from "../menus/fosforocafe/media/menu.jpg";
import { getRestaurants } from "../../lib/supabase";

interface CoffeeShop {
  name: string;
  rating: number;
  reviewCount: number;
  priceRange: string;
  address: string;
  hours: string;
  services: string[];
  image: ImageMetadata;
  menu?: string;
  distance?: string;
  closed?: boolean;
  openingTime?: string;
}


const cafeterias_raw = await getRestaurants({
  type: "cafeteria",
});

const cafeterias = cafeterias_raw.map((cafeteria) => ({
  ...cafeteria,
}));

const url = new URL(Astro.request.url);
const zona = url.searchParams.get('zona') || undefined;
const tipo = url.searchParams.get('tipo') || undefined;

const getDynamicSEO = () => {
  const baseTitle = "Mejores Cafeterías en Monterrey 2025";
  const baseDescription = "Descubre las mejores cafeterías en Monterrey";
  const baseKeywords = ["cafeterías en monterrey", "café monterrey"];
  const baseUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();

  // Si hay filtro por zona
  if (zona) {
    switch (zona.toLowerCase()) {
      case 'barrio-antiguo':
        return {
          title: `Cafeterías en Barrio Antiguo Monterrey 2025 | Café Prana y Más`,
          description: `Mejores cafeterías en Barrio Antiguo, Monterrey. Café Prana, Café Iguana y más opciones bohemias. Guía completa con ubicaciones y horarios.`,
          keywords: [...baseKeywords, "cafeterías barrio antiguo", "café barrio antiguo monterrey", "café prana barrio antiguo", "cafés bohemios monterrey"],
          heading: "Cafeterías en Barrio Antiguo",
          subheading: "Descubre los cafés más bohemios e históricos del corazón cultural de Monterrey",
          canonical: `${baseUrl}?zona=barrio-antiguo`,
          ogUrl: `${baseUrl}?zona=barrio-antiguo`
        };
      
      case 'san-pedro':
        return {
          title: `Cafeterías en San Pedro Garza García 2025 | Cafetería Kali y Más`,
          description: `Mejores cafeterías en San Pedro Garza García. Cafetería Kali, Café Central y opciones premium. Guía completa de café de especialidad.`,
          keywords: [...baseKeywords, "cafeterías san pedro", "cafetería san pedro garza garcía", "cafetería kali san pedro", "café especialidad san pedro"],
          heading: "Cafeterías en San Pedro Garza García", 
          subheading: "Las mejores opciones de café de especialidad en la zona más exclusiva",
          canonical: `${baseUrl}?zona=san-pedro`,
          ogUrl: `${baseUrl}?zona=san-pedro`
        };
      
      case 'centro':
        return {
          title: `Cafeterías en Centro Monterrey 2025 | Panem, El Cafelito y Más`,
          description: `Mejores cafeterías en Centro de Monterrey. Panem, El Cafelito, Cafetería Gaby y más opciones tradicionales. Guía completa.`,
          keywords: [...baseKeywords, "cafetería centro monterrey", "panem centro monterrey", "el cafelito monterrey", "cafeterías centro histórico"],
          heading: "Cafeterías en Centro Monterrey",
          subheading: "Tradición y sabor en el corazón histórico de la ciudad",
          canonical: `${baseUrl}?zona=centro`,
          ogUrl: `${baseUrl}?zona=centro`
        };
      
      case 'sur':
        return {
          title: `Cafeterías en Monterrey Sur 2025 | Le Petite Bretonne y Más`,
          description: `Mejores cafeterías en zona Sur de Monterrey. Le Petite Bretonne y más opciones. Guía completa con ubicaciones y especialidades.`,
          keywords: [...baseKeywords, "cafeterías monterrey sur", "le petite bretonne monterrey", "cafés zona sur monterrey"],
          heading: "Cafeterías en Monterrey Sur",
          subheading: "Explora los mejores cafés en la zona sur de la ciudad",
          canonical: `${baseUrl}?zona=sur`,
          ogUrl: `${baseUrl}?zona=sur`        };
    }
  }

  // Si hay filtro por tipo de café
  if (tipo === 'especialidad') {
    return {
      title: `Café de Especialidad en Monterrey 2025 | Cafetería Kali, Prana y Más`,
      description: `Mejor café de especialidad en Monterrey. Cafetería Kali, Café Prana, métodos alternativos y granos selectos. Guía completa 2025.`,
      keywords: [...baseKeywords, "café de especialidad monterrey", "café especialidad cerca de mi", "mejor café especialidad monterrey", "café gourmet monterrey"],
      heading: "Café de Especialidad en Monterrey",
      subheading: "Los mejores granos y métodos de preparación en la ciudad",
      canonical: `${baseUrl}?tipo=especialidad`,
      ogUrl: `${baseUrl}?tipo=especialidad`
    };
  }
  // SEO por defecto
  return {
    title: baseTitle + " | Café de Especialidad en Centro y San Pedro",
    description: baseDescription + ", San Pedro y Centro. Encuentra Cafetería Kali, Café Prana en Barrio Antiguo, El Cafelito y más. Guía completa con ubicaciones, horarios y menús.",
    keywords: [...baseKeywords, "cafetería centro monterrey", "cafeterías barrio antiguo monterrey", "cafetería san pedro", "mejores cafeterías monterrey", "cafeterías bonitas en monterrey", "cafeterías para trabajar en monterrey", "café de especialidad monterrey"],
    heading: "Mejores Cafeterías en Monterrey 2025",
    subheading: "Descubre las cafeterías más populares en Centro, San Pedro, Barrio Antiguo y toda la zona metropolitana de Monterrey",
    canonical: baseUrl,
    ogUrl: baseUrl
  };
};

const seoData = getDynamicSEO();

// Configuración para Schema.org
const schemaEnrichment = {
  address: {
    addressLocality: "Monterrey",
    addressRegion: "Nuevo León",
    addressCountry: "MX",
  },
};
---

<RestaurantLayout 
  title={seoData.title}
  description={seoData.description}
  schemaEnrichment={schemaEnrichment}
  backgroundColor="bg-[#F8F3E9]"
  canonical={seoData.canonical}
  ogUrl={seoData.ogUrl}
>  <!-- Local Business Structured Data -->
  <LocalBusinessSchema cafeterias={cafeterias} />
  
  <!-- Breadcrumb Structured Data -->
  <BreadcrumbSchema zona={zona} tipo={tipo} />
  
  <div class="min-h-screen bg-[#F8F3E9] py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">      <!-- Encabezado dinámico según filtros SEO -->  
      <div class="text-center mb-16">
        <h1 class="text-5xl md:text-6xl font-serif font-bold text-[#3A2E27] mb-4 tracking-tight">{seoData.heading}</h1>
        <p class="text-xl md:text-2xl font-serif text-[#5F4B3B] max-w-3xl mx-auto">{seoData.subheading}</p>
        <div class="mt-8 text-lg text-[#5F4B3B] max-w-4xl mx-auto">
          <p>Guía completa de cafeterías en Monterrey con ubicaciones verificadas, horarios actualizados y menús digitales. Incluye las favoritas de la comunidad: Cafetería Kali, Café Prana, El Cafelito, Panem y muchas más.</p>
        </div>
      </div><!-- Sección de ubicaciones destacadas - Compacta -->      <!-- Filtros interactivos -->
      <div class="mb-12 space-y-4">
        <!-- Filtros de calidad/estado -->
        <div class="flex flex-wrap justify-center gap-4">
          <button id="filter-all" class="filter-btn px-6 py-2 bg-[#D4BEA3] text-[#3A2E27] rounded-full font-serif hover:bg-[#BFA78E] transition-colors" data-filter="all">Todos</button>
          <button id="filter-rated" class="filter-btn px-6 py-2 bg-white/80 text-[#3A2E27] rounded-full font-serif hover:bg-[#D4BEA3] transition-colors" data-filter="rated">Mejor calificados</button>
          <button id="filter-open" class="filter-btn px-6 py-2 bg-white/80 text-[#3A2E27] rounded-full font-serif hover:bg-[#D4BEA3] transition-colors" data-filter="open">Abiertos ahora</button>
          <button id="filter-menu" class="filter-btn px-6 py-2 bg-white/80 text-[#3A2E27] rounded-full font-serif hover:bg-[#D4BEA3] transition-colors" data-filter="menu">Menú digital</button>
          <button id="filter-especialidad" class="filter-btn px-6 py-2 bg-white/80 text-[#3A2E27] rounded-full font-serif hover:bg-[#D4BEA3] transition-colors" data-filter="especialidad">De Especialidad</button>
        </div>
        
        <!-- Filtros de ubicación -->
        <div class="flex flex-wrap justify-center gap-4">
          <span class="text-sm text-[#5F4B3B] flex items-center">📍 Por zona:</span>
          <button id="filter-centro" class="location-filter-btn px-4 py-2 bg-white/80 text-[#3A2E27] rounded-full text-sm font-serif hover:bg-[#D4BEA3] transition-colors" data-location="centro">Centro</button>
          <button id="filter-san-pedro" class="location-filter-btn px-4 py-2 bg-white/80 text-[#3A2E27] rounded-full text-sm font-serif hover:bg-[#D4BEA3] transition-colors" data-location="san-pedro">San Pedro</button>
          <button id="filter-barrio-antiguo" class="location-filter-btn px-4 py-2 bg-white/80 text-[#3A2E27] rounded-full text-sm font-serif hover:bg-[#D4BEA3] transition-colors" data-location="barrio-antiguo">Barrio Antiguo</button>
          <button id="filter-sur" class="location-filter-btn px-4 py-2 bg-white/80 text-[#3A2E27] rounded-full text-sm font-serif hover:bg-[#D4BEA3] transition-colors" data-location="sur">Sur</button>
        </div>
      </div>

      <!-- Indicador de filtros activos por URL -->
      <div id="url-filter-indicator" class="mb-8 hidden">
        <div class="bg-gradient-to-r from-[#A67C52] to-[#8C5E3B] text-white rounded-lg p-4 text-center">
          <p class="font-serif text-lg">
            <span id="filter-message"></span>
          </p>
          <button id="clear-filters" class="mt-2 px-4 py-2 bg-white/20 hover:bg-white/30 rounded-lg text-sm transition-colors">
            Ver todas las cafeterías
          </button>
        </div>
      </div>

      <!-- Mapa visual de cafeterías (representación estilizada) -->
      <!-- <div class="relative mb-16 overflow-hidden rounded-xl bg-[#E6D7C3] p-4">
        <div class="absolute top-4 left-4 bg-white/90 px-4 py-2 rounded-lg shadow-md z-10">
          <h3 class="font-serif text-lg font-semibold text-[#3A2E27]">Mapa de Cafeterías</h3>
          <p class="text-sm text-[#5F4B3B]">Explora visualmente las cafeterías cercanas</p>
        </div>
        <div class="h-[300px] md:h-[400px] bg-[#E6D7C3] rounded-lg relative overflow-hidden">
          <div class="absolute inset-0 flex items-center justify-center">
            <p class="font-serif text-[#8C7B6D] text-lg">Mapa interactivo (próximamente)</p>
          </div>
          {cafeterias.map((cafe, index) => (
            <div 
              class="absolute w-3 h-3 bg-[#A67C52] rounded-full transform hover:scale-150 transition-transform cursor-pointer"
              style={`top: ${30 + Math.random() * 60}%; left: ${20 + Math.random() * 60}%;`}
              title={cafe.name}
            ></div>
          ))}
        </div>
      </div> -->      <!-- Grid de cafeterías con diseño creativo -->
      <div id="cafeterias-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {cafeterias.map((cafe) => {
          // Determinar zona basada en la dirección
          let zona = "centro";
          if (cafe.address?.includes("San Pedro") || cafe.address?.includes("Garza García")) {
            zona = "san-pedro";
          } else if (cafe.address?.includes("Barrio Antiguo") || cafe.name?.includes("Prana") || cafe.name?.includes("FOSFORO")) {
            zona = "barrio-antiguo";
          } else if (cafe.address?.includes("Sur") || cafe.name?.includes("Petite Bretonne")) {
            zona = "sur";
          }
          
          // Determinar si es café de especialidad
          const esEspecialidad = cafe.name?.includes("Kali") || 
                                 cafe.name?.includes("Prana") || 
                                 cafe.name?.includes("Alchemy") || 
                                 cafe.name?.includes("FOSFORO") ||
                                 cafe.services?.some(service => service.toLowerCase().includes("especialidad"));
          
          return (
          <div 
            class="cafe-card group relative overflow-hidden rounded-xl bg-white shadow-md hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1"
            data-rating={cafe.rating}
            data-distance={cafe.distance ? cafe.distance.replace(" km", "") : "0"}
            data-closed={cafe.closed ? "true" : "false"}
            data-has-menu={cafe.menu ? "true" : "false"}
            data-zona={zona}
            data-especialidad={esEspecialidad ? "true" : "false"}
          >
            <!-- Imagen con overlay -->
            <div class="relative aspect-square overflow-hidden">
              <img
                src={cafe.image} 
                alt={cafe.name}
                width={500}
                height={500}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 aspect-square"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-70"></div>
              
              <!-- Calificación y precio -->
              <div class="absolute bottom-3 left-3 flex items-center space-x-2">
                <div class="flex items-center bg-white/90 px-2 py-1 rounded-full">
                  <Star className="w-4 h-4 text-yellow-500 mr-1" />
                  <span class="text-sm font-medium">{cafe.rating}</span>
                  <span class="text-xs text-gray-600 ml-1">({cafe.reviewCount})</span>
                </div>
                <div class="bg-white/90 px-2 py-1 rounded-full">
                  <span class="text-sm font-medium">{cafe.priceRange}</span>
                </div>
              </div>

              <!-- Distancia -->
              {cafe.distance && (
                <div class="absolute top-3 right-3 bg-white/90 px-2 py-1 rounded-full">
                  <div class="flex items-center">
                    <MapPin className="w-3 h-3 text-[#A67C52] mr-1" />
                    <span class="text-xs">{cafe.distance}</span>
                  </div>
                </div>
              )}

              <!-- Indicador si está en el menú digital -->
              {cafe.menu && (
                <div class="absolute top-3 left-3 bg-[#A67C52] text-white px-2 py-1 rounded-full text-xs">
                  Menú Digital
                </div>
              )}
            </div>

            <!-- Contenido de la tarjeta -->
            <div class="p-5">
              <h3 class="font-serif text-xl font-bold text-[#3A2E27] mb-2 group-hover:text-[#A67C52] transition-colors">
                {cafe.menu ? (
                  <a href={cafe.menu} class="hover:underline">{cafe.name}</a>
                ) : (
                  cafe.name
                )}
              </h3>

              <!-- Estado (abierto/cerrado) -->
              <div class="flex items-center mb-3">
                <Clock className="w-4 h-4 text-gray-500 mr-2" />
                {cafe.closed ? (
                  <span class="text-sm text-red-500">Cerrado · Abre {cafe.openingTime}</span>
                ) : (
                  <span class="text-sm text-green-600">Abierto · {cafe.hours}</span>
                )}
              </div>

              <!-- Dirección con botón para ver en Google Maps -->
              <div class="flex items-start mb-3">
                <MapPin className="w-4 h-4 text-gray-500 mr-2 mt-0.5" />
                <div class="flex flex-col">
                  <span class="text-sm text-gray-600">{cafe.address}</span>
                  <a 
                    href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(cafe.address)}`} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="text-xs text-[#A67C52] hover:text-[#8C5E3B] mt-1 flex items-center transition-colors"
                  >
                    <span>Ver en el mapa</span>
                    <ArrowRight className="w-3 h-3 ml-1" />
                  </a>
                </div>
              </div>

              <!-- Servicios disponibles -->
              <div class="flex flex-wrap gap-2 mt-4">
                {cafe.services && cafe.services.map((service) => (
                  <span class="text-xs bg-[#F8F3E9] text-[#5F4B3B] px-2 py-1 rounded-full">{service}</span>
                ))}
              </div>

              <!-- Botón de acción -->
              <div class="mt-5">
                {cafe.menu ? (
                  <a 
                    href={'menus/' + cafe.menu} 
                    class="inline-block w-full text-center py-2 bg-[#A67C52] text-white rounded-lg font-serif hover:bg-[#8C5E3B] transition-colors"
                  >
                    Ver Menú
                  </a>
                ) : (
                  <button 
                    class="w-full py-2 bg-[#D4BEA3] text-[#3A2E27] rounded-lg font-serif hover:bg-[#BFA78E] transition-colors"
                  >
                    No hay menú disponible
                  </button>                )}
              </div>
            </div>
          </div>
          );
        })}
      </div>

      <!-- Sección de destacados -->
      <div class="mt-20 mb-16">
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#3A2E27] mb-8 text-center">Cafeterías Destacadas</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Cafetería destacada 1 -->
        { cafeterias.filter(cafe => cafe.featured).map(cafe=>(
          <div class="bg-white rounded-xl overflow-hidden shadow-lg flex flex-col md:flex-row">
             <div class="md:w-2/5 relative">
               <Image 
                 src={cafe.image} 
                 alt="Alchemy Coffee Lab"
                 width={400}
                 height={500}
                 class="w-full h-full object-cover"
               />
               <div class="absolute inset-0 bg-gradient-to-r from-black/50 to-transparent md:bg-gradient-to-t"></div>
               <div class="absolute bottom-4 left-4 md:bottom-auto md:top-4">
                 <div class="bg-white/90 px-2 py-1 rounded-full inline-block">
                   <Star className="w-4 h-4 text-yellow-500 inline mr-1" />
                   <span class="text-sm font-medium">4.7 (1.8K)</span>
                 </div>
               </div>
             </div>
             <div class="md:w-3/5 p-6">
               <h3 class="font-serif text-2xl font-bold text-[#3A2E27] mb-2">Alchemy Coffee Lab</h3>
               <p class="text-[#5F4B3B] mb-4">Un laboratorio de café donde cada taza es una experiencia sensorial única. Especialistas en métodos de preparación alternativos y granos de especialidad.</p>
               <div class="flex items-center mb-2">
                 <MapPin className="w-4 h-4 text-gray-500 mr-2" />
                 <span class="text-sm text-gray-600">Bruselas 902</span>
               </div>
               <div class="flex items-center mb-4">
                 <DollarSign className="w-4 h-4 text-gray-500 mr-2" />
                 <span class="text-sm text-gray-600">$200–300</span>
               </div>
                {cafe.menu ? (
                  <a 
                    href={'menus/' + cafe.menu} 
                    class="inline-block w-full text-center py-2 bg-[#A67C52] text-white rounded-lg font-serif hover:bg-[#8C5E3B] transition-colors"
                  >
                    Ver Menú
                  </a>
                ) : (
                  <button 
                    class="w-full py-2 bg-[#D4BEA3] text-[#3A2E27] rounded-lg font-serif hover:bg-[#BFA78E] transition-colors"
                  >
                    No hay menú disponible
                  </button>
                )}
             </div>
           </div>   
          ))
        }
        </div>
      </div>  
            <div class="mb-12 bg-white rounded-lg p-6 shadow-sm">
        <h2 class="text-2xl font-serif font-bold text-[#3A2E27] mb-4 text-center">Explora por Zona</h2>
        <div class="flex flex-wrap justify-center gap-4 text-sm">
          <div class="bg-[#F8F3E9] px-4 py-2 rounded-full">
            <span class="font-semibold text-[#3A2E27]">Centro:</span>
            <span class="text-[#5F4B3B]"> Panem, El Cafelito, Gaby</span>
          </div>
          <div class="bg-[#F8F3E9] px-4 py-2 rounded-full">
            <span class="font-semibold text-[#3A2E27]">San Pedro:</span>
            <span class="text-[#5F4B3B]"> Cafetería Kali, Café Central</span>
          </div>
          <div class="bg-[#F8F3E9] px-4 py-2 rounded-full">
            <span class="font-semibold text-[#3A2E27]">Barrio Antiguo:</span>
            <span class="text-[#5F4B3B]"> Café Prana, Café Iguana</span>
          </div>
          <div class="bg-[#F8F3E9] px-4 py-2 rounded-full">
            <span class="font-semibold text-[#3A2E27]">Sur:</span>
            <span class="text-[#5F4B3B]"> Le Petite Bretonne</span>
          </div>
        </div>
      </div>      <!-- Sección de cafeterías más populares - Versión compacta -->
      <div class="mb-12 bg-gradient-to-r from-[#F8F3E9] to-[#E6D7C3] rounded-lg p-6">
        <h2 class="text-2xl font-serif font-bold text-[#3A2E27] mb-4 text-center">⭐ Top Recomendadas por la Comunidad</h2>
        
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
          <!-- Cafetería Kali -->
          <div class="bg-white rounded-lg p-3 shadow-sm text-center hover:shadow-md transition-shadow">
            <div class="flex items-center justify-center mb-1">
              <Star className="w-3 h-3 text-yellow-500 mr-1" />
              <span class="text-xs font-medium">4.8</span>
            </div>
            <h3 class="text-sm font-serif font-bold text-[#3A2E27] mb-1">Cafetería Kali</h3>
            <p class="text-xs text-[#8C7B6D]">San Pedro</p>
          </div>

          <!-- Café Prana -->
          <div class="bg-white rounded-lg p-3 shadow-sm text-center hover:shadow-md transition-shadow">
            <div class="flex items-center justify-center mb-1">
              <Star className="w-3 h-3 text-yellow-500 mr-1" />
              <span class="text-xs font-medium">4.7</span>
            </div>
            <h3 class="text-sm font-serif font-bold text-[#3A2E27] mb-1">Café Prana</h3>
            <p class="text-xs text-[#8C7B6D]">Barrio Antiguo</p>
          </div>

          <!-- Panem -->
          <div class="bg-white rounded-lg p-3 shadow-sm text-center hover:shadow-md transition-shadow">
            <div class="flex items-center justify-center mb-1">
              <Star className="w-3 h-3 text-yellow-500 mr-1" />
              <span class="text-xs font-medium">4.6</span>
            </div>
            <h3 class="text-sm font-serif font-bold text-[#3A2E27] mb-1">Panem</h3>
            <p class="text-xs text-[#8C7B6D]">Centro</p>
          </div>

          <!-- El Cafelito -->
          <div class="bg-white rounded-lg p-3 shadow-sm text-center hover:shadow-md transition-shadow">
            <div class="flex items-center justify-center mb-1">
              <Star className="w-3 h-3 text-yellow-500 mr-1" />
              <span class="text-xs font-medium">4.5</span>
            </div>
            <h3 class="text-sm font-serif font-bold text-[#3A2E27] mb-1">El Cafelito</h3>
            <p class="text-xs text-[#8C7B6D]">Centro</p>
          </div>

          <!-- Le Petite Bretonne -->
          <div class="bg-white rounded-lg p-3 shadow-sm text-center hover:shadow-md transition-shadow">
            <div class="flex items-center justify-center mb-1">
              <Star className="w-3 h-3 text-yellow-500 mr-1" />
              <span class="text-xs font-medium">4.7</span>
            </div>
