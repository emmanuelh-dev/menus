---
import DefaultLayout from "../../layouts/DefaultLayout.astro";
import { getStates } from "../../lib/supabase";
import { MapPin, ChevronRight, Globe, Utensils } from "lucide-react";

const states = await getStates();

const pageData = {
	title: "Mapa del Sitio - Menús Digitales | BySMax",
	description:
		"Encuentra todos los menús digitales y cartas QR organizados por estado en nuestro directorio nacional.",
};
---

<DefaultLayout title={pageData.title} description={pageData.description}>
	<main class="bg-white min-h-screen">
		<!-- Premium Header -->
		<section class="py-24 bg-slate-900 relative overflow-hidden text-center">
			<div
				class="absolute inset-0 bg-gradient-to-br from-emerald-500/10 to-transparent"
			>
			</div>
			<div class="max-w-4xl mx-auto px-6 relative z-10">
				<h1
					class="text-5xl md:text-7xl font-black text-white mb-6 uppercase tracking-tighter leading-none"
				>
					Mapa del <span class="text-emerald-400">Sitio Regional</span>
				</h1>
				<p class="text-xl text-slate-400 font-medium max-w-2xl mx-auto">
					Explora nuestra red nacional de menús digitales y cartas QR. <br
						class="hidden md:block"
					/>
					La digitalización de México, estado por estado.
				</p>
			</div>
		</section>

		<section class="py-24">
			<div class="max-w-6xl mx-auto px-6">
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
					<!-- Column: Main Navigation -->
					<div class="lg:col-span-1">
						<h2
							class="text-[10px] font-black text-emerald-600 uppercase tracking-[0.4em] mb-10 border-b border-emerald-50 pb-4"
						>
							Páginas de Venta
						</h2>
						<div class="space-y-4">
							{
								[
									{ name: "Inicio BySMax", href: "/", icon: Globe },
									{ name: "Ver un menú demo", href: "/menus", icon: Utensils },
									{
										name: "Directorio Nacional",
										href: "/menus-digitales",
										icon: MapPin,
									},
									{
										name: "Cerrar venta - Registro",
										href: "/admin/register",
										icon: ChevronRight,
										highlight: true,
									},
								].map((link) => (
									<a
										href={link.href}
										class={`flex items-center justify-between p-6 rounded-[24px] border transition-all group ${link.highlight ? "bg-slate-900 border-slate-900 text-white shadow-xl shadow-slate-200" : "bg-white border-slate-100 text-slate-900 hover:border-emerald-200 hover:bg-emerald-50/50"}`}
									>
										<span class="font-black uppercase tracking-tight text-sm flex items-center gap-3">
											<link.icon
												className={`w-4 h-4 ${link.highlight ? "text-emerald-400" : "text-emerald-500"}`}
											/>
											{link.name}
										</span>
										<ChevronRight
											className={`w-4 h-4 group-hover:translate-x-1 transition-transform ${link.highlight ? "text-emerald-400" : "text-slate-300"}`}
										/>
									</a>
								))
							}
						</div>
					</div>

					<!-- Column: States (The Core Sitemap) -->
					<div class="lg:col-span-2">
						<h2
							class="text-[10px] font-black text-emerald-600 uppercase tracking-[0.4em] mb-10 border-b border-emerald-50 pb-4"
						>
							Directorios Estratégicos por Estado
						</h2>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-4">
							{
								states.map((state) => (
									<a
										href={`/menus-digitales/${state.slug}`}
										class="flex items-center justify-between group py-3 border-b border-slate-50 hover:border-emerald-100 transition-all"
									>
										<div class="flex items-center gap-4">
											<div class="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center text-slate-400 group-hover:bg-emerald-500 group-hover:text-white transition-all">
												<MapPin className="w-4 h-4" />
											</div>
											<span class="font-bold text-slate-600 group-hover:text-emerald-600 transition-colors">
												Menús en {state.name}
											</span>
										</div>
										<span class="text-[10px] font-black text-slate-300 uppercase tracking-widest group-hover:text-emerald-400">
											Ir a landing
										</span>
									</a>
								))
							}
						</div>
					</div>
				</div>

				<!-- Footer Note for SEO -->
				<div class="mt-32 pt-10 border-t border-slate-100 text-center">
					<p
						class="text-[10px] text-slate-400 font-bold uppercase tracking-[0.3em]"
					>
						Estructura optimizada para rastreo de buscadores &bull; BySMax {
							new Date().getFullYear()
						}
					</p>
				</div>
			</div>
		</section>
	</main>
</DefaultLayout>
