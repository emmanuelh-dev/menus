---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
	MessageCircle,
	ArrowRight,
	TrendingUp,
	ShieldCheck,
	Zap,
	Send,
	ShoppingCart,
	Smartphone,
	CheckCircle,
} from "lucide-react";

import DefaultLayout from "../layouts/DefaultLayout.astro";

const seoData = {
	title: "Menú Digital para WhatsApp | Recibe Pedidos Directos | BySMax",
	description:
		"Crea tu menú digital para WhatsApp gratis. Tus clientes arman su pedido y te lo envían organizado al chat. Vender por WhatsApp nunca fue tan fácil.",
	keywords:
		"menu digital whatsapp, pedidos whatsapp restaurante, carta digital whatsapp, vender por whatsapp, sistema de pedidos para whatsapp",
};
---

<DefaultLayout
	title={seoData.title}
	description={seoData.description}
	keywords={seoData.keywords}
	showAds={false}
>
	<div>
		<main class="flex-1">
			<!-- Hero Minimalist -->
			<section class="py-20 md:py-32 bg-white">
				<div class="max-w-4xl mx-auto px-6 text-center">
					<div
						class="inline-flex items-center justify-center p-3 bg-marca-100 text-marca-700 rounded-full mb-8"
					>
						<MessageCircle className="w-8 h-8" />
					</div>

					<h1
						class="text-4xl md:text-6xl font-black text-neutral-900 mb-6 tracking-tighter leading-[0.9]"
					>
						Vende por WhatsApp <br />
						<span class="text-marca-500">sin comisiones.</span>
					</h1>
					<p
						class="text-xl text-neutral-600 mb-10 max-w-xl mx-auto leading-relaxed font-medium"
					>
						Deja que tus clientes armen su pedido en tu menú digital y lo envíen
						directo a tu chat. Organizado, rápido y 100% tuyo.
					</p>

					<div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
						<a
							href="/admin/login"
							class="inline-flex items-center px-8 py-4 bg-[#25D366] text-white font-bold rounded-xl hover:bg-[#20bd5a] transition-all shadow-marca-500/20"
						>
							Empezar a Vender
							<ArrowRight className="ml-2 h-5 w-5" />
						</a>
					</div>

					<!-- Chat Simulation Minimal -->
					<div
						class="max-w-sm mx-auto bg-white rounded-3xl shadow-xl border border-neutral-100 overflow-hidden transform rotate-1 hover:rotate-0 transition-transform duration-500"
					>
						<div class="bg-[#075E54] p-4 flex items-center gap-3">
							<div
								class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center text-white font-bold"
							>
								R
							</div>
							<div class="text-left">
								<div class="font-bold text-white text-sm">Restaurante Demo</div>
							</div>
						</div>
						<div
							class="bg-[#ECE5DD] p-4 text-left min-h-[240px] flex flex-col justify-end space-y-3"
						>
							<div
								class="self-end bg-[#DCF8C6] p-3 rounded-lg shadow-sm max-w-[90%] text-sm"
							>
								<div class="font-bold text-marca-800 text-xs mb-1">
									Nuevo Pedido Web
								</div>
								<div class="space-y-1">
									<p>🍕 1x Pizza Pepperoni</p>
									<p>🥤 2x Refrescos</p>
									<div class="border-t border-marca-200 my-1"></div>
									<p class="font-bold">Total: $180.00</p>
									<p class="text-xs text-neutral-500">📍 Av. Siempre Viva 123</p>
								</div>
								<div class="text-[10px] text-right text-neutral-400 mt-1">
									14:05
								</div>
							</div>
							<div
								class="self-start bg-white p-3 rounded-lg shadow-sm max-w-[85%] text-sm"
							>
								<p>¡Recibido! 👨‍🍳 Tu pedido sale en 30min.</p>
								<div class="text-[10px] text-right text-neutral-400 mt-1">
									14:06
								</div>
							</div>
						</div>
						<div
							class="p-3 bg-neutral-50 border-t border-neutral-100 flex items-center gap-2"
						>
							<div
								class="flex-1 h-8 bg-white border border-neutral-200 rounded-full"
							>
							</div>
							<div
								class="w-8 h-8 bg-[#075E54] rounded-full flex items-center justify-center text-white"
							>
								<Send className="w-4 h-4" />
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Workflow Explanation -->
			<section class="py-24 bg-white">
				<div class="max-w-6xl mx-auto px-6">
					<div class="text-center mb-20">
						<h2
							class="text-3xl md:text-5xl font-black text-neutral-900 mb-4 tracking-tighter"
						>
							Adiós al desorden en el chat
						</h2>
						<p class="text-neutral-500 text-lg">
							Tus clientes aman la rapidez, tú amarás la organización.
						</p>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-20 items-center">
						<div class="space-y-12">
							<div class="flex gap-6">
								<div
									class="w-14 h-14 rounded-2xl bg-marca-50 text-marca-600 flex items-center justify-center shrink-0 border border-marca-100"
								>
									<Smartphone className="w-7 h-7" />
								</div>
								<div>
									<h4 class="font-bold text-xl mb-2">Catálogo Interactivo</h4>
									<p class="text-neutral-500 leading-relaxed">
										Tus clientes navegan por tu menú, ven fotos y precios sin
										salir del navegador.
									</p>
								</div>
							</div>
							<div class="flex gap-6">
								<div
									class="w-14 h-14 rounded-2xl bg-neutral-50 text-neutral-600 flex items-center justify-center shrink-0 border border-neutral-100"
								>
									<ShoppingCart className="w-7 h-7" />
								</div>
								<div>
									<h4 class="font-bold text-xl mb-2">Carrito Inteligente</h4>
									<p class="text-neutral-500 leading-relaxed">
										Pueden sumar extras (queso, tocino, etc.) y ver el total en
										tiempo real.
									</p>
								</div>
							</div>
							<div class="flex gap-6">
								<div
									class="w-14 h-14 rounded-2xl bg-neutral-50 text-neutral-600 flex items-center justify-center shrink-0 border border-neutral-100"
								>
									<Zap className="w-7 h-7" />
								</div>
								<div>
									<h4 class="font-bold text-xl mb-2">Envío en 1 Click</h4>
									<p class="text-neutral-500 leading-relaxed">
										Al finalizar, el pedido llega a tu WhatsApp con todos los
										detalles listos para preparar.
									</p>
								</div>
							</div>
						</div>

						<div class="bg-neutral-50 rounded-[40px] p-8 border border-neutral-100">
							<!-- Simulated Order Result -->
							<div
								class="bg-white rounded-2xl shadow-xl overflow-hidden border border-neutral-100"
							>
								<div
									class="bg-marca-600 p-4 text-white flex items-center gap-3"
								>
									<div class="w-10 h-10 bg-white/20 rounded-full"></div>
									<div>
										<p class="text-xs opacity-80">Cliente (WhatsApp)</p>
										<p class="font-bold">Nuevo Pedido Recibido</p>
									</div>
								</div>
								<div class="p-6 font-mono text-sm space-y-2">
									<p class="text-marca-600 font-bold mb-4">
										🛒 DETALLE DEL PEDIDO
									</p>
									<p>-------------------------</p>
									<p>1x Burger Doble Queso (+$2.00)</p>
									<p>1x Papas Grandes</p>
									<p>1x Coca Cola 600ml</p>
									<p>-------------------------</p>
									<p class="font-bold">TOTAL: $18.50</p>
									<p class="mt-4 text-neutral-400">Dir: Calle Falsa 123</p>
									<div class="mt-6 flex justify-end">
										<div
											class="bg-marca-100 text-marca-700 px-3 py-1 rounded-full text-xs font-bold"
										>
											Listo para preparar
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Benefits List Refined -->
			<section class="py-20 bg-neutral-50">
				<div class="max-w-5xl mx-auto px-6">
					<div class="grid grid-cols-1 md:grid-cols-3 gap-10">
						<div class="text-center">
							<div
								class="w-16 h-16 bg-white text-marca-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-sm"
							>
								<TrendingUp className="w-8 h-8" />
							</div>
							<h3 class="font-bold text-lg mb-2 text-neutral-900">
								0% Comisiones
							</h3>
							<p class="text-neutral-600 leading-relaxed">
								Todo el dinero es tuyo. No pagues el 30% a las apps de delivery.
							</p>
						</div>
						<div class="text-center">
							<div
								class="w-16 h-16 bg-white text-neutral-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-sm"
							>
								<ShieldCheck className="w-8 h-8" />
							</div>
							<h3 class="font-bold text-lg mb-2 text-neutral-900">
								Datos Propios
							</h3>
							<p class="text-neutral-600 leading-relaxed">
								Tú tienes el control de tus clientes. Construye tu base de datos
								real.
							</p>
						</div>
						<div class="text-center">
							<div
								class="w-16 h-16 bg-white text-neutral-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-sm"
							>
								<Zap className="w-8 h-8" />
							</div>
							<h3 class="font-bold text-lg mb-2 text-neutral-900">
								Ultra Rápido
							</h3>
							<p class="text-neutral-600 leading-relaxed">
								Configura en 5 minutos. Empieza a recibir pedidos hoy mismo.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Simple CTA -->
			<section class="py-20 bg-[#111b21] text-white overflow-hidden">
				<div class="max-w-3xl mx-auto px-6 text-center">
					<h2 class="text-3xl font-bold mb-6">¿Listo para recibir pedidos?</h2>
					<p class="text-lg text-neutral-400 mb-10">
						Es totalmente gratis y puedes cancelar cuando quieras.
					</p>

					<a
						href="/admin/login"
						class="inline-flex items-center px-8 py-4 bg-[#25D366] text-white font-bold rounded-xl hover:bg-[#20bd5a] transition-all transform hover:scale-105 shadow-marca-500/20"
					>
						Crear Cuenta Gratis
					</a>
				</div>
			</section>
		</main>
	</div>
</DefaultLayout>
